# Compiled files
*.o
*.so
*.rlib
*.dll

# Executables
*.exe
*.elf
*.bin

# Written by userspace/programs/build.sh next to the ELFs it installs
.userspace-manifest.json

# Generated by Cargo
/target/
Cargo.lock
!scripts/metal/efi-stub/Cargo.lock

# Build directories
build/
__pycache__/

# Worktree directories
.worktrees/

# Debug files
rust-os-gdb

