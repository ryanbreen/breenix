# Log files
*.log
test_output.log

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# IDE specific files
.idea/
.vscode/
*.iml

# MCP and other tool logs
.mcp-logs/
.serena/

# Test output
test-results/
coverage/

# QEMU/emulator files
*.qcow2
*.img
ovmf/

**/target/*
scripts/__pycache__

# Third-party sources and build artifacts (cloned/built locally)
third-party/

# EFI System Partition build artifact
esp/

# Parallels EFI disk image (build artifact from build-efi.sh)
scripts/parallels/breenix-efi.hds/

# Debug capture files
serial-capture*.txt
xhci_ftrace*.txt
.factory-runs/
logs/
.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Agent work-session scratch files (repo root)
/heartbeat
/heartbeat.codex
/turn*-*.md
/turn*-artifacts/

# Codex supervision-harness run directories (codex-wf): logs and transcripts,
# never source. Untracked and ignored by design.
.codex-runs/

# Forked Rust std checkout (target_os = "breenix"), required to build userspace.
# It is a per-developer path - it used to be committed as a symlink to one
# machine's home directory, which dangled in every other checkout (#678). Point
# BREENIX_RUST_FORK_LIBRARY at <fork>/library, or create this symlink locally.
/rust-fork

# Run Inspector (tools/breenix-runs): SwiftPM build products and the bundled app.
tools/breenix-runs/.build/
tools/breenix-runs/*.app/
tools/breenix-runs/Icon/AppIcon.iconset/

# All installed executables are local build products; no vendor ELF is pinned.
# Applet list written beside libc-busybox.elf by scripts/build-libc-busybox.sh.
libc-busybox.links
