#!/usr/bin/env python3
"""Host-driven server cases against a leased persistent boot, using the boot host's OpenSSH.

Run after install-persistent and `metal-run boot --persistent`:
    server-suite --boot ID --sha COMMIT --milestone server/ssh-keys
Site fields: SERVER_SSH_HOST, OPERATOR_USER, OPERATOR_SSH_PUBLIC_KEY.
The boot stays leased until the caller stops it through metal-run.
"""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import socket
import subprocess
import tempfile
import time

CASES = (
    ('port-22', 'SSH identification arrives on port 22 before the client sends anything'),
    ('host-key', 'OpenSSH keyscan matches the Ed25519 fingerprint printed by this boot'),
    ('strict-login', 'Strict host-key checking permits the operator key and a non-root identity'),
    ('aes256-gcm', 'OpenSSH authenticates and executes with aes256-gcm forced in both directions'),
    ('aes128-ctr', 'OpenSSH authenticates and executes with aes128-ctr forced in both directions'),
    ('ed25519-user', 'An authorized Ed25519 user key authenticates and executes'),
    ('password-refused', 'OpenSSH password-only authentication is refused'),
    ('wrong-key-refused', 'An unauthorized Ed25519 key is refused by publickey authentication'),
    ('root-refused', 'The authorized operator key cannot log in as root'),
    ('telnet-closed', 'Neither the standard nor the former development telnet port has a listener'),
    ('job-control', 'An interactive SSH PTY supports foreground jobs, terminal signals and owned slave'),
    ('quoted-command', 'Quoted sh -c scripts retain spaces, quotes and backslashes through bsh'),
)


def validate_manifest(manifest):
    expected = [('ssh-keys/' + name, title) for name, title in CASES]
    actual = [(category['id'] + '/' + case['id'], case['title'])
              for category in manifest['categories'] for case in category['cases']]
    if actual != expected:
        raise ValueError('host case table differs from the manifest in ids, order or titles')


def score(manifest, effort_path, records, serial, boot, sha, fatal_patterns):
    """Host evidence has no guest process sweep or PID-1 memory sample.

    Require an exact case table, complete ordered results and a captured persistent
    boot at the requested commit. Never turn a missing prerequisite into a pass.
    """
    validate_manifest(manifest)
    milestone = next(item for effort in effort_path['efforts'] if effort['id'] == 'server'
                     for item in effort['milestones'] if item['id'] == 'ssh-keys')
    categories = milestone['measure']['categories']
    if milestone['measure']['suite'] != 'server' or categories != ['ssh-keys']:
        raise ValueError('milestone measure differs from the implemented category')
    if any(not c['cases'] for c in manifest['categories'] if c['id'] in categories):
        raise ValueError('measured category has no cases')
    if boot.get('mode') != 'persistent' or boot.get('bootedCommit') != sha or not boot.get('evidenceEligible'):
        raise ValueError('evidence needs this commit booted on the persistent install')
    if records['boot'] != boot['id'] or records['commit'] != sha or records['milestone'] != 'server/ssh-keys':
        raise ValueError('host evidence belongs to another boot, commit or milestone')
    if [r['id'] for r in records['cases']] != ['ssh-keys/' + name for name, _ in CASES]:
        raise ValueError('host results are missing, duplicated or out of order')
    if any(r['result'] != 'PASS' for r in records['cases']):
        raise ValueError('one or more ssh-keys cases failed')
    if not records.get('cleanup'):
        raise ValueError('temporary authorized key cleanup did not succeed')
    if not re.search(r'bsshd: host key ED25519 SHA256:[A-Za-z0-9+/]+', serial):
        raise ValueError('boot did not print its host-key fingerprint')
    if records.get('consoleGaps'):
        raise ValueError('console capture has a gap')
    if any(re.search(pattern, serial) for pattern in fatal_patterns):
        raise ValueError('fatal kernel output in the persistent boot')
    return 'PASS: server/ssh-keys categories=ssh-keys cases=' + str(len(CASES))


def command(args, **kwargs):
    return subprocess.run(args, capture_output=True, text=True, timeout=45, **kwargs)


class Probe:
    def __init__(self, host, user, identity, directory):
        self.host, self.user, self.identity = host, user, identity
        self.directory = directory
        self.known = directory / 'known_hosts'
        self.common = ['ssh', '-F', '/dev/null', '-p', '22', '-o', 'ConnectTimeout=10',
                       '-o', 'ConnectionAttempts=1', '-o', 'StrictHostKeyChecking=yes',
                       '-o', 'UserKnownHostsFile=' + str(self.known), '-o', 'GlobalKnownHostsFile=/dev/null',
                       '-o', 'HostKeyAlgorithms=ssh-ed25519', '-o', 'IdentitiesOnly=yes',
                       '-o', 'IdentityAgent=none', '-o', 'BatchMode=yes']
        self.transcript = []
        self.original = None
        self.edkey = directory / 'ed25519'
        self.wrong = directory / 'wrong'
        for key in (self.edkey, self.wrong):
            result = command(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(key)])
            if result.returncode: raise ValueError('cannot generate temporary Ed25519 keys')

    def ssh(self, script, cipher=None, user=None, identity=None, options=(), input=None):
        args = self.common + ['-i', str(identity or self.identity)]
        if cipher: args += ['-c', cipher]
        args += list(options) + [(user or self.user) + '@' + self.host]
        if script is not None: args += [script]
        result = command(args, input=input)
        self.transcript.append(dict(command=args, exit=result.returncode, stdout=result.stdout, stderr=result.stderr))
        return result

    def require(self, result, output=None):
        if result.returncode != 0:
            raise ValueError('OpenSSH failed (exit ' + str(result.returncode) + ')')
        if output is not None and result.stdout.strip() != output:
            raise ValueError('remote output differs from the expected value')

    def refusal(self, result):
        if result.returncode != 255 or 'Permission denied (publickey)' not in result.stderr:
            raise ValueError('expected publickey authentication refusal, not transport failure')

    def run_case(self, name, serial):
        if name == 'port-22':
            with socket.create_connection((self.host, 22), timeout=10) as stream:
                stream.settimeout(10)
                data = b''
                while b'\n' not in data and len(data) < 256:
                    chunk = stream.recv(256 - len(data))
                    if not chunk: break
                    data += chunk
                if not data.startswith(b'SSH-2.0-') or b'\r\n' not in data:
                    raise ValueError('server sent no SSH identification before client data')
        elif name == 'host-key':
            result = command(['ssh-keyscan', '-T', '10', '-p', '22', '-t', 'ed25519', self.host])
            lines = [line for line in result.stdout.splitlines() if not line.startswith('#')]
            if result.returncode or len(lines) != 1:
                raise ValueError('OpenSSH keyscan did not return exactly one Ed25519 key')
            fingerprint = command(['ssh-keygen', '-E', 'sha256', '-lf', '-'], input=lines[0] + '\n')
            printed = set(re.findall(r'bsshd: host key ED25519 (SHA256:[A-Za-z0-9+/]+)', serial))
            if fingerprint.returncode or set(fingerprint.stdout.split()[1:2]) != printed:
                raise ValueError('scanned key fingerprint differs from this boot console')
            self.known.write_text(lines[0] + '\n')
        elif name == 'strict-login':
            result = self.ssh('id -u; id -g; printf "%s\\n" "$USER" "$HOME"; pwd')
            self.require(result, '1000\n1000\n' + self.user + '\n/home/' + self.user + '\n/home/' + self.user)
            # A deliberately different known host must be refused, too.
            wrong = (self.wrong.with_suffix('.pub')).read_text().split()
            self.known.write_text(self.host + ' ' + ' '.join(wrong[:2]) + '\n')
            try:
                rejected = self.ssh('true')
                if rejected.returncode != 255 or 'Host key verification failed' not in rejected.stderr:
                    raise ValueError('strict checking accepted a different host key')
            finally:
                self.run_case('host-key', serial)
        elif name in ('aes256-gcm', 'aes128-ctr'):
            cipher = 'aes256-gcm@openssh.com' if name == 'aes256-gcm' else 'aes128-ctr'
            self.require(self.ssh("printf 'cipher-ok\\n'", cipher=cipher), 'cipher-ok')
        elif name == 'ed25519-user':
            original = self.ssh('cat "$HOME/.ssh/authorized_keys"')
            self.require(original)
            self.original = original.stdout
            public = self.edkey.with_suffix('.pub').read_text().strip()
            self.require(self.ssh('printf "\\n%s\\n" ' + shlex.quote(public) + ' >> "$HOME/.ssh/authorized_keys"'))
            self.require(self.ssh('id -u', identity=self.edkey), '1000')
        elif name == 'password-refused':
            self.refusal(self.ssh('true', options=('-o', 'PubkeyAuthentication=no',
                          '-o', 'PreferredAuthentications=password', '-o', 'PasswordAuthentication=yes')))
        elif name == 'wrong-key-refused':
            self.refusal(self.ssh('true', identity=self.wrong))
        elif name == 'root-refused':
            self.refusal(self.ssh('true', user='root'))
        elif name == 'telnet-closed':
            table = self.ssh('cat /proc/net/tcp')
            self.require(table)
            for row in table.stdout.splitlines()[1:]:
                fields = row.split()
                if len(fields) >= 4 and fields[3] == '0A' and int(fields[1].split(':')[1], 16) in (23, 2323):
                    raise ValueError('a telnet listener exists, including on loopback')
            for port in (23, 2323):
                try:
                    with socket.create_connection((self.host, port), timeout=5):
                        raise ValueError('telnet port ' + str(port) + ' accepted a connection')
                except ConnectionRefusedError:
                    pass
        elif name == 'job-control':
            # Shell request (no exec): a PTY must become the shell's controlling tty.
            # A foreground sleep, Ctrl-C, and another command prove terminal signal routing.
            self.interactive_job_control()
        elif name == 'quoted-command':
            self.interactive_job_control(quoted=True)
        else:
            raise ValueError('unimplemented host case')

    def interactive_job_control(self, quoted=False):
        import select
        args = self.common + ['-i', str(self.identity), '-tt', self.user + '@' + self.host]
        process = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        seen = b''
        def until(marker):
            nonlocal seen
            deadline = time.monotonic() + 15
            while marker not in seen:
                if time.monotonic() >= deadline: raise ValueError('interactive PTY did not reach expected shell output')
                if select.select([process.stdout], [], [], 0.2)[0]:
                    data = os.read(process.stdout.fileno(), 4096)
                    if not data: raise ValueError('interactive SSH ended before the shell check')
                    seen += data
        def send(data):
            process.stdin.write(data); process.stdin.flush()
        try:
            send(b"printf 'READY-%s\\n' tty\n")
            until(b'READY-tty\r\n')
            if b'job control turned off' in seen: raise ValueError('shell has no controlling terminal')
            if quoted:
                send(b"/bin/bsh\n")
                until(b'bsh ')
                seen = b''
                send(b"/bin/sh -c 'printf \"<%s>\\n\" \"$1\" \"$2\" \"$3\"' sh 'two words' '' 'a\\b'\n")
                until(b'<two words>\r\n<>\r\n<a\\b>\r\n')
                send(b'exit\nexit\n')
                process.wait(timeout=10)
                if process.returncode != 0: raise ValueError('quoted command session failed')
                return
            # The controlling device resolves through /dev/tty; actual slave ownership is checked by tty's path.
            send(b"ls -ln $(tty); printf 'PTY-%s\\n' END\n")
            until(b'PTY-END\r\n')
            if not re.search(rb'crw--w----\s+\d+\s+1000\s+1000\s+', seen):
                raise ValueError('PTY slave owner, group or mode differs from the account and 0620')
            send(b"sleep 30\n")
            time.sleep(1)
            send(b'\x03')
            send(b"printf 'AFTER-%s\\n' interrupt\n")
            until(b'AFTER-interrupt\r\n')
            send(b'exit\n')
            process.wait(timeout=10)
            if process.returncode != 0: raise ValueError('interactive shell exit failed')
        finally:
            self.transcript.append(dict(interactive=seen.decode(errors='replace')))
            if process.poll() is None:
                process.terminate()  # Only this exact child, started above.
                process.wait(timeout=5)

    def cleanup(self):
        if self.original is not None:
            self.require(self.ssh('printf %s ' + shlex.quote(self.original) + ' > "$HOME/.ssh/authorized_keys"'))
            result = self.ssh('cat "$HOME/.ssh/authorized_keys"')
            self.require(result)
            if result.stdout != self.original: raise ValueError('authorized_keys restoration differs')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check-manifest', type=Path)
    parser.add_argument('--boot')
    parser.add_argument('--sha')
    parser.add_argument('--milestone', default='server/ssh-keys', choices=['server/ssh-keys'])
    args = parser.parse_args()
    if args.check_manifest:
        validate_manifest(json.loads(args.check_manifest.read_text()))
        return 0
    if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.boot or '') or not re.fullmatch(r'[a-f0-9]{40}', args.sha or ''):
        parser.error('--boot ID and --sha full commit required')
    runner = runpy.run_path(str(Path(__file__).with_name('metal-run')))
    env = runner['host_env']()
    remote = lambda *cmd, **kw: runner['in_metal'](env, *cmd, capture_output=True, text=True, **kw)
    directory = '/var/lib/breenix-metal/boots/' + args.boot
    def read(name):
        result = remote('cat', directory + '/' + name)
        if result.returncode: raise ValueError('boot artifact unavailable: ' + name)
        return result.stdout
    boot = json.loads(read('run.json'))
    lease = remote('cat', '/var/lib/breenix-metal/lease.json')
    if lease.returncode or json.loads(lease.stdout).get('id') != args.boot:
        raise ValueError('this boot does not hold the machine lease')
    serial = read('serial.txt')
    manifest = json.loads(read('definition/docs/suites/server.json'))
    validate_manifest(manifest)
    effort = json.loads(read('definition/docs/efforts/path.json'))
    site = remote('python3', '-c', 'import sys,json;sys.path.insert(0,"/opt/breenix-metal");'
                  'import metal_lib;s=metal_lib.load_site();'
                  'print(json.dumps({k:s.get(k) for k in ("SERVER_SSH_HOST","OPERATOR_USER","OPERATOR_SSH_PUBLIC_KEY")}))')
    if site.returncode: raise ValueError('cannot read suite site fields')
    site = json.loads(site.stdout)
    if not site['SERVER_SSH_HOST']: raise ValueError('site needs SERVER_SSH_HOST for the persistent server')
    identity = next((p.with_suffix('') for p in (Path.home() / '.ssh').glob('*.pub')
                     if p.read_text().split()[:2] == site['OPERATOR_SSH_PUBLIC_KEY'].split()[:2]
                     and p.with_suffix('').is_file()), None)
    if identity is None: raise ValueError('boot host has no private key matching the staged operator public key')
    fatal = json.loads(read('definition/docs/boot-path.json'))['fatal'] + [r'KERNEL PANIC:']
    records = dict(boot=args.boot, commit=args.sha, milestone=args.milestone, cases=[], cleanup=False, consoleGaps=[])
    with tempfile.TemporaryDirectory(prefix='server-ssh-keys-') as scratch:
        probe = Probe(site['SERVER_SSH_HOST'], site['OPERATOR_USER'], identity, Path(scratch))
        try:
            print('SUITE server START cases=' + str(len(CASES)), flush=True)
            for name, _ in CASES:
                start = time.monotonic()
                try:
                    probe.run_case(name, serial)
                    result, reason = 'PASS', ''
                except (ValueError, OSError, subprocess.SubprocessError) as error:
                    result, reason = 'FAIL', type(error).__name__ + ': ' + str(error)
                elapsed = int((time.monotonic() - start) * 1000)
                records['cases'].append(dict(id='ssh-keys/' + name, result=result, ms=elapsed, reason=reason))
                print(f'SUITE server CASE ssh-keys/{name} {result} ms={elapsed}' + (' msg=' + reason if reason else ''), flush=True)
        finally:
            try:
                probe.cleanup()
                records['cleanup'] = True
            except (ValueError, OSError, subprocess.SubprocessError) as error:
                records['cleanupError'] = type(error).__name__ + ': ' + str(error)
        transcript = probe.transcript
    passed = sum(r['result'] == 'PASS' for r in records['cases'])
    print(f'SUITE server DONE passed={passed} failed={len(CASES)-passed} skipped=0 total={len(CASES)}', flush=True)
    # Re-read the live capture after the last operation; authentication errors never mask a kernel failure.
    serial = read('serial.txt')
    records['consoleGaps'] = [json.loads(line) for line in read('events.jsonl').splitlines()
                              if json.loads(line).get('event') == 'console-gap']
    try:
        lease = remote('cat', '/var/lib/breenix-metal/lease.json')
        if lease.returncode or json.loads(lease.stdout).get('id') != args.boot:
            raise ValueError('boot lost the machine lease during the suite')
        verdict = score(manifest, effort, records, serial, boot, args.sha, fatal)
        status = 0
    except ValueError as error:
        verdict, status = 'FAIL: ' + str(error), 1
    records['verdict'] = verdict
    result = runner['in_metal'](env, 'tee', directory + '/server-ssh-keys.json',
                                input=json.dumps(records) + '\n', capture_output=True, text=True)
    if result.returncode: raise ValueError('cannot save host suite evidence in the boot store')
    result = runner['in_metal'](env, 'tee', directory + '/server-ssh-keys-transcript.json',
                                input=json.dumps(transcript) + '\n', capture_output=True, text=True)
    if result.returncode: raise ValueError('cannot save host transcript')
    print(verdict)
    return status


if __name__ == '__main__':
    raise SystemExit(main())
