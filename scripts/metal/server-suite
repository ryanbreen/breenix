# The populated categories in manifest order, and the milestone each one measures.
CATEGORIES = {'ssh-keys': SSH_KEYS, 'services': SERVICES, 'logs': LOGS}
MILESTONES = {'server/ssh-keys': 'ssh-keys', 'server/services': 'services', 'server/logs': 'logs'}
# bsshd restarts 1 s after a run that lasted 10 s exits (libs/libbreenix/src/services.rs); the window
# allows for the console's typing of the kill and for bsshd's start-up.
RESTART_WINDOW_S = 10


def validate_manifest(manifest):
    expected = [(category + '/' + name, title) for category, cases in CATEGORIES.items() for name, title in cases]
    actual = [(category['id'] + '/' + case['id'], case['title'])
              for category in manifest['categories'] for case in category['cases']]
    if actual != expected:
        raise ValueError('host case table differs from the manifest in ids, order or titles')


def score(manifest, effort_path, records, serial, boot, sha, fatal_patterns):
    """Host evidence has no guest process sweep or PID-1 memory sample.

    Require an exact case table, complete ordered results and a captured persistent
    boot at the requested commit. Never turn a missing prerequisite into a pass.
    """
    validate_manifest(manifest)
    name = records.get('milestone')
    if name not in MILESTONES:
        raise ValueError('host evidence names no server milestone this runner measures')
    category = MILESTONES[name]
    milestone = next(item for effort in effort_path['efforts'] if effort['id'] == 'server'
                     for item in effort['milestones'] if 'server/' + item['id'] == name)
    categories = milestone['measure']['categories']
    if milestone['measure']['suite'] != 'server' or categories != [category]:
        raise ValueError('milestone measure differs from the implemented category')
    if any(not c['cases'] for c in manifest['categories'] if c['id'] in categories):
        raise ValueError('measured category has no cases')
    if boot.get('mode') != 'persistent' or boot.get('bootedCommit') != sha or boot.get('toolsCommit') != sha or not boot.get('evidenceEligible'):
        raise ValueError('evidence needs this commit booted on the persistent install')
    if records['boot'] != boot['id'] or records['commit'] != sha:
        raise ValueError('host evidence belongs to another boot, commit or milestone')
    if [r['id'] for r in records['cases']] != [category + '/' + case for case, _ in CATEGORIES[category]]:
        raise ValueError('host results are missing, duplicated or out of order')
    if any(r['result'] != 'PASS' for r in records['cases']):
        raise ValueError('one or more ' + category + ' cases failed')
    if not records.get('cleanup'):
        raise ValueError('temporary authorized key cleanup did not succeed' if category == 'ssh-keys'
                         else 'temporary services were not removed')
    if not re.search(r'bsshd: host key ED25519 SHA256:[A-Za-z0-9+/]+', serial):
        raise ValueError('boot did not print its host-key fingerprint')
    if category == 'ssh-keys' and "bsshd: refused method 'password'" not in serial:
        raise ValueError('boot captured no actual password request refusal')
    if category == 'services':
        for line in ('[init] bsshd killed by signal 9', '[init] svc-suite-fail is crash-looping: 5 failures in a row'):
            if line not in serial:
                raise ValueError('boot captured no line ' + line)
    if category == 'logs' and (not records.get('previous') or records['previous'].get('commit') != sha):
        raise ValueError('logs need prior persistent boot evidence at this commit')
    if records.get('consoleGaps'):
        raise ValueError('console capture has a gap')
    if any(re.search(pattern, serial) for pattern in fatal_patterns):
        raise ValueError('fatal kernel output in the persistent boot')
    return 'PASS: ' + name + ' categories=' + category + ' cases=' + str(len(CATEGORIES[category]))


def command(args, **kwargs):
    kwargs.setdefault('timeout', 45)
    kwargs.setdefault('text', True)
    return subprocess.run(args, capture_output=True, **kwargs)


class Probe:
    def __init__(self, host, user, identity, directory):
        self.host, self.user, self.identity = host, user, identity
        self.directory = directory
        self.known = directory / 'known_hosts'
        self.common = ['ssh', '-F', '/dev/null', '-p', '22', '-o', 'ConnectTimeout=10',
                       '-o', 'ConnectionAttempts=1', '-o', 'StrictHostKeyChecking=yes',
                       '-o', 'UserKnownHostsFile=' + str(self.known), '-o', 'GlobalKnownHostsFile=/dev/null',
                       '-o', 'HostKeyAlgorithms=ssh-ed25519', '-o', 'IdentitiesOnly=yes',
                       '-o', 'IdentityAgent=none', '-o', 'BatchMode=yes']
        self.transcript = []
        self.original = None
        self.edkey = directory / 'ed25519'
        self.wrong = directory / 'wrong'
        for key in (self.edkey, self.wrong):
            result = command(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(key)])
            if result.returncode: raise ValueError('cannot generate temporary Ed25519 keys')

    def ssh(self, script, cipher=None, user=None, identity=None, options=(), input=None, posix=True, env=None, timeout=45, binary=False):
        args = self.common + ['-i', str(identity or self.identity)]
        if cipher: args += ['-c', cipher]
        args += list(options) + [(user or self.user) + '@' + self.host]
        if script is not None: args += ['sh -c ' + shlex.quote(script) if posix else script]
        result = command(args, input=input, env=env, timeout=timeout, text=not binary)
        if binary:
            self.transcript.append(dict(command=args, exit=result.returncode, inputBytes=len(input),
                                        outputBytes=len(result.stdout), inputSha256=hashlib.sha256(input).hexdigest(),
                                        outputSha256=hashlib.sha256(result.stdout).hexdigest(),
                                        stderr=result.stderr.decode(errors='replace')))
        else:
            self.transcript.append(dict(command=args, exit=result.returncode, stdout=result.stdout, stderr=result.stderr))
        return result

    def require(self, result, output=None):
        if result.returncode != 0:
            raise ValueError('OpenSSH failed (exit ' + str(result.returncode) + ')')
        if output is not None and result.stdout.strip() != output:
            raise ValueError('remote output differs from the expected value')

    def refusal(self, result):
        if result.returncode != 255 or 'Permission denied (publickey)' not in result.stderr:
            raise ValueError('expected publickey authentication refusal, not transport failure')

    def run_case(self, name, serial):
        if name == 'port-22':
            with socket.create_connection((self.host, 22), timeout=10) as stream:
                stream.settimeout(10)
                data = b''
                while b'\n' not in data and len(data) < 256:
                    chunk = stream.recv(256 - len(data))
                    if not chunk: break
                    data += chunk
                if not data.startswith(b'SSH-2.0-') or b'\r\n' not in data:
                    raise ValueError('server sent no SSH identification before client data')
        elif name == 'host-key':
            result = command(['ssh-keyscan', '-T', '10', '-p', '22', '-t', 'ed25519', self.host])
            lines = [line for line in result.stdout.splitlines() if not line.startswith('#')]
            if result.returncode or len(lines) != 1:
                raise ValueError('OpenSSH keyscan did not return exactly one Ed25519 key')
            fingerprint = command(['ssh-keygen', '-E', 'sha256', '-lf', '-'], input=lines[0] + '\n')
            printed = set(re.findall(r'bsshd: host key ED25519 (SHA256:[A-Za-z0-9+/]+)', serial))
            if fingerprint.returncode or set(fingerprint.stdout.split()[1:2]) != printed:
                raise ValueError('scanned key fingerprint differs from this boot console')
            self.known.write_text(lines[0] + '\n')
        elif name == 'strict-login':
            result = self.ssh('id -u; id -g; printf "%s\\n" "$USER" "$HOME"; pwd')
            self.require(result, '1000\n1000\n' + self.user + '\n/home/' + self.user + '\n/home/' + self.user)
            # A deliberately different known host must be refused, too.
            wrong = (self.wrong.with_suffix('.pub')).read_text().split()
            self.known.write_text(self.host + ' ' + ' '.join(wrong[:2]) + '\n')
            try:
                rejected = self.ssh('true')
                if rejected.returncode != 255 or 'Host key verification failed' not in rejected.stderr:
                    raise ValueError('strict checking accepted a different host key')
            finally:
                self.run_case('host-key', serial)
        elif name in ('aes256-gcm', 'aes128-ctr'):
            cipher = 'aes256-gcm@openssh.com' if name == 'aes256-gcm' else 'aes128-ctr'
            self.require(self.ssh("printf 'cipher-ok\\n'", cipher=cipher), 'cipher-ok')
        elif name == 'ed25519-user':
            original = self.ssh('cat "$HOME/.ssh/authorized_keys"')
            self.require(original)
            self.original = original.stdout
            public = self.edkey.with_suffix('.pub').read_text().strip()
            self.require(self.ssh('printf "\\n%s\\n" ' + shlex.quote(public) + ' >> "$HOME/.ssh/authorized_keys"'))
            self.require(self.ssh('id -u', identity=self.edkey), '1000')
        elif name == 'password-refused':
            askpass = self.directory / 'askpass'
            askpass.write_text('#!/bin/sh\nprintf "%s\\n" synthetic-refused-password\n')
            askpass.chmod(0o700)
            env = dict(os.environ, SSH_ASKPASS=str(askpass), SSH_ASKPASS_REQUIRE='force', DISPLAY='probe')
            # OpenSSH uses the first value of an option; replace BatchMode, do not append it.
            original = self.common
            self.common = [arg if arg != 'BatchMode=yes' else 'BatchMode=no' for arg in original]
            try:
                self.refusal(self.ssh('true', options=('-o', 'PubkeyAuthentication=no',
                              '-o', 'PreferredAuthentications=password', '-o', 'PasswordAuthentication=yes',
                              '-o', 'NumberOfPasswordPrompts=1'), env=env))
            finally:
                self.common = original
            # OpenSSH will not try an unadvertised method. Our RFC 4252 client
            # sends password directly, regardless of the server's method list.
            result = self.ssh('/usr/bin/bssh ' + shlex.quote(self.host) + ' 22 ' + shlex.quote(self.user)
                              + ' synthetic-refused-password --smoke', posix=False)
            if result.returncode != 77 or 'bssh: authentication failed' not in result.stdout:
                raise ValueError('actual password request did not receive USERAUTH_FAILURE')
        elif name == 'wrong-key-refused':
            self.refusal(self.ssh('true', identity=self.wrong))
        elif name == 'root-refused':
            self.refusal(self.ssh('true', user='root'))
        elif name == 'telnet-closed':
            table = self.ssh('cat /proc/net/tcp')
            self.require(table)
            for row in table.stdout.splitlines()[1:]:
                fields = row.split()
                if len(fields) >= 4 and fields[3] == '0A' and int(fields[1].split(':')[1], 16) in (23, 2323):
                    raise ValueError('a telnet listener exists, including on loopback')
            for port in (23, 2323):
                try:
                    with socket.create_connection((self.host, port), timeout=5):
                        raise ValueError('telnet port ' + str(port) + ' accepted a connection')
                except ConnectionRefusedError:
                    pass
        elif name == 'job-control':
            # Shell request (no exec): a PTY must become the shell's controlling tty.
            # A foreground sleep, Ctrl-C, and another command prove terminal signal routing.
            self.interactive_job_control()
        elif name == 'exec-status':
            self.require(self.ssh('console.log(env("SHELL"));', posix=False), '/bin/bsh')
            for script, status in [("sh -c 'exit 37'", 37), ('exit 23', 23), ('/bin/true', 0),
                                   ('/bin/false', 1), ('/no-such-command', 127)]:
                result = self.ssh(script, posix=False)
                if result.returncode != status:
                    raise ValueError('exec exit status differs: expected ' + str(status))
            for script in ['/bin/echo ' + ' '.join(['arg'] * 64), '/bin/echo ' + 'x' * 4096]:
                result = self.ssh(script, posix=False)
                if result.returncode == 0 or 'argument list too long' not in result.stdout:
                    raise ValueError('oversized argv was executed or not reported')
            for arguments, message in [
                (["/bin/echo"] + ['arg'] * 64, 'argument list too long'),
                (["/bin/echo", 'x' * 4096], 'argument list too long'),
                (["/bin/echo", 'before\x00after'], 'argument contains NUL'),
            ]:
                script = 'exec(' + ','.join(json.dumps(arg) for arg in arguments) + ');'
                result = self.ssh(script, posix=False)
                if result.returncode == 0 or message not in result.stdout:
                    raise ValueError('native exec accepted invalid argv or omitted its error')
            script = 'let r = exec("/bin/echo", "native-argv-ok"); console.log(r.stdout); exit(r.exitCode);'
            self.require(self.ssh(script, posix=False), 'native-argv-ok')
        elif name == 'exec-stdin':
            # Exhaust channel windows and pipe capacity; exact output requires EOF.
            payload = ''.join(f'{i:06d}: stdin data and spaces\n' for i in range(360000))
            result = self.ssh('/bin/cat', input=payload, posix=False, timeout=180)
            self.require(result)
            if result.stdout != payload: raise ValueError('piped stdin differs or was truncated')
            # Preserve NUL, high bytes and CRLF as well as text, across many window adjustments.
            payload = b'0123456789abcdef\x00\xff\r\n' * 524288
            result = self.ssh('/bin/cat', input=payload, posix=False, timeout=180, binary=True)
            self.require(result)
            if result.stdout != payload: raise ValueError('10,485,760-byte binary stdin differs or was truncated')
            self.require(self.ssh('/bin/cat', input='', posix=False), '')
        elif name == 'quoted-command':
            self.interactive_job_control(quoted=True)
        else:
            raise ValueError('unimplemented host case')

    def interactive_job_control(self, quoted=False):
        import select
        args = self.common + ['-i', str(self.identity), '-tt', self.user + '@' + self.host]
        process = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        seen = b''
        history = bytearray()
        def until(marker):
            nonlocal seen
            deadline = time.monotonic() + 15
            while not (marker.search(seen) if hasattr(marker, 'search') else marker in seen):
                if time.monotonic() >= deadline: raise ValueError('interactive PTY did not reach expected shell output')
                if select.select([process.stdout], [], [], 0.2)[0]:
                    data = os.read(process.stdout.fileno(), 4096)
                    if not data: raise ValueError('interactive SSH ended before the shell check')
                    seen += data
                    history.extend(data)
        def send(data):
            process.stdin.write(data); process.stdin.flush()
        prompt = re.compile(rb'(?:^|\n)bsh [^>\r\n]*> ')
        def at_prompt(marker):
            until(re.compile(re.escape(marker) + rb'bsh [^>\r\n]*> '))
        try:
            until(prompt)
            if b'breenish v' not in seen: raise ValueError('login did not enter bsh')
            seen = b''
            send(b'console.log("READY-" + env("HOME"));\n')
            at_prompt(("READY-/home/" + self.user + "\r\n").encode())
            if b'job control turned off' in seen: raise ValueError('shell has no controlling terminal')
            seen = b''
            if quoted:
                send(b"/bin/sh -c 'printf \"<%s>\\n\" \"$1\" \"$2\" \"$3\"' sh 'two words' '' 'a\\b'\n")
                at_prompt(b'<two words>\r\n<>\r\n<a\\b>\r\n')
                send(b'exit\n')
                process.wait(timeout=10)
                if process.returncode != 0: raise ValueError('quoted command session failed')
                return
            send(b"sh -c 'ls -ln $(tty); printf \"PTY-%s\\n\" END'\n")
            at_prompt(b'PTY-END\r\n')
            if not re.search(rb'crw--w----\s+\d+\s+1000\s+1000\s+', seen):
                raise ValueError('PTY slave owner, group or mode differs from the account and 0620')
            seen = b''
            started = time.monotonic()
            send(b'console.log("INTERRUPT-" + run("sleep", "30"));\n')
            time.sleep(1)
            send(b'\x03')
            at_prompt(b'INTERRUPT-130\r\n')
            if time.monotonic() - started >= 10:
                raise ValueError('interrupt did not end the foreground job within 10 seconds')
            seen = b''
            send(b"printf 'AFTER-%s\\n' interrupt\n")
            at_prompt(b'AFTER-interrupt\r\n')
            send(b'exit\n')
            process.wait(timeout=10)
            if process.returncode != 0: raise ValueError('interactive shell exit failed')
        finally:
            self.transcript.append(dict(interactive=history.decode(errors='replace')))
            if process.poll() is None:
                process.terminate()  # Only this exact child, started above.
                process.wait(timeout=5)

    def cleanup(self):
        if self.original is not None:
            # POSIX noclobber creates the staging file exclusively; the guest
            # needs only sh, printf and mv, not an optional mktemp executable.
            name = os.urandom(16).hex()
            self.require(self.ssh('umask 077; set -C; tmp="$HOME/.ssh/authorized_keys.' + name + '"; '
                                  'printf %s ' + shlex.quote(self.original) + ' > "$tmp" && '
                                  'mv "$tmp" "$HOME/.ssh/authorized_keys"'))
            result = self.ssh('cat "$HOME/.ssh/authorized_keys"')
            self.require(result)
            if result.stdout != self.original: raise ValueError('authorized_keys restoration differs')


def parse_state(text):
    """`/run/breenix/services` as libs/libbreenix/src/services.rs renders it."""
    supervisor, services = None, {}
    for line in text.splitlines():
        words = line.split(' ')
        if words[0] == 'supervisor':
            supervisor = {k: int(v) for k, v in (w.split('=', 1) for w in words[1:])}
        elif words[0] == 'service' and len(words) > 2:
            fields = dict(w.split('=', 1) for w in words[2:])
            for key in ('pid', 'starts', 'first', 'since', 'next', 'quick-failures'):
                fields[key] = int(fields[key])
            services[words[1]] = fields
        elif line:
            raise ValueError('unknown line in the published service state')
    if supervisor is None:
        raise ValueError('the published service state has no supervisor line')
    return supervisor, services


class Console:
    """Root's commands, typed on the persistent boot's SOL console through the driver's tmux pane a few
    bytes at a time, as the driver's own --run typing is. SOL can still drop an input byte while the console
    is busy (#2105), so each line is pressed only once its echo shows exactly what was typed; a damaged line
    is cleared with Ctrl-U and typed again. The console capture shows each result."""

    PROMPT = r'bsh [^>\n]*>'
    LOGIN = 'Breenix login: '

    def __init__(self, in_metal, boot, directory, user, password):
        self.in_metal, self.tmux = in_metal, 'tmux -L metal-' + boot
        self.serial = directory + '/serial.txt'
        self.user, self.password = user, password
        self.step, self.logged_in = 0, False

    def size(self):
        result = self.in_metal('stat', '-c', '%s', self.serial, capture_output=True, text=True)
        if result.returncode: raise ValueError('cannot read the console capture')
        return int(result.stdout)

    def since(self, offset):
        result = self.in_metal('tail', '-c', '+' + str(offset + 1), self.serial, capture_output=True)
        if result.returncode: raise ValueError('cannot read the console capture')
        return result.stdout.decode(errors='replace')

    def send(self, text, enter=True):
        data = (text + ('\r' if enter else '')).encode()
        for at in range(0, len(data), 4):
            # stdin keeps the password out of process arguments.
            result = self.in_metal('sh', '-c', self.tmux + ' load-buffer - && ' + self.tmux + ' paste-buffer -d -t sol',
                                   stdin=None, input=data[at:at + 4], capture_output=True)
            if result.returncode: raise ValueError('cannot type on the SOL console')
            time.sleep(0.04)

    def wait(self, offset, pattern, what, timeout=30):
        deadline = time.monotonic() + timeout
        while True:
            text = self.since(offset)
            found = re.search(pattern, text)
            if found: return text, found
            if time.monotonic() >= deadline: raise ValueError('the console did not show ' + what)
            time.sleep(0.5)

    def type_line(self, text, attempts=4):
        """Type `text` at bsh's prompt, and press Enter once bsh's redrawn line matches it."""
        echoed = re.compile(r'(?m)^' + self.PROMPT + ' ' + re.escape(text) + r'[ \t]*$')
        for _ in range(attempts):
            offset = self.size()
            self.send(text, enter=False)
            deadline = time.monotonic() + 6
            while time.monotonic() < deadline:
                if echoed.search(self.since(offset)):
                    self.send('')
                    return
                time.sleep(0.3)
            self.send('\x15', enter=False)
            time.sleep(0.5)
        raise ValueError('the console kept losing typed input: ' + text)

    def login(self, attempts=3):
        if self.logged_in: return
        offset = self.size()
        self.send('')
        text, found = self.wait(offset, re.escape(self.LOGIN) + '|' + self.PROMPT, 'a login prompt')
        if found.group(0) != self.LOGIN:
            offset = self.size()
            self.type_line('exit')
            self.wait(offset, re.escape(self.LOGIN), 'a login prompt after logging out')
        for _ in range(attempts):
            offset = self.size()
            self.send(self.user)
            self.wait(offset, 'Password: ', 'the password prompt')
            offset = self.size()
            # getty's echo follows a prompt printed earlier and the password is not echoed, so a byte lost on
            # the way shows as a refusal, and login is tried again.
            self.send(self.password)
            text, found = self.wait(offset, self.PROMPT + '|Login incorrect', 'a shell prompt')
            if found.group(0) != 'Login incorrect':
                self.logged_in = True
                return
            self.wait(offset + len(text[:found.end()].encode()), re.escape(self.LOGIN), 'a login prompt after a refusal')
        raise ValueError('the console account was refused ' + str(attempts) + ' times')

    def run(self, command, timeout=30):
        """Type one command, then a marker computation; return the console text up to the marker's answer."""
        self.login()
        self.step += 1
        marker = 'svc-suite-step-' + str(self.step)
        offset = self.size()
        self.type_line(command)
        self.type_line('print("' + marker + '", 6*7)')
        text, found = self.wait(offset, re.escape(marker) + ' 42', 'the answer to ' + command, timeout)
        text = text[:found.start()]
        if re.search(r'\[bsh\] command failed status=[1-9]', text): raise ValueError('console command failed: ' + command)
        return text

    def logout(self):
        if not self.logged_in: return
        offset = self.size()
        self.type_line('exit')
        self.wait(offset, r'\[init\] console session ended', 'the console session ending')
        self.logged_in = False


class Services:
    """The services category: the shipped table on the persistent boot, then temporary services that run as the
    operator, defined under /run/breenix/services.d by root on the console and removed afterwards."""

    REQUIRED = ['bsshd', 'blogd', 'ntp'] + ['getty-tty' + str(n) for n in range(2, 7)] + ['getty-console']
    FIXTURES = ['svc-suite-fail', 'svc-suite-sleep', 'svc-suite-stubborn', 'svc-suite-missing', 'svc-suite-noexec', 'svc-suite-nobody']

    def __init__(self, probe, console, capture):
        self.probe, self.console, self.capture = probe, console, capture
        self.fixtures = None
        self.fixture_file = '/run/breenix/services.d/svc-suite'

    def state(self):
        result = self.probe.ssh('cat /run/breenix/services')
        self.probe.require(result)
        return parse_state(result.stdout)

    def lines(self, start, pattern):
        """Console lines from byte offset `start` that match `pattern`, with their arrival times (serial.ts).
        init's lines share the console with the root session's prompt, so patterns are not anchored at the start."""
        text, stamps = self.capture()
        data = text.encode()
        found = []
        for index, (arrived, offset) in enumerate(stamps):
            if offset < start: continue
            end = stamps[index + 1][1] if index + 1 < len(stamps) else len(data)
            line = data[offset:end].decode(errors='replace').rstrip('\n')
            if re.search(pattern, line): found.append((arrived, line))
        return found

    def await_line(self, start, pattern, what, timeout=15):
        """The console capture trails init's answers over SSH; wait for a line before judging its absence."""
        deadline = time.monotonic() + timeout
        while not self.lines(start, pattern):
            if time.monotonic() >= deadline: raise ValueError('the console did not show ' + what)
            time.sleep(1)

    def ensure_fixtures(self):
        if self.fixtures is not None:
            if isinstance(self.fixtures, str): raise ValueError(self.fixtures)
            return
        try:
            user = self.probe.user
            table = ('[svc-suite-fail]\ncommand = /bin/false\nuser = ' + user + '\nrestart = on-failure\n\n'
                     '[svc-suite-sleep]\ncommand = /bin/sh -c \'/sbin/init service-io-check && exec /bin/sleep 3600\'\nuser = ' + user + '\n\n'
                     '[svc-suite-stubborn]\ncommand = /bin/sh -c \'trap "" TERM; exec /bin/sleep 3600\'\nuser = ' + user
                     + '\nstop-timeout = 2\n'
                     '[svc-suite-missing]\ncommand = /nonexistent-svc-suite\nuser = ' + user + '\n\n'
                     '[svc-suite-noexec]\ncommand = /etc/passwd\nuser = ' + user + '\n\n'
                     '[svc-suite-nobody]\ncommand = /bin/true\nuser = svc-suite-absent\n')
            self.start = self.console.size()
            # The root console writes literal data directly into its protected directory.
            # No file or directory controlled by the service account is trusted.
            literal = table.replace('\\', '\\\\').replace('\n', r'\n')
            script = 'umask 022; printf %b ' + shlex.quote(literal) + ' > ' + self.fixture_file
            self.console.run('sh -c ' + shlex.quote(script))
            text = self.console.run('svc reload')
            if 'svc: reloaded' not in text or '6 added' not in text:
                raise ValueError('svc reload did not add the six temporary services')
            self.fixtures = True
        except ValueError as error:
            self.fixtures = 'temporary services were not loaded: ' + str(error)
            raise

    def remove_fixtures(self):
        if self.fixtures is None: return
        self.console.run('rm -f /run/breenix/services.d/svc-suite')
        text = self.console.run('svc reload')
        if 'svc: reloaded' not in text: raise ValueError('svc reload after removal did not answer')
        deadline = time.monotonic() + 15
        while any(name in self.state()[1] for name in self.FIXTURES):
            if time.monotonic() >= deadline: raise ValueError('temporary services remain after removal')
            time.sleep(1)

    def run_case(self, name):
        getattr(self, 'case_' + name.replace('-', '_'))()

    def case_table(self):
        result = self.probe.ssh('cat /etc/breenix/services')
        self.probe.require(result)
        listed = re.findall(r'^\[([a-z0-9-]+)\]', result.stdout, re.M)
        if any(name not in listed for name in self.REQUIRED):
            raise ValueError('the service table lacks one of ' + ', '.join(self.REQUIRED))
        modes = self.probe.ssh('ls -ln /run/breenix/services /run/breenix/svc.sock')
        self.probe.require(modes)
        if not re.search(r'^-rw-r--r-- +\d+ +0 +0 .*/run/breenix/services$', modes.stdout, re.M) or \
                not re.search(r'^srw-rw-rw- +\d+ +0 +0 .*/run/breenix/svc\.sock$', modes.stdout, re.M):
            raise ValueError('the state file or control socket under /run has the wrong owner or mode')
        _, services = self.state()
        for name in self.REQUIRED:
            if name not in services: raise ValueError(name + ' is not in the published state')
            if name != 'ntp' and (services[name]['state'] != 'running' or services[name]['pid'] == 0):
                raise ValueError(name + ' is not running')
        if services['ntp']['state'] not in ('running', 'done', 'backoff', 'crash-loop') or services['ntp']['starts'] < 1:
            raise ValueError('the time client never started')
        report = self.probe.ssh('svc status')
        self.probe.require(report)
        for name in self.REQUIRED:
            if not re.search(r'^' + re.escape(name) + r' +' + re.escape(services[name]['state']) + r' ', report.stdout, re.M):
                raise ValueError('svc status does not report ' + name)

    def case_entropy_first(self):
        supervisor, services = self.state()
        if supervisor['entropy'] == 0 or services['bsshd']['first'] < supervisor['entropy']:
            raise ValueError('bsshd started before the random pool was ready')
        for name in self.REQUIRED:
            if name.startswith('getty-') and services[name]['first'] - supervisor['began'] > 1000:
                raise ValueError(name + ' did not start on the supervisor\'s first pass')

    def case_network_first(self):
        supervisor, services = self.state()
        if supervisor['network-up'] == 0 or services['ntp']['first'] < supervisor['network-up']:
            raise ValueError('the time client started before the network was up')

    def case_kill_restart(self):
        _, services = self.state()
        before = services['bsshd']
        start = self.console.size()
        self.console.login()
        offset = self.console.size()
        self.console.type_line('kill -9 ' + str(before['pid']))
        sent = time.monotonic()
        # Count from the typed kill, and only once init has seen the old listener die.
        self.console.wait(offset, r'\[init\] bsshd killed by signal 9', 'bsshd dying', RESTART_WINDOW_S)
        deadline = sent + RESTART_WINDOW_S
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ValueError('no strict-host-key reconnect within ' + str(RESTART_WINDOW_S) + ' s of the kill')
            try:
                result = self.probe.ssh('id -u', timeout=remaining)
            except subprocess.TimeoutExpired:
                raise ValueError('no strict-host-key reconnect within ' + str(RESTART_WINDOW_S) + ' s of the kill')
            if time.monotonic() > deadline:
                raise ValueError('no strict-host-key reconnect within ' + str(RESTART_WINDOW_S) + ' s of the kill')
            if result.returncode == 0 and result.stdout.strip() == '1000': break
            time.sleep(min(0.25, max(0, deadline - time.monotonic())))
        self.probe.transcript.append(dict(reconnectSeconds=round(time.monotonic() - sent, 3)))
        _, services = self.state()
        after = services['bsshd']
        if after['state'] != 'running' or after['pid'] in (0, before['pid']) or after['starts'] != before['starts'] + 1 \
                or after['exit'] != 'signal:9':
            raise ValueError('the published state does not show the restart after SIGKILL')
        self.await_line(start, r'\[init\] bsshd restarts in 1000 ms$', "init's report of the restart delay")

    def case_reconnect_bsh(self):
        self.probe.require(self.probe.ssh('console.log(env("SHELL"));', posix=False), '/bin/bsh')
        # An interactive login: the bsh banner and prompt, HOME, and a quoted command through bsh.
        self.probe.interactive_job_control(quoted=True)

    def case_backoff(self):
        self.ensure_fixtures()
        deadline = time.monotonic() + 45
        while not self.lines(self.start, r'\[init\] svc-suite-fail is crash-looping'):
            if time.monotonic() >= deadline: raise ValueError('the failing service never reached its crash loop')
            time.sleep(1)
        exits = self.lines(self.start, r'\[init\] svc-suite-fail exited \(code 1\)$')
        delays = [line for _, line in self.lines(self.start, r'\[init\] svc-suite-fail restarts in \d+ ms$')]
        if delays[:4] != ['[init] svc-suite-fail restarts in ' + str(ms) + ' ms' for ms in (1000, 2000, 4000, 8000)]:
            raise ValueError('init reported other restart delays than 1, 2, 4 and 8 s')
        if len(exits) < 5: raise ValueError('fewer than five failures were reported')
        gaps = [round(b[0] - a[0], 2) for a, b in zip(exits, exits[1:5])]
        self.probe.transcript.append(dict(backoffGaps=gaps))
        for gap, seconds in zip(gaps, (1, 2, 4, 8)):
            if not seconds - 0.75 <= gap <= seconds + 2:
                raise ValueError('restart gaps ' + str(gaps) + ' s differ from 1, 2, 4 and 8 s')

    def stop(self, name):
        started = time.monotonic()
        result = self.probe.ssh('svc stop ' + name, timeout=30)
        return result, time.monotonic() - started

    def case_graceful_stop(self):
        self.ensure_fixtures()
        _, services = self.state()
        pids = {name: services[name]['pid'] for name in ('svc-suite-sleep', 'svc-suite-stubborn')}
        if 0 in pids.values(): raise ValueError('the temporary services are not running')
        start = self.console.size()
        result, _ = self.stop('svc-suite-sleep')
        self.probe.require(result, 'svc: stopped svc-suite-sleep (signal 15)')
        result, elapsed = self.stop('svc-suite-stubborn')
        self.probe.require(result, 'svc: stopped svc-suite-stubborn (signal 9)')
        if elapsed < 2: raise ValueError('the service that ignores SIGTERM was killed before its stop timeout')
        self.await_line(start, r'\[init\] svc-suite-stubborn did not stop within 2 s of SIGTERM; sending SIGKILL$',
                        'the SIGKILL report for the service that ignores SIGTERM')
        if self.lines(start, r'\[init\] svc-suite-sleep did not stop'):
            raise ValueError('SIGKILL went to the service that SIGTERM stopped')
        time.sleep(3)
        _, services = self.state()
        for name, pid in pids.items():
            if services[name]['state'] != 'stopped' or services[name]['pid'] != 0:
                raise ValueError(name + ' restarted or did not stay stopped')
            if self.probe.ssh('test -e /proc/' + str(pid)).returncode == 0:
                raise ValueError(name + "'s process still exists")
        result = self.probe.ssh('svc start svc-suite-sleep')
        self.probe.require(result)
        if not re.fullmatch(r'svc: started svc-suite-sleep pid \d+', result.stdout.strip()):
            raise ValueError('svc start did not report the new process')

    def case_account(self):
        self.ensure_fixtures()
        _, services = self.state()
        pid = services['svc-suite-sleep']['pid']
        if services['svc-suite-sleep']['state'] != 'running' or pid == 0:
            raise ValueError('the temporary service is not running')
        status = self.probe.ssh('cat /proc/' + str(pid) + '/status')
        self.probe.require(status)
        if not re.search(r'^Uid:\t1000\t1000\t1000\t1000$', status.stdout, re.M) or \
                not re.search(r'^Gid:\t1000\t1000\t1000\t1000$', status.stdout, re.M):
            raise ValueError('the temporary service does not run as the operator account')
        if 'service-io-ok' not in self.console.run('cat /var/log/svc-suite-sleep.log'):
            raise ValueError('a service retained console input on a standard descriptor')
        for name in ('svc-suite-missing', 'svc-suite-noexec'):
            result = self.probe.ssh('svc start ' + name)
            if result.returncode != 1 or 'did not start' not in result.stdout + result.stderr:
                raise ValueError(name + ' reported success without executing')
        # An unknown account has no owner who can authorize this request. Root
        # must make it so the failed account lookup, rather than access control, is tested.
        script = "svc start svc-suite-nobody; result=$?; printf 'svc-start-status=%s\\n' \"$result\""
        failed = self.console.run('sh -c ' + shlex.quote(script))
        if 'did not start' not in failed or 'svc-start-status=1' not in failed:
            raise ValueError('an unknown service account did not fail its start request')
        bsshd = services['bsshd']['pid']
        for request in ('svc stop bsshd', 'svc reload'):
            result = self.probe.ssh(request)
            # bsshd delivers an exec request's stderr as ordinary channel data.
            if result.returncode != 1 or 'permission denied' not in result.stdout + result.stderr:
                raise ValueError(request + ' was not refused for the operator account')
        if self.state()[1]['bsshd']['pid'] != bsshd: raise ValueError('a refused request changed bsshd')

    def case_crash_loop(self):
        self.ensure_fixtures()
        loops = self.lines(self.start, r'\[init\] svc-suite-fail is crash-looping: 5 failures in a row')
        if not loops: raise ValueError('no crash loop was reported on the console')
        report = self.probe.ssh('svc status svc-suite-fail')
        if report.returncode != 3 or not re.search(r'^svc-suite-fail +crash-loop .*code 1', report.stdout, re.M):
            raise ValueError('svc does not report the crash loop')
        deadline = loops[0][0] + 75
        while True:
            exits = self.lines(self.start, r'\[init\] svc-suite-fail exited \(code 1\)$')
            if len(exits) >= 6: break
            if time.time() >= deadline: raise ValueError('no start followed the crash loop report')
            time.sleep(2)
        gap = round(exits[5][0] - exits[4][0], 2)
        self.probe.transcript.append(dict(crashLoopGap=gap))
        if not 59 <= gap <= 63: raise ValueError('the start after the crash loop came ' + str(gap) + ' s later, not 60 s')

    def cleanup(self):
        errors = []
        for step in (self.remove_fixtures, self.console.logout):
            try:
                step()
            except Exception as error:  # Any exception fails the case; cleanup still runs.
                errors.append(type(error).__name__ + ': ' + str(error))
        if errors: raise ValueError('; '.join(errors))


class Logs:
    """Actual service output and cross-boot files; root reads through the leased SOL console."""
    def __init__(self, probe, console, previous):
        self.probe, self.console, self.previous = probe, console, previous
        self.fixtures = False
        result = probe.ssh('cat /run/breenix/boot-id')
        probe.require(result)
        self.boot_id = result.stdout.strip()
        if not re.fullmatch(r'[a-f0-9-]+', self.boot_id): raise ValueError('missing log boot ID')

    def root_check(self, script):
        text = self.console.run('sh -c ' + shlex.quote('set -e; ' + script + '; printf "\\nlogs-check-%s\\n" ok'), timeout=60)
        if not re.search(r'^logs-check-ok\r?$', text, re.M):
            raise ValueError('root log assertion failed: ' + script)
        return text

    def fixture(self, name, script):
        self.fixtures = True
        table = '[' + name + ']\ncommand = /bin/sh -c ' + shlex.quote(script) + '\nuser = ' + self.probe.user + '\nrestart = never\n'
        literal = table.replace('\\', '\\\\').replace('\n', r'\n')
        self.root_check('printf %b ' + shlex.quote(literal) + ' > /run/breenix/services.d/' + name)
        self.console.run('svc reload')
        deadline = time.monotonic() + 45
        while True:
            result = self.probe.ssh('cat /run/breenix/services')
            self.probe.require(result)
            service = parse_state(result.stdout)[1].get(name)
            if service and service['state'] == 'done': break
            if service and service['state'] == 'failed': raise ValueError(name + ' failed: ' + str(service))
            if time.monotonic() >= deadline: raise ValueError(name + ' did not finish')
            time.sleep(0.5)
        # The final pipe bytes are consumed on the next supervisor pass.
        time.sleep(0.2)

    def prepare(self):
        self.fixture('logs-retained', 'printf "retained-stdout\\n"; printf "retained-stderr\\n" >&2')
        self.root_check('grep -Fx "[stdout] retained-stdout" /var/log/logs-retained.log; '
                        'grep -Fx "[stderr] retained-stderr" /var/log/logs-retained.log')
        text = self.console.run('sha256sum /var/log/logs-retained.log')
        found = re.search(r'^([a-f0-9]{64}) +/var/log/logs-retained.log\r?$', text, re.M)
        if not found: raise ValueError('no persisted service log checksum')
        return dict(logBoot=self.boot_id, sha256=found[1])

    def run_case(self, name):
        getattr(self, 'case_' + name.replace('-', '_'))()

    def case_table(self):
        result = self.probe.ssh('cat /etc/breenix/services')
        self.probe.require(result)
        names = re.findall(r'^\[([a-z0-9-]+)\]', result.stdout, re.M)
        for name in names:
            header = f'BREENIX-LOG 1 boot={self.boot_id} source={name} limit=262144 archives=4'
            self.root_check('test "$(head -n 1 /var/log/' + name + '.log)" = ' + shlex.quote(header))
            if name.startswith('getty-'):
                self.root_check('grep -Fx "[stdout] [getty] console acquired" /var/log/' + name + '.log')
        text = self.console.run('ls -ln ' + ' '.join('/var/log/' + name + '.log' for name in names))
        for name in names:
            if not re.search(r'^-rw-r----- +\d+ +0 +4 +\d+ .* /var/log/' + re.escape(name) + r'\.log\r?$', text, re.M):
                raise ValueError(name + ' log is not 0640 root:adm')
        for path in ('/var/log/bsshd.log', '/var/log/kernel.log.1'):
            self.root_check('test -f ' + path)
            if self.probe.ssh('cat ' + path).returncode == 0:
                raise ValueError('an account outside adm can read ' + path)

    def case_streams(self):
        self.fixture('logs-streams', 'printf "stdout-marker\\n"; printf "stderr-marker\\n" >&2')
        self.root_check('grep -Fx "[stdout] stdout-marker" /var/log/logs-streams.log; '
                        'grep -Fx "[stderr] stderr-marker" /var/log/logs-streams.log; '
                        '! grep -F stdout-marker /var/log/bsshd.log')

        # A directory in place of the log deterministically makes sink creation fail.
        self.root_check('mkdir /var/log/logs-unavailable.log')
        try:
            self.fixture('logs-unavailable', 'printf "unavailable-output\\n"')
        finally:
            self.root_check('rmdir /var/log/logs-unavailable.log')
        self.root_check('sleep 1; grep -Fx "[log] lost lines=1 reason=write-error" /var/log/logs-unavailable.log')

    def case_rotation(self):
        # 600 complete 600-byte lines: the active file and .1 must both hold
        # this boot's header, with the first/last lines on opposite sides.
        script = 'i=0; while test "$i" -lt 600; do printf "row-%04d %0590d\\n" "$i" 0; i=$((i+1)); done'
        self.fixture('logs-rotate', script)
        self.root_check('grep -F "[stdout] row-0000 " /var/log/logs-rotate.log.1 >/dev/null; '
                        'grep -F "[stdout] row-0599 " /var/log/logs-rotate.log >/dev/null; '
                        'for p in /var/log/logs-rotate.log /var/log/logs-rotate.log.1; do '
                        'test "$(wc -c < "$p")" -le 262144; '
                        'head -n 1 "$p" | grep -F ' + shlex.quote('boot=' + self.boot_id + ' source=logs-rotate ') + ' >/dev/null; done')

        self.root_check('expected=$(i=0; while test "$i" -lt 600; do '
                        'printf "[stdout] row-%04d %0590d\\n" "$i" 0; i=$((i+1)); done | sha256sum); '
                        'actual=$( { tail -n +2 /var/log/logs-rotate.log.1; tail -n +2 /var/log/logs-rotate.log; } | sha256sum); '
                        'test "$actual" = "$expected"')

    def case_loss(self):
        self.fixture('logs-loss', 'printf "%05000d\\nafter-loss\\n" 0')
        self.root_check('grep -Fx "[log] lost lines=1 stream=stdout reason=line-too-long" /var/log/logs-loss.log; '
                        'grep -Fx "[stdout] after-loss" /var/log/logs-loss.log')

    def case_kernel(self):
        # A restart without an overrun must neither replay bytes nor invent loss.
        marker = 'kernel-restart-' + self.boot_id
        self.root_check('printf "%s\\n" ' + shlex.quote(marker) + ' > /dev/kmsg; sleep 1')
        self.console.run('svc stop blogd')
        before = self.root_check(r'grep -c "^\[log\] lost .* reason=ring-overrun" /var/log/kernel.log || true')
        self.console.run('svc start blogd')
        self.root_check('sleep 1; test "$(grep -Fxc ' + shlex.quote('[kernel] [ INFO] audit: ' + marker) + ' /var/log/kernel.log)" = 1')
        after = self.root_check(r'grep -c "^\[log\] lost .* reason=ring-overrun" /var/log/kernel.log || true')
        count = lambda text: re.findall(r'^([0-9]+)\r?$', text, re.M)[-1]
        if count(before) != count(after): raise ValueError('restart invented a ring overrun')
        self.console.run('svc stop blogd')
        cursor_text = self.root_check('head -n 1 /run/breenix/kmsg-' + self.boot_id)
        cursor = int(count(cursor_text))
        try:
            self.root_check('i=0; while test "$i" -lt 400; do '
                            'printf "kernel-gap-%04d %090d\\n" "$i" 0 > /dev/kmsg; i=$((i+1)); done')
        finally:
            self.console.run('svc start blogd')
        text = self.root_check('printf "kernel-live-marker\\n" > /dev/kmsg; sleep 1; '
                        'grep -F "kernel-live-marker" /var/log/kernel.log >/dev/null; '
                        'grep -E "lost lines=unknown bytes=[1-9][0-9]* reason=ring-overrun" /var/log/kernel.log; '
                        'head -n 1 /var/log/kernel.log | grep -F ' + shlex.quote('boot=' + self.boot_id + ' source=kernel ') + ' >/dev/null')
        gaps = re.findall(r'lost lines=unknown bytes=(\d+) reason=ring-overrun from=(\d+) to=(\d+)\r?$', text, re.M)
        if not any(int(start) == cursor and int(end) - int(start) == int(size) > 0 for size, start, end in gaps):
            raise ValueError('no new byte-exact ring overrun from the saved restart cursor')

    def case_persistent(self):
        if not self.previous: raise ValueError('--previous-boot preparation required')
        if self.previous['logBoot'] == self.boot_id: raise ValueError('boot ID did not change across reboot')
        # Compare before starting that service again, then prove its new active
        # header and its retained archive both identify the correct boots.
        prior = self.previous
        self.root_check('test "$(sha256sum < /var/log/logs-retained.log)" = ' + shlex.quote(prior['sha256'] + '  -'))
        self.fixture('logs-retained', 'printf "current-stdout\\n"')
        self.root_check('test "$(sha256sum < /var/log/logs-retained.log.1)" = ' + shlex.quote(prior['sha256'] + '  -') + '; '
                        'head -n 1 /var/log/logs-retained.log.1 | grep -F ' + shlex.quote('boot=' + prior['logBoot'] + ' ') + ' >/dev/null; '
                        'head -n 1 /var/log/logs-retained.log | grep -F ' + shlex.quote('boot=' + self.boot_id + ' ') + ' >/dev/null')

    def cleanup(self):
        try:
            if self.fixtures:
                self.console.run('sh -c ' + shlex.quote('rm -f /run/breenix/services.d/logs-*'))
                self.console.run('svc reload')
                result = self.probe.ssh('cat /run/breenix/services')
                self.probe.require(result)
                if any(name.startswith('logs-') for name in parse_state(result.stdout)[1]):
                    raise ValueError('temporary log services remain')
        finally:
            self.console.logout()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check-manifest', type=Path)
    parser.add_argument('--previous-boot', help='Completed logs preparation boot at this same commit')
    parser.add_argument('--prepare-logs', action='store_true', help='Write the log whose bytes the next boot must retain')
    parser.add_argument('--boot')
    parser.add_argument('--sha')
    parser.add_argument('--milestone', default='server/ssh-keys', choices=list(MILESTONES))
    args = parser.parse_args()
    if args.check_manifest:
        validate_manifest(json.loads(args.check_manifest.read_text()))
        return 0
    if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.boot or '') or not re.fullmatch(r'[a-f0-9]{40}', args.sha or ''):
        parser.error('--boot ID and --sha full commit required')
    category = MILESTONES[args.milestone]
    cases = CATEGORIES[category]
    runner = runpy.run_path(str(Path(__file__).with_name('metal-run')))
    env = runner['host_env']()
    remote = lambda *cmd, **kw: runner['in_metal'](env, *cmd, capture_output=True, text=True, **kw)
    directory = '/var/lib/breenix-metal/boots/' + args.boot
    def read(name):
        result = remote('cat', directory + '/' + name)
        if result.returncode: raise ValueError('boot artifact unavailable: ' + name)
        return result.stdout
    previous = None
    if args.previous_boot:
        if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.previous_boot): parser.error('invalid previous boot')
        previous_dir = '/var/lib/breenix-metal/boots/' + args.previous_boot
        result = remote('cat', previous_dir + '/logs-prepared.json')
        if result.returncode: raise ValueError('previous boot has no log preparation record')
        previous = json.loads(result.stdout)
        ended = remote('test', '-e', previous_dir + '/ended')
        prior = remote('cat', previous_dir + '/run.json')
        prior = json.loads(prior.stdout) if prior.returncode == 0 else {}
        if ended.returncode or previous.get('boot') != args.previous_boot or previous.get('commit') != args.sha or prior.get('bootedCommit') != args.sha or prior.get('toolsCommit') != args.sha or prior.get('mode') != 'persistent' or not prior.get('evidenceEligible'):
            raise ValueError('previous log preparation must be a completed persistent boot at this commit')
    boot = json.loads(read('run.json'))
    if boot.get('mode') != 'persistent' or boot.get('bootedCommit') != args.sha or boot.get('toolsCommit') != args.sha or not boot.get('evidenceEligible'):
        raise ValueError('runner needs this exact commit booted in a persistent session')
    lease = remote('cat', '/var/lib/breenix-metal/lease.json')
    if lease.returncode or json.loads(lease.stdout).get('id') != args.boot:
        raise ValueError('this boot does not hold the machine lease')
    serial = read('serial.txt')
    manifest = json.loads(read('definition/docs/suites/server.json'))
    validate_manifest(manifest)
    effort = json.loads(read('definition/docs/efforts/path.json'))
    fields = ["SERVER_SSH_HOST", "OPERATOR_USER", "OPERATOR_SSH_PUBLIC_KEY"]
    if category in ('services', 'logs'):
        fields += ["CONSOLE_USER", "CONSOLE_PASSWORD"]
    site = remote('python3', '-c', 'import sys,json;sys.path.insert(0,"/opt/breenix-metal");'
                  'import metal_lib;s=metal_lib.load_site();'
                  'print(json.dumps({k:s.get(k) for k in ' + repr(tuple(fields)) + '}))')
    if site.returncode: raise ValueError('cannot read suite site fields')
    site = json.loads(site.stdout)
    if not site['SERVER_SSH_HOST']: raise ValueError('site needs SERVER_SSH_HOST for the persistent server')
    identity = next((p.with_suffix('') for p in (Path.home() / '.ssh').glob('*.pub')
                     if p.read_text().split()[:2] == site['OPERATOR_SSH_PUBLIC_KEY'].split()[:2]
                     and p.with_suffix('').is_file()), None)
    if identity is None: raise ValueError('boot host has no private key matching the staged operator public key')
    fatal = json.loads(read('definition/docs/boot-path.json'))['fatal'] + [r'KERNEL PANIC:']
    records = dict(boot=args.boot, commit=args.sha, milestone=args.milestone, cases=[], cleanup=False, consoleGaps=[])
    with tempfile.TemporaryDirectory(prefix='server-' + category + '-') as scratch:
        probe = Probe(site['SERVER_SSH_HOST'], site['OPERATOR_USER'], identity, Path(scratch))
        target = probe
        if category in ('services', 'logs'):
            if not site['CONSOLE_USER'] or not site['CONSOLE_PASSWORD']:
                raise ValueError('site needs CONSOLE_USER and CONSOLE_PASSWORD for the root steps')
            def capture():
                stamps = [(float(a), int(b)) for a, b in (row.split('\t') for row in read('serial.ts').splitlines() if row)]
                return read('serial.txt'), stamps
            console = Console(lambda *cmd, **kw: runner['in_metal'](env, *cmd, **kw), args.boot, directory,
                              site['CONSOLE_USER'], site['CONSOLE_PASSWORD'])
            # The services cases need the strict known_hosts entry the host-key case writes.
            probe.run_case('host-key', serial)
            target = Services(probe, console, capture) if category == 'services' else Logs(probe, console, previous)
        if args.prepare_logs:
            if category != 'logs': raise ValueError('--prepare-logs needs server/logs')
            try:
                prepared = target.prepare()
                prepared.update(boot=args.boot, commit=args.sha)
                result = runner['in_metal'](env, 'tee', directory + '/logs-prepared.json',
                    stdin=None, input=json.dumps(prepared) + '\n', capture_output=True, text=True)
                if result.returncode: raise ValueError('cannot save log preparation')
                print('Prepared persistent log for the next boot', flush=True)
            finally:
                target.cleanup()
            return 0
        try:
            print('SUITE server START cases=' + str(len(cases)), flush=True)
            for name, _ in cases:
                start = time.monotonic()
                try:
                    if target is probe:
                        probe.run_case(name, serial)
                    else:
                        target.run_case(name)
                    result, reason = 'PASS', ''
                except Exception as error:  # Any exception fails the case; cleanup still runs.
                    result, reason = 'FAIL', type(error).__name__ + ': ' + str(error)
                elapsed = int((time.monotonic() - start) * 1000)
                records['cases'].append(dict(id=category + '/' + name, result=result, ms=elapsed, reason=reason))
                print(f'SUITE server CASE {category}/{name} {result} ms={elapsed}' + (' msg=' + reason if reason else ''), flush=True)
        finally:
            try:
                target.cleanup()
                records['cleanup'] = True
            except Exception as error:  # Any exception fails the case; cleanup still runs.
                records['cleanupError'] = type(error).__name__ + ': ' + str(error)
        transcript = probe.transcript
    passed = sum(r['result'] == 'PASS' for r in records['cases'])
    print(f'SUITE server DONE passed={passed} failed={len(cases)-passed} skipped=0 total={len(cases)}', flush=True)
    # Re-read the live capture after the last operation; authentication errors never mask a kernel failure.
    serial = read('serial.txt')
    records['consoleGaps'] = [json.loads(line) for line in read('events.jsonl').splitlines()
                              if json.loads(line).get('event') == 'console-gap']
    try:
        lease = remote('cat', '/var/lib/breenix-metal/lease.json')
        if lease.returncode or json.loads(lease.stdout).get('id') != args.boot:
            raise ValueError('boot lost the machine lease during the suite')
        if category == 'logs': records['previous'] = previous
        verdict = score(manifest, effort, records, serial, boot, args.sha, fatal)
        status = 0
    except ValueError as error:
        verdict, status = 'FAIL: ' + str(error), 1
    if category == 'logs': records['previous'] = previous
    records['verdict'] = verdict
    result = runner['in_metal'](env, 'tee', directory + '/server-' + category + '.json',
                                stdin=None, input=json.dumps(records) + '\n', capture_output=True, text=True)
    if result.returncode: raise ValueError('cannot save host suite evidence in the boot store')
    result = runner['in_metal'](env, 'tee', directory + '/server-' + category + '-transcript.json',
                                stdin=None, input=json.dumps(transcript) + '\n', capture_output=True, text=True)
    if result.returncode: raise ValueError('cannot save host transcript')
    print(verdict)
    return status


if __name__ == '__main__':
    raise SystemExit(main())
