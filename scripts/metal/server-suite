#!/usr/bin/env python3
"""Host-driven server cases against a leased persistent boot, using the boot host's OpenSSH.

Run after install-persistent and `metal-run boot --persistent`:
    server-suite --boot ID --sha COMMIT --milestone server/ssh-keys|server/services
Site fields: SERVER_SSH_HOST, OPERATOR_USER, OPERATOR_SSH_PUBLIC_KEY; the services cases also
use CONSOLE_USER and CONSOLE_PASSWORD, the console account, to act as root on the SOL console.
The boot stays leased until the caller stops it through metal-run.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import socket
import subprocess
import tempfile
import time

