def ce_pattern(i, seed):
    x=(i^seed)&0xffffffff
    x^=x>>16; x=x*0x7feb352d&0xffffffff; x^=x>>15
    x=x*0x846ca68b&0xffffffff
    return (x^(x>>16))&255


def copy_bytes(e, digests):
    """Each complementary CE read-back's complete-buffer SHA-256 must equal the
    host's independently built destination, padding and untouched bytes included."""
    def need(ok,why):
        if not ok: raise ValueError(why)
    size=e['size']; width=e['width']; height=e['height']
    need(0<size<=32768 and size%4096==0 and width>0 and 0<height<=65536, 'invalid CE extent')
    need(e['poisons']==[0x55,0xaa] and len(digests)==2, 'two complementary CE transfers required')
    initial=bytes(ce_pattern(i,e['seed']) for i in range(size))
    expected=bytearray(initial if e.get('overlap',False) else bytes([e['fill']])*size)
    for y in range(height):
        a=e['src_offset']+y*e['src_pitch']; b=e['dst_offset']+y*e['dst_pitch']
        need(min(a,b)>=0 and max(a,b)+width<=size and width<=min(e['src_pitch'],e['dst_pitch']), 'CE rectangle outside backing')
        expected[b:b+width]=initial[a:a+width]
    want=hashlib.sha256(bytes(expected)).hexdigest()
    need(digests[0]==want and digests[1]==want, 'CE full destination mismatch or unwritten bytes')


def copy_source(c):
