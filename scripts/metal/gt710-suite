            # MIT nouveau v6.8 nvkm/engine/gr/gf100.c gf100_gr_ctxsw_inst reads
            # 0x409b00; gf100_gr_intr masks 0x0fffffff and shifts left 12 to
            # recover the instance address. hub.fuc ctx_chan sets valid bit 31.
            need(c['current_context'] == 0x80000000 | (c['instance'] >> 12), 'current context')
            releases = e['releases']
