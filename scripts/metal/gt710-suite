        sizes['present'] = pitch * height
        chunks = {}
        rows = re.findall(r'^GT710_DRAW_IMAGE (triangle|vertex-control|after-vertex|fragment-control|after-fragment|present) (85|170) (\d+) ([0-9a-f:,]+)$', serial, re.M)
        need(len(rows) == len(re.findall(r'^GT710_DRAW_IMAGE ', serial, re.M)), 'malformed draw image row')
        for name, poison, off, hexdata in rows:
            key = name, int(poison); off = int(off)
            chunks.setdefault(key, bytearray())
            if name == 'present':
                need(off * pitch == len(chunks[key]) and off < height, 'present row order')
                data = bytearray()
                for run in hexdata.split(','):
                    count, word = run.split(':')
                    need(re.fullmatch(r'[0-9a-f]+', count) and re.fullmatch(r'[0-9a-f]{8}', word), 'present run format')
                    count = int(count, 16)
                    need(0 < count <= pitch//4 and len(data) + count*4 <= pitch, 'present run length')
                    data.extend(int(word,16).to_bytes(4,'little') * count)
                need(len(data) == pitch, 'present row length')
            else:
                data = bytes.fromhex(hexdata)
                need(off == len(chunks[key]) and off < sizes[name] and len(data) == min(256, sizes[name]-off), 'draw image row offset or length')
            chunks[key].extend(data)
        keys = [(name, poison) for name in names for poison in (85,170)]
        need(list(chunks) == keys and len(e['readbacks']) == len(keys), 'draw images missing or out of order')
        for i, key in enumerate(keys):
            data = bytes(chunks[key]); record = e['readbacks'][i]
            need(len(data) == sizes[key[0]] and record == dict(case=key[0], poison=key[1], bytes=len(data), sha256=hashlib.sha256(data).hexdigest()), 'draw read-back length or digest')
        for name in names:
            need(chunks[name,85] == chunks[name,170], 'complementary read-backs differ')
        need(e['schema'] == 1 and e['class_id'] == 0xa197 and e['error'] is None and e['trap_registers'] == [0x400100,0x400108,0x400110,0x400118] and e['trap_before'] == [0]*4 and e['trap_after'] == [0]*4, 'draw class or traps')
        releases = e['releases']
        need(len(releases) == 5, 'draw receipts missing')
        for r in releases:
            need(type(r['target']) is int and 0 < r['target'] < 1<<40 and r['target'] % 4 == 0 and type(r['epoch']) is int and r['epoch'] > 0 and type(r['nonce']) is int and 0 < r['nonce'] <= 0xffffffff and r['observed'] == r['nonce'] and r['observed_epoch'] == r['epoch'] and r['consumed'] is True and r['accepted'] is True, 'stale draw receipt')
        need(len({(r['epoch'],r['nonce']) for r in releases}) == 5, 'reused draw receipt')
        def literals(data):
            return all(data[(s['y']*64+s['x'])*4:(s['y']*64+s['x']+1)*4] == bytes(s['bgra']) for s in oracle['samples'])
        def clean(name):
            data = chunks[name,85]
            mask = bytearray()
            for i in range(0, len(data), 4):
                pixel = data[i:i+4]
                mask.append(int(pixel[3] == 255))
                need(pixel[3] == 255 or pixel == b'\0'*4, 'draw background differs')
            need(hashlib.sha256(mask).hexdigest() == oracle['coverage_sha256'] and literals(data), 'draw coverage or literal samples differ')
        if case == 'triangle': clean('triangle')
        elif case == 'controls':
            for control, after in (('vertex-control','after-vertex'),('fragment-control','after-fragment')):
                need(not literals(chunks[control,85]), 'shader control passed literals')
                clean(after)
        elif case == 'present':
            clean('after-fragment')
            memory = json.loads(one(r'^GT710_MEMORY (.+)$', serial, 'display memory evidence')[1])
            first, second = [o['start'] for o in memory['objects'][:2]]
            need(type(first) is int and type(second) is int and 0 < first != second and second % 256 == 0 and p['second_address'] == second and p['head'] in (0, 1) and p['active_register'] == 0x640460 + p['head'] * 0x300 and p['active_value'] == second >> 8 and p['schema'] == 1 and p['active_address'] == second and p['firmware_writes'] == 0 and p['epoch'] == releases[-1]['epoch'] and p['nonce'] == releases[-1]['nonce'], 'stale present or firmware write')
            image = chunks['present',85]; draw = chunks['after-fragment',85]
            need(type(p['background']) is int and 0 <= p['background'] <= 0xffffffff, 'present background')
            background = p['background'].to_bytes(4,'little')
            for y in range(height):
                for x in range(pitch//4):
                    expected = draw[((y-p['y'])*64+x-p['x'])*4:((y-p['y'])*64+x-p['x']+1)*4] if p['y'] <= y < p['y']+64 and p['x'] <= x < p['x']+64 else background
                    need(image[(y*pitch+x*4):(y*pitch+x*4+4)] == expected, 'present read-back differs')
        else: raise ValueError('unknown draw case')
    except (KeyError, TypeError, IndexError, OverflowError, OSError) as error:
        raise ValueError('malformed draw evidence') from error

def graphics_contexts_gate(serial, case):
    """M7.5: retained target bytes, FECS binding and peer read-back digests."""
    def need(ok, why):
        if not ok:
            raise ValueError('graphics contexts: ' + why)

    def integer(value, low, high):
        return type(value) is int and low <= value < high

    try:
        # claim-lint:ok: normative wire validation; tests/gt710_contexts_report_test.py mutates images and channel records.
        e = json.loads(one(r'^GT710_CONTEXTS (.+)$', serial, 'graphics contexts')[1])
        root = Path(__file__).resolve().parents[2]
        v1 = json.loads((root / 'docs/gui/provenance/gt710-triangle.json').read_text())
        oracle = json.loads((root / 'docs/gui/provenance/gt710-contexts.json').read_text())
        assets = json.loads((root / 'kernel/assets/kepler/manifest.json').read_text())['files']
        steps = (('a-v1', 'a', 'v1'), ('b-gradient', 'b', 'gradient'),
                 ('a-v2', 'a', 'v2'), ('b-restored', 'b', 'gradient'),
                 ('suppress', 'a', 'v2'), ('after-suppress', 'a', 'v2'),
                 ('corrupt', 'b', 'gradient'), ('after-corrupt', 'b', 'gradient'))
        need(case in ('switch', 'controls'), 'unknown case')
        need(e['schema'] == 1 and e['class_id'] == 0xa197 and e['error'] is None
             and e['current_register'] == 0x409b00
             and e['trap_registers'] == [0x400100, 0x400108, 0x400110, 0x400118],
             'class, register namespace or error')
        channels = e['channels']
        need(len(channels) == 2 and [c['id'] for c in channels] == ['a', 'b'], 'two channel identities required')
        for c, fragment in zip(channels, ('diagnostic-triangle-fragment', 'gradient-fragment')):
            for field in ('instance', 'image', 'target', 'release'):
                need(integer(c[field], 4096, 1 << 40) and c[field] % 4096 == 0, 'channel allocation')
            need(integer(c['epoch'], 1, 1 << 64), 'channel epoch')
            need(c['vertex_sha256'] == assets['diagnostic-triangle-vertex.bin']['sha256']
                 and c['fragment_sha256'] == assets[fragment + '.bin']['sha256'], 'distinct shader identity')
        # The retained record names allocation bases, not offsets within them.
        allocations = [c[field] for c in channels for field in ('instance', 'image', 'target', 'release')]
        need(len(set(allocations)) == len(allocations), 'aliased channel storage')
        channels = {c['id']: c for c in channels}
        keys = [(name, poison) for name, _, _ in steps for poison in (85, 170)]
        rows = re.findall(r'^GT710_CTX_IMAGE ([a-z0-9-]+) (85|170) (\d+) ([0-9a-f:,]+)$', serial, re.M)
        need(len(rows) == len(re.findall(r'^GT710_CTX_IMAGE ', serial, re.M)), 'malformed image row')
        images = {}
        previous = None
        for name, poison, y, encoded in rows:
            key = (name, int(poison))
            need(key in keys, 'unknown image')
            if key != previous:
                need(key not in images, 'interleaved image rows')
            data = images.setdefault(key, bytearray())
            need(int(y) < 64 and int(y)*256 == len(data), 'image row order')
            row = bytearray()
            for run in encoded.split(','):
                need(re.fullmatch(r'[0-9a-f]+:[0-9a-f]{8}', run), 'image run format')
                count, word = (int(value, 16) for value in run.split(':'))
                need(0 < count <= 64 and len(row) + count*4 <= 256, 'image run length')
                row.extend(word.to_bytes(4, 'little') * count)
            need(len(row) == 256, 'incomplete image row')
            data.extend(row)
            previous = key
        need(list(images) == keys and len(e['readbacks']) == len(keys), 'missing poison or image order')
        for key, record in zip(keys, e['readbacks']):
            data = images[key]
            need(len(data) == 16384 and record == dict(case=key[0], poison=key[1], bytes=16384,
                 sha256=hashlib.sha256(data).hexdigest()), 'image digest or extent')
        for name, _, _ in steps:
            need(images[name, 85] == images[name, 170], 'complementary read-backs differ')

        def clean(data, variant):
            # claim-lint:ok: normative pixel oracle; tests/gt710_contexts_report_test.py mutates matching-poison samples and gradient bytes.
            if variant == 'gradient':
                expected = bytes(v for y in range(64) for x in range(64) for v in (4*x, 4*y, 2*(x+y), 255))
                return (data == expected and hashlib.sha256(data).hexdigest() == oracle['gradient']['image_sha256'])
            reference = v1 if variant == 'v1' else oracle['v2']
            mask = bytearray()
            for i in range(0, 16384, 4):
                pixel = data[i:i+4]
                if pixel[3] != 255 and pixel != b'\0'*4:
                    return False
                mask.append(int(pixel[3] == 255))
            return (hashlib.sha256(mask).hexdigest() == reference['coverage_sha256']
                    and all(data[(s['y']*64+s['x'])*4:(s['y']*64+s['x']+1)*4] == bytes(s['bgra'])
                            for s in reference['samples']))

        frames = e['frames']
        # claim-lint:ok: normative frame validation; tests/gt710_contexts_report_test.py mutates peers, bindings, receipts and controls.
        need(len(frames) == len(steps), 'missing frame or clean successor')
        state = {c: hashlib.sha256(bytes(16384)).hexdigest() for c in channels}
        seen = set()
        for frame, (name, channel, variant) in zip(frames, steps):
            need((frame['case'], frame['channel'], frame['variant']) == (name, channel, variant), 'frame sequence')
            c = channels[channel]
            # MIT nouveau macros.fuc:125, hub.fuc:234-267, gr/gf100.c:1613-1626:
            # bit 31 validates the channel; bits 27:0 carry instance >> 12.
            current = 0x80000000 | (c['instance'] >> 12)
            need(type(frame['current_before']) is int and type(frame['current_after']) is int
                 and frame['current_before'] == current == frame['current_after'], 'draw under another channel')
            need(frame['trap_before'] == [0]*4 and frame['trap_after'] == [0]*4, 'graphics trap')
            peer = 'b' if channel == 'a' else 'a'
            need(frame['peer_before'] == [state[peer]]*2 == frame['peer_after'], 'peer target changed')
            r = frame['receipt']
            need(type(r['target']) is int and r['target'] == c['release']
                 and type(r['epoch']) is int and r['epoch'] == c['epoch']
                 and integer(r['nonce'], 1, 1 << 32) and type(r['observed']) is int
                 and type(r['observed_epoch']) is int and r['observed'] == r['nonce']
                 and r['observed_epoch'] == r['epoch'] and r['consumed'] is True
                 and r['accepted'] is True, 'stale or foreign release')
            pair = r['epoch'], r['nonce']
            need(pair not in seen, 'reused epoch/nonce')
            seen.add(pair)
            data = images[name, 85]
            is_control = name in ('suppress', 'corrupt')
            need(frame['accepted'] is (not is_control), 'accepted control or rejected clean draw')
            if not is_control:
                need(clean(data, variant), 'coverage, background, literal or gradient mismatch')
            elif case == 'controls':
                need(not clean(data, variant), 'control passed pixel oracle')
                if name == 'suppress':
                    need(data == bytes(16384), 'suppressed draw must leave the cleared target')
                else:
                    expected = bytearray(images['b-restored', 85])
                    offset = (c['epoch'] % 4096)*4
                    expected[offset:offset+4] = bytes(4)
                    need(data == expected, 'corruption must overwrite only the epoch-selected pixel with background')
            state[channel] = hashlib.sha256(data).hexdigest()
    except (KeyError, TypeError, IndexError, OverflowError, OSError) as error:
        raise ValueError('malformed graphics context evidence') from error


CORE_NAMES = ('3d-feature', 'capability-set', 'b8g8r8a8-render', 'b8g8r8a8-sample',
              'r8g8b8a8-render', 'r8g8b8a8-sample', 'r8-sample', 'integer-ops',
              'texel-fetch', 'region-copy', 'target-size')


def core_startup(serial):
    """First-CAPS startup-window gauge, under its 500 us bound, not GPU syscalls."""
    anchor = one(r'^GT710_CORE_STARTUP_BULK (\d+) ([0-9a-f]{64})$', serial, 'core startup anchor')
    line = one(r'^GT710_CORE_STARTUP (.+)$', serial, 'core startup row')
    raw = ('GT710_CORE_STARTUP ' + line[1] + '\n').encode('ascii')
    if len(raw) != int(anchor[1]) or hashlib.sha256(raw).hexdigest() != anchor[2]:
        raise ValueError('core startup differs from bulk anchor')
    row = json.loads(line[1])
    if (type(row) is not dict or type(row.get('schema')) is not int or row['schema'] != 1
            or row.get('ready') is not True or type(row.get('irq_masked_max_us')) is not int
            or not 0 <= row['irq_masked_max_us'] <= 500):
        raise ValueError('core startup failed or startup-window IRQ-masked maximum exceeds 500 us')
    return row['irq_masked_max_us']


def core_records(serial):
    anchor = one(r'^GT710_CORE_BULK (\d+) ([0-9a-f]{64})$', serial, 'core bulk anchor')
    rows = re.findall(r'^GT710_CORE (.+)\n', serial, re.M)
    raw = ''.join('GT710_CORE ' + row + '\n' for row in rows).encode('ascii')
    if not rows or len(raw) != int(anchor[1]) or hashlib.sha256(raw).hexdigest() != anchor[2]:
        raise ValueError('core records differ from their bulk anchor')
    try:
        records = [json.loads(row) for row in rows]
        if any(type(r) is not dict or type(r.get('schema')) is not int or r['schema'] != 1 for r in records):
            raise ValueError('core record schema')
        if records[0].get('type') != 'caps' or any(r.get('type') != 'completion' for r in records[1:]):
            raise ValueError('core record order/types')
        return records
    except (TypeError, json.JSONDecodeError) as error:
        raise ValueError('malformed core records') from error


def core_row(serial):
    """The 8.1 row deliberately has no executable format/profile probes."""
    import struct
    try:
        record = core_records(serial)[0]
        if record['bytes'] != 512 or not re.fullmatch('[0-9a-f]{1024}', record['hex']):
            raise ValueError('core CAPS wire size/encoding')
        data = bytes.fromhex(record['hex'])
        words = struct.unpack('<128I', data)
        expected = (1, 512, 2, 3, 6, 512, 0xa197, 0, 4,
                    0x927d, 0xa06f, 0xa0b5, 0xa197, 0, 0, 0, 0,
                    0, 0, 1, 0, 2, 0, 0, 0, 16384, 16384, 1, 0)
        if words[:29] != expected or int.from_bytes(data[120:128], 'little') != 3 | (1 << 3) | (2 << 30):
            raise ValueError('core CAPS backend-6 classes, origins, limits or unprobed support')
        reason = b'missing b8g8r8a8-render'
        if data[128:192] != b'GK208B' + bytes(58) or data[192:256] != reason + bytes(64-len(reason)):
            raise ValueError('core CAPS identity or admission reason')
        count = words[29]
        if not 1 <= count <= 16:
            raise ValueError('core CAPS scanout count')
        active = 0
        for i in range(16):
            enabled, width, height, reserved = words[64+i*4:68+i*4]
            if i >= count:
                if (enabled, width, height, reserved) != (0,0,0,0):
                    raise ValueError('core CAPS unused scanout')
            elif reserved or enabled not in (0,1) or not 0 < width <= 16384 or not 0 < height <= 16384:
                raise ValueError('core CAPS live scanout')
            active += enabled
        if not active:
            raise ValueError('core CAPS lacks an active scanout')
        return dict(hex=record['hex'], missing=3, name=CORE_NAMES[2], commit=None)
    except (KeyError, TypeError, struct.error) as error:
        raise ValueError('malformed core CAPS') from error


def core_dispatch(serial):
    core_row(serial)
    records = core_records(serial)[1:]
    expected = [('triangle','clean')] * 5 + [
        ('copy','withheld-release'), ('after-withheld','clean'),
        ('copy','stale-epoch'), ('after-stale','clean'),
        ('copy','masked-class'), ('after-mask','clean'), ('copy','clean')]
    try:
        if [(r['case'],r['control']) for r in records] != expected:
            raise ValueError('core dispatch controls/clean successors or draw/copy order')
        context, epoch = records[0]['context'], records[0]['epoch']
        if type(context) is not int or not 0 < context < 1 << 40 or type(epoch) is not int or not 1 < epoch < 1 << 64:
            raise ValueError('core dispatch native identity')
        previous = None
        resources = {}
        for index, r in enumerate(records):
            numeric = ('context','epoch','sequence','caller','resource','generation','kind','answer',
                       'observed_context','observed_epoch','observed_sequence','consumed','elapsed_us')
            if type(r['healthy']) is not bool or any(type(r[k]) is not int or not 0 <= r[k] < 1 << 64 for k in numeric):
                raise ValueError('core dispatch unsigned fields')
            control = r['control']
            draw = r['case'] == 'triangle'
            if (r['context'] != context or r['epoch'] != epoch or r['generation'] != 1
                    or not 0 < r['resource'] < 1 << 40 or r['elapsed_us'] > 2000000
                    or r['kind'] != (0xa1971b0c if draw else 0xa0b50300)):
                raise ValueError('core dispatch identity, native kind or wait bound')
            if resources.setdefault(draw,r['resource']) != r['resource']:
                raise ValueError('core dispatch destination changed')
            planned = r['caller'] & 0xffffffff
            # The core rows select draws/copy from the shared native queue.
            # draw_probe performs two readbacks then four 4 KiB background
            # uploads between draws; the last draw has two readbacks before
            # present's copy. See gr/mod.rs draw_probe and gr/channel.rs
            # COPY_BYTES=4096, READBACK_BYTES=65536. Controls are consecutive.
            step = 7 if 1 <= index <= 4 else 3 if index == 5 else 1
            if not planned or r['caller'] != (1 << 32) | planned or (previous is not None and planned != previous+step):
                raise ValueError('core dispatch caller/sequence order')
            if control == 'masked-class':
                if (r['sequence'],r['answer'],r['observed_context'],r['observed_epoch'],
                        r['observed_sequence'],r['consumed'],r['healthy'],r['outcome']) != (0,0,0,0,0,0,False,'refused'):
                    raise ValueError('core dispatch masked class published or completed')
                continue
            if (r['sequence'] != planned or r['observed_context'] != context or r['consumed'] != planned
                    or r['healthy'] is not True):
                raise ValueError('core dispatch native completion/consumption')
            previous = planned
            observed = (r['observed_epoch'],r['observed_sequence'],r['answer'],r['outcome'])
            want = {'clean': (epoch,planned,0x60000000,'done'),
                    'withheld-release': (epoch,0,0,'rejected'),
                    'stale-epoch': (epoch-1,planned,0,'rejected')}[control]
            if observed != want:
                raise ValueError('core dispatch native answer or negative receipt')
    except (KeyError, TypeError, IndexError) as error:
        raise ValueError('malformed core dispatch') from error


def require_profile(boot, profile):
    if boot.get('build', {}).get('profile') != profile:
        raise ValueError(profile + ' build.profile required for this capture')


def core_producer(serial, caps, boot):
    require_profile(boot, 'production')
    sha = boot.get('bootedCommit')
    if (not re.fullmatch('[0-9a-f]{40}', sha or '') or boot.get('toolsCommit') != sha
            or boot.get('kind') != 'boot' or boot.get('mode') != 'suite' or boot.get('suite') != 'gpu'
            or boot.get('suites') not in (None, ['gpu']) or boot.get('platform') != 'metal'
            or boot.get('arch') != 'x86_64' or boot.get('evidenceEligible') is not True
            or not re.fullmatch(r'\d{8}T\d{6}Z-metal', boot.get('id',''))):
        raise ValueError('core producer needs a named eligible GPU-only boot of the same kernel/tools')
    if caps.get('commit') not in (None, sha):
        raise ValueError('core producer commit differs from core evidence')
    root = Path(__file__).resolve().parents[2]
    manifest = json.loads((root / 'docs/suites/gpu.json').read_text())
    names = [c['id']+'/'+case['id'] for c in manifest['categories'] for case in c['cases']]
    if len(names) != 170 or len(manifest['categories']) != 9:
        raise ValueError('core producer manifest is not the shared 170-case GPU suite')
    fatal = json.loads((root / 'docs/boot-path.json').read_text())['fatal']
    if (any(re.search(p,serial) for p in fatal + [r'KERNEL PANIC[:!]',r'GT710_GR_REFUSAL',r'SUITE_SEQUENCE STALLED'])
            or re.search(r'^SUITE gpu (?:ERROR|MEMORY reclaimed=FAIL)', serial, re.M)):
        raise ValueError('core producer fatal, stalled or other suite failure')
    if not serial.endswith('\n'):
        raise ValueError('core producer incomplete line')
    lines = serial.splitlines()
    records = [line for line in lines if re.match(r'^SUITE gpu (?:START|CASE|DONE|ELAPSED)\b',line)]
    # Production must register the native backend and refuse the unprobed format.
    reason = 'missing the GPU core with a device admitted to the profile (G1): CAPS status 2 (missing b8g8r8a8-render)'
    if len(records) != 173 or records[0] != 'SUITE gpu START cases=170':
        raise ValueError('core producer START/CASE/DONE/time count')
    for line, name in zip(records[1:171], names):
        if not re.fullmatch(r'SUITE gpu CASE '+re.escape(name)+r' FAIL ms=\d+ msg='+re.escape(reason),line):
            raise ValueError('core producer case not refused solely at unprobed admission in manifest order')
    if records[171] != 'SUITE gpu DONE passed=0 failed=170 skipped=0 total=170':
        raise ValueError('core producer DONE count or skip')
    elapsed = re.fullmatch(r'SUITE gpu ELAPSED ms=(\d+)',records[172])
    if not elapsed or not 0 < int(elapsed[1]) <= 900000:
        raise ValueError('core producer missing suite time or 900 s bound')
    ready = [i for i,line in enumerate(lines) if line == 'SUITE_SEQUENCE READY gpu']
    if len(ready) != 1 or ready[0] <= lines.index(records[-1]):
        raise ValueError('core producer missing READY after suite time')
    # Apply the ordinary memory rule even though this admission-only boot is red.
    shapes = {
        'START': r'^SUITE gpu START cases=170$',
        'FAIL': r'^SUITE gpu CASE .+ FAIL .+$',
        'DONE': r'^SUITE gpu DONE .+$',
        'MEMORY': r'^SUITE gpu MEMORY (before|after) free=(\d+) heap_free_kb=\d+(?: [a-z_]+=\d+)+$',
        'RECLAIMED': r'^SUITE gpu MEMORY reclaimed=(PASS|FAIL) free_before=(\d+) free_after=(\d+) allowance=(\d+)$',
    }
    memory_records = []
    for line in lines:
        for kind, pattern in shapes.items():
            match = re.fullmatch(pattern, line)
            if match:
                memory_records.append((kind,match,line))
                break
    memory = runpy.run_path(str(root / 'scripts/suite-verdict.py'))['memory_problem'](memory_records)
    if not memory[0]:
        raise ValueError('core producer ' + memory[1])
    return int(elapsed[1])


def core_producer_capture(directory, sha):
    """Read a completed companion; exit 1 is expected for 170 honest refusals."""
    directory = Path(directory)
    read = lambda name: (directory / name).read_text()
    boot = json.loads(read('run.json'))
    require_profile(boot, 'production')
    events = [json.loads(line) for line in read('events.jsonl').splitlines()]
    if (not read('ended').strip() or read('exit-status').strip() not in ('0','1')
            or read('dirty').strip() != '0' or read('commit').strip() != sha
            or boot.get('bootedCommit', sha) != sha or boot.get('toolsCommit') != sha
            or boot.get('build', {}).get('commit') != sha
            or boot.get('build', {}).get('features') != []
            or any(e['event'] in ('console-gap','fatal') for e in events)
            or not any(e['event'] == 'final-marker' for e in events)):
        raise ValueError('core producer capture incomplete, dirty, gapped or wrong commit')
    serial = capture_serial(directory)
    core_startup(serial)
    return dict(boot=dict(boot, bootedCommit=sha), serial=serial)


def core_diagnostic_capture(directory, sha):
    """Only a separately requested core diagnostic supplies row/dispatch data."""
    directory = Path(directory)
    read = lambda name: (directory / name).read_text()
    boot = json.loads(read('run.json'))
    require_profile(boot, 'gpu-core')
    events = [json.loads(line) for line in read('events.jsonl').splitlines()]
    if (boot.get('gt710Category') != 'core' or boot.get('mode') != 'probe'
            or boot.get('suite') or boot.get('suites') or boot.get('kind') != 'boot'
            or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('evidenceEligible') is not True
            or boot.get('build', {}).get('features') != ['gt710_core_probe']
            or boot.get('build', {}).get('commit') != sha
            or boot.get('toolsCommit') != sha or boot.get('bootedCommit', sha) != sha
            or not re.fullmatch(r'\d{8}T\d{6}Z-metal', boot.get('id', ''))
            or not read('ended').strip() or read('exit-status').strip() != '0'
            or read('dirty').strip() != '0' or read('commit').strip() != sha
            or any(e['event'] in ('console-gap', 'fatal') for e in events)
            or not any(e['event'] == 'final-marker' for e in events)):
        raise ValueError('core diagnostic capture incomplete, dirty, gapped or wrong identity')
    serial = capture_serial(directory)
    root = Path(__file__).resolve().parents[2]
    fatal = json.loads((root / 'docs/boot-path.json').read_text())['fatal'] + [r'KERNEL PANIC[:!]']
    if any(re.search(pattern, serial) for pattern in fatal):
        raise ValueError('core diagnostic fatal kernel output')
    return dict(boot=boot, serial=serial)


def core_capture(directory, sha, producer_sha=None):
    directory = Path(directory)
    read = lambda name: (directory / name).read_text()
    boot = json.loads(read('run.json'))
    require_profile(boot, 'production')
    events = [json.loads(line) for line in read('events.jsonl').splitlines()]
    if (boot.get('mode') != 'suite' or boot.get('suite') != 'console'
            or boot.get('suites') not in (None, ['console']) or boot.get('kind') != 'boot'
            or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('evidenceEligible') is not True or boot.get('inject')
            or boot.get('toolsCommit') != sha or boot.get('bootedCommit', sha) != sha
            or boot.get('build', {}).get('commit') != sha
            or boot.get('build', {}).get('features') != []
            or not read('ended').strip() or read('exit-status').strip() != '0'
            or read('dirty').strip() != '0' or read('commit').strip() != sha
            or any(e['event'] in ('console-gap', 'fatal') for e in events)):
        raise ValueError('core needs a completed clean console boot of the requested kernel/build/tools')
    handoff = [e['seconds'] for e in events if e['event'] == 'handoff']
    done = [e['seconds'] for e in events if e['event'] == 'final-marker']
    if (len(handoff) != 1 or len(done) != 1
            or any(type(v) not in (int,float) for v in handoff+done)
            or not 0 < done[0]-handoff[0] <= 330):
        raise ValueError('core console handoff-to-done exceeds 330 s or lacks timing')
    serial = capture_serial(directory)
    maximum = core_startup(serial)
    if not (directory / 'core-producer').is_dir():
        raise ValueError('core producer requires a named production GPU-suite capture')
    # An explicit producer SHA permits the coordinator's retained console/core
    # evidence when the review fix changes only userspace, docs and scoring.
    # The caller checks that source scope; each capture keeps its own identity.
    producer_sha = sha if producer_sha is None else producer_sha
    producer = core_producer_capture(directory / 'core-producer', producer_sha)
    producer.update(commit=producer_sha, console_ms=round((done[0]-handoff[0])*1000),
                    startup_irq_masked_max_us=maximum)
    diagnostic = core_diagnostic_capture(directory / 'core-diagnostic', sha)
    if diagnostic['boot']['id'] in (boot['id'], producer['boot']['id']):
        raise ValueError('core diagnostic must be distinct from its production boot')
    producer['diagnostic'] = diagnostic
    core_console_verdict(serial)
    return producer


def core_console_verdict(serial):
    """The retained console must still satisfy its ordinary suite verdict."""
    root = Path(__file__).resolve().parents[2]
    manifest = json.loads((root / 'docs/suites/console.json').read_text())
    verdict = runpy.run_path(str(root / 'scripts/suite-verdict.py'))['verdict']
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / 'serial.txt'
        path.write_text(serial)
        passed, reason = verdict(manifest, path, [path])
    if not passed:
        raise ValueError('core console producer: ' + reason)


def resources_row(serial):
    """Judge the exact production CAPS syscall bytes, separate from 8.1 core/*."""
    import struct
    try:
        anchor = one(r'^GT710_RESOURCES_BULK (\d+) ([0-9a-f]{64})$', serial, 'resources anchor')
        row = one(r'^GT710_RESOURCES (.+)$', serial, 'resources CAPS')
        raw = ('GT710_RESOURCES ' + row[1] + '\n').encode('ascii')
        if len(raw) != int(anchor[1]) or hashlib.sha256(raw).hexdigest() != anchor[2]:
            raise ValueError('resources CAPS differs from bulk anchor')
        record = json.loads(row[1])
        if (type(record.get('schema')) is not int or record['schema'] != 1
                or record.get('type') != 'caps' or record.get('bytes') != 512
                or not re.fullmatch('[0-9a-f]{1024}', record.get('hex', ''))):
            raise ValueError('resources CAPS schema or wire size')
        data = bytes.fromhex(record['hex'])
        words = struct.unpack('<128I', data)
        expected = (1, 512, 0, 0, 6, 512, 0xa197, 0, 4,
                    0x927d, 0xa06f, 0xa0b5, 0xa197, 0, 0, 0, 0,
                    0, 3, 1, 3, 2, 1, 7, 0, 16384, 16384, 1)
        # The pipeline mask describes implementation, not executable admission.
        # 8.2 requires its five pipelines through shared-suite results below.
        if words[:28] != expected or words[28] >> 17:
            raise ValueError('resources CAPS admission, native classes, formats, profile or limits')
        origins = [3, 1] + [4] * 8 + [2]
        if int.from_bytes(data[120:128], 'little') != sum(o << (3*i) for i, o in enumerate(origins)):
            raise ValueError('resources CAPS requires executable origins 3-10')
        if data[128:192] != b'GK208B' + bytes(58) or data[192:256] != bytes(64):
            raise ValueError('resources CAPS identity or admission reason')
        count = words[29]
        if not 1 <= count <= 16:
            raise ValueError('resources CAPS scanout count')
        active = 0
        for i in range(16):
            enabled, width, height, reserved = words[64+i*4:68+i*4]
            if i >= count:
                if (enabled, width, height, reserved) != (0, 0, 0, 0):
                    raise ValueError('resources CAPS unused scanout')
            elif reserved or enabled not in (0, 1) or not 0 < width <= 16384 or not 0 < height <= 16384:
                raise ValueError('resources CAPS live scanout')
            active += enabled
        if not active:
            raise ValueError('resources CAPS lacks active scanout')
        root = Path(__file__).resolve().parents[2]
        probes = [json.loads(line) for line in re.findall(r'^(\{.+\})$', serial, re.M)
                  if json.loads(line).get('phase') == 'caps-probe']
        if [p.get('capability') for p in probes] != list(range(3, 11)):
            raise ValueError('resources requires all eight executable probe images in order')
        files = ['colour.bgra', 'colour.bgra', 'colour.rgba', 'colour.bgra',
                 'r8.bgra', 'integer.bgra', 'colour.bgra', 'region.bgra']
        groups = [probes]
        epoch = 0
        for probe in [json.loads(line) for line in re.findall(r'^(\{.+\})$', serial, re.M)
                      if json.loads(line).get('phase') == 'caps-reprobe']:
            current = probe.get('epoch')
            if type(current) is not int or not 0 < current < 1 << 64:
                raise ValueError('resources invalid reprobe epoch')
            if current != epoch:
                if current <= epoch:
                    raise ValueError('resources reprobe epoch regressed')
                groups.append([])
                epoch = current
            groups[-1].append(probe)
        for group in groups:
            if [p.get('capability') for p in group] != list(range(3, 11)):
                raise ValueError('resources requires eight ordered probes in each epoch')
        for probe, name in [(p, name) for group in groups for p, name in zip(group, files)]:
            expected = (root / 'kernel/src/gpu/gk208/caps' / name).read_bytes()
            if (type(probe.get('schema')) is not int or probe['schema'] != 1
                    or type(probe.get('capability')) is not int
                    or (probe.get('width'), probe.get('height')) != (80, 16)
                    or probe.get('completed') is not True or probe.get('exact') is not True
                    or probe.get('error') != ''
                    or probe.get('expected_sha256') != hashlib.sha256(expected).hexdigest()
                    or probe.get('first') != expected.hex() or probe.get('second') != expected.hex()):
                raise ValueError('resources executable probe failed or whole-buffer mismatch: ' + name)
        return record
    except (KeyError, TypeError, AttributeError, struct.error, json.JSONDecodeError) as error:
        raise ValueError('malformed resources CAPS') from error


def resources_identity(boot, suite, sha=None):
    sha = boot.get('bootedCommit') if sha is None else sha
    if (not re.fullmatch('[0-9a-f]{40}', sha or '')
            or boot.get('bootedCommit', sha) != sha or boot.get('toolsCommit') != sha
            or boot.get('kind') != 'boot' or boot.get('mode') != 'suite'
            or boot.get('suite') != suite or boot.get('suites') not in (None, [suite])
            or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('evidenceEligible') is not True or boot.get('inject')
            or boot.get('build', {}).get('commit') != sha
            or boot.get('build', {}).get('profile') != 'production'
            or boot.get('build', {}).get('features') != []
            or not re.fullmatch(r'\d{8}T\d{6}Z-metal', boot.get('id', ''))):
        raise ValueError('resources requires a named production ' + suite + ' boot of the same kernel/build/tools')


STEP_SELECTIONS = {'resources': 'gt710-step-8-2.json', 'alpha': 'gt710-step-8-3.json', 'shapes': 'gt710-step-8-4.json', 'isolation': 'gt710-step-8-5.json', 'presentation': 'gt710-step-8-6.json'}


def resources_suite(serial, boot, selection='gt710-step-8-2.json'):
    """Score a selected step while recording every real result of the shared suite."""
    resources_identity(boot, 'gpu')
    root = Path(__file__).resolve().parents[2]
    manifest = json.loads((root / 'docs/suites/gpu.json').read_text())
    names = [c['id']+'/'+t['id'] for c in manifest['categories'] for t in c['cases']]
    step = json.loads((root / 'docs/gui' / selection).read_text())
    required = step['cases']
    if (len(names) != 170 or len(manifest['categories']) != 9
            or step.get('suite') != 'gpu' or not required
            or required != [n for n in names if n in required]):
        raise ValueError('resources step must select shared GPU cases in manifest order')
    if selection in (STEP_SELECTIONS['isolation'], STEP_SELECTIONS['presentation']):
        prior_steps = ('shapes',) if selection == STEP_SELECTIONS['isolation'] else ('resources', 'alpha', 'shapes', 'isolation')
        prior = set().union(*(set(json.loads((root / 'docs/gui' / STEP_SELECTIONS[key]).read_text())['cases']) for key in prior_steps))
        required = [n for n in names if n in prior | set(required)]
    fatal = json.loads((root / 'docs/boot-path.json').read_text())['fatal']
    if (not serial.endswith('\n') or any(re.search(p, serial) for p in
            fatal + [r'KERNEL PANIC[:!]', r'GT710_GR_REFUSAL', r'SUITE_SEQUENCE (?:STALLED|FAIL)'])):
        raise ValueError('resources GPU capture incomplete, fatal or stalled')
    # These are the suite-verdict wire shapes, with the existing memory oracle.
    shapes = {
        'START': r'SUITE gpu START cases=(\d+)',
        'PASS': r'SUITE gpu CASE ([a-z0-9/-]+) PASS ms=(\d+)(?: sha256=[0-9a-f]{64})?',
        'FAIL': r'SUITE gpu CASE ([a-z0-9/-]+) FAIL ms=(\d+)(?: sha256=[0-9a-f]{64})? msg=(\S.*)',
        'DONE': r'SUITE gpu DONE passed=(\d+) failed=(\d+) skipped=(\d+) total=(\d+)',
        'ELAPSED': r'SUITE gpu ELAPSED ms=(\d+)',
        'MEMORY': r'SUITE gpu MEMORY (before|after) free=(\d+) heap_free_kb=\d+(?: [a-z_]+=\d+)+',
        'RECLAIMED': r'SUITE gpu MEMORY reclaimed=(PASS|FAIL) free_before=(\d+) free_after=(\d+) allowance=(\d+)',
        'VALUE': r'SUITE gpu VALUE ([a-z0-9/-]+) [a-z0-9-]+=(-?\d+(?:\.\d+)?)([a-z]*)(?: expect=(-?\d+(?:\.\d+)?)\.\.(-?\d+(?:\.\d+)?)([a-z]*))?',
        'WAIT': r'SUITE gpu WAIT ([a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*) until=(\d+) for=(\d+) result=[a-z0-9]+(?:-[a-z0-9]+)*',
    }
    parsed = []
    for line in serial.splitlines():
        if 'SUITE gpu ' not in line:
            continue
        for kind, shape in shapes.items():
            match = re.fullmatch(shape, line)
            if match:
                parsed.append((kind, match, line))
                break
        else:
            raise ValueError('resources malformed or skipped GPU record: ' + line[:180])
    records = [(k, m, l) for k, m, l in parsed if k in ('START', 'PASS', 'FAIL', 'DONE', 'ELAPSED')]
    if (len(records) != 173 or records[0][0] != 'START' or records[0][1][1] != '170'
            or [k for k, _, _ in records[1:171] if k not in ('PASS', 'FAIL')]
            or [m[1] for _, m, _ in records[1:171]] != names
            or records[171][0] != 'DONE' or records[172][0] != 'ELAPSED'):
        raise ValueError('resources requires manifest-ordered START/170 CASE/DONE/ELAPSED')
    # Live WAIT measurements name the pending case; CASE still decides its result
    # (docs/suites/README.md, live measurements).
    completed, started, ended = 0, False, False
    for kind, match, _ in parsed:
        if kind == 'START': started = True
        elif kind == 'DONE': ended = True
        elif kind in ('PASS', 'FAIL'): completed += 1
        elif kind == 'WAIT' and (not started or ended or completed >= len(names)
                or match[1] != names[completed] or int(match[2]) < int(match[3])):
            raise ValueError('resources WAIT outside its pending manifest case or before its duration')
    cases = [dict(id=m[1], result=k, ms=int(m[2]), reason=m[3] if k == 'FAIL' else '')
             for k, m, _ in records[1:171]]
    for c in cases:
        if c['id'] in required and c['result'] != 'PASS':
            raise ValueError('resources step failed: ' + c['id'] + ': ' + c['reason'])
    tally = (sum(c['result'] == 'PASS' for c in cases), sum(c['result'] == 'FAIL' for c in cases), 0, 170)
    if tuple(map(int, records[171][1].groups())) != tally:
        raise ValueError('resources DONE disagrees with cases or has skips')
    elapsed = int(records[172][1][1])
    if not 0 < elapsed <= 900000:
        raise ValueError('resources GPU own ELAPSED exceeds 900 s or is absent')
    lines = serial.splitlines()
    ready = [i for i, l in enumerate(lines) if l == 'SUITE_SEQUENCE READY gpu']
    if len(ready) != 1 or ready[0] <= lines.index(records[-1][2]):
        raise ValueError('resources GPU requires READY after own ELAPSED')
    start_at = next(i for i, (k, _, _) in enumerate(parsed) if k == 'START')
    done_at = next(i for i, (k, _, _) in enumerate(parsed) if k == 'DONE')
    for i, (kind, m, _) in enumerate(parsed):
        if kind == 'VALUE' and (not start_at < i < done_at or m[1] not in names
                               or (m[6] is not None and m[6] != m[3])):
            raise ValueError('resources VALUE outside cases or with invalid unit')
    ok, why = runpy.run_path(str(root / 'scripts/suite-verdict.py'))['memory_problem'](parsed)
    if not ok:
        raise ValueError('resources GPU ' + why)
    return dict(elapsed_ms=elapsed, cases=cases)


def resources_console(serial, boot, events):
    import math
    resources_identity(boot, 'console')
    if re.search(r'SUITE_SEQUENCE (?:STALLED|FAIL)|KERNEL PANIC[:!]', serial):
        raise ValueError('resources console fatal or stalled')
    core_console_verdict(serial)
    if any(e.get('event') in ('console-gap', 'fatal') for e in events):
        raise ValueError('resources console capture gap or fatal')
    handoff = [e.get('seconds') for e in events if e.get('event') == 'handoff']
    done = [e.get('seconds') for e in events if e.get('event') == 'final-marker']
    if (len(handoff) != 1 or len(done) != 1
            or any(type(v) not in (int, float) or not math.isfinite(v) for v in handoff + done)
            or not 0 < done[0] - handoff[0] <= 330):
        raise ValueError('resources console requires handoff-to-DONE at most 330 s')
    ready = one(r'^SUITE_SEQUENCE READY console$', serial, 'resources console READY')
    last = one(r'^SUITE console ELAPSED ms=\d+$', serial, 'resources console ELAPSED')
    if ready.start() <= last.start():
        raise ValueError('resources console READY before suite completion')
    return round((done[0] - handoff[0])*1000)


def resources_capture(directory, sha):
    """Console is primary; resources-producer is the completed GPU companion."""
    directory = Path(directory)
    def read_capture(path, suite):
        read = lambda name: (path / name).read_text()
        boot = json.loads(read('run.json'))
        resources_identity(boot, suite, sha)
        events = [json.loads(l) for l in read('events.jsonl').splitlines()]
        status = read('exit-status').strip()
        if (not read('ended').strip() or read('dirty').strip() != '0' or read('commit').strip() != sha
                or status not in (('0','1') if suite == 'gpu' else ('0',))
                or any(e.get('event') in ('console-gap', 'fatal') for e in events)
                or sum(e.get('event') == 'final-marker' for e in events) != 1):
            raise ValueError('resources capture incomplete, dirty, gapped or unsuccessful')
        serial=capture_serial(path)
        boot = dict(boot, bootedCommit=sha)
        if status == '1':
            measured=resources_suite(serial, boot)
            if not any(c['result'] == 'FAIL' for c in measured['cases']):
                raise ValueError('resources exit 1 without failed GPU cases')
        return dict(boot=boot, serial=serial, events=events,
                    exit_status=int(status))
    console = read_capture(directory, 'console')
    gpu = read_capture(directory / 'resources-producer', 'gpu')
    if console['boot']['id'] == gpu['boot']['id']:
        raise ValueError('resources requires distinct console and GPU captures')
    return dict(console=console, gpu=gpu)


def read_panic_capture(directory, sha):
    path = Path(directory)
    read = lambda name: (path / name).read_text()
    boot = json.loads(read('run.json'))
    events = [json.loads(l) for l in read('events.jsonl').splitlines()]
    if (not re.fullmatch(r'\d{8}T\d{6}Z-metal', boot.get('id', ''))
            or boot.get('kind') != 'boot' or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('commit') != sha or boot.get('toolsCommit') != sha
            or boot.get('build', {}).get('commit') != sha or boot.get('inject')
            or boot.get('evidenceEligible') is not True or not read('ended').strip()
            or read('dirty').strip() != '0' or read('commit').strip() != sha
            or read('exit-status').strip() != '1'
            or any(e.get('event') == 'console-gap' for e in events)
            or not any(e.get('event') == 'power-off' and e.get('off') is True for e in events)
            or not events or events[-1].get('event') != 'closed'
            or events[-1].get('status') != 1 or events[-1].get('endedBy') != 'driver'):
        raise ValueError('panic companion requires a complete, clean, ungapped driver-stopped fatal capture of this build/tools')
    serial = read('serial.txt')
    panic_capture(serial, boot)
    return dict(boot=boot, serial=serial, events=events, exit_status=1)


def record_resources_capture(directory, sha, category='resources'):
    directory = Path(directory)
    producer = resources_capture(directory, sha)
    if category == 'presentation':
        producer['panic'] = read_panic_capture(directory / 'panic-producer', sha)
    gpu = producer['gpu']
    selection = STEP_SELECTIONS[category]
    results = cases(category, producer['console']['serial'], producer)
    report = dict(boot=producer['console']['boot']['id'], commit=sha,
                  milestone='metal-gt710/' + category, producerBoot=gpu['boot']['id'], cases=results)
    # Retain all 170 outcomes even when a required case makes this step red.
    report['gpuCaseLines'] = [l for l in gpu['serial'].splitlines() if l.startswith('SUITE gpu CASE ')]
    try:
        suite = resources_suite(gpu['serial'], gpu['boot'], selection)
        report.update(gpuCases=suite['cases'], gpuElapsedMS=suite['elapsed_ms'])
    except ValueError as error:
        report['gpuError'] = str(error)
    try:
        report['consoleHandoffToDoneMS'] = resources_console(
            producer['console']['serial'], producer['console']['boot'], producer['console']['events'])
    except ValueError as error:
        report['consoleError'] = str(error)
    for row in results:
        print('SUITE gt710 CASE ' + row['id'] + ' ' + row['result'] + ' ms=0'
              + (' msg=' + row['reason'] if row['reason'] else ''), flush=True)
    (directory / ('gt710-' + category + '.json')).write_text(json.dumps(report, indent=2) + '\n')
    return 0 if all(c['result'] == 'PASS' for c in results) else 1


def panic_capture(serial, boot):
    if (boot.get('gt710Category') != 'panic' or boot.get('mode') != 'probe'
            or boot.get('suite') or boot.get('build', {}).get('profile') != 'gpu-panic'
            or boot.get('build', {}).get('features') != ['capture_panic_oracle']):
        raise ValueError('panic requires the separate capture_panic_oracle diagnostic build')
    root = Path(__file__).resolve().parents[2]
    ok, detail = runpy.run_path(str(root / 'scripts/check-gpu-panic.py'))['check_native'](serial)
    if not ok:
        raise ValueError(detail)


def runtime_display(serial, preferred):
    if 'GT710_DISPLAY_EVIDENCE_ERROR' in serial: raise ValueError('runtime display evidence storage failed')
    rows = [json.loads(m[1]) for m in re.finditer(r'^GT710_DISPLAY_V1 (.+)$', serial, re.M)]
    if not rows or {r.get('mode') for r in rows} != {0, 1}:
        raise ValueError('runtime display needs both G20 logical modes')
    sequences = []
    for r in rows:
        try:
            mode = r['mode']
            w, h = ((1280, 800), (2560, 1600))[mode]
            pitch, bh, fmt = r['pitch'], r['block_height'], r['format']
            if (type(pitch) is not int or pitch != w * 4 or bh not in (0, 1, 2, 4, 8, 16, 32) or fmt not in (0, 1)):
                raise ValueError('invalid runtime display storage')
            storage = (0x1000000 | pitch) if bh == 0 else ((pitch // 64) << 8) | (bh.bit_length() - 1)
            arrays = [('active', 5), ('armed', 5), ('viewport_active', 8), ('viewport_armed', 8), ('raster', 2)]
            if (r['schema'] != 1 or type(mode) is not int
                    or any(type(r[k]) is not list or len(r[k]) != n
                           or any(type(v) is not int or not 0 <= v < 1 << 32 for v in r[k]) for k, n in arrays)
                    or any(type(r[k]) is not int or r[k] <= 0 for k in ('sequence', 'resource', 'requested'))
                    or r['head'] not in range(4) or r['notifier'] & 1 != 1
                    or r['active'] != r['armed'] or r['active'][0] << 8 != r['requested']
                    or r['active'][1] != w | h << 16 or r['active'][4] == 0
                    or r['active'][2] != storage or r['active'][3] != (0xcf00 if fmt == 0 else 0xd500)
                    or r['viewport_active'] != [0, 0, 0, w | h << 16, 0, 1280 | 800 << 16, 1280 | 800 << 16, 1280 | 800 << 16]
                    or r['viewport_armed'] != r['viewport_active'] or r['firmware_writes'] != 0):
                raise ValueError('runtime display latch, viewport, completion or firmware writes differ')
            blank, end = r['raster']
            if ((end & 0xffff) - (blank & 0xffff), (end >> 16) - (blank >> 16)) != tuple(preferred):
                raise ValueError('runtime raster differs from the DDC preferred timing')
            sequences.append(r['sequence'])
        except (KeyError, TypeError, IndexError) as error:
            raise ValueError('malformed runtime display evidence') from error
    if sequences != sorted(set(sequences)):
        raise ValueError('runtime display sequence is duplicated or unordered')
    return rows


def check_case(category, case, serial, producer=None):
    if category == 'presentation' and case == 'display':
        if producer is None: raise ValueError('presentation needs named GPU and console captures')
        preferred, _ = native_mode(producer['console']['serial'])
        runtime_display(producer['gpu']['serial'], (preferred['width'], preferred['height']))
        return
    if category == 'presentation' and case == 'panic':
        if producer is None or 'panic' not in producer:
            raise ValueError('presentation needs a named panic capture')
        panic_capture(producer['panic']['serial'], producer['panic']['boot'])
        return
    if category in ('alpha', 'shapes', 'isolation', 'presentation'):
        if producer is None or case != 'suite':
            raise ValueError(f'{category} needs named production GPU and console captures')
        gpu = producer['gpu']
        resources_suite(gpu['serial'], gpu['boot'], STEP_SELECTIONS[category])
        return
    if category == 'resources':
        if producer is None:
            raise ValueError('resources needs named production GPU and console captures')
        gpu, console = producer['gpu'], producer['console']
        if case == 'row': resources_row(gpu['serial'])
        elif case == 'suite': resources_suite(gpu['serial'], gpu['boot'])
        elif case == 'console': resources_console(console['serial'], console['boot'], console['events'])
        else: raise ValueError('unknown resources case')
        return
    if category == 'core':
        if producer is not None and 'diagnostic' in producer:
            serial = producer['diagnostic']['serial']
        if case == 'row': core_row(serial)
        elif case == 'dispatch': core_dispatch(serial)
        elif case == 'producer':
            if producer is None: raise ValueError('missing named production and core diagnostic captures')
            caps = core_row(serial)
            caps['commit'] = producer.get('commit')
            core_producer(producer['serial'], caps, producer['boot'])
        else: raise ValueError('unknown core case')
        return
    # claim-lint:ok: normative category dispatch; tests/gt710_contexts_report_test.py exercises gr-contexts through cases().
    if category == 'gr-contexts':
        graphics_contexts_gate(serial, case)
        return
    if category == 'draw':
        draw_gate(serial, case)
        return
    if category == 'shaders':
        shader_gate(serial, case)
        return
    if category == 'graphics':
        if case not in ('ctxctl', 'context', 'channel'): raise ValueError('unknown graphics case')
        graphics_engine(serial, case)
        return
    if category == 'recovery':
        if case != 'fault-reset': raise ValueError('unknown recovery case')
        recovery_gate(serial)
        return
    if category == 'contexts':
        if case == 'concurrent': multiple_contexts(serial)
        elif case == 'killed-wait': killed_wait(serial)
        else: raise ValueError('unknown contexts case')
        return
    if category == 'completion':
        if case != 'observation': raise ValueError('unknown completion case')
        native_observations(serial)
        return
    if category == 'copy':
        if case != 'transfers': raise ValueError('unknown CE case')
        copy_engine(serial)
        return
    if category == 'channel':
        if case != 'semaphore': raise ValueError('unknown channel case')
        privileged_channel(serial)
        return
    if category == 'lifetime':
        if case != 'retention': raise ValueError('unknown lifetime case')
        memory_lifetimes(serial)
        return
    if category == 'aperture':
        if case != 'cpu-dma': raise ValueError('unknown CPU aperture case')
        cpu_apertures(serial)
        return
    if category == 'vm':
        if case != 'tables': raise ValueError('unknown VM case')
        virtual_memory(serial)
        return
    if category == 'inventory':
        if case != 'allocator': raise ValueError('unknown inventory case')
        memory_inventory(serial)
    elif category == 'flips':
        if case != 'aba-handoff': raise ValueError('unknown flips case')
        native_flips(serial)
    elif category == 'switching':
        if case != 'low-high-low': raise ValueError('unknown switching case')
        native_switches(serial)
    elif category == 'native':
        if case != 'preferred': raise ValueError('unknown native case')
        native_mode(serial)
    elif category == 'memory':
        if case != 'carveout':
            raise ValueError('unknown memory case')
        try:
            display_memory(serial)
        except (KeyError, TypeError, OverflowError, IndexError, json.JSONDecodeError) as error:
            raise ValueError('malformed display memory evidence') from error
    elif category == 'board':
        if case != 'inventory':
            raise ValueError('unknown board case')
        board_inventory(serial)
    elif category == 'console':
        if case != 'acceptance':
            raise ValueError('unknown console case')
        for group in ('firmware', 'device'):
            for name, _ in CATEGORIES[group]:
                check_case(group, name, serial)
        if not re.search(r'\[fbcon\] screen read back identical: [1-9][0-9]* pixel rows, [1-9][0-9]* glyph cells match the font, sha256 [0-9a-f]{64}$', serial, re.M):
            raise ValueError('missing screen and font read-back')
        root = Path(__file__).resolve().parents[2]
        verdict = runpy.run_path(str(root / 'scripts/suite-verdict.py'))['verdict']
        manifest = json.loads((root / 'docs/suites/console.json').read_text())
        with tempfile.TemporaryDirectory() as tmp:
            capture = Path(tmp) / 'serial.txt'
            capture.write_text(serial)
            passed, reason = verdict(manifest, capture, [capture])
        if not passed:
            raise ValueError('E16 console: ' + reason)
    elif category == 'firmware':
        f = framebuffer(serial)
        if case == 'mode':
            if not (0 < f['width'] <= f['stride'] and f['height'] > 0 and f['base'] > 0
                    and f['size'] >= f['stride'] * f['height'] * f['bpp']):
                raise ValueError('framebuffer geometry or pitch exceeds the handed-off mapping')
        elif case == 'owner':
            bdf, _, _, _ = pci(serial)
            if not (f['ident'] == '10de:128b' and f['bdf'] == bdf
                    and f['bar'] <= f['base'] and f['base'] + f['size'] <= f['bar'] + f['span']):
                raise ValueError('firmware framebuffer is not wholly inside the GT 710 BAR')
            bar = one(r'^PCI_DISPLAY_BAR ' + bdf + r' index=' + str(f['index'])
                      + r' address=(' + HEX + r') size=(' + HEX + r') kind=mem prefetch=1 width=(32|64)$', serial, 'framebuffer PCI BAR')
            if (int(bar[1], 16), int(bar[2], 16)) != (f['bar'], f['span']):
                raise ValueError('framebuffer owner and PCI BAR census disagree')
        else:
            raise ValueError('unknown firmware case')
    elif category == 'device':
        bdf, bar0, size0, irq = pci(serial)
        if case == 'identity':
            m = one(r'^PCI_DISPLAY ' + bdf + r' subsystem=1462:8c93 irq=(' + HEX + r') pin=([0-4]) bars=([1-6])$', serial, 'GT 710 subsystem and interrupt')
            if int(m[1], 16) != irq:
                raise ValueError('PCI census and display interrupt line disagree')
        elif case == 'bars-link':
            m = one(r'^PCI_DISPLAY ' + bdf + r' subsystem=1462:8c93 irq=' + HEX + r' pin=[0-4] bars=([1-6])$', serial, 'display BAR count')
            bars = list(re.finditer(r'^PCI_DISPLAY_BAR ' + bdf + r' index=([0-5]) address=(' + HEX + r') size=(' + HEX + r') kind=(mem|io) prefetch=([01]) width=(32|64)$', serial, re.M))
            if len(bars) != int(m[1]) or len({b[1] for b in bars}) != len(bars):
                raise ValueError('missing or duplicated display BARs')
            if not any(b[1] == '0' and (int(b[2], 16), int(b[3], 16)) == (bar0, size0) for b in bars):
                raise ValueError('BAR0 differs from the PCI function census')
            for b in bars:
                if int(b[2], 16) == 0 or int(b[3], 16) == 0:
                    raise ValueError('display BAR is unassigned or has no measured extent')
            link = one(r'^PCI_DISPLAY_LINK ' + bdf + r' cap=(' + HEX + r') status=(' + HEX + r') speed=(\d+) width=(\d+) max_speed=(\d+) max_width=(\d+)$', serial, 'display PCIe link')
            cap, status = int(link[1], 16), int(link[2], 16)
            values = tuple(int(link[i]) for i in range(3, 7))
            if values != (status & 15, (status >> 4) & 63, cap & 15, (cap >> 4) & 63):
                raise ValueError('PCIe link fields differ from their raw registers')
            speed, width, max_speed, max_width = values
            if not (1 <= speed <= max_speed <= 7 and width in (1, 2, 4, 8, 12, 16, 32) and width <= max_width):
                raise ValueError('PCIe link is down or its reported parameters are invalid')
        elif case == 'claimed':
            one(r'\[devices\] display found: pci ' + bdf + r' \[10de:128b\] subclass 0x00$', serial, 'display class discovery')
            f = framebuffer(serial)
            one(r'\[devices\] display initialized: pci ' + bdf + r' \[10de:128b\] driver=firmware-framebuffer BAR' + str(f['index']) + r'$', serial, 'firmware display claim')
            if f['bdf'] != bdf:
                raise ValueError('claimed function does not own the console framebuffer')
        else:
            raise ValueError('unknown device case')
    else:
        raise ValueError('unknown category')


def cases(category, serial, producer=None):
    results = []
    for name, title in CATEGORIES[category]:
        try:
            check_case(category, name, serial, producer)
            result, reason = 'PASS', ''
        except ValueError as error:
            result, reason = 'FAIL', str(error)
        results.append(dict(id=category + '/' + name, title=title, result=result, reason=reason))
    return results


def validate_manifest(manifest):
    expected = [(cat, [(name, title) for name, title in entries]) for cat, entries in CATEGORIES.items()]
    actual = [(cat['id'], [(case['id'], case['title']) for case in cat['cases']]) for cat in manifest['categories']]
    if manifest.get('id') != 'gt710' or actual != expected:
        raise ValueError('GT 710 case table differs from its manifest')


def score(manifest, effort_path, records, serial, boot, sha, fatal_patterns, producer=None):
    validate_manifest(manifest)
    milestone = records.get('milestone', '').removeprefix('metal-gt710/')
    category = 'core' if milestone == 'gpu-core' else milestone
    if category not in CATEGORIES or records.get('milestone') != 'metal-gt710/' + milestone:
        raise ValueError('unknown GT 710 milestone')
    measures = [m['measure'] for e in effort_path['efforts'] if e['id'] == 'metal-gt710'
                for m in e['milestones'] if m['id'] == milestone]
    if measures != [dict(suite='gt710', categories=[category])]:
        raise ValueError('milestone must measure its complete populated category')
    if (not re.fullmatch('[0-9a-f]{40}', sha or '') or boot.get('toolsCommit') != sha
            or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('evidenceEligible') is not True or boot.get('kind') not in ('boot', 'persistent')
            or boot.get('mode') not in ('default', 'console', 'suite', 'persistent', 'probe')
            or boot.get('bootedCommit', sha) != sha):
        raise ValueError('GT 710 evidence needs this kernel and tools in an eligible metal boot')
    if records.get('boot') != boot.get('id') or records.get('commit') != sha:
        raise ValueError('GT 710 records belong to another boot or commit')
    if category in ('console', 'core'):
        require_profile(boot, 'production')
    if category == 'core':
        if (producer is None or producer['boot']['id'] == boot['id']
                or not 0 < producer.get('console_ms', 0) <= 330000
                or 'diagnostic' not in producer):
            raise ValueError('core needs its named production and diagnostic captures')
        require_profile(producer['diagnostic']['boot'], 'gpu-core')
        if records.get('producerBoot') != producer['boot']['id']:
            raise ValueError('core producer boot differs from retained companion')
    if category in STEP_SELECTIONS:
        if producer is None or producer['console']['boot']['id'] != boot['id']:
            raise ValueError('resources primary capture differs from report')
        for capture, suite in [(producer['console'], 'console'), (producer['gpu'], 'gpu')]:
            resources_identity(capture['boot'], suite, sha)
        if producer['console']['boot']['id'] == producer['gpu']['boot']['id']:
            raise ValueError('resources captures must be distinct')
        suite = resources_suite(producer['gpu']['serial'], producer['gpu']['boot'], STEP_SELECTIONS[category])
        console_ms = resources_console(producer['console']['serial'], producer['console']['boot'],
                                       producer['console']['events'])
        lines = [l for l in producer['gpu']['serial'].splitlines() if l.startswith('SUITE gpu CASE ')]
        if (records.get('producerBoot') != producer['gpu']['boot']['id']
                or records.get('gpuCases') != suite['cases'] or records.get('gpuCaseLines') != lines
                or records.get('gpuElapsedMS') != suite['elapsed_ms']
                or records.get('consoleHandoffToDoneMS') != console_ms):
            raise ValueError('resources report differs from retained suite results or timing')
    if category == 'presentation':
        if producer is None or 'panic' not in producer:
            raise ValueError('presentation needs a separate panic-producer capture')
        panic = producer['panic']
        pb = panic['boot']
        if (pb.get('id') in (producer['gpu']['boot']['id'], producer['console']['boot']['id'])
                or pb.get('commit') != sha or pb.get('toolsCommit') != sha
                or pb.get('build', {}).get('commit') != sha):
            raise ValueError('panic companion differs from this build/tools or reuses a suite boot')
        panic_capture(panic['serial'], pb)
    if records.get('cases') != cases(category, serial, producer):
        raise ValueError('GT 710 results differ from the captured evidence')
    if any(c['result'] != 'PASS' for c in records['cases']):
        raise ValueError('one or more ' + category + ' cases failed')
    if any(re.search(p, serial) for p in fatal_patterns):
        raise ValueError('fatal kernel output')
    return category + ': ' + str(len(CATEGORIES[category])) + ' cases passed'


def capture_serial(directory):
    # claim-lint:ok: normative bulk framing; tests/gt710_bulk_test.py and tests/gt710_contexts_report_test.py mutate anchors and bodies.
    serial=(Path(directory)/'serial.txt').read_text()
    spans = bool(re.search(r'^GT710_SPANS_BULK ', serial, re.M))
    stalls = bool(re.search(r'^GT710_STALL_BULK ', serial, re.M))
    timings = bool(re.search(r'^GT710_TIMING_BULK ', serial, re.M))
    matches=list(re.finditer(r'^GT710_BULK (\d+) ([a-f0-9]{64})$',serial,re.M))
    finals=list(re.finditer(r'^GT710_FINAL_BULK (\d+) ([a-f0-9]{64})$',serial,re.M))
    final_path=Path(directory)/'gt710-final.rle'
