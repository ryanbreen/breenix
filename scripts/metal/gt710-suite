        raise ValueError('final artifact slot missing or duplicated')
    if finals:
        start=list(re.finditer(r'^SUITE gpu START .*$',serial,re.M))
        done=list(re.finditer(r'^SUITE gpu DONE .*$',serial,re.M))
        memory=list(re.finditer(r'^SUITE gpu MEMORY reclaimed=.*$',serial,re.M))
        ready=list(re.finditer(r'^SUITE_SEQUENCE READY gpu$',serial,re.M))
        case_rows=list(re.finditer(r'^SUITE gpu CASE .*$',serial,re.M))
        if (len(matches)!=1 or len(start)!=1 or len(done)!=1 or len(memory)!=1
                or len(ready)!=1 or not case_rows
                or not matches[0].end()<start[0].start()<case_rows[0].start()
                or not case_rows[-1].end()<done[0].start()<memory[0].start()<finals[0].start()<ready[0].start()):
            raise ValueError('final artifact slot outside completed GPU suite')
    contexts = 'GT710_CTX_BULK ' in serial or 'GT710_CONTEXTS ' in serial
    if contexts and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file()
                     or re.search(r'^GT710_CTX_IMAGE ', serial, re.M)):
        raise ValueError('graphics context image bulk missing or on serial')
    probes = bool(re.search(r'^GT710_CAPS_(?:PROBE|REPROBE) id=', serial, re.M))
    if probes and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file()):
        raise ValueError('executable CAPS probe bulk missing')
    if any(line.startswith('{') and any('"phase":"' + phase + '"' in line
           for phase in ('caps-probe', 'caps-reprobe')) for line in serial.splitlines()):
        raise ValueError('executable CAPS probe images must arrive in bulk')
    resources = 'GT710_RESOURCES_BULK ' in serial
    if resources and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file()):
        raise ValueError('resources evidence bulk missing')
    if re.search(r'^GT710_RESOURCES ', serial, re.M):
        raise ValueError('resources CAPS must arrive in bulk')
    startup = 'GT710_CORE_STARTUP_BULK ' in serial
    core = 'GT710_CORE_BULK ' in serial or startup
    if core and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file()):
        raise ValueError('core evidence bulk missing')
    if re.search(r'^GT710_CORE(?:_STARTUP)? ', serial, re.M):
        raise ValueError('core records must arrive in bulk')
    draw = 'GT710_DRAW_BULK ' in serial or 'GT710_DRAW ' in serial
    if draw and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file() or re.search(r'^GT710_DRAW_IMAGE ', serial, re.M)):
        raise ValueError('draw image bulk missing or on serial')
    graphics = 'GT710_GR_IMAGE_BULK ' in serial or 'GT710_GR ' in serial
    shaders = 'GT710_SHADER_BULK ' in serial or 'GT710_SHADER ' in serial
    if shaders and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file() or re.search(r'^GT710_SHADER_IMAGE ', serial, re.M)):
        raise ValueError('shader image bulk missing or on serial')
    if graphics and (not matches or not (Path(directory)/'gt710-pixels.rle').is_file()):
        raise ValueError('graphics image bulk missing')
    if graphics and re.search(r'^GT710_GR_IMAGE ', serial, re.M):
        raise ValueError('graphics image rows must arrive in bulk')
    if spans and not matches:
        raise ValueError('spans evidence bulk missing')
    if re.search(r'^GT710_DISPLAY_V1 ', serial, re.M):
        raise ValueError('runtime display records must arrive in bulk')
    if re.search(r'^GT710_SPANS_V1 ', serial, re.M):
        raise ValueError('spans records must arrive in bulk')
    if stalls and not matches:
        raise ValueError('stall evidence bulk missing')
    if re.search(r'^GT710_STALL_V1 ', serial, re.M):
        raise ValueError('stall records must arrive in bulk')
    if timings and not matches: raise ValueError('timing evidence bulk missing')
    if re.search(r'^GT710_TIMING_V1 ', serial, re.M): raise ValueError('timing records must arrive in bulk')
    if re.search(r'^GT710_GR_REFUSAL_V1 ', serial, re.M):
