            for r in releases:
                need(r['class_id'] == 0xa197, 'release class')
                # MIT cla197.h: RELEASE, writes complete, pipeline location 0xf,
                # one-word structure, flushing enabled (0x1b00..0x1b0c).
                need(r['method'] == 0x1b0c and r['word'] == 0x1000f010, 'release operation')
                need(type(r['nonce']) is int and 0 < r['nonce'] <= 0xffffffff and r['nonce'] not in (85, 170)
                     and r['observed'] == r['nonce'] and r['epoch'] == c['epoch'], 'release nonce')
                bounded(r, 'release bound')
            need(releases[0]['nonce'] == releases[1]['nonce'], 'release nonce')
            w = e['withheld_release']
            need(w['accepted'] is False and w['poison'] in (85, 170) and w['observed'] == w['poison'], 'withheld release')
            s = e['stale_release']
            need(s['accepted'] is False and 0 <= s['epoch'] < c['epoch']
                 and s['nonce'] == releases[0]['nonce'] and s['observed'] == s['nonce'], 'stale release')
            faults = words(e['faults'])
            need(set(faults) == {0x400100, 0x400108, 0x259c} and all(v == 0 for v in faults.values()), 'trap/fault')
            need(e['teardown'] == dict(runlist_count=0, binding=0), 'channel teardown')
            need(e['baseline'] == e['after'], 'allocator baseline')
            need(e['firmware_writes'] == 0, 'firmware writes')
            need(e['draw'] == 'pending-7.4' and e['shaders'] == 'pending-7.3'
                 and e['context_switch'] == 'pending-7.5', 'pending markers')
        for name, check in [('ctxctl', check_ctxctl), ('context', check_context), ('channel', check_channel)]:
            if case is None or case == name:
