        if display: return ('display-state', int(display[1]))
        if line.startswith('GT710_DISPLAY_BULK '): raise ValueError('invalid runtime display anchor')
        refusal = re.fullmatch(r'GT710_GR_REFUSAL_BULK bytes=([1-9]\d*) sha256=([a-f0-9]{64})\n?', line)
        if refusal: return ('gr-refusal', refusal[2])
        if line.startswith('GT710_GR_REFUSAL_BULK '): raise ValueError('invalid GR refusal anchor')
        timing = re.fullmatch(r'GT710_TIMING_BULK batch=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if timing: return ('timing', int(timing[1]))
        if line.startswith('GT710_TIMING_BULK '): raise ValueError('invalid timing anchor')
        spans = re.fullmatch(r'GT710_SPANS_BULK id=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if spans: return ('spans', int(spans[1]))
        if line.startswith('GT710_SPANS_BULK '): raise ValueError('invalid spans anchor')
        mmu = re.fullmatch(r'GT710_MMU_ERROR_BULK epoch=(\d+) sequence=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if mmu: return ('mmu-error', int(mmu[1]), int(mmu[2]))
        if line.startswith('GT710_MMU_ERROR_BULK '): raise ValueError('invalid MMU error anchor')
        stall = re.fullmatch(r'GT710_STALL_BULK epoch=(\d+) put=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if stall: return ('stall', int(stall[1]), int(stall[2]))
        if line.startswith('GT710_STALL_BULK '): raise ValueError('invalid stall anchor')
        reprobe = re.fullmatch(r'GT710_CAPS_REPROBE id=(\d+) epoch=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if reprobe: return ('caps-reprobe', int(reprobe[2]), int(reprobe[1]))
        probe = re.fullmatch(r'GT710_CAPS_PROBE id=(\d+) sha256=([a-f0-9]{64})\n?', line)
        if probe: return ('caps-probe', int(probe[1]))
        if line.startswith('GT710_RESOURCES_BULK '): return ('resources',)
        if line.startswith('GT710_CORE_STARTUP_BULK '): return ('core-startup',)
        if line.startswith('GT710_CORE_BULK '): return ('core',)
        if line.startswith('GT710_CTX_BULK '): return ('gr-contexts',)
        if line.startswith('GT710_DRAW_BULK '): return ('draw',)
        if line.startswith('GT710_SHADER_BULK '): return ('shaders',)
        if line.startswith('GT710_MULTI_BULK '): return ('multi',)
        if line.startswith('GT710_GR_IMAGE_BULK '): return ('graphics',)
        for prefix,kind in [('GT710_MODE ','native'),('GT710_SWITCH ','switch'),('GT710_FLIP ','flip')]:
            if line.startswith(prefix):
                e=json.loads(line[len(prefix):])
                return (kind,) if kind=='native' else ((kind,e['step']) if kind=='switch' else (kind,e['mode'],e['step']))
        return None
    reports=[report_key(line) for line in serial.splitlines()]
    order=[key for key in reports if key is not None]
    if len(order)!=len(set(order)) or list(groups)!=order:
        raise ValueError('display artifact blocks differ from update order')
    result=[]
    serial_offset=0
    for line in serial.splitlines(keepends=True):
        key=report_key(line)
        if key is not None and finals:
            lower=matches[0].end() if group_slots[key] else 0
            upper=finals[0].start() if group_slots[key] else matches[0].start()
            if not lower<=serial_offset<upper:
                raise ValueError('artifact anchor outside its upload slot')
        serial_offset+=len(line)
        if key is not None and key[0] == 'display-state':
            anchor = re.fullmatch(r'GT710_DISPLAY_BULK sequence=([1-9]\d*) bytes=([1-9]\d*) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or len(record) != int(anchor[2]) or hashlib.sha256(record).hexdigest() != anchor[3]:
                raise ValueError('runtime display record differs from serial length/digest')
        if key is not None and key[0] == 'gr-refusal':
            anchor = re.fullmatch(r'GT710_GR_REFUSAL_BULK bytes=([1-9]\d*) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or len(record) != int(anchor[1]) or hashlib.sha256(record).hexdigest() != anchor[2]:
                raise ValueError('GR refusal record differs from serial length/digest')
        if key is not None and key[0] == 'timing':
            anchor = re.fullmatch(r'GT710_TIMING_BULK batch=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or len(record) != int(anchor[2]) or hashlib.sha256(record).hexdigest() != anchor[3]:
                raise ValueError('timing record differs from serial length/digest')
        if key is not None and key[0] == 'spans':
            anchor = re.fullmatch(r'GT710_SPANS_BULK id=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or len(record) != int(anchor[2]) or hashlib.sha256(record).hexdigest() != anchor[3]:
                raise ValueError('spans record differs from serial length/digest')
        if key is not None and key[0] == 'mmu-error':
            anchor = re.fullmatch(r'GT710_MMU_ERROR_BULK epoch=(\d+) sequence=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or str(len(record)) != anchor[3] or hashlib.sha256(record).hexdigest() != anchor[4]:
                raise ValueError('MMU error record differs from serial length/digest')
        if key is not None and key[0] == 'stall':
            anchor = re.fullmatch(r'GT710_STALL_BULK epoch=(\d+) put=(\d+) bytes=(\d+) sha256=([a-f0-9]{64})\n?', line)
            record = groups[key][0].removesuffix('\n').encode('ascii')
            if len(groups[key]) != 1 or len(record) != int(anchor[3]) or hashlib.sha256(record).hexdigest() != anchor[4]:
                raise ValueError('stall record differs from serial length/digest')
        if key is not None and key[0] in ('caps-probe', 'caps-reprobe'):
            digest = re.search(r'sha256=([a-f0-9]{64})', line)
            if (len(groups[key]) != 1 or digest is None
                    or hashlib.sha256(groups[key][0].removesuffix('\n').encode('ascii')).hexdigest() != digest[1]):
                raise ValueError('executable CAPS probe differs from serial digest')
        if key in (('multi',), ('graphics',), ('shaders',), ('draw',), ('gr-contexts',), ('core',), ('core-startup',), ('resources',)):
            record=''.join(groups[key]).encode('ascii')
            fields=line.split()
            if len(fields)!=3 or (key==('multi',) and len(groups[key])!=1) or len(record)!=int(fields[1]) or hashlib.sha256(record).hexdigest()!=fields[2]:
                kind='concurrency' if key==('multi',) else 'graphics image'
                raise ValueError(kind+' artifact differs from serial length/digest')
        if key is not None and key[0] == 'caps-reprobe':
            row = json.loads(groups[key][0])
            if any(side + '_sha256' in row for side in ('first', 'second')):
                source = groups.get(('caps-probe', row['capability']), [])
                if len(source) != 1 or any(side in row for side in ('first', 'second')):
                    raise ValueError('reprobe needs complete uploaded source images')
                source = json.loads(source[0])
                for side in ('first', 'second'):
                    pixels = source.get(side)
                    digest = row.get(side + '_sha256')
                    if (not isinstance(pixels, str) or len(pixels) % 2
                            or re.fullmatch('[0-9a-f]*', pixels) is None
                            or not isinstance(digest, str) or re.fullmatch('[0-9a-f]{64}', digest) is None
                            or hashlib.sha256(bytes.fromhex(pixels)).hexdigest() != digest):
                        raise ValueError('fresh reprobe digest differs from uploaded image')
                    row[side] = pixels
                result.append(json.dumps(row, separators=(',', ':')) + '\n')
            else:
                result.extend(groups[key])
        elif key is not None:
            result.extend(groups[key])
        result.append(line)
    joined = ''.join(result)
    if startup:
        core_startup(joined)
    return joined


CPU_MEMORY_CATEGORIES = {'inventory','vm','aperture','lifetime'}

def capture_categories(boot):
    if boot.get('mode') == 'probe':
        return [c for c in CATEGORIES if c in CPU_MEMORY_CATEGORIES]
    return [c for c in CATEGORIES if c not in STEP_SELECTIONS and c not in CPU_MEMORY_CATEGORIES
            # The console entry runs CE kill/recovery before CAPS transfers FIFO
            # ownership. The GPU entry starts with CAPS and cannot run those probes.
            and not (boot.get('suite') == 'gpu' and c in ('recovery', 'contexts'))
            and (c != 'console' or (boot.get('mode') == 'suite' and boot.get('suite') == 'console'))]


def record_capture(directory, sha, producer_sha=None):
    """Apply this scorer's manifest to retained capture facts and identities."""
    directory = Path(directory)
    read = lambda name: json.loads((directory / name).read_text())
    boot = read('run.json')
    serial = capture_serial(directory)
    root = Path(__file__).resolve().parents[2]
    manifest = json.loads((root / 'docs/suites/gt710.json').read_text())
    effort = json.loads((root / 'docs/efforts/metal.json').read_text())
    fatal = json.loads((root / 'docs/boot-path.json').read_text())['fatal'] + [r'KERNEL PANIC:']
    producer = None
    if (directory / 'core-diagnostic').is_dir():
        producer = core_capture(directory, sha, producer_sha)
    passed = True
    for category in capture_categories(boot):
        records = dict(boot=boot['id'], commit=sha, milestone='metal-gt710/' + ('gpu-core' if category == 'core' else category),
                       cases=cases(category, serial, producer))
        if category == 'core': records['producerBoot'] = producer['boot']['id'] if producer else None
        for c in records['cases']:
            print('SUITE gt710 CASE ' + c['id'] + ' ' + c['result'] + ' ms=0' + (' msg=' + c['reason'] if c['reason'] else ''), flush=True)
        try:
            score(manifest, effort, records, serial, boot, sha, fatal, producer)
        except ValueError as error:
            passed = False
            print(str(error), flush=True)
        (directory / ('gt710-' + category + '.json')).write_text(json.dumps(records) + '\n')
    if passed and boot.get('mode') != 'probe':
        _, pixels = native_mode(serial)
        (directory / 'gt710-native-scanout.bin').write_bytes(pixels)
        for e, pixels in native_flips(serial):
            (directory / ('gt710-flip-' + str(e['mode']) + '-' + str(e['step']) + '.bin')).write_bytes(pixels)
        for e, pixels in native_switches(serial):
            (directory / ('gt710-switch-' + str(e['step']) + '.bin')).write_bytes(pixels)
    return 0 if passed else 1


def alpha_capture_identity(directory, head):
    """G13 retained boots may differ only by the authorized host scorer files."""
    import subprocess
    capture = (Path(directory) / 'commit').read_text().strip()
    if not re.fullmatch('[a-f0-9]{40}', capture):
        raise ValueError('alpha capture requires a full recorded commit')
    changed = []
    if capture != head:
        root = Path(__file__).resolve().parents[2]
        subprocess.check_output(['git', 'merge-base', '--is-ancestor', capture, head], cwd=root)
        changed = subprocess.check_output(
            ['git', 'diff', '--no-renames', '--name-only', '-z', capture, head], cwd=root).decode().split('\0')[:-1]
        allowed = {'scripts/metal/gt710-suite', 'tests/gt710_alpha_report_test.py',
                   'tests/gt710_graphics_report_test.py'}
        if set(changed) - allowed:
            raise ValueError('alpha retained capture differs in runtime or unauthorized files: ' + ', '.join(changed))
    return capture, changed


def alpha_capture_proof(directory, sha, pr, category='alpha'):
    """Bind the step's two completed captures to the observed open PR head (G13)."""
    if pr.get('state') != 'OPEN' or pr.get('headRefOid') != sha:
        raise ValueError('alpha acceptance requires the current open PR head')
    capture_sha, changed = alpha_capture_identity(directory, sha)
    producer = resources_capture(directory, capture_sha)
    gpu = resources_suite(producer['gpu']['serial'], producer['gpu']['boot'], STEP_SELECTIONS[category])
    console_ms = resources_console(producer['console']['serial'], producer['console']['boot'],
                                   producer['console']['events'])
    proof = dict(head=sha, captureCommit=capture_sha, hostOnlyDiff=changed, pr=pr, boots=[], consoleHandoffToDoneMS=console_ms,
                 gpuElapsedMS=gpu['elapsed_ms'])
    selected = json.loads((Path(__file__).resolve().parents[2] / 'docs/gui' / STEP_SELECTIONS[category]).read_text())['cases']
    if category == 'isolation':
        prior = json.loads((Path(__file__).resolve().parents[2] / 'docs/gui' / STEP_SELECTIONS['shapes']).read_text())['cases']
        selected = list(set(selected) | set(prior))
    proof['selected'] = dict(passed=sum(c['id'] in selected and c['result'] == 'PASS' for c in gpu['cases']),
                             total=len(selected))
    for suite, capture in producer.items():
        boot, serial, events = capture['boot'], capture['serial'], capture['events']
        if boot.get('target', {}).get('branch', {}).get('name') != pr.get('headRefName'):
            raise ValueError('alpha capture branch differs from PR head branch')
        status = capture['exit_status']
        done = one(r'^SUITE ' + suite + r' DONE passed=(\d+) failed=(\d+) skipped=(\d+) total=(\d+)$',
                   serial, 'alpha ' + suite + ' DONE')
        tally = dict(zip(('passed', 'failed', 'skipped', 'total'), map(int, done.groups())))
        # A nonzero result is attributable to case failures only when the driver
        # first reached its final marker, powered off, and then applied the suite verdict.
        expected = int(tally['failed'] != 0)
        lifecycle = ('final-marker', 'decided', 'power-off', 'suite-verdict', 'closed')
        rows = [e for e in events if e.get('event') in lifecycle]
        if ([e['event'] for e in rows] != list(lifecycle) or status != expected
                or rows[1].get('status') != 0 or rows[2].get('off') is not True
                or rows[3].get('status') != expected or rows[4].get('status') != expected
                or rows[4].get('endedBy') != 'driver'):
            raise ValueError('alpha ' + suite + ' exit is not a completed driver/suite verdict')
        path = Path(directory) / ('resources-producer' if suite == 'gpu' else '')
        artifacts = ['serial.txt', 'events.jsonl', 'gt710-pixels.rle']
        if any(not (path / name).is_file() for name in artifacts):
            raise ValueError('alpha ' + suite + ' requires retained serial, events and startup artifact')
        if (path / 'gt710-final.rle').exists():
            artifacts.append('gt710-final.rle')
        digests = {name: hashlib.sha256((path / name).read_bytes()).hexdigest() for name in artifacts}
        memory = one(r'^SUITE ' + suite + r' MEMORY reclaimed=(PASS|FAIL) free_before=\d+ free_after=\d+ allowance=\d+$',
                     serial, 'alpha ' + suite + ' memory')[1]
        if memory != 'PASS':
            raise ValueError('alpha ' + suite + ' memory was not reclaimed')
        proof['boots'].append(dict(id=boot['id'], suite=suite, commit=capture_sha,
            toolsCommit=boot['toolsCommit'], build=boot['build'], exitStatus=status,
            exitReason=('failed GPU cases outside step ' + ({'isolation': '8.5', 'shapes': '8.4'}.get(category, '8.3')) + ' (G13)') if status else 'passed suite',
            done=tally, memory=memory, captureComplete=True, lifecycle=rows, sha256=digests))
    return proof


def alpha_acceptance(directory, sha, pr, category='alpha'):
    """Score existing hardware cases and this step against the same pair of captures."""
    step_categories = ('resources', 'alpha', 'shapes', 'isolation') if category == 'isolation' else (('resources', 'alpha', 'shapes') if category == 'shapes' else ('resources', 'alpha'))
    proof = alpha_capture_proof(directory, sha, pr, category)
    capture_sha = proof['captureCommit']
    producer = resources_capture(directory, capture_sha)
    root = Path(__file__).resolve().parents[2]
    manifest = json.loads((root / 'docs/suites/gt710.json').read_text())
    effort = json.loads((root / 'docs/efforts/metal.json').read_text())
    fatal = json.loads((root / 'docs/boot-path.json').read_text())['fatal'] + [r'KERNEL PANIC:']
    proof['checks'] = []
    for suite, capture in producer.items():
        boot, serial = capture['boot'], capture['serial']
        for category in capture_categories(boot):
            # The coordinator binds the unchanged core/* rows to the retained 8.1 captures.
            if category == 'core':
                continue
            records = dict(boot=boot['id'], commit=capture_sha, milestone='metal-gt710/' + category,
                           cases=cases(category, serial))
            reason = score(manifest, effort, records, serial, boot, capture_sha, fatal)
            proof['checks'].append(dict(suite=suite, category=category, count=len(records['cases']), reason=reason))
    for category in step_categories:
        if record_resources_capture(directory, capture_sha, category) != 0:
            raise ValueError(category + ' acceptance failed')
        records = json.loads((Path(directory) / ('gt710-' + category + '.json')).read_text())
        reason = score(manifest, effort, records, producer['console']['serial'], producer['console']['boot'],
                       capture_sha, fatal, producer)
        proof['checks'].append(dict(suite='gpu', category=category, count=len(records['cases']), reason=reason))
    proof['passed'] = True
    return proof


def acceptance_status(directory, verdict, producer_sha=None):
    """Require the retained boot status and every measured GT 710 aggregate."""
    directory = Path(directory)
    boot = json.loads((directory / 'run.json').read_text())
    status = (directory / 'exit-status').read_text().strip()
    print(f'{boot.get("suite", boot["mode"])} exit {status}', flush=True)
    passed = status == '0' and verdict.get('captureComplete') is True
    for category in capture_categories(boot):
        name = 'metal-gt710/' + ('gpu-core' if category == 'core' else category)
        result = verdict.get('milestones', {}).get(name, {})
        count = len(CATEGORIES[category])
        complete = (result.get('passed') is True
                    and result.get('reached') == count and result.get('total') == count)
        print(f'{name} {"PASS" if complete else "FAIL"} '
              f'{result.get("reached", 0)}/{result.get("total", count)}', flush=True)
        passed = passed and complete
    if (directory / 'core-diagnostic').is_dir():
        sha = (directory / 'commit').read_text().strip()
        producer = core_capture(directory, sha, producer_sha)
        core = cases('core', capture_serial(directory), producer)
        checks = {c['id']: c['result'] for c in core}
        checks['masked-capability'] = checks['core/dispatch']
        passed = passed and all(result == 'PASS' for result in checks.values())
        captures = []
        for path in [directory, directory / 'core-diagnostic', directory / 'core-producer']:
            run = json.loads((path / 'run.json').read_text())
            capture = dict(id=run['id'], commit=(path / 'commit').read_text().strip(),
                           toolsCommit=run['toolsCommit'], build=run['build'],
                           exitStatus=int((path / 'exit-status').read_text()),
                           serialSHA256=hashlib.sha256((path / 'serial.txt').read_bytes()).hexdigest(),
                           bulkSHA256=hashlib.sha256((path / 'gt710-pixels.rle').read_bytes()).hexdigest())
            captures.append(capture)
            print(f'boot {capture["id"]} commit={capture["commit"]} '
                  f'toolsCommit={capture["toolsCommit"]} build.commit={capture["build"]["commit"]} '
                  f'profile={capture["build"]["profile"]} exit={capture["exitStatus"]}', flush=True)
        for name, result in checks.items():
            print(f'{name} {result}', flush=True)
        print(f'console handoff-to-done ms={producer["console_ms"]} '
              f'startup-window ready=true irq_masked_max_us={producer["startup_irq_masked_max_us"]}', flush=True)
        gpu_ms = core_producer(producer['serial'], dict(commit=producer['commit']), producer['boot'])
        print(f'GPU producer {producer["boot"]["id"]} elapsed_ms={gpu_ms}', flush=True)
        proof = dict(commit=producer['commit'], retainedCommit=sha, passed=passed,
                     producerBoot=producer['boot']['id'], gpuElapsedMS=gpu_ms,
                     boots=captures, coreChecks=checks,
                     consoleHandoffToDoneMS=producer['console_ms'],
                     startupIRQMaskedMaxUS=producer['startup_irq_masked_max_us'],
                     milestones=verdict['milestones'])
        (directory / 'acceptance.json').write_text(json.dumps(proof, indent=2) + '\n')

    return passed


def main():
    import argparse
    import json
    from pathlib import Path
    import runpy
    import sys
    parser = argparse.ArgumentParser(description='Score E19 firmware and PCI-device cases from a completed metal boot')
    parser.add_argument('--check-manifest', type=Path)
    parser.add_argument('--boot')
    parser.add_argument('--sha')
    parser.add_argument('--gpu-boot', help='completed companion GPU-only suite boot for core/producer')
    parser.add_argument('--resources', action='store_true', help='score PR 8.2 from this console boot and --gpu-boot; retain core/* separately')
    parser.add_argument('--isolation', action='store_true', help='score PR 8.5 isolation and preceding selections from the same captures')
    parser.add_argument('--shapes', action='store_true', help='score PR 8.4 shapes and preceding selections from the same captures')
    parser.add_argument('--alpha', action='store_true', help='score PR 8.3 alpha/suite and the unchanged PR 8.2 resources rows from the same captures')
    parser.add_argument('--acceptance-directory', type=Path, help='score a locally retained console capture and its resources-producer at the current PR head')
    parser.add_argument('--pr', type=int, help='open PR whose live head must match --sha for local alpha acceptance')
    parser.add_argument('--core-boot', help='completed --gt710-category core diagnostic boot for row/dispatch')
    args = parser.parse_args()
    if args.check_manifest:
        validate_manifest(json.loads(args.check_manifest.read_text()))
        return 0
    if args.acceptance_directory:
        import subprocess
        root = Path(__file__).resolve().parents[2]
        if not (args.alpha or args.shapes or args.isolation) or not args.pr or not re.fullmatch('[a-f0-9]{40}', args.sha or ''):
            parser.error('--acceptance-directory requires --alpha, --shapes or --isolation, --pr and --sha')
        if (subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip() != args.sha
                or subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=no'], cwd=root, text=True).strip()):
            raise ValueError('alpha scorer must run from the clean requested head')
        def current_pr():
            return json.loads(subprocess.check_output(['gh', 'pr', 'view', str(args.pr), '--json',
                'number,state,headRefOid,headRefName,url'], cwd=root, text=True))
        proof = dict(head=args.sha, passed=False)
        try:
            pr = current_pr()
            proof = alpha_acceptance(args.acceptance_directory, args.sha, pr, 'isolation' if args.isolation else 'shapes' if args.shapes else 'alpha')
            if current_pr() != pr:
                raise ValueError('PR head or state changed during acceptance scoring')
            for boot in proof['boots']:
                print(f'{boot["suite"]} boot={boot["id"]} capture={boot["commit"]} '
                      f'tools={boot["toolsCommit"]} build={boot["build"]["commit"]} '
                      f'profile={boot["build"]["profile"]} features={boot["build"]["features"]} '
                      f'exit={boot["exitStatus"]} reason={boot["exitReason"]} '
                      f'DONE={boot["done"]} memory={boot["memory"]} '
                      f'captureComplete={json.dumps(boot["captureComplete"])}')
            for check in proof['checks']:
                print(f'scorer {check["suite"]}/{check["category"]} '
                      f'PASS {check["count"]}/{check["count"]}: {check["reason"]}')
            print(f'PR #{pr["number"]} current head={pr["headRefOid"]}; '
                  f'console handoff-to-done={proof["consoleHandoffToDoneMS"]} ms; '
                  f'GPU elapsed={proof["gpuElapsedMS"]} ms; selected={proof["selected"]}; '
                  f'GT710 checks={sum(c["count"] for c in proof["checks"])} PASS')
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
            proof.update(passed=False, error=str(error))
            print('alpha acceptance FAIL: ' + str(error), flush=True)
        (args.acceptance_directory / 'acceptance.json').write_text(json.dumps(proof, indent=2) + '\n')
        if proof['passed']:
            print('acceptance proof=' + str(args.acceptance_directory / 'acceptance.json'), flush=True)
        return 0 if proof['passed'] else 1
    if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.boot or '') or not re.fullmatch('[a-f0-9]{40}', args.sha or ''):
        parser.error('--boot ID and --sha full commit required')
    runner = runpy.run_path(str(Path(__file__).with_name('metal-run')))
    env = runner['host_env']()
    directory = runner['STATE'] + '/boots/' + args.boot

    def read(name):
        result = runner['in_metal'](env, 'cat', directory + '/' + name, capture_output=True, text=True, check=True)
        return result.stdout

    boot = json.loads(read('run.json'))
    if (not read('ended').strip() or read('exit-status').strip() != '0' or read('dirty').strip() != '0'
            or read('commit').strip() != args.sha):
        raise ValueError('a completed, clean, successful boot of the requested commit is required')
    if any(json.loads(line).get('event') == 'console-gap' for line in read('events.jsonl').splitlines()):
        raise ValueError('capture has a console gap')
    if args.resources or args.alpha or args.shapes or args.isolation:
        if (args.core_boot or not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.gpu_boot or '')
                or args.gpu_boot == args.boot):
            parser.error('--resources needs a distinct --gpu-boot and no --core-boot')
        categories = ['resources', 'alpha', 'shapes', 'isolation'] if args.isolation else (['resources', 'alpha', 'shapes'] if args.shapes else (['resources', 'alpha'] if args.alpha else ['resources']))
        companion = runner['STATE'] + '/boots/' + args.gpu_boot
        runner['in_metal'](env, 'python3', '-c',
            'import sys,shutil;from pathlib import Path;'
            'p=Path(sys.argv[1]);q=Path(sys.argv[2]);d=p/"resources-producer";d.mkdir(exist_ok=True);'
            '[shutil.copyfile(q/n,d/n) for n in ("run.json","serial.txt","events.jsonl","ended","exit-status","dirty","commit","gt710-pixels.rle")];[(shutil.copyfile(q/n,d/n) if (q/n).is_file() else (d/n).unlink(missing_ok=True)) for n in ("gt710-final.rle","native-final-upload.json")]',
            directory, companion, check=True)
        result = runner['in_metal'](env, 'python3', '-c',
            'import runpy,sys;from pathlib import Path;'
            'p=Path(sys.argv[1]);a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
            'codes=[a["record_resources_capture"](p,sys.argv[2],c) for c in sys.argv[3].split(",")];'
            'sys.exit(1 if any(codes) else 0)', directory, args.sha, ','.join(categories))
        aggregate = runner['in_metal'](env, 'python3', '-c',
            'import sys,json;sys.path.insert(0,"/opt/breenix-metal");import metal_score,metal_lib as m;'
            'p=m.boot_dir(sys.argv[1]);v=metal_score.score(p);m.write_json(p/"milestone-verdict.json",v);'
            'rows=[(c,v["milestones"].get("metal-gt710/"+c,{})) for c in sys.argv[2].split(",")];'
            'passed=v.get("captureComplete") is True and all(r.get("passed") is True and '
            'r.get("reached")==r.get("total")==({"resources":3,"alpha":1,"shapes":1,"isolation":1}[c]) for c,r in rows);'
            '[print("metal-gt710/"+c,r,flush=True) for c,r in rows];'
            '\nwith m.locked("finished"):\n entries=[json.loads(l) for l in (m.STATE/"finished.jsonl").read_text().splitlines()];'
            'm.append_jsonl(m.STATE/"finished.jsonl",dict(id=p.name,seq=max(e["seq"] for e in entries)+1))'
            '\nsys.exit(0 if passed else 1)', args.boot, ','.join(categories))
        return 0 if result.returncode == aggregate.returncode == 0 else 1
    if args.core_boot:
        if (not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.core_boot)
                or args.core_boot in (args.boot, args.gpu_boot)):
            parser.error('--core-boot must name a distinct metal boot')
        diagnostic = runner['STATE'] + '/boots/' + args.core_boot
        runner['in_metal'](env, 'python3', '-c',
            'import runpy,sys,shutil;from pathlib import Path;'
            'p=Path(sys.argv[1]);q=Path(sys.argv[2]);a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
            'a["core_diagnostic_capture"](q,sys.argv[3]);d=p/"core-diagnostic";d.mkdir(exist_ok=True);'
            '[shutil.copyfile(q/n,d/n) for n in ("run.json","serial.txt","events.jsonl","ended","exit-status","dirty","commit","gt710-pixels.rle")];[(shutil.copyfile(q/n,d/n) if (q/n).is_file() else (d/n).unlink(missing_ok=True)) for n in ("gt710-final.rle","native-final-upload.json")] ',
            directory, diagnostic, args.sha, check=True)
    if args.gpu_boot:
        if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.gpu_boot) or args.gpu_boot == args.boot:
            parser.error('--gpu-boot must name a distinct metal boot')
        companion = runner['STATE'] + '/boots/' + args.gpu_boot
        runner['in_metal'](env, 'python3', '-c',
            'import runpy,sys,shutil;from pathlib import Path;'
            'p=Path(sys.argv[1]);q=Path(sys.argv[2]);a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
            'a["core_producer_capture"](q,sys.argv[3]);d=p/"core-producer";d.mkdir(exist_ok=True);'
            '[shutil.copyfile(q/n,d/n) for n in ("run.json","serial.txt","events.jsonl","ended","exit-status","dirty","commit","gt710-pixels.rle")];[(shutil.copyfile(q/n,d/n) if (q/n).is_file() else (d/n).unlink(missing_ok=True)) for n in ("gt710-final.rle","native-final-upload.json")]',
            directory, companion, args.sha, check=True)
    result = runner['in_metal'](env, 'python3', '-c',
        'import runpy,sys;from pathlib import Path;'
        'p=Path(sys.argv[1]);a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
        'sys.exit(a["record_capture"](p,sys.argv[2]))', directory, args.sha)
    passed = result.returncode == 0
    # Rescore the retained facts, without executing another boot or suite.
    aggregate = runner['in_metal'](env, 'python3', '-c',
        'import sys,json;sys.path.insert(0,"/opt/breenix-metal");import metal_score,metal_lib as m;'
        'import runpy;p=m.boot_dir(sys.argv[1]);v=metal_score.score(p);'
        'm.write_json(p/"milestone-verdict.json",v);'
        'a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
        'passed=a["acceptance_status"](p,v);'
        '\nwith m.locked("finished"):\n entries=[json.loads(l) for l in (m.STATE/"finished.jsonl").read_text().splitlines()];'
        'm.append_jsonl(m.STATE/"finished.jsonl",dict(id=p.name,seq=max(e["seq"] for e in entries)+1))'
        '\nsys.exit(0 if passed else 1)',
        args.boot)
    return 0 if passed and aggregate.returncode == 0 else 1


