            need(c['class_id'] == 0xa197, 'graphics class')
            # MIT nouveau subdev/top/gk104.c: ENUM carries engine/runlist;
            # terminal ENGINE_TYPE 0 is GR, whereas 1/2/3 are CE engines.
            need(len(c['top']) == 64 and 0 <= c['engine'] < 16 and 0 <= c['runlist'] < 16, 'GR runlist inventory')
            found = False
