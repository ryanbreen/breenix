BDF = r'[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]'
HEX = r'0x[0-9a-f]+'
FB = (r'\[fbcon\] framebuffer in display BAR: (\d+)x(\d+) (Rgb|Bgr) ([34]) bytes/pixel stride (\d+) at (' + HEX + r') length (\d+), (' + BDF + r') ([0-9a-f]{4}:[0-9a-f]{4}) class 03/[0-9a-f]{2} BAR([0-5]) (' + HEX + r')/(' + HEX + r') prefetchable$')


def one(pattern, serial, why):
    matches = list(pattern.finditer(serial) if hasattr(pattern, 'finditer') else re.finditer(pattern, serial, re.M))
    if len(matches) != 1:
        raise ValueError(why + ': expected one record, got ' + str(len(matches)))
    return matches[0]


def framebuffer(serial):
    m = one(FB, serial, 'firmware framebuffer description')
    width, height, fmt, bpp, stride, base, size, bdf, ident, index, bar, span = m.groups()
    return dict(width=int(width), height=int(height), fmt=fmt, bpp=int(bpp), stride=int(stride),
                base=int(base, 16), size=int(size), bdf=bdf, ident=ident, index=int(index),
                bar=int(bar, 16), span=int(span, 16))


def pci(serial):
    m = one(r'^PCI_FN (' + BDF + r') 10de:128b class=03/00 bar0=(' + HEX + r')/(' + HEX + r') irq=(' + HEX + r')$', serial, 'GT 710 PCI function')
    return m[1], int(m[2], 16), int(m[3], 16), int(m[4], 16)


def edid_timings(raw):
    if (len(raw) < 128 or raw[:8] != bytes([0,255,255,255,255,255,255,0])
            or raw[18] != 1 or raw[19] not in (3,4) or not raw[20] & 128
            or raw[126] > 3 or len(raw) != 128 * (raw[126] + 1)
            or any(sum(raw[i:i+128]) % 256 for i in range(0,len(raw),128))):
        raise ValueError('incomplete or corrupt digital EDID')
    timings = []
    def detailed(d):
        clock = int.from_bytes(d[:2], 'little') * 10
        if not clock:
            return
        w, h = d[2] + ((d[4] & 240) << 4), d[5] + ((d[7] & 240) << 4)
        hb, vb = d[3] + ((d[4] & 15) << 8), d[6] + ((d[7] & 15) << 8)
        hs, hw = d[8] + ((d[11] & 192) << 2), d[9] + ((d[11] & 48) << 4)
        vs, vw = (d[10] >> 4) + ((d[11] & 12) << 2), (d[10] & 15) + ((d[11] & 3) << 4)
        if min(w,h,hs,hw,vs,vw) <= 0 or hs+hw > hb or vs+vw > vb:
            raise ValueError('invalid EDID detailed timing')
        if d[17] & 152 == 24:
            timings.append(dict(width=w,height=h,clock_khz=clock,hsync_start=w+hs,
                                hsync_end=w+hs+hw,htotal=w+hb,vsync_start=h+vs,
                                vsync_end=h+vs+vw,vtotal=h+vb,flags=d[17]))
    for i in range(54,126,18):
        detailed(raw[i:i+18])
    if any(raw[i:i+2] == bytes([129,0]) for i in range(38,54,2)):
        timings.append(dict(width=1280,height=800,clock_khz=83500,hsync_start=1352,
                            hsync_end=1480,htotal=1680,vsync_start=803,vsync_end=809,vtotal=831,flags=28))
    # E-EDID A2 table 3.18 p.30; DMT 1.13 p.33, ID 10h / standard 61 40.
    if raw[36] & 8 or any(raw[i:i+2] == bytes([97,64]) for i in range(38,54,2)):
        timing = dict(width=1024,height=768,clock_khz=65000,hsync_start=1048,
                      hsync_end=1184,htotal=1344,vsync_start=771,vsync_end=777,vtotal=806,flags=24)
        if timing not in timings:
            timings.append(timing)
    for i in range(128,len(raw),128):
        b = raw[i:i+128]
        if b[0] == 2 and b[2]:
            if not 4 <= b[2] <= 127:
                raise ValueError('CTA timing offset outside block')
            for offset in range(b[2],110,18):
                detailed(b[offset:offset+18])
    return timings


def board_inventory(serial):
    bdf, _, _, _ = pci(serial)
    m = one(r'^GT710_NATIVE (.+)$', serial, 'native board evidence')
    try:
        e = json.loads(m[1])
        raw = bytes.fromhex(e['edid'])
        timings = edid_timings(raw)
        integers = ('boot0','chipset','revision','post','rom_bytes','bit_version','dcb_version',
                    'i2c_version','connector_version','pll_version','dcb_entry','dcb_conf','i2c_entry',
                    'connector','connector_type','drive','sor','sor_state','head','head_total','head_clock')
        if any(type(e[k]) is not int or not 0 <= e[k] <= 0xffffffff for k in integers):
            raise ValueError('invalid integer evidence')
        entry, state = e['dcb_entry'], e['sor_state']
        i2c = e['i2c_entry']
        legacy = e['i2c_version'] in (0x30, 0x40)
        drive = i2c & (15 if legacy else 31)
        if (e['schema'] != 1 or e['phase'] != 'board' or e['bdf'] != bdf or e['ddc'] != 'live'
                or e['chipset'] != 0x106 or (e['boot0'] >> 20) & 511 != e['chipset']
                or e['revision'] != e['boot0'] & 255 or not e['post'] & 2
                or not 512 <= e['rom_bytes'] <= 256*1024 or e['rom_bytes'] % 512
                or not re.fullmatch('[0-9a-f]{64}',e['rom_sha256'])
                or e['bit_version'] != 0x100 or e['dcb_version'] not in (0x40,0x41)
                or e['i2c_version'] not in (0x30,0x40,0x41)
                or (legacy and i2c >> 24 != 5) or e['connector_version'] not in (0x30,0x40)
                or e['pll_version'] not in (0x30,0x40,0x50)
                or entry & 15 != 2 or entry & 0x00300000
                or e['connector'] != (entry >> 12) & 15 or e['connector_type'] not in (0x30,0x31,0x60,0x61)
                or e['drive'] != drive or e['drive'] == 31
                or not 0 <= e['sor'] < 4 or (entry >> 24) & 15 != 1 << e['sor']
                or not 0 <= e['head'] < 4 or state & 15 != 1 << e['head']
                or not entry & (1 << (e['head']+8)) or (state >> 8) & 15 not in (1,2,5)
                or not e['dcb_conf'] & 48 or not e['head_total'] & 65535
                or not e['head_total'] >> 16 or not e['head_clock']
                or e['edid_sha256'] != hashlib.sha256(raw).hexdigest()):
            raise ValueError('board identity, route, POST, active state or EDID provenance mismatch')
        selected = e['modes']
        # G3: the attached monitor supplies the modes, including its first DTD.
        preferred = raw[54:72]
        if (not selected or selected != list({tuple(t.items()): t for t in timings}.values())
                or selected[0]['clock_khz'] != int.from_bytes(preferred[:2], 'little') * 10
                or selected[0]['width'] != preferred[2] + ((preferred[4] & 240) << 4)
                or selected[0]['height'] != preferred[5] + ((preferred[7] & 240) << 4)):
            raise ValueError('complete decoded timings including the preferred DTD must match this live sink')
    except (KeyError,TypeError,IndexError,json.JSONDecodeError) as error:
        raise ValueError('malformed native board evidence') from error
    for group in ('firmware','device'):
        for name, _ in CATEGORIES[group]:
            check_case(group,name,serial)
    return e


def display_memory(serial):
    bdf, _, _, _ = pci(serial)
    e = json.loads(one(r'^GT710_MEMORY (.+)$', serial, 'display memory evidence')[1])
    integer = lambda v: type(v) is int and 0 <= v <= (1 << 40)
    def require(ok, why):
        if not ok:
            raise ValueError(why)
    require(e['schema'] == 1 and e['phase'] == 'memory' and e['bdf'] == bdf, 'memory identity mismatch')
    total, aperture = e['total'], e['aperture']
    require(integer(total) and integer(aperture) and (32 << 20) <= total <= (1 << 32)
            and (16 << 20) <= aperture < total and aperture & (aperture-1) == 0, 'invalid memory sizes')
    require(framebuffer(serial)['span'] == aperture, 'BAR aperture differs from PCI ownership')
    pairs = e['registers']
    require(isinstance(pairs,list) and len(pairs) <= 41 and all(len(p)==2 and all(integer(v) for v in p) for p in pairs), 'invalid register evidence')
    regs = dict(pairs)
    require(len(regs) == len(pairs), 'duplicate register evidence')
    fbps, disabled = regs[0x22438], regs[0x22554]
    require(1 <= fbps <= 8, 'invalid partition count')
    fbpat = regs[0x2243c]
    require(fbps <= fbpat <= 16 and fbpat % fbps == 0, 'invalid FBPA topology')
    units = fbpat // fbps
    amounts = []
    for fbp in range(fbps):
        part = 0
        for unit in range(fbp*units,(fbp+1)*units):
            if disabled & (1 << unit):
                continue
            mib = regs[0x11020c+unit*4096]
            require(0 < mib <= 4096, 'invalid FBPA capacity')
            part += mib
        if part:
            amounts.append(part)
    require(amounts and len(set(amounts)) == 1 and sum(amounts) << 20 == total, 'VRAM inventory mismatch')
    refs = e['references']
    require(isinstance(refs,list) and len(refs) <= 4096, 'missing inherited references')
    require(all(len(r)==2 and all(integer(v) for v in r) and r[0] % 4096 == 0
                and 0 < r[1] <= (1 << 20) and r[1] % 4096 == 0 and sum(r) <= total for r in refs), 'invalid inherited reference')
    disp = regs[0x610010]
    require(disp in (0,1) or (disp & 15 == 9 and [(disp & ~255) << 8,65536] in refs), 'missing display instance reservation')
    for reg in (0x1704,0x1714):
        control = regs[reg]
        require(not control & 0x80000000 or [(control & 0x0fffffff) << 12,4096] in refs, 'missing BAR instance reservation')
    for i in range(9):
        require(disp != 0 or regs[0x610490+i*16] & 3 == 0, 'active display channel without a known instance')
        require(disp != 1 or regs[0x610490+i*16] & 0x80000010 == 0, 'opaque POST channel has DMA enabled or activation busy')
        push = regs[0x610494+i*16]
        require(not push or push & 3 in (1,2,3), 'invalid inherited push target')
        require(push & 3 != 1 or [(push & ~3) << 8,4096] in refs, 'missing inherited push reservation')
    require(not any(r[0] < aperture < sum(r) for r in refs), 'inherited object straddles reservation boundary')
    upper = min([total-(1 << 20)]+[r[0] for r in refs if r[0] >= aperture])
    require(e['reserved'] == [[0,aperture],[upper,total-upper]] and upper > aperture, 'reservation envelope mismatch')
    require(integer(e['seed']) and 0 < e['seed'] <= 0xffffffff, 'invalid nonce seed')
    require(integer(e['pramin_before']) and e['pramin_before'] == e['pramin_after'], 'PRAMIN control changed')
    snapshots = set(map(tuple, refs)) | {(0,256 << 10),(total-(1 << 20),1 << 20)}
    require(e['protected_bytes'] == sum(r[1] for r in snapshots), 'incomplete protected storage snapshot')
    for prefix in ('protected','guard'):
        require(re.fullmatch('[0-9a-f]{64}',e[prefix+'_before']) and e[prefix+'_before'] == e[prefix+'_after'], prefix+' storage changed')
    w,h = e['width'],e['height']
    require(integer(w) and integer(h) and 0 < w <= 8192 and 0 < h <= 8192, 'invalid scanout geometry')
    preferred = board_inventory(serial)['modes'][0]
    require((w,h) == (preferred['width'],preferred['height']), 'scanouts differ from the live sink preferred timing')
    pitch = (w*4+255) & ~255
    size = (pitch*h+4095) & ~4095
    require(e['pitch'] == pitch, 'invalid scanout pitch')
    specs = [('scanout-a',size,65536),('scanout-b',size,65536),('evo',4096,4096),
             ('notifier',4096,4096),('instance',65536,65536),('dma',4096,4096)]
    objects = e['objects']
    require(isinstance(objects,list) and len(objects)==len(specs), 'missing display allocations')
    occupied = [(0,aperture),(upper,total-upper)]
    import struct
    cursor = 4096
    for o,(name,length,align) in zip(objects,specs):
        require(o['name']==name and o['size']==length and o['align']==align and integer(o['start']), 'object geometry mismatch')
        while True:
            start = (cursor+align-1) & -align
            lo,hi = start-4096,start+length+4096
            overlaps = [a+b for a,b in occupied if a < hi and lo < a+b]
            if not overlaps:
                break
            cursor = max(overlaps)+4096
        require(o['start']==start and hi<=total, 'overlapping, unaligned or reserved allocation')
        occupied.append((lo,hi-lo))
        cursor = hi+4096
        expected = []
        for phase in range(2):
            digest = hashlib.sha256()
            for offset in range(start,start+length,65536):
                data = b''.join(struct.pack('<I',((a//4)*0x9e3779b1 ^ e['seed'] ^ (0xffffffff if phase else 0)) & 0xffffffff)
                                for a in range(offset,min(offset+65536,start+length),4))
                digest.update(data)
            expected.append(digest.hexdigest())
        require(o['sha256']==expected, 'complete complementary physical read-back mismatch')
    require(e['guard_bytes']==12*4096 and e['verified_bytes']==2*sum(s[1] for s in specs), 'short guard or allocation read-back')
    return e


def memory_inventory(serial):
    """M5.1 CPU evidence; no engine or permission verdict is derived here."""
    try:
        m=display_memory(serial)
        e=json.loads(one(r'^GT710_VRAM (.+)$',serial,'VRAM inventory evidence')[1])
        def need(ok,why):
            if not ok:raise ValueError(why)
        need(e['schema']==1 and e['phase']=='inventory' and e['bdf']==m['bdf']
             and e['total']==m['total'] and e['aperture']==m['aperture'], 'inventory differs from discovered hardware')
        total=m['total'];reserved=sum(r[1] for r in m['reserved'])
        payload=sum(o['size'] for o in m['objects'])
        baseline=dict(reserved=reserved,payload=payload,guards=49152,charged=payload+49152,
                      display=payload,engine=0,probe=0,free=total-reserved-payload-49152,allocations=6)
        need(e['baseline']==baseline and e['after']==baseline,'VRAM charges or reclamation differ')
        occupied=[(r[0],sum(r)) for r in m['reserved']]
        occupied += [(o['start']-4096,o['start']+o['size']+4096) for o in m['objects']]
        need(type(e['scratch']) is list and len(e['scratch'])==2,'missing scratch allocations')
        for r,size in zip(e['scratch']+[e['tables']],[(1<<20)+4096,12288,65536]):
            need(type(r) is list and len(r)==2 and all(type(v) is int for v in r)
                 and r[1]==size and r[0]%4096==0 and 4096<=r[0] and sum(r)+4096<=total,'invalid scratch extent')
            lo,hi=r[0]-4096,sum(r)+4096
            need(not any(a<hi and lo<b for a,b in occupied),'allocation aliases retained storage')
            occupied.append((lo,hi))
        peak=dict(baseline)
        peak.update(engine=65536,probe=sum(r[1] for r in e['scratch']),allocations=9)
        peak['payload']+=peak['engine']+peak['probe'];peak['guards']+=24576
        peak['charged']=peak['payload']+peak['guards'];peak['free']=total-reserved-peak['charged']
