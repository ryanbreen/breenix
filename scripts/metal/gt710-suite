#!/usr/bin/env python3
"""E19's firmware and PCI-display cases, judged from a boot's retained capture."""
import re
import hashlib
import json
from pathlib import Path
import runpy
import tempfile

CATEGORIES = {
    'memory': (
        ('carveout', 'Private display allocations preserve inherited VRAM and pass complete complementary physical read-back without aliasing'),
    ),
    'board': (
        ('inventory', 'Live board tables, POST and active TMDS routing identify the attached DDC sink and its preferred timing'),
    ),
    'firmware': (
        ('mode', 'The firmware framebuffer report gives its mode, pixel format, pitch, base and mapped size'),
        ('owner', 'The whole firmware framebuffer lies in the reported GT 710 memory BAR, not the embedded display'),
    ),
    'console': (
        ('acceptance', 'The same GT 710 capture passes firmware ownership, display claim, screen read-back and the complete E16 console suite'),
    ),
    'device': (
        ('identity', 'The PCI report identifies 10de:128b with subsystem 1462:8c93 and its interrupt line'),
        ('bars-link', 'The PCI report lists the display BARs and the negotiated PCIe link from its capability registers'),
        ('claimed', 'Display discovery and the firmware framebuffer claim name the same GT 710 function'),
    ),
}
BDF = r'[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]'
HEX = r'0x[0-9a-f]+'
FB = (r'\[fbcon\] framebuffer in display BAR: (\d+)x(\d+) (Rgb|Bgr) ([34]) bytes/pixel stride (\d+) at (' + HEX + r') length (\d+), (' + BDF + r') ([0-9a-f]{4}:[0-9a-f]{4}) class 03/[0-9a-f]{2} BAR([0-5]) (' + HEX + r')/(' + HEX + r') prefetchable$')


def one(pattern, serial, why):
    matches = list(pattern.finditer(serial) if hasattr(pattern, 'finditer') else re.finditer(pattern, serial, re.M))
    if len(matches) != 1:
        raise ValueError(why + ': expected one record, got ' + str(len(matches)))
    return matches[0]


def framebuffer(serial):
    m = one(FB, serial, 'firmware framebuffer description')
    width, height, fmt, bpp, stride, base, size, bdf, ident, index, bar, span = m.groups()
    return dict(width=int(width), height=int(height), fmt=fmt, bpp=int(bpp), stride=int(stride),
                base=int(base, 16), size=int(size), bdf=bdf, ident=ident, index=int(index),
                bar=int(bar, 16), span=int(span, 16))


def pci(serial):
    m = one(r'^PCI_FN (' + BDF + r') 10de:128b class=03/00 bar0=(' + HEX + r')/(' + HEX + r') irq=(' + HEX + r')$', serial, 'GT 710 PCI function')
    return m[1], int(m[2], 16), int(m[3], 16), int(m[4], 16)


def edid_timings(raw):
    if (len(raw) < 128 or raw[:8] != bytes([0,255,255,255,255,255,255,0])
            or raw[18] != 1 or raw[19] not in (3,4) or not raw[20] & 128
            or raw[126] > 3 or len(raw) != 128 * (raw[126] + 1)
            or any(sum(raw[i:i+128]) % 256 for i in range(0,len(raw),128))):
        raise ValueError('incomplete or corrupt digital EDID')
    timings = []
    def detailed(d):
        clock = int.from_bytes(d[:2], 'little') * 10
        if not clock:
            return
        w, h = d[2] + ((d[4] & 240) << 4), d[5] + ((d[7] & 240) << 4)
        hb, vb = d[3] + ((d[4] & 15) << 8), d[6] + ((d[7] & 15) << 8)
        hs, hw = d[8] + ((d[11] & 192) << 2), d[9] + ((d[11] & 48) << 4)
        vs, vw = (d[10] >> 4) + ((d[11] & 12) << 2), (d[10] & 15) + ((d[11] & 3) << 4)
        if min(w,h,hs,hw,vs,vw) <= 0 or hs+hw > hb or vs+vw > vb:
            raise ValueError('invalid EDID detailed timing')
        if d[17] & 152 == 24:
            timings.append(dict(width=w,height=h,clock_khz=clock,hsync_start=w+hs,
                                hsync_end=w+hs+hw,htotal=w+hb,vsync_start=h+vs,
                                vsync_end=h+vs+vw,vtotal=h+vb,flags=d[17]))
    for i in range(54,126,18):
        detailed(raw[i:i+18])
    if any(raw[i:i+2] == bytes([129,0]) for i in range(38,54,2)):
        timings.append(dict(width=1280,height=800,clock_khz=83500,hsync_start=1352,
                            hsync_end=1480,htotal=1680,vsync_start=803,vsync_end=809,vtotal=831,flags=28))
    for i in range(128,len(raw),128):
        b = raw[i:i+128]
        if b[0] == 2 and b[2]:
            if not 4 <= b[2] <= 127:
                raise ValueError('CTA timing offset outside block')
            for offset in range(b[2],110,18):
                detailed(b[offset:offset+18])
    return timings


def board_inventory(serial):
    bdf, _, _, _ = pci(serial)
    m = one(r'^GT710_NATIVE (.+)$', serial, 'native board evidence')
    try:
        e = json.loads(m[1])
        raw = bytes.fromhex(e['edid'])
        timings = edid_timings(raw)
        integers = ('boot0','chipset','revision','post','rom_bytes','bit_version','dcb_version',
                    'i2c_version','connector_version','pll_version','dcb_entry','dcb_conf','i2c_entry',
                    'connector','connector_type','drive','sor','sor_state','head','head_total','head_clock')
        if any(type(e[k]) is not int or not 0 <= e[k] <= 0xffffffff for k in integers):
            raise ValueError('invalid integer evidence')
        entry, state = e['dcb_entry'], e['sor_state']
        i2c = e['i2c_entry']
        legacy = e['i2c_version'] in (0x30, 0x40)
        drive = i2c & (15 if legacy else 31)
        if (e['schema'] != 1 or e['phase'] != 'board' or e['bdf'] != bdf or e['ddc'] != 'live'
                or e['chipset'] != 0x106 or (e['boot0'] >> 20) & 511 != e['chipset']
                or e['revision'] != e['boot0'] & 255 or not e['post'] & 2
                or not 512 <= e['rom_bytes'] <= 256*1024 or e['rom_bytes'] % 512
                or not re.fullmatch('[0-9a-f]{64}',e['rom_sha256'])
                or e['bit_version'] != 0x100 or e['dcb_version'] not in (0x40,0x41)
                or e['i2c_version'] not in (0x30,0x40,0x41)
                or (legacy and i2c >> 24 != 5) or e['connector_version'] not in (0x30,0x40)
                or e['pll_version'] not in (0x30,0x40,0x50)
                or entry & 15 != 2 or entry & 0x00300000
                or e['connector'] != (entry >> 12) & 15 or e['connector_type'] not in (0x30,0x31,0x60,0x61)
                or e['drive'] != drive or e['drive'] == 31
                or not 0 <= e['sor'] < 4 or (entry >> 24) & 15 != 1 << e['sor']
                or not 0 <= e['head'] < 4 or state & 15 != 1 << e['head']
                or not entry & (1 << (e['head']+8)) or (state >> 8) & 15 not in (1,2,5)
                or not e['dcb_conf'] & 48 or not e['head_total'] & 65535
                or not e['head_total'] >> 16 or not e['head_clock']
                or e['edid_sha256'] != hashlib.sha256(raw).hexdigest()):
            raise ValueError('board identity, route, POST, active state or EDID provenance mismatch')
        selected = e['modes']
        # G3: the attached monitor supplies the modes, including its first DTD.
        preferred = raw[54:72]
        if (not selected or selected != list({tuple(t.items()): t for t in timings}.values())
                or selected[0]['clock_khz'] != int.from_bytes(preferred[:2], 'little') * 10
                or selected[0]['width'] != preferred[2] + ((preferred[4] & 240) << 4)
                or selected[0]['height'] != preferred[5] + ((preferred[7] & 240) << 4)):
            raise ValueError('complete decoded timings including the preferred DTD must match this live sink')
    except (KeyError,TypeError,IndexError,json.JSONDecodeError) as error:
        raise ValueError('malformed native board evidence') from error
    for group in ('firmware','device'):
        for name, _ in CATEGORIES[group]:
            check_case(group,name,serial)
    return e


def display_memory(serial):
    bdf, _, _, _ = pci(serial)
    e = json.loads(one(r'^GT710_MEMORY (.+)$', serial, 'display memory evidence')[1])
    integer = lambda v: type(v) is int and 0 <= v <= (1 << 40)
    def require(ok, why):
        if not ok:
            raise ValueError(why)
    require(e['schema'] == 1 and e['phase'] == 'memory' and e['bdf'] == bdf, 'memory identity mismatch')
    total, aperture = e['total'], e['aperture']
    require(integer(total) and integer(aperture) and (32 << 20) <= total <= (1 << 32)
            and (16 << 20) <= aperture < total and aperture & (aperture-1) == 0, 'invalid memory sizes')
    require(framebuffer(serial)['span'] == aperture, 'BAR aperture differs from PCI ownership')
    pairs = e['registers']
    require(isinstance(pairs,list) and len(pairs) <= 41 and all(len(p)==2 and all(integer(v) for v in p) for p in pairs), 'invalid register evidence')
    regs = dict(pairs)
    require(len(regs) == len(pairs), 'duplicate register evidence')
    fbps, disabled = regs[0x22438], regs[0x22554]
    require(1 <= fbps <= 8, 'invalid partition count')
    fbpat = regs[0x2243c]
    require(fbps <= fbpat <= 16 and fbpat % fbps == 0, 'invalid FBPA topology')
    units = fbpat // fbps
    amounts = []
    for fbp in range(fbps):
        part = 0
        for unit in range(fbp*units,(fbp+1)*units):
            if disabled & (1 << unit):
                continue
            mib = regs[0x11020c+unit*4096]
            require(0 < mib <= 4096, 'invalid FBPA capacity')
            part += mib
        if part:
            amounts.append(part)
    require(amounts and len(set(amounts)) == 1 and sum(amounts) << 20 == total, 'VRAM inventory mismatch')
    refs = e['references']
    require(isinstance(refs,list) and len(refs) <= 4096, 'missing inherited references')
    require(all(len(r)==2 and all(integer(v) for v in r) and r[0] > 0 and r[0] % 4096 == 0
                and 0 < r[1] <= (1 << 20) and r[1] % 4096 == 0 and sum(r) <= total for r in refs), 'invalid inherited reference')
    disp = regs[0x610010]
    require(disp in (0,1) or (disp & 15 == 9 and [(disp & ~255) << 8,65536] in refs), 'missing display instance reservation')
    for reg in (0x1704,0x1714):
        control = regs[reg]
        require(not control & 0x80000000 or [(control & 0x0fffffff) << 12,4096] in refs, 'missing BAR instance reservation')
    for i in range(9):
        require(disp != 0 or regs[0x610490+i*16] & 3 == 0, 'active display channel without a known instance')
        require(disp != 1 or regs[0x610490+i*16] == 0, 'opaque POST channel is not idle')
        push = regs[0x610494+i*16]
        require(not push or push & 3 in (1,2,3), 'invalid inherited push target')
        require(push & 3 != 1 or [(push & ~3) << 8,4096] in refs, 'missing inherited push reservation')
    require(not any(r[0] < aperture < sum(r) for r in refs), 'inherited object straddles reservation boundary')
    upper = min([total-(1 << 20)]+[r[0] for r in refs if r[0] >= aperture])
    require(e['reserved'] == [[0,aperture],[upper,total-upper]] and upper > aperture, 'reservation envelope mismatch')
    require(integer(e['seed']) and 0 < e['seed'] <= 0xffffffff, 'invalid nonce seed')
    require(integer(e['pramin_before']) and e['pramin_before'] == e['pramin_after'], 'PRAMIN control changed')
    snapshots = set(map(tuple, refs)) | {(0,256 << 10),(total-(1 << 20),1 << 20)}
    require(e['protected_bytes'] == sum(r[1] for r in snapshots), 'incomplete protected storage snapshot')
    for prefix in ('protected','guard'):
        require(re.fullmatch('[0-9a-f]{64}',e[prefix+'_before']) and e[prefix+'_before'] == e[prefix+'_after'], prefix+' storage changed')
    w,h = e['width'],e['height']
    require(integer(w) and integer(h) and 0 < w <= 8192 and 0 < h <= 8192, 'invalid scanout geometry')
    pitch = (w*4+255) & ~255
    size = (pitch*h+4095) & ~4095
    require(e['pitch'] == pitch, 'invalid scanout pitch')
    specs = [('scanout-a',size,65536),('scanout-b',size,65536),('evo',4096,4096),
             ('notifier',4096,4096),('instance',65536,65536),('dma',4096,4096)]
    objects = e['objects']
    require(isinstance(objects,list) and len(objects)==len(specs), 'missing display allocations')
    occupied = [(0,aperture),(upper,total-upper)]
    import struct
    cursor = 4096
    for o,(name,length,align) in zip(objects,specs):
        require(o['name']==name and o['size']==length and o['align']==align and integer(o['start']), 'object geometry mismatch')
        while True:
            start = (cursor+align-1) & -align
            lo,hi = start-4096,start+length+4096
            overlaps = [a+b for a,b in occupied if a < hi and lo < a+b]
            if not overlaps:
                break
            cursor = max(overlaps)+4096
        require(o['start']==start and hi<=total, 'overlapping, unaligned or reserved allocation')
        occupied.append((lo,hi-lo))
        cursor = hi+4096
        expected = []
        for phase in range(2):
            digest = hashlib.sha256()
            for offset in range(start,start+length,65536):
                data = b''.join(struct.pack('<I',((a//4)*0x9e3779b1 ^ e['seed'] ^ (0xffffffff if phase else 0)) & 0xffffffff)
                                for a in range(offset,min(offset+65536,start+length),4))
                digest.update(data)
            expected.append(digest.hexdigest())
        require(o['sha256']==expected, 'complete complementary physical read-back mismatch')
    require(e['guard_bytes']==12*4096 and e['verified_bytes']==2*sum(s[1] for s in specs), 'short guard or allocation read-back')
    return e


def check_case(category, case, serial):
    if category == 'memory':
        if case != 'carveout':
            raise ValueError('unknown memory case')
        try:
            display_memory(serial)
        except (KeyError, TypeError, OverflowError, IndexError, json.JSONDecodeError) as error:
            raise ValueError('malformed display memory evidence') from error
    elif category == 'board':
        if case != 'inventory':
            raise ValueError('unknown board case')
        board_inventory(serial)
    elif category == 'console':
        if case != 'acceptance':
            raise ValueError('unknown console case')
        for group in ('firmware', 'device'):
            for name, _ in CATEGORIES[group]:
                check_case(group, name, serial)
        if not re.search(r'\[fbcon\] screen read back identical: [1-9][0-9]* pixel rows, [1-9][0-9]* glyph cells match the font, sha256 [0-9a-f]{64}$', serial, re.M):
            raise ValueError('missing screen and font read-back')
        root = Path(__file__).resolve().parents[2]
        verdict = runpy.run_path(str(root / 'scripts/suite-verdict.py'))['verdict']
        manifest = json.loads((root / 'docs/suites/console.json').read_text())
        with tempfile.TemporaryDirectory() as tmp:
            capture = Path(tmp) / 'serial.txt'
            capture.write_text(serial)
            passed, reason = verdict(manifest, capture, [capture])
        if not passed:
            raise ValueError('E16 console: ' + reason)
    elif category == 'firmware':
        f = framebuffer(serial)
        if case == 'mode':
            if not (0 < f['width'] <= f['stride'] and f['height'] > 0 and f['base'] > 0
                    and f['size'] >= f['stride'] * f['height'] * f['bpp']):
                raise ValueError('framebuffer geometry or pitch exceeds the handed-off mapping')
        elif case == 'owner':
            bdf, _, _, _ = pci(serial)
            if not (f['ident'] == '10de:128b' and f['bdf'] == bdf
                    and f['bar'] <= f['base'] and f['base'] + f['size'] <= f['bar'] + f['span']):
                raise ValueError('firmware framebuffer is not wholly inside the GT 710 BAR')
            bar = one(r'^PCI_DISPLAY_BAR ' + bdf + r' index=' + str(f['index'])
                      + r' address=(' + HEX + r') size=(' + HEX + r') kind=mem prefetch=1 width=(32|64)$', serial, 'framebuffer PCI BAR')
            if (int(bar[1], 16), int(bar[2], 16)) != (f['bar'], f['span']):
                raise ValueError('framebuffer owner and PCI BAR census disagree')
        else:
            raise ValueError('unknown firmware case')
    elif category == 'device':
        bdf, bar0, size0, irq = pci(serial)
        if case == 'identity':
            m = one(r'^PCI_DISPLAY ' + bdf + r' subsystem=1462:8c93 irq=(' + HEX + r') pin=([0-4]) bars=([1-6])$', serial, 'GT 710 subsystem and interrupt')
            if int(m[1], 16) != irq:
                raise ValueError('PCI census and display interrupt line disagree')
        elif case == 'bars-link':
            m = one(r'^PCI_DISPLAY ' + bdf + r' subsystem=1462:8c93 irq=' + HEX + r' pin=[0-4] bars=([1-6])$', serial, 'display BAR count')
            bars = list(re.finditer(r'^PCI_DISPLAY_BAR ' + bdf + r' index=([0-5]) address=(' + HEX + r') size=(' + HEX + r') kind=(mem|io) prefetch=([01]) width=(32|64)$', serial, re.M))
            if len(bars) != int(m[1]) or len({b[1] for b in bars}) != len(bars):
                raise ValueError('missing or duplicated display BARs')
            if not any(b[1] == '0' and (int(b[2], 16), int(b[3], 16)) == (bar0, size0) for b in bars):
                raise ValueError('BAR0 differs from the PCI function census')
            for b in bars:
                if int(b[2], 16) == 0 or int(b[3], 16) == 0:
                    raise ValueError('display BAR is unassigned or has no measured extent')
            link = one(r'^PCI_DISPLAY_LINK ' + bdf + r' cap=(' + HEX + r') status=(' + HEX + r') speed=(\d+) width=(\d+) max_speed=(\d+) max_width=(\d+)$', serial, 'display PCIe link')
            cap, status = int(link[1], 16), int(link[2], 16)
            values = tuple(int(link[i]) for i in range(3, 7))
            if values != (status & 15, (status >> 4) & 63, cap & 15, (cap >> 4) & 63):
                raise ValueError('PCIe link fields differ from their raw registers')
            speed, width, max_speed, max_width = values
            if not (1 <= speed <= max_speed <= 7 and width in (1, 2, 4, 8, 12, 16, 32) and width <= max_width):
                raise ValueError('PCIe link is down or its reported parameters are invalid')
        elif case == 'claimed':
            one(r'\[devices\] display found: pci ' + bdf + r' \[10de:128b\] subclass 0x00$', serial, 'display class discovery')
            f = framebuffer(serial)
            one(r'\[devices\] display initialized: pci ' + bdf + r' \[10de:128b\] driver=firmware-framebuffer BAR' + str(f['index']) + r'$', serial, 'firmware display claim')
            if f['bdf'] != bdf:
                raise ValueError('claimed function does not own the console framebuffer')
        else:
            raise ValueError('unknown device case')
    else:
        raise ValueError('unknown category')


def cases(category, serial):
    results = []
    for name, title in CATEGORIES[category]:
        try:
            check_case(category, name, serial)
            result, reason = 'PASS', ''
        except ValueError as error:
            result, reason = 'FAIL', str(error)
        results.append(dict(id=category + '/' + name, title=title, result=result, reason=reason))
    return results


def validate_manifest(manifest):
    expected = [(cat, [(name, title) for name, title in entries]) for cat, entries in CATEGORIES.items()]
    actual = [(cat['id'], [(case['id'], case['title']) for case in cat['cases']]) for cat in manifest['categories']]
    if manifest.get('id') != 'gt710' or actual != expected:
        raise ValueError('GT 710 case table differs from its manifest')


def score(manifest, effort_path, records, serial, boot, sha, fatal_patterns):
    validate_manifest(manifest)
    category = records.get('milestone', '').removeprefix('metal-gt710/')
    if category not in CATEGORIES or records.get('milestone') != 'metal-gt710/' + category:
        raise ValueError('unknown GT 710 milestone')
    measures = [m['measure'] for e in effort_path['efforts'] if e['id'] == 'metal-gt710'
                for m in e['milestones'] if m['id'] == category]
    if measures != [dict(suite='gt710', categories=[category])]:
        raise ValueError('milestone must measure its complete populated category')
    if (not re.fullmatch('[0-9a-f]{40}', sha or '') or boot.get('toolsCommit') != sha
            or boot.get('platform') != 'metal' or boot.get('arch') != 'x86_64'
            or boot.get('evidenceEligible') is not True or boot.get('kind') not in ('boot', 'persistent')
            or boot.get('mode') not in ('default', 'console', 'suite', 'persistent')
            or boot.get('bootedCommit', sha) != sha):
        raise ValueError('GT 710 evidence needs this kernel and tools in an eligible metal boot')
    if records.get('boot') != boot.get('id') or records.get('commit') != sha:
        raise ValueError('GT 710 records belong to another boot or commit')
    if records.get('cases') != cases(category, serial):
        raise ValueError('GT 710 results differ from the captured evidence')
    if any(c['result'] != 'PASS' for c in records['cases']):
        raise ValueError('one or more ' + category + ' cases failed')
    if any(re.search(p, serial) for p in fatal_patterns):
        raise ValueError('fatal kernel output')
    return category + ': ' + str(len(CATEGORIES[category])) + ' cases passed'


def record_capture(directory, sha):
    """Recompute using the scorer and E16 files retained beside this capture."""
    directory = Path(directory)
    read = lambda name: json.loads((directory / name).read_text())
    boot = read('run.json')
    serial = (directory / 'serial.txt').read_text()
    manifest = read('definition/docs/suites/gt710.json')
    effort = read('definition/docs/efforts/metal.json')
    fatal = read('definition/docs/boot-path.json')['fatal'] + [r'KERNEL PANIC:']
    passed = True
    for category in CATEGORIES:
        if category == 'console' and (boot.get('mode') != 'suite' or boot.get('suite') != 'console'):
            continue
        records = dict(boot=boot['id'], commit=sha, milestone='metal-gt710/' + category,
                       cases=cases(category, serial))
        for c in records['cases']:
            print('SUITE gt710 CASE ' + c['id'] + ' ' + c['result'] + ' ms=0' + (' msg=' + c['reason'] if c['reason'] else ''), flush=True)
        try:
            score(manifest, effort, records, serial, boot, sha, fatal)
        except ValueError as error:
            passed = False
            print(str(error), flush=True)
        (directory / ('gt710-' + category + '.json')).write_text(json.dumps(records) + '\n')
    return 0 if passed else 1


def main():
    import argparse
    import json
    from pathlib import Path
    import runpy
    import sys
    parser = argparse.ArgumentParser(description='Score E19 firmware and PCI-device cases from a completed metal boot')
    parser.add_argument('--check-manifest', type=Path)
    parser.add_argument('--boot')
    parser.add_argument('--sha')
    args = parser.parse_args()
    if args.check_manifest:
        validate_manifest(json.loads(args.check_manifest.read_text()))
        return 0
    if not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.boot or '') or not re.fullmatch('[a-f0-9]{40}', args.sha or ''):
        parser.error('--boot ID and --sha full commit required')
    runner = runpy.run_path(str(Path(__file__).with_name('metal-run')))
    env = runner['host_env']()
    directory = runner['STATE'] + '/boots/' + args.boot

    def read(name):
        result = runner['in_metal'](env, 'cat', directory + '/' + name, capture_output=True, text=True, check=True)
        return result.stdout

    boot = json.loads(read('run.json'))
    if (not read('ended').strip() or read('exit-status').strip() != '0' or read('dirty').strip() != '0'
            or read('commit').strip() != args.sha):
        raise ValueError('a completed, clean, successful boot of the requested commit is required')
    if any(json.loads(line).get('event') == 'console-gap' for line in read('events.jsonl').splitlines()):
        raise ValueError('capture has a console gap')
    result = runner['in_metal'](env, 'python3', '-c',
        'import runpy,sys;from pathlib import Path;'
        'p=Path(sys.argv[1]);a=runpy.run_path(str(p/"definition/scripts/metal/gt710-suite"));'
        'sys.exit(a["record_capture"](p,sys.argv[2]))', directory, args.sha)
    passed = result.returncode == 0
    # Rescore the retained facts, without executing another boot or suite.
    runner['in_metal'](env, 'python3', '-c',
        'import sys,json;sys.path.insert(0,"/opt/breenix-metal");import metal_score,metal_lib as m;'
        'p=m.boot_dir(sys.argv[1]);m.write_json(p/"milestone-verdict.json",metal_score.score(p));'
