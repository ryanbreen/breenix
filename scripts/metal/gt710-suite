                or hashlib.sha256(final_data).hexdigest()!=finals[0][2]):
            raise ValueError('final artifact differs from serial length/digest')
        data+=final_data
    text=data.decode('ascii')
    groups={};group_slots={};previous=None;offset=0
    for line in text.splitlines(keepends=True):
        slot=int(offset>=startup_bytes);offset+=len(line)
        fields=line.split()
        if fields[0]=='GT710_PIX': key=('native',)
        elif fields[0]=='GT710_SWITCH_PIX': key=('switch',int(fields[1]))
        elif fields[0]=='GT710_FLIP_PIX': key=('flip',int(fields[1]),int(fields[2]))
        elif fields[0]=='GT710_MULTI': key=('multi',)
        elif fields[0]=='GT710_GR_IMAGE': key=('graphics',)
        elif fields[0]=='GT710_SHADER_IMAGE': key=('shaders',)
        elif fields[0]=='GT710_DRAW_IMAGE': key=('draw',)
        elif fields[0]=='GT710_CTX_IMAGE': key=('gr-contexts',)
        elif fields[0]=='GT710_SPANS_V1':
            row = json.loads(line.removeprefix('GT710_SPANS_V1 '))
            if type(row.get('id')) is not int or row['id'] <= 0:
                raise ValueError('invalid spans record')
            key=('spans', row['id'])
        elif fields[0]=='GT710_TIMING_V1':
            row = json.loads(line.removeprefix('GT710_TIMING_V1 '))
            if (type(row.get('batch')) is not int or row['batch'] <= 0
                    or type(row.get('dropped')) is not int or row['dropped'] < 0
                    or not isinstance(row.get('rows'), list)
                    or any(not isinstance(r, list) or len(r) != 5
                           or any(type(v) is not int or v < 0 for v in r) for r in row['rows'])):
                raise ValueError('invalid timing record')
            key=('timing', row['batch'])
        elif fields[0]=='GT710_GR_REFUSAL_V1':
            row = json.loads(line.removeprefix('GT710_GR_REFUSAL_V1 '))
            if (row.get('registers') != [0x400704, 0x400708, 0x400700, 0x409c18, 0x2634, 0x2640, 0x262c]
                    or any(not isinstance(row.get(k), list) or len(row[k]) != n
                           or any(type(v) is not int or not 0 <= v < 1 << 32 for v in row[k])
                           for k, n in [('status', 4), ('values', 7)])):
                raise ValueError('invalid GR refusal record')
            if 'pri_registers' in row or 'pri_values' in row:
                pri = row.get('pri_values')
                if (row.get('pri_registers') != [0x400100, 0x200, 0x409614, 0x404170]
                        or not isinstance(pri, list) or len(pri) != 4
                        or any(type(v) is not int or not 0 <= v < 1 << 32 for v in pri)):
                    raise ValueError('invalid GR PRI refusal diagnostics')
            key=('gr-refusal', hashlib.sha256(line.removesuffix('\n').encode('ascii')).hexdigest())
        elif fields[0]=='GT710_MMU_ERROR_V1':
            row = json.loads(line.removeprefix('GT710_MMU_ERROR_V1 '))
            raw = row.get('raw')
            if (any(type(row.get(k)) is not int or row[k] <= 0
                    for k in ('instance', 'epoch', 'sequence'))
                    or row.get('unit') != 0 or not isinstance(raw, list) or len(raw) != 4
                    or any(type(v) is not int or not 0 <= v < 1 << 32 for v in raw)
                    or row['instance'] != raw[0] << 12 or not 0 < row['sequence'] < 1 << 32
                    or (raw[1] | raw[2] << 32) != (1 << 40) - (1 << 27) + (row['sequence'] % 32768) * 4096
                    or not raw[3] & 0x80 or raw[3] & 15 not in (0, 2)
                    or row.get('answer') != 0x60010000 | (raw[3] & 15)):
                raise ValueError('inconsistent attributed MMU write record')
            key=('mmu-error', row['epoch'], row['sequence'])
        elif fields[0]=='GT710_DISPLAY_V1':
            row = json.loads(line.removeprefix('GT710_DISPLAY_V1 '))
            if type(row.get('sequence')) is not int or row['sequence'] <= 0:
                raise ValueError('invalid runtime display sequence')
            key=('display-state', row['sequence'])
        elif fields[0]=='GT710_STALL_V1':
            stall = re.fullmatch(r'GT710_STALL_V1 instance=(\d+) epoch=(\d+) put=(\d+) registers=\[.*\]\n?', line)
            if stall is None: raise ValueError('invalid stall record')
            key=('stall', int(stall[2]), int(stall[3]))
        elif line.startswith('{'):
            row = json.loads(line)
            if row.get('phase') not in ('caps-probe', 'caps-reprobe') or type(row.get('capability')) is not int:
                raise ValueError('unexpected JSON artifact record')
            if row['phase'] == 'caps-reprobe':
                if type(row.get('epoch')) is not int or not 0 < row['epoch'] < 1 << 64:
                    raise ValueError('invalid executable reprobe epoch')
                key=('caps-reprobe', row['epoch'], row['capability'])
            else:
                key=('caps-probe', row['capability'])
        elif fields[0]=='GT710_RESOURCES': key=('resources',)
        elif fields[0]=='GT710_CORE': key=('core',)
