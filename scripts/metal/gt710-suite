        need(e['faults_before']==e['faults_after']==0 and e['fault_records_before']==e['fault_records_after']==[],'pending GPU fault')
        return e
    except (KeyError,TypeError,IndexError,OverflowError,json.JSONDecodeError) as error:
        raise ValueError('malformed CPU aperture evidence') from error


def native_mode(serial):
    try:
        board = board_inventory(serial)
        memory = display_memory(serial)
        e = json.loads(one(r'^GT710_MODE (.+)$', serial, 'native mode evidence')[1])
        def need(ok, why):
            if not ok: raise ValueError(why)
        need('GT710_NATIVE_CONSOLE_REFUSAL' not in serial, 'native console reported lost binding or health')
        t = board['modes'][0]
        surface = memory['objects'][0]['start']
        need(e['schema']==1 and e['phase']=='native' and e['bdf']==board['bdf']
             and e['head']==board['head'] and e['sor']==board['sor'] and e['timing']==t,
             'native timing differs from the live preferred EDID route')
        need(e['surface']==surface and e['pitch']==memory['pitch']
             and e['instance']==memory['objects'][4]['start'] and e['push']==memory['objects'][2]['start'],
             'native display uses foreign storage')
        for phase in ('quiesce_before','quiesce_after'):
            controls=e[phase]
            need(type(controls) is list and len(controls)==17, 'incomplete native quiesce snapshot')
            for channel,control in enumerate(controls):
                need(type(control) is int and 0<=control<=0xffffffff, 'invalid channel control')
                need(control & (0x13 if channel<9 else 1)==0, 'inherited channel requests remain enabled')
                if phase=='quiesce_after':
                    need(control & (0x1e0000 if channel<9 else 0x30000)==0,
                         'display channel was busy before native enable')
        h=e['head']*0x300
        regs=dict(e['active'])
        need(len(regs)==len(e['active']), 'duplicate active register')
        pair=lambda x,y:x|(y<<16)
        expected={0x414:pair(t['htotal'],t['vtotal']),
          0x418:pair(t['hsync_end']-t['hsync_start']-1,t['vsync_end']-t['vsync_start']-1),
          0x41c:pair(t['htotal']-t['hsync_start']-1,t['vtotal']-t['vsync_start']-1),
          0x420:pair(t['htotal']-t['hsync_start']+t['width']-1,t['vtotal']-t['vsync_start']+t['height']-1),
          0x450:t['clock_khz']*1000,0x460:surface>>8,0x468:pair(t['width'],t['height']),
          0x46c:0x1000000|e['pitch'],0x470:0xcf00,0x474:1,0x498:0x40000,0x4a0:0}
        need(all(regs.get(0x640000+h+r)==v for r,v in expected.items()), 'active native head or scanout mismatch')
        polarity=(8 if not t['flags']&2 else 0)|(16 if not t['flags']&4 else 0)
        need(regs[0x640404+h]&0x3d8==0x140|polarity, 'native sync polarity or pixel depth mismatch')
        need(e['protocol'] in (1,2) and regs[0x640200+e['sor']*32]&0xf0f==e['protocol']<<8|1<<e['head'],
             'active TMDS output mismatch')
        need(e['notifier_before']==0 and e['notifier_after']&1 and e['clean_notifier']&1
             and type(e['put']) is int and 0<e['put']<=2048 and e['get']==e['put'], 'uncompleted native update')
        need(e['skipped_address']==surface and e['skipped_notifier']==0, 'suppressed update was accepted')
        need(e['errors']==0 and e['underflow']&0x111==1 and e['power']&0x80000001==1
             and not e['power_status']&0x10000000, 'native output is down or faulted')
        progressed=((e['raster_after']>>16)-(e['raster_before']>>16))&65535
        need(0<progressed<100, 'native raster did not advance')
        need(e['firmware_writes']==0, 'firmware framebuffer written during native ownership')
        pll=bytes.fromhex(e['pll_record'])
        need(11<=len(pll)<=255 and pll[0]==0x80+e['head'], 'invalid selected board VPLL record')
        pll_register=int.from_bytes(pll[3:7],'little')
        pll_reference=int.from_bytes(pll[9:11],'little')*1000
        need(0x614100<=pll_register<0x614180 and pll_register%32==0
             and e['pll_register']==pll_register and e['pll_reference']==pll_reference
             and 1000<=pll_reference<=100000,
             'invalid native pixel PLL source')
        c=e['pll_coefficients']; m=c&255; n=(c>>8)&255; p=(c>>16)&63
        fraction=(e['pll_fraction']>>16)&65535
        if fraction&32768: fraction-=65536
        need(m>0 and p>0 and n>0, 'invalid native pixel PLL coefficients')
        numerator=e['pll_reference']*(n*8192+4096+fraction)
        denominator=m*p*8192
        need(abs(numerator-t['clock_khz']*denominator)*1000000<=t['clock_khz']*denominator*250,
             'native pixel PLL frequency differs from preferred timing')
        end=one(r'^GT710_MODE (.+)$',serial,'native mode evidence').end()
        receipts=list(re.finditer(r'^GT710_NATIVE_CONSOLE surface=(\d+) firmware_writes=(\d+)$',serial[end:],re.M))
        need(receipts and all(int(r[1])==surface and int(r[2])==0 for r in receipts),
             'native console binding or firmware-write evidence missing or wrong')
        rows=list(re.finditer(r'^GT710_PIX (\d+) ([0-9a-f:,]+)$',serial,re.M))
        need(len(rows)==t['height'], 'incomplete native full-screen read-back')
        import struct
        data=bytearray()
        for y,row in enumerate(rows):
            need(int(row[1])==y, 'out-of-order native read-back row')
            x=0
            for run in row[2].split(','):
                count,value=map(lambda s:int(s,16),run.split(':'))
                need(0<count<=e['pitch']//4 and 0<=value<=0xffffffff, 'invalid native pixel run')
                need(x+count<=e['pitch']//4, 'native pixel run exceeds pitch')
                for column in range(x,x+count):
                    expected=0xff000000|((e['seed']+y*257+(column//64)*0x10203)&0xffffff)
                    need(value==expected, 'native pixel differs from independent nonce pattern')
                data+=struct.pack('<I',value)*count
                x+=count
            need(x*4==e['pitch'], 'incomplete native pitch edge')
        need(e['bytes']==len(data)==e['pitch']*t['height'] and e['sha256']==hashlib.sha256(data).hexdigest(),
             'native binary read-back length or digest mismatch')
        return e, bytes(data)
    except (KeyError,TypeError,IndexError,OverflowError,json.JSONDecodeError) as error:
        raise ValueError('malformed native modeset evidence') from error


def native_switches(serial):
    """Validate each clock-changing UPDATE against the live route and full image."""
    try:
        board = board_inventory(serial)
        memory = display_memory(serial)
        previous, _ = native_mode(serial)
        reports = list(re.finditer(r'^GT710_SWITCH (.+)$', serial, re.M))
        def need(ok, why):
            if not ok: raise ValueError(why)
        need(len(reports)==3, 'three completed mode switches required')
        frames = []
        seeds = {previous['seed']}
        for step, match in enumerate(reports):
            e = json.loads(match[1]); t = e['timing']; h = board['head']*0x300
            need(e['schema']==1 and e['phase']=='switch' and e['step']==step
                 and e['bdf']==board['bdf'] and e['head']==board['head'] and e['sor']==board['sor'],
                 'switch identity or order mismatch')
            need(t in board['modes'] and t['flags']&0x98==0x18, 'switch timing not advertised by live sink')
            high = board['modes'][0]
            if step==1:
                need(t==high, 'middle switch must use preferred EDID mode')
            else:
                need(t['width']<high['width'] and t['height']<=high['height']
                     and t['clock_khz']<high['clock_khz'], 'switch needs a lower EDID mode')
                if step==2: need(t==frames[0][0]['timing'], 'final switch did not return to low mode')
            need(e['before_active']==previous['active'] and e['put_before']==previous['put']
                 and previous['put']<e['put']<=2048 and e['get']==e['put'], 'stale switch state or cursor')
            need(match.start()>serial.index('GT710_MODE ')
                 and (step==0 or match.start()>reports[step-1].end()), 'switch precedes takeover')
            need(e['detached_notifier']&1 and e['detached_output']&0xf0f==0
                 and e['detached_iso']==0 and e['detached_power']&0x80000001==0
                 and e['detached_link']&0x10000000==0, 'switch output did not detach')
            pitch = (t['width']*4+255)&~255
            surface = memory['objects'][0]['start']
            need(e['surface']==surface and e['pitch']==pitch
                 and pitch*t['height']<=memory['objects'][0]['size']
                 and e['instance']==memory['objects'][4]['start'] and e['push']==memory['objects'][2]['start'],
                 'switch uses foreign or undersized storage')
            regs = dict(e['active']); pair=lambda x,y:x|y<<16
            need(len(regs)==len(e['active']), 'duplicate switch active register')
            expected={0x414:pair(t['htotal'],t['vtotal']),
                0x418:pair(t['hsync_end']-t['hsync_start']-1,t['vsync_end']-t['vsync_start']-1),
                0x41c:pair(t['htotal']-t['hsync_start']-1,t['vtotal']-t['vsync_start']-1),
                0x420:pair(t['htotal']-t['hsync_start']+t['width']-1,t['vtotal']-t['vsync_start']+t['height']-1),
                0x450:t['clock_khz']*1000,0x460:surface>>8,0x468:pair(t['width'],t['height']),
                0x46c:0x1000000|pitch,0x470:0xcf00,0x474:1,0x498:0x40000,0x4a0:0}
            need(all(regs.get(0x640000+h+r)==v for r,v in expected.items()), 'active switch timings or scanout differ')
            polarity=(8 if not t['flags']&2 else 0)|(16 if not t['flags']&4 else 0)
            need(regs[0x640404+h]&0x3d8==0x140|polarity, 'switch sync polarity mismatch')
            need(e['protocol']==previous['protocol'] and e['protocol'] in (1,2)
                 and regs[0x640200+e['sor']*32]&0xf0f==e['protocol']<<8|1<<e['head'], 'switch link mismatch')
            need(e['notifier_before']==0 and e['notifier_after']&1, 'switch completion missing or stale')
            need(e['errors']==0 and e['underflow']&0x111==1 and e['power']&0x80000001==1
                 and not e['power_status']&0x10000000 and e['firmware_writes']==0, 'switch output fault or firmware write')
            need(0<((e['raster_after']>>16)-(e['raster_before']>>16))&65535<100, 'switch raster did not advance')
            need(e['pll_record']==previous['pll_record'] and e['pll_register']==previous['pll_register']
                 and e['pll_reference']==previous['pll_reference'], 'switch uses another PLL source')
            c=e['pll_coefficients']; m=c&255; n=(c>>8)&255; p=(c>>16)&63
            f=(e['pll_fraction']>>16)&65535
            if f&32768: f-=65536
            denominator=m*p*8192; numerator=e['pll_reference']*(n*8192+4096+f)
            need(m>0 and p>0 and n>0 and
                 abs(numerator-t['clock_khz']*denominator)*1000000<=t['clock_khz']*denominator*250,
                 'switch pixel PLL frequency differs from EDID timing')
            need(type(e['seed']) is int and 0<e['seed']<=0xffffffff and e['seed'] not in seeds, 'switch pattern nonce reused')
            seeds.add(e['seed'])
            rows=list(re.finditer(r'^GT710_SWITCH_PIX '+str(step)+r' (\d+) ([0-9a-f:,]+)$',serial,re.M))
            need(len(rows)==t['height'], 'incomplete switch image')
            data=bytearray()
            import struct
            for y,row in enumerate(rows):
                need(int(row[1])==y and (reports[step-1].end() if step else serial.index('GT710_MODE '))<row.start()<match.start(),
                     'switch image belongs to another update')
                x=0
                for run in row[2].split(','):
                    count,value=(int(v,16) for v in run.split(':'))
                    need(0<count<=pitch//4-x and value>>24==255, 'invalid unique-pixel run')
                    for i in range(count):
                        actual=0xff000000|((value+i)&0xffffff)
                        expected=0xff000000|((e['seed']+y*(pitch//4)+x+i)&0xffffff)
                        need(actual==expected, 'switch pixel differs from independent nonce pattern')
                        data+=struct.pack('<I',actual)
                    x+=count
                need(x*4==pitch, 'incomplete switch pitch edge')
            need(e['bytes']==len(data)==pitch*t['height'] and e['sha256']==hashlib.sha256(data).hexdigest(),
                 'switch binary length or digest mismatch')
            frames.append((e,bytes(data)));previous=e
        need(len(re.findall(r'^GT710_SWITCH_PIX ',serial,re.M))==sum(e['timing']['height'] for e,_ in frames),
             'unassociated switch pixels')
        returned=list(re.finditer(r'^GT710_PREFERRED_RETURN (.+)$',serial,re.M))
        need(len(returned)==1 and returned[0].start()>reports[-1].end(), 'preferred return missing or early')
        restored=json.loads(returned[0][1]); preferred=frames[1][0]
        need(restored['active']==preferred['active'] and restored['notifier']&1
             and previous['put']<restored['put']<=2048 and restored['get']==restored['put']
             and restored['power']&0x80000001==1 and restored['link']&0x10000000==0
             and restored['pll_coefficients']==preferred['pll_coefficients']
             and restored['pll_fraction']==preferred['pll_fraction'] and restored['firmware_writes']==0,
             'preferred return binding, completion, clock or output fault')
        need(0<((restored['raster_after']>>16)-(restored['raster_before']>>16))&65535<100,
             'preferred return raster did not advance')
        receipts=list(re.finditer(r'^GT710_NATIVE_CONSOLE surface=(\d+) firmware_writes=(\d+)$',
                                 serial[returned[0].end():],re.M))
        need(receipts and all(int(r[1])==previous['surface'] and int(r[2])==0 for r in receipts),
             'console return after final low mode is missing or faulted')
        return frames
    except (KeyError,TypeError,IndexError,OverflowError,json.JSONDecodeError) as error:
        raise ValueError('malformed native switching evidence') from error


def native_flips(serial):
    """Judge the two same-mode A-B-A sequences from device state and full pixels."""
    try:
        modes = native_switches(serial)
        memory = display_memory(serial)
        returned = one(r'^GT710_PREFERRED_RETURN (.+)$',serial,'preferred return')
        restored = json.loads(returned[1])
        reports = list(re.finditer(r'^GT710_FLIP (.+)$',serial,re.M))
        skipped = list(re.finditer(r'^GT710_FLIP_SKIPPED (.+)$',serial,re.M))
        def need(ok, why):
            if not ok: raise ValueError(why)
        need('GT710_FLIP_REFUSAL' not in serial, 'native flip reported an error')
        need(len(reports)==6 and len(skipped)==2, 'both modes need A-B-A and a suppressed update')
        a,b = [o['start'] for o in memory['objects'][:2]]
        seeds = {json.loads(one(r'^GT710_MODE (.+)$',serial,'native mode')[1])['seed']}
        seeds.update(e['seed'] for e,_ in modes)
        frames=[]
        switch_end = list(re.finditer(r'^GT710_SWITCH (.+)$',serial,re.M))[-1].end()
        for mode,template in enumerate([modes[2][0],modes[1][0]]):
            h=template['head']*0x300
            boundary=switch_end if mode==0 else returned.end()
            cursor=template['put'] if mode==0 else restored['put']
            s=json.loads(skipped[mode][1])
            need(boundary<skipped[mode].start()<reports[mode*3].start()
                 and s['mode']==mode and s['expected']==b and s['active']==template['active']
                 and s['notifier']==0 and s['put']==cursor+16 and s['get']==s['put']
                 and s['errors']==0 and s['firmware_writes']==0, 'suppressed update changed binding or completion')
            cursor=s['put']; previous=template['active']; seed_a=None; data_a=None
            for step,address in enumerate([a,b,a]):
                match=reports[mode*3+step]; e=json.loads(match[1]);t=template['timing']
                need(e['schema']==1 and e['phase']=='flip' and e['mode']==mode and e['step']==step,
                     'flip sequence identity differs')
                for field in ['bdf','head','sor','protocol','timing','pitch','instance','push',
                              'pll_record','pll_register','pll_reference','pll_coefficients','pll_fraction']:
                    need(e[field]==template[field], 'flip changed mode, route or private objects')
                active=[list(r) for r in template['active']]
                next(r for r in active if r[0]==0x640460+h)[1]=address>>8
                need(e['surface']==address and e['before_active']==previous and e['active']==active,
                     'flip did not latch the expected private surface')
                need(e['put_before']==cursor and e['put']==cursor+24<=2048 and e['get']==e['put']
                     and e['notifier_before']==0 and e['notifier_after']&1, 'flip completion missing or stale')
                need(e['errors']==0 and e['underflow']&0x111==1 and e['power']&0x80000001==1
                     and not e['power_status']&0x10000000 and e['firmware_writes']==0, 'flip output fault or firmware write')
                need(0<((e['raster_after']>>16)-(e['raster_before']>>16))&65535<100, 'flip raster did not advance')
                need(type(e['seed']) is int and 0<e['seed']<=0xffffffff, 'invalid flip nonce')
                if step<2:
                    need(e['seed'] not in seeds, 'flip pattern nonce reused')
                    seeds.add(e['seed'])
                if step==0: seed_a=e['seed']
                else: need((e['seed']==seed_a)==(step==2), 'A-B-A nonce relationship differs')
                rows=list(re.finditer(r'^GT710_FLIP_PIX '+str(mode)+' '+str(step)+r' (\d+) ([0-9a-f:,]+)$',serial,re.M))
                need(len(rows)==t['height'], 'incomplete flip read-back')
                import struct
                data=bytearray()
                for y,row in enumerate(rows):
                    need(int(row[1])==y and boundary<row.start()<match.start(), 'flip pixel association differs')
                    x=0
                    for run in row[2].split(','):
                        count,value=(int(v,16) for v in run.split(':'))
                        need(0<count<=e['pitch']//4-x and value>>24==255, 'invalid flip pixel run')
                        for i in range(count):
                            actual=0xff000000|((value+i)&0xffffff)
                            expected=0xff000000|((e['seed']+y*(e['pitch']//4)+x+i)&0xffffff)
                            need(actual==expected, 'flip pixel differs from independent nonce pattern')
                            data+=struct.pack('<I',actual)
                        x+=count
                    need(x*4==e['pitch'], 'incomplete flip pitch edge')
                need(e['bytes']==len(data)==e['pitch']*t['height'] and e['sha256']==hashlib.sha256(data).hexdigest(),
                     'flip binary length or digest differs')
                if step==0: data_a=bytes(data)
                else: need((data==data_a)==(step==2), 'A-B-A full images differ')
                frames.append((e,bytes(data)));cursor=e['put'];previous=e['active'];boundary=match.end()
            if mode==0:
                need(boundary<returned.start() and cursor<restored['put'], 'preferred return precedes low flips')
        need(len(re.findall(r'^GT710_FLIP_PIX ',serial,re.M))==sum(e['timing']['height'] for e,_ in frames),
             'unassociated flip pixels')
        receipts=list(re.finditer(r'^GT710_NATIVE_CONSOLE surface=(\d+) firmware_writes=(\d+)$',serial[reports[-1].end():],re.M))
        need(receipts and all(int(r[1])==a and int(r[2])==0 for r in receipts), 'console handoff after flips missing or faulted')
        return frames
    except (KeyError,TypeError,IndexError,StopIteration,OverflowError,json.JSONDecodeError) as error:
        raise ValueError('malformed native flip evidence') from error


