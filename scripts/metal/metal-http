#!/usr/bin/env python3
"""The single-transfer boot image server (docs/metal/README.md, "Delivery").

One route. While a boot has an image staged and it has not yet been sent completely, the route answers HEAD and GET
with that file; a transfer that breaks off can be retried; after one complete transfer, and whenever nothing is
staged, every request gets 404, so a machine that resets cannot boot the same image again. Every request and
transfer is logged to STATE/http.jsonl, without the client's address.
"""
import hashlib
import http.server
from pathlib import Path
import sys
import time
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parent))
import metal_lib as m  # noqa: E402

CHUNK = 1 << 20
PROGRESS_SECONDS = 1.0


def log(**fields):
    m.append_jsonl(m.STATE / 'http.jsonl', dict(fields, t=round(m.now(), 3)))


def current():
    staged = m.read_json(m.STATE / 'stage' / 'current.json')
    if not staged or staged.get('served') or not Path(staged.get('path', '')).is_file():
        return None
    return staged


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = 'breenix-metal'
    sys_version = ''
    protocol_version = 'HTTP/1.1'

    def log_message(self, *_):
        pass

    def not_found(self, staged_id):
        log(event='404', method=self.command, route=self.path == self.server.route, id=staged_id)
        self.send_response(404)
        self.send_header('Content-Length', '0')
        self.end_headers()

    def headers_for(self, staged):
        self.send_response(200)
        self.send_header('Content-Type', staged['contentType'])
        self.send_header('Content-Length', str(staged['size']))
        self.send_header('Accept-Ranges', 'none')
        self.end_headers()

    def do_HEAD(self):
        staged = current() if urlsplit(self.path).path == self.server.route else None
        if not staged:
            return self.not_found(None)
        log(event='head', id=staged['id'])
        self.headers_for(staged)

    def do_GET(self):
        staged = current() if urlsplit(self.path).path == self.server.route else None
        if not staged:
            return self.not_found(None)
        log(event='start', id=staged['id'], total=staged['size'], range=self.headers.get('Range'))
        self.headers_for(staged)
        digest = hashlib.sha256()
        sent = 0
        last = time.monotonic()
        try:
            with open(staged['path'], 'rb') as source:
                while chunk := source.read(CHUNK):
                    self.wfile.write(chunk)
                    digest.update(chunk)
                    sent += len(chunk)
                    if time.monotonic() - last >= PROGRESS_SECONDS:
                        last = time.monotonic()
                        log(event='progress', id=staged['id'], bytes=sent, total=staged['size'])
            self.wfile.flush()
        except OSError as error:
            log(event='broken', id=staged['id'], bytes=sent, total=staged['size'], error=error.__class__.__name__)
            self.close_connection = True
            return
        complete = sent == staged['size']
        sha256 = digest.hexdigest()
        if complete:
            with m.locked('stage'):
                latest = m.read_json(m.STATE / 'stage' / 'current.json')
                if latest and latest.get('id') == staged['id']:
                    latest.update(served=True, servedAt=m.now(), servedSha256=sha256)
                    m.write_json(m.STATE / 'stage' / 'current.json', latest)
        log(event='complete' if complete else 'short', id=staged['id'], bytes=sent, total=staged['size'],
            sha256=sha256, matches=sha256 == staged['sha256'])


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    site = m.load_site()
    url = urlsplit(site['BOOT_URL'])
    port = int(site.get('HTTP_LISTEN_PORT') or url.port or 80)
    server = Server(('127.0.0.1', port), Handler)
    server.route = url.path
    log(event='listening')
    server.serve_forever()


if __name__ == '__main__':
    main()
