def measured_stages(metal, mode, catalog, shape='ramdisk', input_kind=None):
    """Track each measured milestone in its own print order, including delayed kernel producers. Milestones in
    the definition select which boot shapes and modes can measure them. A stage tagged with an input (the USB keyboard)
    is required only of a boot whose input is that one; the scorer still counts it, unreached, for any other."""
    markers = {stage['name']: stage for stage in catalog.get('stages', [])}
    groups = []
    for milestone in metal.get('milestones', []):
        if milestone.get('stub') or not metal_score.measures(milestone, shape, mode):
            continue
        lists = milestone.get('stages', {})
        listed = lists.get(mode, lists.get(metal['gateArch'], []) if milestone.get('kernel') else [])
        group = []
        for stage in listed:
            spec = markers.get(stage, {}) if isinstance(stage, str) else stage
            if 'host' in spec:
                continue  # These are checked by preflight, delivery and console setup.
            if spec.get('input') and spec['input'] != input_kind:
                continue
            if not spec.get('marker'):
                raise ValueError('unresolved measured serial stage')
            group.append((spec['marker'], spec.get('match', 'contains')) +
                         ((spec['input'],) if spec.get('input') else ()))
        if group:
            groups.append(group)
    return groups


def final_marker(metal, mode, catalog, shape='ramdisk', input_kind=None):
    """Resolve the final measured serial stage and preserve its matching contract. A stub milestone's markers are
    proposals its producing lane has not landed (docs/metal/boot-path.json), so no boot measures it yet, and a
    milestone excluded by `bootShapes` or `bootModes` cannot be measured by this boot."""
    markers = {stage['name']: stage for stage in catalog.get('stages', []) if 'marker' in stage}
    milestones = [milestone for milestone in reversed(metal.get('milestones', []))
                  if not milestone.get('stub') and metal_score.measures(milestone, shape, mode)]
    scoped = [milestone.get('stages', {}).get(mode) for milestone in milestones]
    scoped = [listed for listed in scoped if listed]
    if not scoped:
        scoped = [milestone.get('stages', {}).get(metal.get('gateArch', 'x86_64'))
                  for milestone in milestones if milestone.get('kernel')]
    for listed in scoped:
        if not listed:
            continue
        for stage in reversed(listed):
            if isinstance(stage, dict) and ('host' in stage or stage.get('input', input_kind) != input_kind):
                continue
            stage = stage if isinstance(stage, dict) else markers.get(stage, {})
            if stage.get('marker'):
                return (stage['marker'], stage.get('match', 'contains')) + ((stage['input'],) if stage.get('input') else ())
            return None
    return None


def launch(args, extra):
    boot_id = args.id or boot_id_now()
    unit = unit_name(boot_id)
    command = ['systemd-run', '--unit', unit, '--collect', '--property', 'MemoryMax=256M',
               '--setenv', 'BREENIX_METAL_SITE=' + str(m.SITE_PATH), sys.executable, str(Path(__file__).resolve()),
               'run', '--id', boot_id] + extra
    subprocess.run(command, check=True, capture_output=True)
    claim = m.boot_dir(boot_id) / 'claim.json'
    deadline = m.now() + 30
    status = 'starting'
    while m.now() < deadline:
        state = m.read_json(claim)
        if state:
            status = state['status']
            break
        if not m.unit_active(unit) and (m.boot_dir(boot_id) / 'ended').exists():
            status = 'ended'
            break
        time.sleep(0.25)
    print(json.dumps({'id': boot_id, 'unit': unit, 'status': status}))
    return {'claimed': 0, 'waiting': 0, 'busy': 75, 'quarantined': 75, 'not-ready': 75}.get(status, 1)


# claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
def status():
    finished = []
    path = m.STATE / 'finished.jsonl'
    if path.exists():
        for line in path.read_text().splitlines()[-10:]:
            entry = json.loads(line)
            directory = m.boot_dir(entry['id'])
            entry['exit'] = (directory / 'exit-status').read_text().strip() if (directory / 'exit-status').exists() else None
            finished.append(entry)
    print(json.dumps({'lease': m.read_lease(), 'machine': m.read_json(m.STATE / 'machine.json'),
                      'finished': finished}, indent=1))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('launch', 'run'):
        p = sub.add_parser(name)
        p.add_argument('--id')
        p.add_argument('--payload', choices=PAYLOADS, default='image')
        p.add_argument('--mode', choices=MODES, default='default')
        p.add_argument('--input', choices=('sol',))
        p.add_argument('--attended', action='store_true', help='score the operator challenge without sending input')
        p.add_argument('--wait', type=float, default=30, metavar='MIN', help='attended wait in minutes (default 30)')
        p.add_argument('--session', action='store_true', help='hold the console for operator input, without scoring')
        p.add_argument('--idle-minutes', type=int, default=30, help='session input idle limit (1 through 240; default 30)')
        p.add_argument('--suite')
        p.add_argument('--commit', default='')
        p.add_argument('--target', default='main')
        p.add_argument('--task', default='')
        p.add_argument('--no-wait', action='store_true')
        p.add_argument('--inject', choices=('forceoff-fail', 'xhci-reset-device', 'xhci-short-read'))
        p.add_argument('--nmi', action='store_true',
                       help='send the NMI and capture for 5 s before powering off a started kernel, finished or not')
        p.add_argument('--ramdisk', action='store_true', default=True, help='put the ext2 root on the boot disk as `ramdisk`')
        p.add_argument('--disk', choices=DISK_ACTIONS,
                       help='probe mode: install the RAM-disk root on the disk, or boot from the installed root')
        p.add_argument('--content-type', choices=('application/octet-stream',),
                       help='a test payload served with this type instead of its form\'s own')
        p.add_argument('--serve-as', choices=('boot.iso', 'boot.efi'),
                       help='answer the fixed URI with a redirect to this name beside it, and serve the file there')
    p = sub.add_parser('stop')
    p.add_argument('id')
    p = sub.add_parser('inputs-ready')
    p.add_argument('id')
    p = sub.add_parser('inputs-failed')
    p.add_argument('id')
    p.add_argument('why')
    sub.add_parser('status')
    args, _ = parser.parse_known_args()
    if args.command in ('launch', 'run'):
        try:
            validate_xhci_fault(args)
        except ValueError as error:
            parser.error(str(error))
        if args.mode == 'suite':
            if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', args.suite or ''):
                parser.error('suite mode needs --suite ID')
        elif args.suite:
            parser.error('--suite needs suite mode')
        if args.payload != 'image' and args.mode != 'default':
            parser.error('boot modes need an image payload')
        if args.disk and args.mode not in ('probe', 'console'):
            parser.error('--disk needs probe or console mode')
        if args.session and (args.mode != 'console' or args.input or args.disk == 'install'):
            parser.error('--session needs console mode, operator input and no disk install')
        if not 1 <= args.idle_minutes <= 240 or (args.idle_minutes != 30 and (not args.session or args.disk == 'root')):
            parser.error('--idle-minutes needs a RAM-disk session and 1 through 240 minutes')
        if args.attended and (args.session or args.mode != 'console' or args.input or args.payload != 'image' or args.disk):
            parser.error('--attended needs a RAM-disk console boot, without --session or --input')
        if not 0 < args.wait <= 240 or (args.wait != 30 and not args.attended):
            parser.error('--wait needs --attended and more than 0 through 240 minutes')
        if args.mode == 'console' and not args.session and not args.attended and args.input != 'sol':
            parser.error('console typing waits for the injector; development boots require --input sol')
        if args.input and args.mode != 'console':
            parser.error('--input needs console mode')
    if args.command == 'launch':
        extra = sys.argv[2:]
        if args.id:
            index = extra.index('--id')
            del extra[index:index + 2]
        return launch(args, extra)
    if args.command == 'run':
        if not args.id or not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.id):
            parser.error('run needs --id in the form YYYYMMDDTHHMMSSZ-metal')
        return Driver(args).run()
    if args.command == 'stop':
        directory = m.boot_dir(args.id)
        if not directory.is_dir() or (directory / 'ended').exists():
            print('no such running boot', file=sys.stderr)
            return 1
        (directory / 'stop-request').touch()
        return 0
    if args.command in ('inputs-ready', 'inputs-failed'):
        inputs = m.stage_dir(args.id) / 'inputs'
        inputs.mkdir(parents=True, exist_ok=True)
        if args.command == 'inputs-ready':
            (inputs / 'ready').touch()
        else:
            (inputs / 'failed').write_text(args.why[:300] + '\n')
        return 0
    return status()


if __name__ == '__main__':
    sys.exit(main())
