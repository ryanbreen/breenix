def status():
    finished = []
    path = m.STATE / 'finished.jsonl'
    if path.exists():
        for line in path.read_text().splitlines()[-10:]:
            entry = json.loads(line)
            directory = m.boot_dir(entry['id'])
            entry['exit'] = (directory / 'exit-status').read_text().strip() if (directory / 'exit-status').exists() else None
            finished.append(entry)
    print(json.dumps({'lease': m.read_lease(), 'queue': m.read_queue(), 'machine': m.read_json(m.STATE / 'machine.json'),
                      'finished': finished}, indent=1))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('launch', 'run'):
        p = sub.add_parser(name)
        p.add_argument('--id')
        p.add_argument('--payload', choices=PAYLOADS, default='image')
        p.add_argument('--mode', choices=MODES, default='default')
        p.add_argument('--input', choices=('sol',))
        p.add_argument('--attended', action='store_true', help='score the operator challenge without sending input')
        p.add_argument('--wait', type=float, default=None, metavar='MIN', help='queue wait (default 240); with --attended, challenge wait (default 30)')
        p.add_argument('--session', action='store_true', help='hold the console for operator input, without scoring')
        p.add_argument('--idle-minutes', type=int, default=30, help='session input idle limit (1 through 240; default 30)')
        p.add_argument('--suite')
        p.add_argument('--source-boot')
        p.add_argument('--commit', default='')
        p.add_argument('--target', default='main')
        p.add_argument('--catchup', action='store_true')
        p.add_argument('--task', default='')
        p.add_argument('--no-wait', action='store_true')
        p.add_argument('--inject', choices=('forceoff-fail', 'xhci-reset-device', 'xhci-short-read', 'disk-before-mount',
                                            FENCE_FAULT))
        p.add_argument('--entry', choices=('current', 'previous'), help='the kernel slot a persistent boot runs')
        p.add_argument('--slot-action', choices=('commit', 'rollback'), help='what the manager does to the slots first')
        p.add_argument('--run', action='append', help='a persistent boot logs in over SOL and runs this; repeatable')
        p.add_argument('--verify', action='store_true', help='a persistent boot that ends at the login prompt')
        p.add_argument('--adopt', action='store_true', help=argparse.SUPPRESS)
        p.add_argument('--nmi', action='store_true',
                       help='send the NMI and capture for 5 s before powering off a started kernel, finished or not')
        p.add_argument('--ramdisk', action='store_true', default=True, help='carry the ext2 RAM root for recovery boots; main-path roots use the physical disk')
        p.add_argument('--disk', choices=DISK_ACTIONS,
                       help='physical disk root (default), or an explicit recovery install')
        p.add_argument('--content-type', choices=('application/octet-stream',),
                       help='a test payload served with this type instead of its form\'s own')
        p.add_argument('--serve-as', choices=('boot.iso', 'boot.efi'),
                       help='answer the fixed URI with a redirect to this name beside it, and serve the file there')
    p = sub.add_parser('stop')
    p.add_argument('id')
    p = sub.add_parser('inputs-ready')
    p.add_argument('id')
    p = sub.add_parser('inputs-failed')
    p.add_argument('id')
    p.add_argument('why')
    sub.add_parser('status')
    args, _ = parser.parse_known_args()
    if args.command in ('launch', 'run'):
        if args.payload == 'disk-readback' and not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.source_boot or ''):
            parser.error('disk-readback needs --source-boot ID')
        try:
            validate_xhci_fault(args)
        except ValueError as error:
            parser.error(str(error))
        if args.mode == 'suite':
            if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*)*', args.suite or '') or len(set(suites(args))) != len(suites(args)):
                parser.error('suite mode needs --suite ID, or distinct ids joined by commas')
        elif args.suite:
            parser.error('--suite needs suite mode')
        if (args.payload == 'persistent') != (args.mode == 'persistent'):
            parser.error('a persistent boot needs the persistent payload and mode together')
        if args.payload not in ('image', 'persistent') and args.mode != 'default':
            parser.error('boot modes need an image payload')
        if (args.entry or args.slot_action or args.run or args.verify or args.adopt) and args.payload != 'persistent':
            parser.error('--entry, --slot-action, --run, --verify and --adopt need a persistent boot')
        if args.inject == FENCE_FAULT and (args.payload != 'image' or args.mode != 'default' or args.disk not in (None, 'root')):
            parser.error('the fence fault needs a default disk-root image boot')
        if args.disk == 'install' and args.mode not in ('probe', 'console'):
            parser.error('--disk install needs probe or console mode')
        if args.mode == 'tests' and (args.inject or args.disk == 'install'):
            parser.error('tests mode needs a disk-root boot without --inject')
        if args.session and (args.mode != 'console' or args.input or args.disk == 'install'):
            parser.error('--session needs console mode, operator input and no disk install')
        if not 1 <= args.idle_minutes <= 240 or (args.idle_minutes != 30 and not args.session):
            parser.error('--idle-minutes needs a console session and 1 through 240 minutes')
        if args.attended and (args.session or args.mode != 'console' or args.input or args.payload != 'image' or args.disk == 'install'):
            parser.error('--attended needs a console boot, without --session or --input')
        if args.wait is None:
            args.wait = 30 if args.attended else 240
        if not 0 < args.wait <= 240:
            parser.error('--wait needs more than 0 through 240 minutes')
        if args.mode == 'console' and not args.session and not args.attended and args.input != 'sol':
            parser.error('console typing waits for the injector; development boots require --input sol')
        if args.input and args.mode != 'console':
            parser.error('--input needs console mode')
    if args.command in ('launch', 'run') and args.payload == 'image' and not args.disk and not xhci_fault(args):
        args.disk = 'root'
    if args.command in ('launch', 'run') and args.inject == 'disk-before-mount' and (args.payload != 'image' or args.disk != 'root'):
        parser.error('disk-before-mount needs a disk-root image boot')
    if args.command == 'launch':
        extra = sys.argv[2:]
        if '--wait' not in extra:
            extra += ['--wait', str(args.wait)]
        if args.disk and '--disk' not in extra:
            extra += ['--disk', args.disk]
        if args.id:
            index = extra.index('--id')
            del extra[index:index + 2]
        return launch(args, extra)
    if args.command == 'run':
        if not args.id or not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.id):
            parser.error('run needs --id in the form YYYYMMDDTHHMMSSZ-metal')
        return Driver(args).run()
    if args.command == 'stop':
        directory = m.boot_dir(args.id)
        if not directory.is_dir() or (directory / 'ended').exists():
            print('no such running boot', file=sys.stderr)
            return 1
        (directory / 'stop-request').touch()
        return 0
    if args.command in ('inputs-ready', 'inputs-failed'):
        inputs = m.stage_dir(args.id) / 'inputs'
        inputs.mkdir(parents=True, exist_ok=True)
        if args.command == 'inputs-ready':
            (inputs / 'ready').touch()
        else:
            (inputs / 'failed').write_text(args.why[:300] + '\n')
        return 0
    return status()


if __name__ == '__main__':
    sys.exit(main())
