def status():
    finished = []
    path = m.STATE / 'finished.jsonl'
    if path.exists():
        for line in path.read_text().splitlines()[-10:]:
            entry = json.loads(line)
            directory = m.boot_dir(entry['id'])
            entry['exit'] = (directory / 'exit-status').read_text().strip() if (directory / 'exit-status').exists() else None
            finished.append(entry)
    print(json.dumps({'lease': m.read_lease(), 'queue': m.read_queue(), 'machine': m.read_json(m.STATE / 'machine.json'),
                      'finished': finished}, indent=1))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('launch', 'run'):
        p = sub.add_parser(name)
        p.add_argument('--id')
        p.add_argument('--payload', choices=PAYLOADS, default='image')
        p.add_argument('--mode', choices=MODES, default='default')
        p.add_argument('--input', choices=('sol',))
        p.add_argument('--wait', type=float, default=None, metavar='MIN', help='queue wait (default 240 minutes)')
        p.add_argument('--session', action='store_true', help='hold the console for operator input, without scoring')
        p.add_argument('--screen-known-json', type=json.loads, help=argparse.SUPPRESS)
        p.add_argument('--screen-proof', action='store_true', help='enable screen proof checkpoints')
        p.add_argument('--idle-minutes', type=int, default=30, help='session input idle limit (1 through 240; default 30)')
        p.add_argument('--suite')
        p.add_argument('--root-fs', choices=('breenfs',), help='opt in to a BreenFS test root with --disk root')
        p.add_argument('--case')
        p.add_argument('--kernel-command-line')
        p.add_argument('--gt710-category', choices=('core', 'panic', 'clocks'))
        p.add_argument('--milestone')
        p.add_argument('--source-boot')
        p.add_argument('--migration-phase', choices=metal_migration.PHASES, help=argparse.SUPPRESS)
        p.add_argument('--reclaim-upgrades', nargs=2, help=argparse.SUPPRESS)
        p.add_argument('--commit', default='')
        p.add_argument('--target', default='main')
        p.add_argument('--catchup', action='store_true')
        p.add_argument('--build-choice', type=json.loads, help=argparse.SUPPRESS)
        p.add_argument('--transfer-input', type=json.loads, help=argparse.SUPPRESS)
        p.add_argument('--task', default='')
        p.add_argument('--no-wait', action='store_true')
