def ceiling_seconds(args):
    migration = getattr(args, 'migration_phase', None)
    if migration == 'migrate':
        return 3 * 60 * 60
    if args.payload == metal_export.PAYLOAD:
        total_bytes = sum(metal_persist.SIZES[role] for role in metal_export.ROLES)
        if migration == 'readback':
            total_bytes = 2 * metal_migration.MAX_DATA
        transfer_seconds = (total_bytes + EXPORT_BYTES_PER_SECOND - 1) // EXPORT_BYTES_PER_SECOND
        return transfer_seconds + EXPORT_OVERHEAD_SECONDS
    if args.mode == 'suite':
        # The base includes startup and a 900-second first suite; longer suites need more time.
        names = suites(args)
        first_extension = max(0, mode_deadline_seconds(args, names[0]) - 900) if names else 0
        return CEILING_SECONDS['suite'] + first_extension + sum(mode_deadline_seconds(args, name) for name in names[1:])
    if persistent(args) and session(args):
        # A persistent session keeps the machine with no deadline until it is stopped or powered off.
        return None
    return SESSION_CEILING_SECONDS if session(args) else CEILING_SECONDS[args.mode]


MODE_DEADLINE_SECONDS = {'default': 300, 'shell': 180, 'probe': 300, 'suite': 420, 'console': 300, 'tests': 600,
                         'persistent-install': 1200, 'persistent': 600}


def mode_deadline_seconds(args, suite=None):
    """Give long-running suites their own DONE deadlines."""
    name = suite or (suites(args)[0] if args.mode == 'suite' else None)
    if args.mode == 'suite':
        milestone = getattr(args, 'milestone', None)
        if milestone == KERNEL_ASSEMBLY_MILESTONE:
            # Case budgets (seconds): toolchain 1415, processes 1540, signals 1260,
            # time 935. Keep the existing toolchain deadline and at least 25% reserve per suite.
            deadlines = {'toolchain': 1969, 'processes': 1925, 'signals': 1575, 'time': 1169}
            if name in deadlines:
                return deadlines[name]
        if milestone == 'toolchain/busybox-on-box':
            # E25 ruling 65: add a 25% reserve to each suite's case budgets.
            # Toolchain: 735 existing + 6*10 + 13*60 = 1575. Libc: 260*10.
            # Utilities: 194*10. Keep the reserve on each stage's DONE timer.
            deadlines = {'toolchain': 1969, 'libc': 3250, 'utilities': 2425}
            if name in deadlines:
                return deadlines[name]
        # Seven 610 s watchdogs under E25 ruling 126, plus at least 25% reserve.
        if name == 'd1':
            return 5338
        base = {'breengel': 900, 'window-manager': 1800, 'ui-testing': 1800}.get(name, MODE_DEADLINE_SECONDS['suite'])
        return base + (intent_manifest.counts().get(name, 0) if getattr(args, 'screen_proof', False) else 0)
    return MODE_DEADLINE_SECONDS[args.mode]

