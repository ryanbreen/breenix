            command = ['systemd-run', '--quiet', '--wait', '--pipe', '--collect',
                       '--property=DynamicUser=yes', '--property=PrivateTmp=yes', '--property=PrivateNetwork=yes',
                       '--property=BindReadOnlyPaths=' + str(root) + ':' + str(sandbox),
