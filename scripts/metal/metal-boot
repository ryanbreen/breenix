def tools_commit():
    path = m.TOOLS / 'COMMIT'
    return path.read_text().strip() if path.exists() else None


def unit_name(boot_id):
    return 'metal-boot-' + boot_id


def boot_id_now():
    return time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-metal'


class Finish(Exception):
    def __init__(self, status, reason, hung=False):
        super().__init__(reason)
        self.status, self.reason, self.hung = status, reason, hung


