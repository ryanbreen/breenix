class Finish(Exception):
    def __init__(self, status, reason, hung=False):
        super().__init__(reason)
        self.status, self.reason, self.hung = status, reason, hung


class PowerCut(Finish):
    def __init__(self, line=None, observed_at=None, serial_offset=None):
        super().__init__(m.EXIT_SHORT, 'deliberate power cut')
        self.line = line
        self.observed_at = observed_at
        self.serial_offset = serial_offset


class BootManagerAbort(Finish):
    def __init__(self, line, observed_at):
        super().__init__(m.EXIT_DELIVERY, 'the boot manager did not stay on the requested test path')
