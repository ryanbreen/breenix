def measured_stages(metal, mode, catalog):
    """Track each measured milestone in its own print order, including delayed kernel producers."""
    markers = {stage['name']: stage for stage in catalog.get('stages', [])}
    groups = []
    for milestone in metal.get('milestones', []):
        if milestone.get('stub'):
            continue
        lists = milestone.get('stages', {})
        listed = lists.get(mode, lists.get(metal['gateArch'], []) if milestone.get('kernel') else [])
        group = []
        for stage in listed:
            spec = markers.get(stage, {}) if isinstance(stage, str) else stage
            if 'host' in spec:
                continue  # These are checked by preflight, delivery and console setup.
            if not spec.get('marker'):
                raise ValueError('unresolved measured serial stage')
            group.append((spec['marker'], spec.get('match', 'contains')))
        if group:
            groups.append(group)
    return groups


def final_marker(metal, mode, catalog):
    """Resolve the final measured serial stage and preserve its matching contract. A stub milestone's markers are
    proposals its producing lane has not landed (docs/metal/boot-path.json), so no boot measures it yet."""
    markers = {stage['name']: stage for stage in catalog.get('stages', []) if 'marker' in stage}
    milestones = [milestone for milestone in reversed(metal.get('milestones', [])) if not milestone.get('stub')]
    scoped = [milestone.get('stages', {}).get(mode) for milestone in milestones]
    scoped = [listed for listed in scoped if listed]
    if not scoped:
        scoped = [milestone.get('stages', {}).get(metal.get('gateArch', 'x86_64'))
                  for milestone in milestones if milestone.get('kernel')]
    for listed in scoped:
        if not listed:
            continue
        for stage in reversed(listed):
            if isinstance(stage, dict) and 'host' in stage:
                continue
            stage = stage if isinstance(stage, dict) else markers.get(stage, {})
            if stage.get('marker'):
                return (stage['marker'], stage.get('match', 'contains'))
            return None
    return None


def launch(args, extra):
    boot_id = args.id or boot_id_now()
    unit = unit_name(boot_id)
    command = ['systemd-run', '--unit', unit, '--collect', '--property', 'MemoryMax=256M',
               '--setenv', 'BREENIX_METAL_SITE=' + str(m.SITE_PATH), sys.executable, str(Path(__file__).resolve()),
               'run', '--id', boot_id] + extra
    subprocess.run(command, check=True, capture_output=True)
    claim = m.boot_dir(boot_id) / 'claim.json'
    deadline = m.now() + 30
    status = 'starting'
    while m.now() < deadline:
        state = m.read_json(claim)
        if state:
            status = state['status']
            break
        if not m.unit_active(unit) and (m.boot_dir(boot_id) / 'ended').exists():
            status = 'ended'
            break
        time.sleep(0.25)
    print(json.dumps({'id': boot_id, 'unit': unit, 'status': status}))
    return {'claimed': 0, 'waiting': 0, 'busy': 75, 'quarantined': 75, 'not-ready': 75}.get(status, 1)


