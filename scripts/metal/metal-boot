    p.add_argument('id')
    p.add_argument('why')
    sub.add_parser('status')
    args, _ = parser.parse_known_args()
    if args.command in ('launch', 'run'):
        transfer = transfer_fixture.selected(args.suite)
        if transfer:
            facts = args.transfer_input
            if (args.mode != 'suite' or args.payload != 'image' or args.session or args.case or args.inject
                    or args.disk == 'install' or not isinstance(facts, dict)
                    or not re.fullmatch(r'\d{8}T\d{6}Z-metal', facts.get('prebuilt', ''))
                    or not re.fullmatch(r'[a-f0-9]{64}', facts.get('sha256', ''))
                    or type(facts.get('size')) is not int or facts['size'] <= 0):
                parser.error('transfer-fixture needs a bounded suite boot with a hashed Mac input')
        elif args.transfer_input is not None:
            parser.error('--transfer-input needs --suite transfer-fixture')
        if args.gt710_category and args.mode == 'default':
            args.mode = 'probe'
        if args.root_fs is not None and (
                args.disk != 'root' or args.payload != 'image' or args.mode not in ('default', 'suite', 'console')):
            parser.error('--root-fs breenfs needs --disk root and an image boot in default, suite or console mode')
        if args.payload == 'disk-readback' and not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.source_boot or ''):
            parser.error('disk-readback needs --source-boot ID')
        if args.payload == metal_export.PAYLOAD and (
                args.disk or args.inject or args.nmi or args.source_boot or args.slot_action
                or args.resting or not re.fullmatch(r'[0-9a-f]{40}', args.commit)):
            parser.error('persistent export needs a commit and a firmware-only boot')
        if args.payload == metal_persist.RECLAIM_PAYLOAD:
            if (not args.reclaim_upgrades or any(not metal_migration.BOOT_ID.fullmatch(boot)
                                                for boot in args.reclaim_upgrades)
                    or args.reclaim_upgrades[0] >= args.reclaim_upgrades[1]
                    or not metal_migration.COMMIT.fullmatch(args.commit)
                    or not re.fullmatch(r'branch:metal-[a-z0-9_-]+/[a-zA-Z0-9_./-]+', args.target)
                    or any((args.disk, args.inject, args.nmi, args.source_boot, args.session,
                            args.resting, args.migration_phase, args.upgrade_parent, args.power_cut_after,
                            args.power_cut_window, args.breenfs_bit_flip, args.gt710_category))):
                parser.error('ext2 reclaim needs two upgrade IDs, a pinned metal branch and a firmware-only boot')
        elif args.reclaim_upgrades:
            parser.error('--reclaim-upgrades needs the ext2 reclaim payload')
        if args.migration_phase:
            phase = args.migration_phase
            payload = ('persistent' if phase in ('rescue', 'return') else metal_export.PAYLOAD
                       if phase == 'readback' else 'image')
            entry = 'previous' if phase == 'rescue' else 'current' if phase == 'return' else None
            if (args.payload != payload or args.mode != ('persistent' if entry else 'default')
                    or args.entry != entry or args.slot_action != ('commit' if phase == 'rescue' else None)
                    or args.verify != bool(entry) or args.session or args.run or args.inject or args.nmi
                    or args.disk not in ((None, 'root') if payload == 'image' else (None,))
                    or args.root_fs or args.resting or args.adopt or args.breenfs_bit_flip
                    or args.power_cut_window or args.power_cut_after or args.gt710_category
                    or args.source_boot or not re.fullmatch(r'[0-9a-f]{40}', args.commit)):
                parser.error('invalid E24 migration phase arguments')
        try:
            metal_power_cut.validate(args)
            validate_xhci_fault(args)
            kernel_profile(args)
            if args.gt710_category and (args.payload != 'image' or session(args)):
                raise ValueError('--gt710-category needs an automated image boot')
        except ValueError as error:
            parser.error(str(error))
        if args.mode == 'suite':
            if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*(?:,[a-z0-9]+(?:-[a-z0-9]+)*)*', args.suite or '') or len(set(suites(args))) != len(suites(args)):
                parser.error('suite mode needs --suite ID, or distinct ids joined by commas')
        elif args.suite:
            parser.error('--suite needs suite mode')
        if args.milestone and args.mode != 'suite':
            parser.error('--milestone needs suite mode')
        if (args.payload == 'persistent') != (args.mode == 'persistent'):
            parser.error('a persistent boot needs the persistent payload and mode together')
        if args.payload not in ('image', 'persistent') and args.mode != 'default':
            parser.error('boot modes need an image payload')
        if (args.entry or args.slot_action or args.run or args.verify or args.adopt) and args.payload != 'persistent':
            parser.error('--entry, --slot-action, --run, --verify and --adopt need a persistent boot')
        if args.entry == 'rescue' and (not args.verify or args.run or args.slot_action or args.adopt or args.resting):
            parser.error('the ext2 rescue needs a bounded verification boot without slot actions')
        if args.inject in WATCHDOG_FAULTS and (args.payload != 'image' or args.mode != 'default' or args.disk or args.nmi):
            parser.error('watchdog fault needs a default RAM-disk image boot without --nmi')
        if args.inject == FENCE_FAULT and (args.payload != 'image' or args.mode != 'default' or args.disk not in (None, 'root')):
            parser.error('the fence fault needs a default disk-root image boot')
        if args.disk == 'install' and args.mode not in ('probe', 'console'):
