    def challenge_console(self, text, complete=False):
        if xhci_fault(self.args):
            return
        if self.args.mode != 'console' or session(self.args) or self.fatal_at is not None:
            return
        if attended(self.args):
            if not complete and not text.startswith('Breenix login: '):
                return
            self.console_done = self.attended_challenge.feed(text)
            if self.attended_challenge.invalid and not self.completion_reported:
                self.completion_reported = True
                raise Finish(m.EXIT_SHORT, 'input other than the USB keyboard reached the console; the challenge cannot pass')
            if (self.console_done and self.final_seen and not any(self.required_stages)
                    and not self.completion_reported):
                self.completion_reported = True
                self.event('attended-challenge-complete')
                raise Finish(m.EXIT_DONE, 'USB keyboard challenge completed')
            return
        step = self.console_step
        if step in (0, 3) and 'login: ' in text:
            self.console_step += 1
            self.console_send(self.site['CONSOLE_USER'])
        elif step in (1, 4) and 'Password: ' in text:
            self.console_step += 1
            self.console_send('deliberately-wrong-password' if step == 1 else self.site['CONSOLE_PASSWORD'])
        elif step == 2 and 'Login incorrect' in text:
            self.console_step = 3
            self.event('console-wrong-password-refused')
        elif step == 5 and re.search(r'bsh [^\n]*>', text):
            self.console_step = 6
            self.console_send('print("metal-login-ok", 6*7)')
        elif step == 6 and text.strip() == 'metal-login-ok 42':
            self.console_step = 7
            self.event('console-computation-answered')
            self.console_send('cat /proc/fbcon/check')
        elif step == 7 and complete and text.startswith('fbcon check: '):
            self.console_step = 8
        elif step == 8 and re.match(r'bsh [^\n]*>', text):
            # The prompt after cat: its rows are complete, so typing cannot interleave with them.
            self.console_step = 9
            self.console_send('exit')
        elif step == 9 and '[init] console session ended; restarting getty' in text:
            self.console_step = 10
        elif step == 10 and '[getty] console acquired' in text:
            self.console_step = 11
        elif step == 11 and 'login: ' in text:
            self.console_step = 12
            self.console_done = True
            self.event('console-logout-returned-to-getty')
