    # claim-lint:ok: #1680 Reviewed tool contract against this function and the host tests in tests/metal_tools_test.py.
    # Record helpers: event text is always a fixed template or redacted.
    def event(self, kind, *, observed_at=None, **fields):
        m.event(self.dir, kind, observed_at=observed_at, **{k: (self.redact(v) if isinstance(v, str) else v) for k, v in fields.items()})

    def phase(self, text):
        m.phase(self.dir, self.redact(text))

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def since_power(self):
        return 0 if self.t0 is None else m.now() - self.t0

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    # Setup of the record and the lease.
    def create_record(self):
        self.dir.mkdir(parents=True, exist_ok=False)
        target = {'main': {}}
        if self.args.target.startswith('branch:'):
            target = {'branch': {'name': self.args.target.split(':', 1)[1]}}
        kind = 'fault-test' if xhci_fault(self.args) else 'console-session' if session(self.args) else {'image': 'boot', 'linux': 'platform-census'}.get(self.args.payload, 'fault-test')
        run = {'id': self.id, 'platform': 'metal', 'arch': 'x86_64', 'mode': self.args.mode, 'target': target,
               'taskName': self.args.task or self.id, 'watch': False, 'display': False, 'startedAt': m.now(),
               'payload': self.args.payload, 'kind': kind, 'suite': getattr(self.args, 'suite', None), 'inject': self.args.inject or None,
               'disk': getattr(self.args, 'disk', None), 'toolsCommit': tools_commit(),
               'input': input_kind(self.args),
               'attended': attended(self.args),
               'waitMinutes': self.args.wait if attended(self.args) else None,
               'session': session(self.args),
               'idleMinutes': getattr(self.args, 'idle_minutes', 30) if session(self.args) else None,
               'evidenceEligible': not xhci_fault(self.args) and not session(self.args) and (self.args.mode != 'console' or attended(self.args))}
        m.write_json(self.dir / 'run.json', run)
        m.write_text(self.dir / 'commit', (self.args.commit or 'none') + '\n')
        m.write_text(self.dir / 'dirty', '0\n')
        (self.dir / 'console.log').touch()
        (self.dir / 'events.jsonl').touch()
        self.event('created', payload=self.args.payload, mode=self.args.mode, inject=self.args.inject or 'none',
                   nmi=bool(getattr(self.args, 'nmi', False)))

    def claim_status(self, status, text=''):
        m.write_json(self.dir / 'claim.json', {'status': status, 'text': text, 't': m.now()})

    def claim(self):
        holder = {'id': self.id, 'unit': self.unit, 'mode': self.args.mode, 'payload': self.args.payload,
                  'kind': 'console-session' if session(self.args) else 'boot'}
        try:
            m.claim_lease(holder, wait=not self.args.no_wait, checkpoint=self.checkpoint,
                          on_wait=lambda lease: (self.claim_status('waiting'),
                                                 self.phase('Waiting for the machine to finish another boot')))
        except m.Busy:
            self.claim_status('busy')
            raise Finish(m.EXIT_BUSY, 'the machine is busy with another boot')
        except m.Quarantined:
            self.claim_status('quarantined')
            raise Finish(m.EXIT_BUSY, 'the machine may still be on: power-off failed and the lease is quarantined')
        except m.NotReady:
            self.claim_status('not-ready')
            raise Finish(m.EXIT_BUSY, 'the machine service is not ready')
        self.claimed = True
        self.claim_status('claimed')
        self.event('lease-claimed')
        threading.Thread(target=self.heartbeat, daemon=True).start()

    def heartbeat(self):
        while not self.stopping.wait(m.HEARTBEAT_SECONDS):
            if not m.update_lease(self.id, phase=self.phase_name):
                self.lost = True

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def checkpoint(self):
        if self.lost:
            raise Finish(m.EXIT_INCOMPLETE, 'the lease was taken from this boot')
        if (self.dir / 'stop-request').exists():
            if self.t0 is None:
                raise Finish(m.EXIT_CANCELLED, 'cancelled before power-on')
            raise Finish(m.EXIT_STOPPED, 'stopped by the operator')

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    # Inputs and the image.
    def prepare_payload(self):
        self.stage.mkdir(parents=True, exist_ok=True)
        if self.args.payload == 'none':
            self.event('nothing-staged')
            return
        if self.args.payload.startswith('hang'):
            # metal-hang.efi bare, or as \EFI\BOOT\BOOTX64.EFI in a small RAM-disk image or ISO: the delivery
            # ladder's probes of which image forms the firmware accepts.
            efi = self.stage / 'metal-hang.efi'
            efi.write_bytes(metal_image.hang_efi())
            path, form = efi, 'efi'
            if self.args.payload == 'hang-img':
                path, form = self.stage / 'metal-hang.img', 'img'
                metal_image.assemble(path, {'efi/boot/bootx64.efi': efi})
            elif self.args.payload == 'hang-iso':
                path, form = self.stage / 'metal-hang.iso', 'iso'
                metal_image.iso(path, {'efi/boot/bootx64.efi': efi}, self.stage)
            self.payload_facts = {'path': path, 'size': path.stat().st_size, 'sha256': metal_image.sha256(path),
                                  'contentType': self.args.content_type or metal_image.CONTENT_TYPES[form],
                                  'name': path.name}
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            self.event('payload-ready', name=path.name, size=self.payload_facts['size'],
                       sha256=self.payload_facts['sha256'])
            return
        self.phase_name = 'building'
        self.phase('Building the image')
        inputs = self.stage / 'inputs'
        deadline = m.now() + INPUT_DEADLINE_SECONDS
        while not (inputs / 'ready').exists():
            self.checkpoint()
            if (inputs / 'failed').exists():
                why = (inputs / 'failed').read_text().strip()[:300]
                self.event('build-failed', why=why)
                raise Finish(m.EXIT_CANCELLED, 'the image build failed')
            if m.now() > deadline:
                raise Finish(m.EXIT_CANCELLED, 'the image build did not deliver its inputs in time')
            time.sleep(2)
        if self.args.payload == 'linux':
            manifest = m.read_json(inputs / 'build.json', {})
            image = inputs / 'metal-linux.efi'
            expected = manifest.get('files', {}).get('efi', {})
            if (image.stat().st_size != expected.get('size') or
                    metal_image.sha256(image) != expected.get('sha256')):
                raise Finish(m.EXIT_CANCELLED, 'Linux payload checksum mismatch')
            config = inputs / 'config'
            config_facts = manifest.get('files', {}).get('config', {})
            if (config.stat().st_size != config_facts.get('size') or
                    metal_image.sha256(config) != config_facts.get('sha256')):
                raise Finish(m.EXIT_CANCELLED, 'Linux configuration checksum mismatch')
            try:
                metal_census.validate_config(config.read_text())
            except ValueError:
                raise Finish(m.EXIT_CANCELLED, 'Linux configuration violates instrument constraints')
            shutil.copyfile(inputs / 'build.json', self.dir / 'linux-build.json')
            shutil.copyfile(inputs / 'config', self.dir / 'linux-config')
            self.payload_facts = {'path': image, 'size': expected['size'], 'sha256': expected['sha256'],
                                  'contentType': metal_image.CONTENT_TYPES['efi'], 'name': 'metal-linux.efi'}
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            self.event('linux-payload-ready', sha256=expected['sha256'], size=expected['size'])
            return
        build = m.read_json(inputs / 'build.json', {})
        if build.get('commit') != self.args.commit or build.get('profile') != 'production' or build.get('features') != []:
            raise Finish(m.EXIT_CANCELLED, 'build provenance differs from the requested production commit')
        self.delivery['build'] = build
        self.event('build-delivered', commit=build.get('commit'), guard=build.get('guardTarget'))
        if (inputs / 'definition').is_dir():
            shutil.copytree(inputs / 'definition', self.dir / 'definition')
        if self.args.mode == 'suite':
            manifest = self.dir / 'definition/docs/suites' / (self.args.suite + '.json')
            if not manifest.is_file() or m.read_json(manifest).get('id') != self.args.suite:
                raise Finish(m.EXIT_CANCELLED, 'the suite manifest is missing or differs')
        disk = getattr(self.args, 'disk', None)
        if disk == 'root':
            # The root is the disk the last install wrote; nothing is staged onto it.
            installed = m.read_json(m.STATE / 'disk.json')
            if not installed:
                raise Finish(m.EXIT_CANCELLED, 'no verified install is recorded for the disk')
            if installed.get('commit') != self.args.commit:
                raise Finish(m.EXIT_CANCELLED, 'the recorded install is from a different commit; install this commit first')
            if self.args.mode == 'console':
                if (installed.get('mode') != 'console'
                        or installed.get('consoleIdentity') != metal_root.console_identity(self.site)):
                    raise Finish(m.EXIT_CANCELLED, 'the installed root has a different console target or credential')
            elif installed.get('mode', 'probe') != self.args.mode:
                raise Finish(m.EXIT_CANCELLED, 'the installed root has a different boot target')
            self.delivery['diskRoot'] = installed
            self.event('disk-root-expected', installedBy=installed.get('installedBy'), bytes=installed.get('bytes'))
        else:
            self.delivery['root'] = metal_root.stage_root(inputs / 'ext2.img', self.args.mode,
                                                           getattr(self.args, 'suite', None), self.site,
                                                           install=self.id if disk == 'install' else None,
                                                           hasher=inputs / 'sha512-crypt',
                                                           idle_minutes=getattr(self.args, 'idle_minutes', 30) if session(self.args) else None,
                                                           replug=self.args.mode == 'console' and not session(self.args) and not xhci_fault(self.args),
                                                           xhci_fault=xhci_fault(self.args))
            if disk == 'install':
                write = self.delivery['root']['diskWrite']
                m.write_json(self.dir / 'disk-write.json', write)
                self.event('disk-write-requested', bytes=write['bytes'], sha256=write['sha256AfterRecord'])
        self.phase('Assembling the image')
        extracted = self.stage / 'esp'
        files = metal_image.extract_esp(inputs / 'uefi.img', extracted)
        root_ramdisk = self.args.ramdisk and disk != 'root'
        if root_ramdisk:
            files['ramdisk'] = inputs / 'ext2.img'
        if disk == 'root' and self.args.mode == 'console':
            # The installed target cannot describe this boot's session/test
            # choice. A small intent payload rides the RAM-payload slot and is
            # consumed before root discovery; it is not a RAM-disk root.
            self.console_intent = 'session' if session(self.args) else 'measure'
            self.delivery['consoleIntent'] = self.console_intent
            intent = self.stage / 'console-intent'
            intent.write_bytes(b'BREENIX-CONSOLE 1\n' + self.console_intent.encode() + b'\n')
            files['ramdisk'] = intent
        disk = self.stage / 'boot-disk.img'
        facts = metal_image.assemble(disk, files)
        shutil.rmtree(extracted, ignore_errors=True)
        # The firmware boots only a bare EFI application over HTTP: the stub carries the disk (README, "Delivery").
        image = self.stage / 'boot.efi'
        wrapped = metal_image.stub_efi(inputs / 'stub.efi', disk, image)
        disk.unlink()
        for name in ('uefi.img', 'ext2.img', 'stub.efi'):
            (inputs / name).unlink(missing_ok=True)
        self.payload_facts = {'path': image, 'size': wrapped['size'], 'sha256': wrapped['sha256'],
                              'contentType': metal_image.CONTENT_TYPES['efi'], 'name': 'boot.efi'}
        self.delivery['image'] = {'name': 'boot.efi', 'size': wrapped['size'], 'sha256': wrapped['sha256'],
                                  'contentType': self.payload_facts['contentType'], 'stub': wrapped['stub'],
                                  'disk': {'size': facts['size'], 'sha256': facts['sha256'],
                                           'components': facts['components']}}
        self.event('image-assembled', size=wrapped['size'], sha256=wrapped['sha256'], disk=facts['size'],
                   ramdisk=root_ramdisk, consoleIntent=self.console_intent)
        self.load_definition()

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def load_definition(self):
        """Fatal patterns and the mode's final marker come from this boot's own definition copy."""
        definition = self.dir / 'definition'
        metal = m.read_json(definition / 'docs/metal/boot-path.json')
        main = m.read_json(definition / 'docs/boot-path.json', {})
        source = metal or main
        self.fatal_patterns = [re.compile(p) for p in (source or {}).get('fatal', [])]
        if metal and attended(self.args):
            self.attended_challenge = metal_attended.Challenge(metal_attended.stages(metal))
            metal = metal_score.attended_definition(metal)
        if metal and not session(self.args):
            catalog = m.read_json(definition / 'tools/breenix-runs/Sources/BreenixRuns/Resources/boot-stages-x86_64.json', {})
            shape = boot_shape(getattr(self.args, 'disk', None))
            kind = input_kind(self.args)
            self.final_marker = final_marker(metal, self.args.mode, catalog, shape, kind)
            self.required_stages = measured_stages(metal, self.args.mode, catalog, shape, kind)
        if xhci_fault(self.args):
            marker = '[xhci-fault] ' + xhci_fault(self.args) + ' PASS:'
            self.final_marker = (marker, 'contains')
            self.required_stages = [[(marker, 'contains')]]
            self.console_done = True
        if self.args.mode == 'probe':
            self.final_marker = ('PROBE DONE ', 'contains')
        if self.args.mode == 'suite':
            self.final_marker = ('SUITE ' + self.args.suite + ' DONE ', 'contains')
        self.event('definition', metalPath=bool(metal), fatalPatterns=len(self.fatal_patterns),
                   finalMarker=self.final_marker is not None)

    # Read-only checks before power-on.
    def preflight(self):
        self.phase_name = 'preflight'
        self.phase('Checking the machine')
        try:
            rows, baseline = m.machine_checks(self.site)
        except m.BmcError as error:
            self.event('preflight-error', error=str(error))
            raise Finish(m.EXIT_DELIVERY, 'pre-flight could not read the machine')
        failed = m.failed_checks(rows)
        self.event('preflight', checks=len(rows), failed=[name for name, _, _ in failed])
        self.delivery['baseline'] = baseline
        self.event('baseline', **baseline)
        self.post_code = baseline.get('postCode')
        self.progress_key = progress_key(baseline.get('bootProgress'))
        if baseline.get('power') != 'Off':
            self.event('stray-power-on', power=baseline.get('power'))
            if not m.force_off_and_wait():
                m.quarantine_lease(self.id, 'pre-flight power-off failed')
                raise Finish(m.EXIT_DELIVERY, 'the machine was on and would not power off')
            failed = [row for row in failed if row[0] != 'boot.BootSourceOverrideEnabled']
        if failed:
            raise Finish(m.EXIT_DELIVERY, 'pre-flight: ' + ', '.join(name for name, _, _ in failed))

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def do_stage(self):
        if self.payload_facts:
            facts = self.payload_facts
            redirect = None
            if self.args.serve_as:
                redirect = m.load_site()['BOOT_URL'].split('://', 1)[1].split('/', 1)[1].rsplit('/', 1)[0]
                redirect = '/' + redirect + '/' + self.args.serve_as
            m.stage(self.id, facts['path'], facts['sha256'], facts['size'], facts['contentType'], redirect)
            self.event('staged', name=facts['name'], size=facts['size'], sha256=facts['sha256'],
                       redirectedTo=self.args.serve_as or None)
        else:
            m.unstage()
        log = m.STATE / 'http.jsonl'
        self.http_offset = log.stat().st_size if log.exists() else 0

    # The console.
    def start_console(self):
        self.phase_name = 'console'
        raw = self.dir / 'serial.raw'
        raw.touch()
        (self.dir / 'serial.txt').touch()
        (self.dir / 'serial.ts').touch()
        for attempt in (1, 2):
            with contextlib.suppress(m.BmcError):
                m.sol_deactivate()
            start = raw.stat().st_size
            self.spawn_console(fresh=attempt == 1)
            deadline = m.now() + CONSOLE_WAIT_SECONDS
            while m.now() < deadline:
                self.checkpoint()
                with raw.open('rb') as handle:
                    handle.seek(start)
                    if CONSOLE_BANNER in handle.read():
                        self.pump_serial()
                        self.event('console-ready', rawOffset=raw.stat().st_size, txtOffset=self.txt_bytes)
                        self.phase('Console ready')
                        return
                time.sleep(0.25)
            self.event('console-retry', attempt=attempt)
