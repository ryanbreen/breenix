def kernel_profile(args):
    """Expected build identity for this boot's requested mode and suite."""
    case = getattr(args, 'case', None)
    suite = getattr(args, 'suite', None)
    if case is not None:
        if (args.mode != 'suite' or args.payload != 'image' or not suite or suite == 'all' or ',' in suite
                or args.inject or getattr(args, 'gt710_category', None)
                or not re.fullmatch(r'[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?', case)):
            raise ValueError('--case needs one production suite and a category[/case] selector')
    category = getattr(args, 'gt710_category', None)
    if category is not None:
        if category not in ('core', 'panic', 'clocks') or args.mode not in ('default', 'probe') or getattr(args, 'suite', None) or args.inject:
            raise ValueError('gt710 diagnostic needs a default/probe boot without suites or injection')
        return {'panic':(['capture_panic_oracle'],'gpu-panic'),'core':(['gt710_core_probe'],'gpu-core'),'clocks':(['gt710_clock_probe'],'gpu-clock')}[category]
    if fault := metal_power_cut.kernel_fault(args):
        return [fault[0]], 'fault-test'
    features = (['watchdog_fault_inject'] if args.inject in WATCHDOG_FAULTS else
                ['xhci_fault_inject'] if xhci_fault(args) else
                ['block_fence_inject'] if args.inject == FENCE_FAULT else
                ['server_reboot_fault'] if args.inject == 'panic-reboot' else
                ['testing'] if args.mode == 'tests' else [])
    profile = {'watchdog_fault_inject': 'fault-test', 'xhci_fault_inject': 'fault-test',
               'block_fence_inject': 'fault-test', 'server_reboot_fault': 'fault-test',
               'testing': 'testing', 'gt710_core_probe': 'gpu-core',
               'gt710_clock_probe': 'gpu-clock'}.get(''.join(features), 'production')
    return features, profile


