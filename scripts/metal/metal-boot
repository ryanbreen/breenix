        if persistent(self.args):
            holder.update(entry=getattr(self.args, 'entry', None) or 'current',
                          slotAction=getattr(self.args, 'slot_action', None))
        return holder

    def claim_status(self, status, text='', **fields):
        m.write_json(self.dir / 'claim.json', dict(status=status, text=text, t=m.now(), **fields))

    def claim(self):
        holder = self.holder()
        def waiting(state):
            text = f"Waiting for holder={state['holder']} queue position={state['position']}"
            self.claim_status('waiting', text, **state)
            self.phase(text)

        wait = getattr(self.args, 'wait', None)
        queue_minutes = 240 if wait is None else wait
        try:
            m.claim_lease(holder, wait=True, checkpoint=self.checkpoint,
                          wait_seconds=queue_minutes * 60, on_wait=waiting)
        except m.Busy:
            self.claim_status('busy')
            raise Finish(m.EXIT_BUSY, 'the bounded machine queue wait expired')
        except m.Quarantined:
            self.claim_status('quarantined')
            raise Finish(m.EXIT_BUSY, 'the machine may still be on: power-off failed and the lease is quarantined')
        except m.NotReady:
            self.claim_status('not-ready')
            raise Finish(m.EXIT_BUSY, 'the machine service is not ready')
        self.claimed = True
        self.claim_status('claimed')
        self.event('lease-claimed')
        threading.Thread(target=self.heartbeat, daemon=True).start()

    def heartbeat(self):
        while not self.stopping.wait(m.HEARTBEAT_SECONDS):
            if not m.update_lease(self.id, phase=self.phase_name):
                self.lost = True

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def checkpoint(self):
        if threading.current_thread() is not getattr(self, 'hostkey_reader', None):
            self.drain_hostkey_events()
            error = getattr(self, 'hostkey_error', None)
            if error is not None:
                if isinstance(error, Finish):
                    raise error
                raise Finish(m.EXIT_SHORT, 'host key reader failed: ' + type(error).__name__)
        elif self.hostkey_stop.is_set():
            raise Finish(m.EXIT_STOPPED, 'host key reader stopped')
        if self.lost:
            raise Finish(m.EXIT_INCOMPLETE, 'the lease was taken from this boot')
        if (self.dir / 'stop-request').exists():
            if self.t0 is None:
                raise Finish(m.EXIT_CANCELLED, 'cancelled before power-on')
            raise Finish(m.EXIT_STOPPED, 'stopped by the operator')

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    # Inputs and the image.
    def prepare_payload(self):
        self.stage.mkdir(parents=True, exist_ok=True)
        if getattr(self.args, 'cut_recovery_from', None):
            self.prepare_cut_recovery_payload()
            return
        if self.args.payload == 'none':
            self.event('nothing-staged')
            return
        if self.migration_phase:
            self.migration = metal_migration.admit(
                self.migration_phase, self.id, self.args.commit, tools_commit())
            self.event('migration-admitted', phase=self.migration_phase)
        if persistent(self.args):
            if not self.migration_phase and metal_migration.in_progress():
                raise Finish(m.EXIT_CANCELLED, 'the E24 migration has parked the persistent install in the test loop')
            self.prepare_persistent()
            return
        if self.args.payload.startswith('hang'):
            # metal-hang.efi bare, or as \EFI\BOOT\BOOTX64.EFI in a small RAM-disk image or ISO: the delivery
            # ladder's probes of which image forms the firmware accepts.
            efi = self.stage / 'metal-hang.efi'
            efi.write_bytes(metal_image.hang_efi())
            path, form = efi, 'efi'
            if self.args.payload == 'hang-img':
                path, form = self.stage / 'metal-hang.img', 'img'
                metal_image.assemble(path, {'efi/boot/bootx64.efi': efi})
            elif self.args.payload == 'hang-iso':
                path, form = self.stage / 'metal-hang.iso', 'iso'
                metal_image.iso(path, {'efi/boot/bootx64.efi': efi}, self.stage)
            self.payload_facts = {'path': path, 'size': path.stat().st_size, 'sha256': metal_image.sha256(path),
                                  'contentType': self.args.content_type or metal_image.CONTENT_TYPES[form],
                                  'name': path.name}
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            self.event('payload-ready', name=path.name, size=self.payload_facts['size'],
                       sha256=self.payload_facts['sha256'])
            return
        self.phase_name = 'building'
        self.phase('Building the image')
        inputs = self.stage / 'inputs'
        deadline = m.now() + INPUT_DEADLINE_SECONDS
        while not (inputs / 'ready').exists():
            self.checkpoint()
            if (inputs / 'failed').exists():
                why = (inputs / 'failed').read_text().strip()[:300]
                self.event('build-failed', why=why)
                raise Finish(m.EXIT_CANCELLED, 'the image build failed')
            if m.now() > deadline:
                raise Finish(m.EXIT_CANCELLED, 'the image build did not deliver its inputs in time')
            time.sleep(2)
        if self.args.payload == 'manager':
            # The boot manager in probe mode, served bare: it asks the lab, reports and halts (README, "Probe mode").
            build = m.read_json(inputs / 'build.json', {})
            manager = inputs / 'manager.efi'
            if (build.get('commit') != self.args.commit or build.get('profile') != 'boot-manager'
                    or build.get('manager', {}).get('sha256') != metal_image.sha256(manager)):
                raise Finish(m.EXIT_CANCELLED, 'the boot manager differs from its build record')
            self.delivery['build'] = build
            self.payload_facts = dict(path=manager, size=manager.stat().st_size, sha256=metal_image.sha256(manager),
                                      contentType=metal_image.CONTENT_TYPES['efi'], name='metal-boot-manager.efi')
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            self.event('payload-ready', name='metal-boot-manager.efi', size=self.payload_facts['size'],
                       sha256=self.payload_facts['sha256'])
            return
        if self.args.payload == metal_persist.RECLAIM_PAYLOAD:
            self.prepare_reclaim(inputs)
            return
        if self.args.payload in ('disk-readback', metal_export.PAYLOAD):
            build = m.read_json(inputs / 'build.json', {})
            stub = inputs / 'stub.efi'
            if (build.get('commit') != self.args.commit or build.get('profile') != self.args.payload
                    or build.get('stub', {}).get('sha256') != metal_image.sha256(stub)):
                raise Finish(m.EXIT_CANCELLED, 'the readback firmware differs from its build record')
            self.delivery['build'] = build
            if self.args.payload == metal_export.PAYLOAD:
                facts, image = metal_export.prepare(self.stage, self.id, self.site, stub,
                                                    sparse=self.migration_phase == 'readback')
            else:
                facts, image = metal_disk.prepare_readback(self.dir, self.stage, self.args.source_boot,
                                                           self.args.commit, self.id, self.site, stub)
            self.payload_facts = dict(path=image, size=facts['size'], sha256=facts['sha256'],
                                      contentType=metal_image.CONTENT_TYPES['efi'], name='boot.efi')
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            return
        if self.args.payload == 'linux':
            manifest = m.read_json(inputs / 'build.json', {})
            image = inputs / 'metal-linux.efi'
            expected = manifest.get('files', {}).get('efi', {})
            if (image.stat().st_size != expected.get('size') or
                    metal_image.sha256(image) != expected.get('sha256')):
                raise Finish(m.EXIT_CANCELLED, 'Linux payload checksum mismatch')
            config = inputs / 'config'
            config_facts = manifest.get('files', {}).get('config', {})
            if (config.stat().st_size != config_facts.get('size') or
                    metal_image.sha256(config) != config_facts.get('sha256')):
                raise Finish(m.EXIT_CANCELLED, 'Linux configuration checksum mismatch')
            try:
                metal_census.validate_config(config.read_text())
            except ValueError:
                raise Finish(m.EXIT_CANCELLED, 'Linux configuration violates instrument constraints')
            shutil.copyfile(inputs / 'build.json', self.dir / 'linux-build.json')
            shutil.copyfile(inputs / 'config', self.dir / 'linux-config')
            self.payload_facts = {'path': image, 'size': expected['size'], 'sha256': expected['sha256'],
                                  'contentType': metal_image.CONTENT_TYPES['efi'], 'name': 'metal-linux.efi'}
            self.delivery['image'] = {k: v for k, v in self.payload_facts.items() if k != 'path'}
            self.event('linux-payload-ready', sha256=expected['sha256'], size=expected['size'])
            return
        build = m.read_json(inputs / 'build.json', {})
        features, profile = kernel_profile(self.args)
        prebuilt = (inputs / 'manifest.json').exists() or build.get('builder') == 'mac'
        if getattr(self.args, 'milestone', None) == 'toolchain/cc-hello' and (
                not prebuilt or build.get('toolchain', {}).get('candidateProducer') != 'mac-bcc'):
            raise Finish(m.EXIT_CANCELLED, 'toolchain/cc-hello requires a Mac prebuilt with bcc candidates')
        if prebuilt:
            try:
                manifest = metal_prebuilt.verify(inputs, commit=self.args.commit, tools_commit=tools_commit(),
                    mode=self.args.mode, features=features, suite=getattr(self.args, 'suite', None), staged=True)
            except (ValueError, OSError, KeyError) as error:
                self.event('prebuilt-refused', reason=str(error))
                raise Finish(m.EXIT_CANCELLED, 'prebuilt refused: ' + str(error)) from None
            if transfer_input := getattr(self.args, 'transfer_input', None):
                facts = {key: transfer_input[key] for key in ('size', 'sha256')}
                if facts != build.get('transferInput') or facts != manifest['artifacts'].get(transfer_fixture.ARTIFACT):
                    raise Finish(m.EXIT_CANCELLED, 'hashed transfer input differs from the launch record')
            shutil.copyfile(inputs / 'manifest.json', self.dir / 'manifest.json')
            run = metal_prebuilt.record_builder(m.read_json(self.dir / 'run.json'), manifest)
            m.write_json(self.dir / 'run.json', run)
            m.write_json(self.dir / 'metal-run.json', run)
        if build.get('commit') != self.args.commit or build.get('profile') != profile or build.get('features') != features:
            raise Finish(m.EXIT_CANCELLED, f'build provenance differs from the requested {profile} commit')
        root_fs = getattr(self.args, 'root_fs', None)
        tools = build.get('breenfsTools')
        if root_fs == 'breenfs' or tools is not None:
            names = ('breenfs-mkfs', 'breenfs-check', 'breenfs-extract')
            if not isinstance(tools, dict):
                raise Finish(m.EXIT_CANCELLED, 'breenfs tools are missing from the build record')
            for name in names:
                path = inputs / name
                facts = tools.get(name)
                if (not isinstance(facts, dict) or not path.is_file() or facts.get('size') != path.stat().st_size
                        or facts.get('sha256') != metal_image.sha256(path)):
                    raise Finish(m.EXIT_CANCELLED, 'breenfs tools differ from the build record: ' + name)
            retained = self.dir / 'breenfs-tools'
            retained.mkdir(exist_ok=True)
            for name in names:
                shutil.copyfile(inputs / name, retained / name)
                (retained / name).chmod(0o755)
            if root_fs == 'breenfs':
                helper = Path(__file__).with_name('ext2-owners.py')
                if not helper.is_file():
                    helper = Path(__file__).resolve().parents[1] / 'ext2-owners.py'
                shutil.copyfile(helper, inputs / 'ext2-owners.py')
        tests = inputs / 'test-binaries.img'
        if self.args.mode == 'tests' and (not tests.is_file() or build.get('testBinaries', {}).get('sha256') != metal_image.sha256(tests)):
            raise Finish(m.EXIT_CANCELLED, 'the test-binary disk differs from its build record')
        if not prebuilt and build.get('suite') != (getattr(self.args, 'suite', None) if self.args.mode == 'suite' else None):
            raise Finish(m.EXIT_CANCELLED, 'the build staged fixtures for a different suite')
        fixture = inputs / 'toolchain-root.img'
        scratch = inputs / 'toolchain-scratch.img'
        if 'toolchain' in suites(self.args):
            if getattr(self.args, 'disk', None) == 'install':
                raise Finish(m.EXIT_CANCELLED, 'a toolchain fixture cannot be an install image')
            record = build.get('toolchain')
            try:
                toolchain_evidence.build_identity(record, self.args.commit, 'x86_64')
                if record.get('root') != metal_prebuilt.facts(fixture):
                    raise ValueError('fixture root differs from its toolchain build record')
                if getattr(self.args, 'milestone', None) in BUSYBOX_MILESTONES:
                    if not record.get('busyboxInputs') or record.get('busyboxScratch') != metal_prebuilt.facts(scratch):
                        raise ValueError('BusyBox fixture differs from its toolchain build record')
                    # The E24 transport exposes four contiguous fixture slots.
                    # Use its stock first three companions and replace slot four
                    # with the independently verified toolchain scratch build.
                    companions = build.get('filesystemFixtures')
                    siblings = {f'breenfs-{role}.img' for role in metal_disk.FIXTURE_ROLES[:-1]}
                    if not isinstance(companions, dict) or set(companions) - {'breenfs-scratch.img'} != siblings:
                        raise ValueError('BusyBox needs the E24 fixture companion slots')
                    scratch.replace(inputs / 'breenfs-scratch.img')
                    companions['breenfs-scratch.img'] = record['busyboxScratch']
                elif 'busyboxInputs' in record or 'busyboxScratch' in record or scratch.exists():
                    raise ValueError('BusyBox fixture requires toolchain/busybox-on-box or toolchain/kernel-assembly')
            except (OSError, ValueError) as error:
                raise Finish(m.EXIT_CANCELLED, str(error)) from None
            # ext2.img is the ordinary/persistent input. Only a toolchain
            # suite request replaces that private staged copy with its fixture.
            fixture.replace(inputs / 'ext2.img')
            build['ext2'] = record['root']
        elif 'toolchain' in build or fixture.exists() or scratch.exists():
            if self.args.mode != 'suite':
                raise Finish(m.EXIT_CANCELLED, 'a toolchain fixture needs a suite boot')
            raise Finish(m.EXIT_CANCELLED, 'a toolchain fixture needs the toolchain suite')
        if 'd1' in suites(self.args):
            record = build.get('d1')
            companions = build.get('filesystemFixtures')
            disk = inputs / 'breenfs-scratch.img'
            if (getattr(self.args, 'disk', None) != 'root' or getattr(self.args, 'case', None)
                    or not isinstance(record, dict) or record.get('commit') != self.args.commit
                    or not isinstance(companions, dict) or record.get('disk') != companions.get(disk.name)
                    or not disk.is_file() or record.get('disk') != metal_prebuilt.facts(disk)):
                raise Finish(m.EXIT_CANCELLED, 'D1 requires its verified scratch image and a whole-suite test boot')
        self.delivery['build'] = build
        run = m.read_json(self.dir / 'run.json', {})
        run['build'] = {key: build[key] for key in ('commit', 'profile', 'features')}
        if 'toolchain' in suites(self.args):
            run['build']['toolchain'] = build['toolchain']
        if 'd1' in suites(self.args):
            run['build']['d1'] = build['d1']
        m.write_json(self.dir / 'run.json', run)
        self.event('build-delivered', commit=build.get('commit'), guard=build.get('guardTarget'))
        if run.get('builder') == 'mac' or 'buildChoice' in run:
            m.write_json(self.dir / 'metal-run.json', run)
        if (inputs / 'definition').is_dir():
            shutil.copytree(inputs / 'definition', self.dir / 'definition')
        for suite in suites(self.args):
            manifest = self.dir / 'definition/docs/suites' / (suite + '.json')
            if not manifest.is_file() or m.read_json(manifest).get('id') != suite:
                raise Finish(m.EXIT_CANCELLED, 'the suite manifest is missing or differs')
        if len(suites(self.args)) > 1 and not (self.dir / 'definition/scripts/suite-sequence.py').is_file():
            raise Finish(m.EXIT_CANCELLED, 'the commit cannot score a multi-suite boot')
        if self.migration_phase:
            files, extracted = self.prepare_migration(inputs, build)
            self.assemble(inputs, files, extracted, root_ramdisk=False)
            return
        if self.args.mode == 'persistent-install':
            if metal_migration.in_progress():
                raise Finish(m.EXIT_CANCELLED, 'the E24 migration has parked the persistent install in the test loop')
            files, extracted = self.prepare_install(inputs, build)
            self.assemble(inputs, files, extracted, root_ramdisk=False)
            return
        the_layout = metal_persist.layout()
        if (self.power_cut is not None or self.bit_flip) and not the_layout:
            raise Finish(m.EXIT_CANCELLED, 'BreenFS faults require the disposable test partition')
        disk = getattr(self.args, 'disk', None)
        if disk != 'root':
            screen_route = metal_disk.gt710_upload.prepare(self.dir, self.id, self.site,
                suite=getattr(self.args, 'suite', None)) if getattr(self.args, 'screen_proof', False) else None
            self.delivery['root'] = metal_root.stage_root(inputs / 'ext2.img', self.args.mode,
                getattr(self.args, 'suite', None), self.site,
                install=self.id if disk == 'install' else None, hasher=inputs / 'sha512-crypt',
                install_partition=the_layout['partitions']['test']['guid'] if the_layout and disk == 'install' else None,
                idle_minutes=getattr(self.args, 'idle_minutes', 30) if session(self.args) else None,
                replug=self.args.mode == 'console' and not session(self.args) and not xhci_fault(self.args),
                xhci_fault=xhci_fault(self.args), power_token=self.shutdown_token,
                watchdog_fault=self.args.inject.removeprefix('watchdog-') if self.args.inject in WATCHDOG_FAULTS else None,
                screen_proof=getattr(self.args, 'screen_proof', False),
                screen_known=getattr(self.args, 'screen_known_json', None), gt710_upload=screen_route,
                case=getattr(self.args, 'case', None))
            if disk == 'install':
                write = self.delivery['root']['diskWrite']
                m.write_json(self.dir / 'disk-write.json', write)
                self.event('disk-write-requested', bytes=write['bytes'], sha256=write['sha256AfterRecord'])
        self.phase('Assembling the image')
        extracted = self.stage / 'esp'
        files = metal_image.extract_esp(inputs / 'uefi.img', extracted)
        if disk == 'root':
            facts, suite_files = metal_disk.stage(self.dir, inputs, self.id, self.args.commit, self.site, build,
                mode=self.args.mode, suite=getattr(self.args, 'suite', None),
                idle_minutes=self.args.idle_minutes if session(self.args) else None,
                replug=self.args.mode == 'console' and not session(self.args),
                screen_proof=getattr(self.args, 'screen_proof', False),
                screen_known=getattr(self.args, 'screen_known_json', None), case=getattr(self.args, 'case', None),
                **({'root_fs': root_fs, 'tools_dir': inputs} if root_fs is not None else {}))
            self.delivery['diskRoot'] = facts
            if self.power_cut is not None:
                self.retain_cut_recovery_payload(inputs, files, facts)
            files.update(suite_files)
            if self.power_cut is not None or self.bit_flip or (self.args.mode == 'suite'
                    and metal_disk.needs_readback(self.dir, suites(self.args))):
                shutil.copyfile(inputs / 'stub.efi', self.dir / 'readback-stub.efi')
        root_ramdisk = self.args.ramdisk and disk != 'root'
        if root_ramdisk:
            files['ramdisk'] = inputs / 'ext2.img'
        if disk == 'root':
            target = self.args.mode
            if target == 'suite':
                # The intent replaces the root's boot target, so it carries the same host-key declaration.
                target = suite_target(self.args)
            elif target == 'console':
                self.console_intent = 'session' if session(self.args) else 'measure'
                self.delivery['consoleIntent'] = self.console_intent
                target += (' idle=' + str(self.args.idle_minutes)) if session(self.args) else ' replug'
            intent = self.stage / 'boot-intent'
            # On the persistent layout the intent names the test root, the only partition a test boot is given.
            test_root = the_layout['partitions']['test']['guid'] if the_layout else None
            fault = metal_power_cut.kernel_fault(self.args)
            command_line = fault[1] if fault else getattr(self.args, 'kernel_command_line', None)
            if test_root or command_line is not None:
                intent.write_bytes(metal_persist.intent(target, root=test_root, command_line=command_line,
                                                       fixtures=facts.get('fixtureSlices')))
            else:
                intent.write_bytes(('BREENIX-BOOT 1\n' + target + '\n').encode('ascii'))
            files['ramdisk'] = intent
            if self.args.mode == 'tests':
                # The testing kernel takes its test binaries from the RAM disk and never reads a boot target; on the
                # persistent layout they follow an intent naming its root.
                files['ramdisk'] = (metal_persist.tests_ramdisk(self.stage / 'tests-ramdisk', 'default', test_root, tests)
                                    if test_root else tests)
                self.delivery['testBinaries'] = build['testBinaries']
        if self.args.inject == 'disk-before-mount':
            # The stub installs and verifies the root before loading this file.
            # An invalid EFI image fails delivery without executing a kernel.
            files['efi/boot/bootx64.efi'].write_bytes(b'injected invalid EFI image\n')
        self.assemble(inputs, files, extracted, root_ramdisk)

    def retain_cut_recovery_payload(self, inputs, esp, facts):
        # Only the bootloader, kernel, boot configuration and intent are present.
        intent = self.stage / 'recovery-intent'
        intent.write_bytes(metal_persist.intent('suite filesystem case power-cut/recovery hostkeys ' + metal_root.HOSTKEYS,
                                                root=facts['partition']))
        disk = self.stage / 'recovery-disk.img'
        metal_image.assemble(disk, dict(esp, ramdisk=intent))
        image = self.dir / 'recovery.efi'
        wrapped = metal_image.stub_efi(inputs / 'stub.efi', disk, image)
        disk.unlink()
        m.write_json(self.dir / 'recovery-payload.json',
                     {key: wrapped[key] for key in ('size', 'sha256')})

    def prepare_cut_recovery_payload(self):
        source = m.boot_dir(self.args.source_boot)
        facts, self.recovery_expected = metal_disk.prepare_cut_recovery(
            self.args.source_boot, self.args.cut_recovery_from, self.args.commit)
        image = self.stage / 'boot.efi'
        shutil.copyfile(source / 'recovery.efi', image)
        expected = m.read_json(source / 'recovery-payload.json')
        if image.stat().st_size != expected['size'] or metal_image.sha256(image) != expected['sha256']:
            raise Finish(m.EXIT_CANCELLED, 'the no-restage payload differs from its record')
        self.payload_facts = dict(expected, path=image, contentType=metal_image.CONTENT_TYPES['efi'], name='boot.efi')
        self.delivery['image'] = {key: value for key, value in self.payload_facts.items() if key != 'path'}
        self.delivery['diskRoot'] = facts
        shutil.copytree(source / 'definition', self.dir / 'definition')
        self.load_definition()

    def assemble(self, inputs, files, extracted, root_ramdisk):
        """The boot disk of `files` appended to the stub as boot.efi, its facts recorded, and the definition loaded."""
        disk = self.stage / 'boot-disk.img'
        facts = metal_image.assemble(disk, files)
        shutil.rmtree(extracted, ignore_errors=True)
        # The firmware boots only a bare EFI application over HTTP: the stub carries the disk (README, "Delivery").
        image = self.stage / 'boot.efi'
        wrapped = metal_image.stub_efi(inputs / 'stub.efi', disk, image)
        disk.unlink()
        for name in ('uefi.img', 'ext2.img', 'toolchain-root.img', 'stub.efi', 'test-binaries.img', 'manager.efi'):
            (inputs / name).unlink(missing_ok=True)
        shutil.rmtree(self.stage / 'persist', ignore_errors=True)
        self.payload_facts = {'path': image, 'size': wrapped['size'], 'sha256': wrapped['sha256'],
                              'contentType': metal_image.CONTENT_TYPES['efi'], 'name': 'boot.efi'}
        self.delivery['image'] = {'name': 'boot.efi', 'size': wrapped['size'], 'sha256': wrapped['sha256'],
                                  'contentType': self.payload_facts['contentType'], 'stub': wrapped['stub'],
                                  'disk': {'size': facts['size'], 'sha256': facts['sha256'],
                                           'components': facts['components']}}
        self.event('image-assembled', size=wrapped['size'], sha256=wrapped['sha256'], disk=facts['size'],
                   ramdisk=root_ramdisk, consoleIntent=self.console_intent)
        self.load_definition()

    def slot_commit(self):
        """The commit a persistent boot runs: the slot the manager will boot once its slot action is done."""
        slots = metal_persist.read_disk().get('slots', {})
        action = getattr(self.args, 'slot_action', None)
        entry = getattr(self.args, 'entry', None) or 'current'
        slot = ('next' if action == 'commit' and slots.get('next') else 'previous' if action == 'rollback' else entry)
        selected = slots.get(slot) or {}
        if selected.get('installedBy') == metal_migration.STOPPED_UPGRADE:
            raise Finish(m.EXIT_CANCELLED, 'the stopped BreenFS install in NEXT must be replaced before verification')
        return selected.get('commit')

    def prepare_persistent(self):
        """A persistent boot stages nothing: the manager boots a kernel slot from the disk. Its record carries the
        slot's commit and that commit's definition, kept in the store at the install (README, "Persistent
        sessions")."""
        layout = metal_persist.layout()
        if not layout:
            raise Finish(m.EXIT_CANCELLED, 'the disk has no persistent install')
        if getattr(self.args, 'entry', None) == 'rescue':
            rescue = (metal_persist.read_disk().get('slots') or {}).get('rescue') or {}
            if layout['version'] != 2 or rescue.get('migration') != 'rescue':
                raise Finish(m.EXIT_CANCELLED, 'the persistent layout has no ext2 rescue slot')
        if layout['version'] == 3:
            record = metal_persist.read_disk().get('ext2Reclaimed') or {}
            if not metal_migration.BOOT_ID.fullmatch(record.get('boot', '')):
                raise Finish(m.EXIT_CANCELLED, 'the retired layout is missing its firmware readback record')
            self.args.ext2_reclaimed = record['boot']
        if layout['version'] == 3 or getattr(self.args, 'breenfs_upgrade', None):
            run = m.read_json(self.dir / 'run.json', {})
            if layout['version'] == 3:
                run['ext2Reclaimed'] = record['boot']
            m.write_json(self.dir / 'run.json', dict(run, persistentLayout=layout))
            if not session(self.args):
                self.persistent_fence_layout = layout
        if self.migration_phase in ('rescue', 'return'):
            slots = metal_persist.read_disk().get('slots', {})
            if self.migration_phase == 'rescue':
                self.prepare_migration_rescue(slots)
            elif (slots.get('current') or {}).get('migration') != 'cutover':
                raise Finish(m.EXIT_CANCELLED, 'migration return needs the promoted BreenFS slot')
        commit = self.slot_commit()
        if not commit:
            raise Finish(m.EXIT_CANCELLED, 'no kernel slot is recorded for this persistent boot')
        self.args.commit = commit
        m.write_text(self.dir / 'commit', commit + '\n')
        kept = m.STATE / 'persistent' / commit / 'definition'
        if kept.is_dir() and not (self.dir / 'definition').exists():
            shutil.copytree(kept, self.dir / 'definition')
        self.event('persistent-boot', commit=commit, entry=getattr(self.args, 'entry', None) or 'current',
                   slotAction=getattr(self.args, 'slot_action', None), definition=kept.is_dir())
        m.unstage()
        self.load_definition()

    def prepare_migration_rescue(self, slots):
        current = slots.get('current') or {}
        if current.get('migration') == 'rescue' and (slots.get('next') or {}).get('migration') == 'cutover':
            return
        previous = slots.get('previous') or {}
        cutover = m.boot_dir(self.migration['boots']['cutover'])
        staged_commit = m.read_json(cutover / 'run.json', {}).get('commit')
        if (not staged_commit or slots.get('next') or current.get('migration') != 'cutover'
                or previous.get('migration') != 'rescue'
                or current.get('commit') != staged_commit or previous.get('commit') != staged_commit):
            raise Finish(m.EXIT_CANCELLED, 'migration rescue needs the staged or confirmed promoted slot pair')
        if not m.update_lease(self.id, slotAction=None):
            raise Finish(m.EXIT_CANCELLED, 'migration rescue lost its lease')
        self.args.slot_action = None
        run = m.read_json(self.dir / 'run.json', {})
        m.write_json(self.dir / 'run.json', dict(run, slotAction=None))

    def prepare_reclaim(self, inputs):
        first, second = self.args.reclaim_upgrades
        build = m.read_json(inputs / 'build.json', {})
        stub = inputs / 'stub.efi'
        try:
            if (build.get('commit') != self.args.commit or build.get('profile') != metal_persist.RECLAIM_PAYLOAD
                    or build.get('stub') != metal_persist.file_facts(stub)):
                raise ValueError('the ext2 reclaim firmware differs from its build record')
            previous = metal_persist.read_disk()
            proof = metal_migration.admit_reclaim(self.id, first, second, self.args.commit, tools_commit())
            config, request = metal_persist.reclaim_request(self.stage, previous['layout'], first, second)
        except (OSError, ValueError) as error:
            raise Finish(m.EXIT_CANCELLED, str(error)) from error
        self.reclaim = (proof, previous)
        disk = self.stage / 'reclaim.img'
        metal_image.assemble(disk, {'persist.cfg': config, 'persist.dat': request.data})
        image = self.stage / 'boot.efi'
        facts = metal_image.stub_efi(stub, disk, image)
        disk.unlink()
        self.payload_facts = dict(path=image, size=facts['size'], sha256=facts['sha256'],
                                  contentType=metal_image.CONTENT_TYPES['efi'], name='boot.efi')
        self.delivery['build'] = build
        self.delivery['image'] = {key: value for key, value in self.payload_facts.items() if key != 'path'}
        self.event('ext2-reclaim-admitted', twoUpgrades=proof['boot'])

    def prepare_migration(self, inputs, build):
        phase, cycle = self.migration_phase, self.migration
        layout = cycle['layout']
        scratch = self.stage / 'migration'
        scratch.mkdir()
        extracted = self.stage / 'esp'
        files = metal_image.extract_esp(inputs / 'uefi.img', extracted)
        if phase == 'add':
            request = metal_persist.add_breenfs_request(scratch, layout, mkfs=inputs / 'breenfs-mkfs')
            config = request.finish()
        else:
            intent = scratch / 'boot-intent'
            intent.write_bytes(metal_persist.migration_intent(layout, phase, cycle['userland']))
            files['ramdisk'] = intent
            if phase == 'migrate':
                facts, suite_files = metal_disk.stage(self.dir, inputs, self.id, self.args.commit, self.site,
                                                      build, mode='persistent-migrate', the_layout=layout)
                self.delivery['diskRoot'] = facts
                files.update(suite_files)
                return files, extracted
            if phase != 'cutover':
                raise ValueError('unexpected migration image phase')
            candidates = dict()
            slots = {}
            for kind in ('rescue', 'cutover'):
                image = scratch / (kind + '.img')
                note = scratch / (kind + '.txt')
                ramdisk = scratch / (kind + '-intent')
                ramdisk.write_bytes(metal_persist.migration_intent(layout, kind, cycle['userland']))
                metal_image.assemble(image, {name: files[name] for name in metal_image.ESP_FILES}
                                     | {'ramdisk': ramdisk})
                note.write_text(metal_persist.slot_note(self.args.commit, cycle['userland']))
                slots[kind] = dict(metal_persist.file_facts(image), commit=self.args.commit,
                                   installedBy=cycle['userland'], migration=kind)
                candidates[kind] = (image, note)
            config, request = metal_persist.upgrade_request(
                scratch, layout, {}, *candidates['cutover'], self.site, rescue=candidates['rescue'])
            self.migration_slots = slots
            metal_persist.store_definition(self.dir / 'definition', self.args.commit)
        files.update({'persist.cfg': config, 'persist.dat': request.data})
        return files, extracted

    def prepare_install(self, inputs, build):
        """The install boot (README, "Install and upgrade"): the request, the new kernel slot, the new userland on the
        test root, and the migration's intent. Returns the boot disk's files."""
        the_layout = metal_persist.layout()
        slots = metal_persist.read_disk().get('slots') or {}
        breenfs = bool(the_layout and the_layout['version'] in (2, 3))
        if breenfs:
            try:
                cycle = metal_migration.require_closed(the_layout)
                metal_migration.require_upgrade_next(the_layout, slots)
            except ValueError as error:
                raise Finish(m.EXIT_CANCELLED, str(error)) from error
            self.args.breenfs_upgrade = cycle['closed']
            run = m.read_json(self.dir / 'run.json', {})
            m.write_json(self.dir / 'run.json', dict(run, breenfsUpgrade=cycle['closed']))
        action = 'upgrade' if the_layout else 'install'
        expect = None
        if not the_layout:
            previous = metal_persist.test_root()
            if not previous:
                raise Finish(m.EXIT_CANCELLED, "the one-time install needs the owned disk's whole-disk root record")
            the_layout = metal_persist.new_layout()
            expect = metal_disk.record(previous)
        manager = inputs / 'manager.efi'
        if not manager.is_file() or build.get('manager', {}).get('sha256') != metal_image.sha256(manager):
            raise Finish(m.EXIT_CANCELLED, 'the boot manager differs from its build record')
        self.phase('Assembling the ' + action)
        extracted = self.stage / 'esp'
        esp_files = metal_image.extract_esp(inputs / 'uefi.img', extracted)
        scratch = self.stage / 'persist'
        scratch.mkdir(parents=True, exist_ok=True)
        slot = scratch / 'next.img'
        slot_files = dict(esp_files)
        if self.args.inject == 'upgrade-no-ssh':
            broken = scratch / 'broken-loader.efi'
            broken.write_bytes(b'deliberately invalid verification bootloader\n')
            slot_files['efi/boot/bootx64.efi'] = broken
        metal_persist.slot_image(slot, slot_files, the_layout, scratch, self.id)
        note = scratch / 'next.txt'
        note.write_text(metal_persist.slot_note(self.args.commit, self.id))
        manager_files = {'efi/breenix/bootmgr.efi': manager, 'efi/boot/bootx64.efi': manager}
        # The new userland, staged as a default boot's root (console account included) with the operator's account
        # and SSH public key for the installer's machine state store, for the stub to write onto the test root once
        # the request is done.
        facts, suite_files = metal_disk.stage(self.dir, inputs, self.id, self.args.commit, self.site, build,
                                              mode='persistent-install' if breenfs else 'default', the_layout=the_layout,
                                              operator=None if breenfs else metal_root.operator_account(self.site),
                                              no_ssh=self.args.inject == 'upgrade-service-down')
        self.delivery['diskRoot'] = facts
        files = dict(esp_files)
        files.update(suite_files)
        parts = the_layout['partitions']
        intent = self.stage / 'boot-intent'
        intent.write_bytes(metal_persist.breenfs_upgrade_intent(the_layout, self.id) if breenfs else
                           metal_persist.intent('persistent-install', root=parts['test']['guid'],
                                                home=parts['system']['guid'], userland=self.id,
                                                previous_userland=(slots.get('current') or {}).get('installedBy')))
        files['ramdisk'] = intent
        if action == 'install':
            config, request = metal_persist.install_request(scratch, the_layout, expect, manager_files, slot, note,
                                                            self.site, scratch)
        else:
            config, request = metal_persist.upgrade_request(scratch, the_layout, manager_files, slot, note, self.site,
                                                            breenfs=breenfs)
        files['persist.cfg'] = config
        files['persist.dat'] = request.data
        self.persist = {'action': action, 'layout': the_layout,
                        'slot': dict(metal_persist.file_facts(slot), commit=self.args.commit, installedBy=self.id),
                        'request': {'extents': request.extents, 'bytes': request.written,
                                    'payload': request.data.stat().st_size}}
        if breenfs:
            previous = slots.get('previous') or {}
            if previous.get('migration') == 'rescue':
                self.persist['rescue'] = previous
        m.write_json(self.dir / 'persist.json', self.persist)
        metal_persist.store_definition(self.dir / 'definition', self.args.commit)
        self.event('persist-requested', action=action, extents=request.extents, bytes=request.written,
                   payload=request.data.stat().st_size)
        return files, extracted

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def load_definition(self):
        """Fatal patterns and the mode's final marker come from this boot's own definition copy."""
        definition = self.dir / 'definition'
        metal = m.read_json(definition / 'docs/metal/boot-path.json')
        main = m.read_json(definition / 'docs/boot-path.json', {})
        source = metal or main
        self.fatal_patterns = [re.compile(p) for p in (source or {}).get('fatal', [])]
        retired = getattr(self.args, 'ext2_reclaimed', None)
        upgrade = getattr(self.args, 'breenfs_upgrade', None)
        breenfs = bool(upgrade or retired)
        if upgrade and getattr(self.args, 'upgrade_parent', None):
            parent = m.boot_dir(self.args.upgrade_parent)
            metal = m.read_json(parent / 'definition/docs/metal/boot-path.json')
            if not metal:
                raise Finish(m.EXIT_CANCELLED, 'BreenFS verification needs the install boot definition')
        if metal and not session(self.args):
            catalog = m.read_json(definition / 'tools/breenix-runs/Sources/BreenixRuns/Resources/boot-stages-x86_64.json', {})
            shape = boot_shape('persistent' if persistent(self.args) else getattr(self.args, 'disk', None))
            self.final_marker = final_marker(metal, self.args.mode, catalog, shape, breenfs=breenfs)
            self.required_stages = measured_stages(metal, self.args.mode, catalog, shape, breenfs=breenfs,
                                                   previous=bool(retired and getattr(self.args, 'entry', None) == 'previous'),
                                                   rescue=getattr(self.args, 'entry', None) == 'rescue')
        if xhci_fault(self.args):
            marker = '[xhci-fault] ' + xhci_fault(self.args) + ' PASS:'
            self.final_marker = (marker, 'contains')
            self.required_stages = [[(marker, 'contains')]]
            self.console_done = True
        if self.args.mode == 'tests':
            # The report's end triggers validation of its loader and exit accounting before completion.
            # Milestones are scored against main's path after capture stops.
            self.fatal_patterns = [re.compile(p) for p in main.get('fatal', [])]
            self.final_marker = (TESTS_DONE, 'contains')
            self.required_stages = []
        if self.migration_phase in metal_migration.VERIFY_PHASES:
            self.final_marker = ('Breenix login: ', 'contains')
            self.required_stages = []
        elif self.migration_phase:
            self.final_marker = None
            self.required_stages = []
        if self.args.mode == 'probe':
            self.final_marker = ('PROBE DONE ', 'contains')
        if self.args.mode == 'persistent-install':
            # The migration's last line ends the install boot (README, "Install and upgrade").
            self.final_marker = (INSTALL_DONE, 'contains')
        if self.args.inject == FENCE_FAULT:
            marker = '[fence-fault] PASS: '
            self.final_marker = (marker, 'contains')
            self.required_stages = [[(marker, 'contains')]]
        if self.args.mode == 'suite':
            # One suite finishes at its READY, after its DONE and memory record (docs/suites/README.md,
            # "Memory record"); several suites when the last has handed off.
            self.final_marker = (('SUITE_SEQUENCE READY ' + self.args.suite, 'contains') if len(suites(self.args)) == 1
                                 else ('SUITE_SEQUENCE DONE ', 'contains'))
        self.panic_oracle = 'capture_panic_oracle' in kernel_profile(self.args)[0]
        if self.panic_oracle:
            # The production probe finishes before the timer-triggered oracle arms.
            # Keep capturing through the device observation, including its binding.
            self.final_marker = ('[GPU_PANIC_NATIVE ', 'contains')
            self.required_stages.append([
                ('[BXCAP:BEGIN ', 'contains'), ('[BXCAP:END ', 'contains'),
                ('[GPU_PANIC_SCREEN ', 'contains'), ('[GPU_PANIC_NATIVE ', 'contains')])
        self.event('definition', metalPath=bool(metal), fatalPatterns=len(self.fatal_patterns),
                   finalMarker=self.final_marker is not None)

    # Read-only checks before power-on.
    def preflight(self):
        self.phase_name = 'preflight'
        self.phase('Checking the machine')
        try:
            rows, baseline = m.machine_checks(self.site)
        except m.BmcError as error:
            self.event('preflight-error', error=str(error))
            raise Finish(m.EXIT_DELIVERY, 'pre-flight could not read the machine')
        failed = m.failed_checks(rows)
        self.event('preflight', checks=len(rows), failed=[name for name, _, _ in failed])
        self.delivery['baseline'] = baseline
        self.event('baseline', **baseline)
        self.post_code = baseline.get('postCode')
        self.progress_key = progress_key(baseline.get('bootProgress'))
        if baseline.get('power') != 'Off':
            if (self.args.payload in (metal_export.PAYLOAD, metal_persist.RECLAIM_PAYLOAD) or self.migration_phase
                    or getattr(self.args, 'breenfs_upgrade', None)):
                raise Finish(m.EXIT_CANCELLED, 'this persistent operation requires a powered-off machine')
            if getattr(self.args, 'resting', False):
                raise Finish(m.EXIT_CANCELLED, 'an existing power-on is left for boot manager adoption')
            self.event('stray-power-on', power=baseline.get('power'))
            if not m.force_off_and_wait():
                m.quarantine_lease(self.id, 'pre-flight power-off failed')
                raise Finish(m.EXIT_DELIVERY, 'the machine was on and would not power off')
            failed = [row for row in failed if row[0] != 'boot.BootSourceOverrideEnabled']
        if failed:
            raise Finish(m.EXIT_DELIVERY, 'pre-flight: ' + ', '.join(name for name, _, _ in failed))

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def do_stage(self):
        if self.payload_facts:
            facts = self.payload_facts
            redirect = None
            if self.args.serve_as:
                redirect = m.load_site()['BOOT_URL'].split('://', 1)[1].split('/', 1)[1].rsplit('/', 1)[0]
                redirect = '/' + redirect + '/' + self.args.serve_as
            m.stage(self.id, facts['path'], facts['sha256'], facts['size'], facts['contentType'], redirect)
            self.event('staged', name=facts['name'], size=facts['size'], sha256=facts['sha256'],
                       redirectedTo=self.args.serve_as or None)
        else:
            m.unstage()
        try:
            metal_disk.gt710_upload.check_ready(self.dir, self.id, self.site)
        except ValueError as error:
            raise Finish(m.EXIT_DELIVERY, str(error)) from error
        log = m.STATE / 'http.jsonl'
        self.http_offset = log.stat().st_size if log.exists() else 0

    # The console.
    def start_console(self):
        self.phase_name = 'console'
        raw = self.dir / 'serial.raw'
        raw.touch()
        (self.dir / 'serial.txt').touch()
        (self.dir / 'serial.ts').touch()
        for attempt in (1, 2):
            with contextlib.suppress(m.BmcError):
                m.sol_deactivate()
            start = raw.stat().st_size
            self.spawn_console(fresh=attempt == 1)
            deadline = m.now() + CONSOLE_WAIT_SECONDS
            while m.now() < deadline:
                self.checkpoint()
                with raw.open('rb') as handle:
                    handle.seek(start)
                    if CONSOLE_BANNER in handle.read():
                        self.pump_serial()
                        self.event('console-ready', rawOffset=raw.stat().st_size, txtOffset=self.txt_bytes)
                        self.phase('Console ready')
                        return
                time.sleep(0.25)
            self.event('console-retry', attempt=attempt)
        raise Finish(m.EXIT_DELIVERY, 'no console: the serial-over-LAN session did not start')

    def spawn_console(self, fresh):
        """Archive SOL stdout before the terminal line discipline or tmux processes it.

        Keep stdin on the pane for interactive SOL input; stdout and stderr go
        through a blocking pipe to tee, whose other output keeps the pane live.
        """
        hold = (f"sh -c 'stty -echo; read go; {m.TOOLS / 'metal-sol'} activate 2>&1 "
                f"| tee -a {self.dir / 'serial.raw'}'")
        environment = dict(os.environ, TERM='xterm-256color')
        if fresh:
            subprocess.run(self.tmux + ['kill-server'], capture_output=True)
            subprocess.run(self.tmux + ['new-session', '-d', '-s', 'sol', '-x', '200', '-y', '50', hold],
                           check=True, env=environment)
            subprocess.run(self.tmux + ['set-option', '-t', 'sol', 'remain-on-exit', 'on'], capture_output=True)
        else:
            subprocess.run(self.tmux + ['respawn-pane', '-k', '-t', 'sol', hold], check=True, env=environment)
        time.sleep(0.5)
        subprocess.run(self.tmux + ['send-keys', '-t', 'sol', 'go', 'Enter'], check=True)

    def console_dead(self):
        result = subprocess.run(self.tmux + ['display-message', '-p', '-t', 'sol', '#{pane_dead}'],
                                capture_output=True, text=True)
        return result.returncode != 0 or result.stdout.strip() == '1'

    def heal_console(self):
        """A dropped session is reconnected within two seconds; the gap makes the boot capture-incomplete."""
        started = m.now()
        self.gap = True
        self.event('console-gap-start')
        raw = self.dir / 'serial.raw'
        with contextlib.suppress(m.BmcError):
            m.sol_deactivate()
        offset = raw.stat().st_size
        self.spawn_console(fresh=subprocess.run(self.tmux + ['has-session', '-t', 'sol'],
                                                capture_output=True).returncode != 0)
        deadline = m.now() + CONSOLE_WAIT_SECONDS
        while m.now() < deadline:
            with raw.open('rb') as handle:
                handle.seek(offset)
                if CONSOLE_BANNER in handle.read():
                    self.event('console-gap-end', seconds=round(m.now() - started, 1))
                    return
            time.sleep(0.25)
        self.event('console-gap-end', seconds=round(m.now() - started, 1), reconnected=False)

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def pump_serial(self):
        raw = self.dir / 'serial.raw'
        if not raw.exists():
            return
        size = raw.stat().st_size
        if size <= self.raw_offset:
            return
        with raw.open('rb') as handle:
            handle.seek(self.raw_offset)
            data = handle.read(size - self.raw_offset)
        self.raw_offset = size
        arrived = m.now()
        text = self.cleaner.feed(data)
        if not text:
            return
        if self.t0 is not None:
            self.last_serial = arrived
        decision = None
        with (self.dir / 'serial.txt').open('a') as out, (self.dir / 'serial.ts').open('a') as stamps:
            for char_line in text.splitlines(keepends=True):
                if not self.line:
                    stamps.write(f'{arrived:.3f}\t{self.txt_bytes}\n')
                    self.line_start = self.txt_bytes
                out.write(char_line)
                self.txt_bytes += len(char_line.encode())
                self.line += char_line
                if self.line.endswith('\n'):
                    line, self.line = self.line.rstrip('\n'), ''
                    if isinstance(decision, PowerCut):
                        continue  # Keep archiving bytes already received without running other serial actions.
                    try:
                        self.on_line(line, observed_at=arrived)
                    except BootManagerAbort:
                        raise  # Act before dispatching any later lines already in the serial buffer.
                    except PowerCut as cut:
                        if decision is None:
                            decision = cut
                    except Finish as finish:
                        if decision is None or finish.status != m.EXIT_DONE:
                            decision = finish
        if isinstance(decision, PowerCut):
            raise decision
        # getty leaves its prompt unterminated while waiting for login input.
        if self.args.mode in ("default", "persistent") and "Breenix login: " in self.line:
            try:
                self.on_line(self.line, observed_at=arrived)
            except Finish as finish:
                if decision is None or finish.status != m.EXIT_DONE:
                    decision = finish
        try:
            self.challenge_shell(self.line)
            self.challenge_console(self.line)
            self.challenge_persistent(self.line)
        except Finish as finish:
            if decision is None or finish.status != m.EXIT_DONE:
                decision = finish
        if self.fatal_at is not None and decision is not None and decision.status == m.EXIT_DONE:
            return  # The fatal grace interval captures its backtrace before failing.
        if decision is not None:
            raise decision

    def score_suite(self, disk=None, disk_report=None):
        """Run the commit's scorer after power-off, without site files or management access."""
        run = m.read_json(self.dir / 'run.json', {})
        try:
            metal_score.require_suite_profile(run)
            if 'toolchain' in suites(self.args) and not getattr(self.args, 'case', None):
                toolchain_evidence.verify_sysroot(
                    (self.dir / 'serial.txt').read_text(errors='replace'),
                    run.get('build', {}).get('toolchain'), self.args.commit, 'x86_64')
        except (OSError, ValueError) as error:
            self.event('suite-verdict', status=1, reason=str(error))
            m.write_text(self.dir / 'suite-verdict.txt', 'FAIL: ' + str(error) + '\n')
            return False
        definition = self.dir / 'definition'
        with tempfile.TemporaryDirectory(prefix='metal-verdict-') as temporary:
            root = Path(temporary)
            root.chmod(0o755)
            several = len(suites(self.args)) > 1
            names = ['scripts/suite-verdict.py', 'docs/boot-path.json',
                     'libs/libbreenix/src/suite_memory.rs'] + ['docs/suites/' + s + '.json' for s in suites(self.args)]
            if getattr(self.args, 'milestone', None):
                names.append('docs/efforts/path.json')
            for name in names + (['scripts/suite-sequence.py'] if several else []):
                target = root / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(definition / name, target)
                target.chmod(0o644)
            if disk_report is not None:
                entrypoint = 'suite-sequence.py' if several else 'suite-verdict.py'
                if '--disk-report' not in (root / 'scripts' / entrypoint).read_text():
                    # A retry uses the source commit's retained verifier.
                    disk_report['legacyScorer'] = True
                    disk_report = None
            shutil.copyfile(self.dir / 'serial.txt', root / 'serial.txt')
            (root / 'serial.txt').chmod(0o644)
            if disk is not None:
                shutil.copyfile(disk, root / 'disk.img')
                (root / 'disk.img').chmod(0o644)
                scratch = disk.with_name('breenfs-scratch.img')
                if 'filesystem' in suites(self.args) and scratch.is_file():
                    shutil.copyfile(scratch, root / scratch.name)
                    (root / scratch.name).chmod(0o644)
            retained = self.dir / 'breenfs-tools'
            if retained.is_dir():
                tools = root / 'tools/breenfs/target/release'
                tools.mkdir(parents=True)
                for name in ('breenfs-extract', 'breenfs-check'):
                    shutil.copyfile(retained / name, tools / name)
                    (tools / name).chmod(0o755)
            sandbox, command = verdict_command(root)
            if several:
                command += [str(sandbox / 'scripts/suite-sequence.py'), 'score', self.args.suite, str(sandbox / 'serial.txt')]
            else:
                command += [str(sandbox / 'scripts/suite-verdict.py'),
                            str(sandbox / 'docs/suites' / (self.args.suite + '.json')), str(sandbox / 'serial.txt')]
            if getattr(self.args, 'milestone', None):
                selector = self.args.milestone
                if several:
                    path = json.loads((definition / 'docs/efforts/path.json').read_text())
                    measure = next(item['measure'] for effort in path['efforts'] for item in effort['milestones']
                                   if effort['id'] + '/' + item['id'] == selector)
                    selector = measure['suite'] + '=' + selector
                command += ['--milestone', selector]
            if disk is not None:
                command += ['--disk', str(sandbox / 'disk.img')]
            if disk_report is not None:
                command.append('--disk-report')
                if run.get('rootFs'):
                    command += ['--disk-root-fs', run['rootFs']]
            try:
                verdict = subprocess.run(command, capture_output=True, text=True,
                                         timeout=SUITE_VERDICT_SECONDS + 5,
                                         env={'PATH': os.defpath, 'LANG': 'C.UTF-8'}, cwd='/')
            except subprocess.TimeoutExpired:
                self.event('suite-verdict-timeout')
                m.write_text(self.dir / 'suite-verdict.txt', 'FAIL: suite verdict timed out\n')
                return False
            stderr = verdict.stderr
            if disk_report is not None:
                prefix = 'METAL_DISK_VERDICT '
                rows = stderr.splitlines(keepends=True)
                reports = [row[len(prefix):] for row in rows if row.startswith(prefix)]
                if len(reports) == 1:
                    disk_report.update(json.loads(reports[0]))
                stderr = ''.join(row for row in rows if not row.startswith(prefix))
            failure = clock_failure((self.dir / 'serial.txt').read_text(errors='replace'))
            output = ('FAIL: ' + failure + '\n' if failure else '') + verdict.stdout + stderr
            m.write_text(self.dir / 'suite-verdict.txt', self.redact(output))
            status = verdict.returncode or (1 if failure else 0)
            self.event('suite-verdict', status=status)
            return status == 0

    def score_breenfs_readback(self, source, image, upload, mode):
        bit_flip = mode == 'bit-flip'
        with tempfile.TemporaryDirectory(prefix='metal-breenfs-readback-') as temporary:
            root = Path(temporary)
            root.chmod(0o755)
            captures = ('serial.txt',) if bit_flip else ('run.json', 'events.jsonl', 'serial.txt')
            for name in captures:
                shutil.copyfile(source / name, root / name)
                (root / name).chmod(0o644)
            shutil.copyfile(Path(__file__).with_name('breenfs_replay.py'), root / 'replay.py')
            (root / 'replay.py').chmod(0o644)
            shutil.copyfile(image, root / 'disk.img')
            (root / 'disk.img').chmod(0o644)
            tools = ('breenfs-check',) if bit_flip else ('breenfs-check', 'breenfs-extract')
            for name in tools:
                shutil.copyfile(source / 'breenfs-tools' / name, root / name)
                (root / name).chmod(0o755)
            sandbox, command = verdict_command(root)
            command += [str(sandbox / 'replay.py'), mode, str(sandbox / 'serial.txt'),
                        str(sandbox / 'disk.img'), '--tools-dir', str(sandbox), '--json']
            result = subprocess.run(command, capture_output=True, text=True,
                                    timeout=SUITE_VERDICT_SECONDS + 5,
                                    env={'PATH': os.defpath, 'LANG': 'C.UTF-8'}, cwd='/')
        passed = result.returncode == 0
        details = json.loads(result.stdout) if passed else dict(reason=self.redact(result.stderr.strip()))
        name = 'bit-flip-readback' if bit_flip else 'cut-readback'
        m.write_json(source / (name + '.json'), dict(details, id=self.id, passed=passed, sha256=upload['sha256']))
        self.event('bit-flip-readback-verdict' if bit_flip else 'cut-replay-verdict', passed=passed)
        return passed

    def finalize_disk_suite(self):
        readback = m.read_json(self.dir / 'readback.json')
        source = m.boot_dir(readback['source'])
        upload = m.read_json(self.dir / 'disk-upload.json', {})
        image = self.dir / 'disk.img'
        if (not upload.get('complete') or image.stat().st_size != readback['bytes']
                or upload['sha256'] != metal_image.sha256(image)
                or upload['rootRecord'] != readback['rootRecord']
                or self.t0 <= readback['suitePoweredOffAt']):
            raise ValueError('cold raw disk evidence differs from the completed suite boot')
        if readback.get('powerCut'):
            return self.score_breenfs_readback(source, image, upload, 'replay')
        if readback.get('bitFlip'):
            passed = self.score_breenfs_readback(source, image, upload, 'bit-flip')
            self.finish_readback_source(source, passed)
            return passed
        run = m.read_json(source / 'run.json')
        args = argparse.Namespace(id=readback['source'], mode='suite', suite=','.join(run.get('suites') or [run['suite']]), payload='image',
                                  inject=None, milestone=run.get('milestone'))
        scorer = Driver(args)
        disk_report = {}
        score_image = image
        if slices := readback.get('fixtureSlices'):
            score_image = metal_disk.unpack_readback(image, readback['rootBytes'], slices)
        suite_passed = scorer.score_suite(disk=score_image, disk_report=disk_report)
        legacy_scorer = disk_report.pop('legacyScorer', False)
        if not disk_report:
            checks = metal_disk.readback_checks(source, suites(args)[-1])
            disk_report = dict(passed=False, detail='disk verdict unavailable', breenfsCheckExit=None,
                               diskChecks=[dict(path=check['path'], status='not-run') for check in checks])
        provisional = readback['sourceProvisional']
        passed = disk_report['passed']
        if provisional:
            milestone = m.read_json(source / 'milestone-verdict.json', {})
            passed = ((passed or legacy_scorer) and suite_passed and bool(milestone)
                      and not metal_score.falls_short(milestone))
        m.write_json(self.dir / 'readback.json', dict(readback, diskVerdict=disk_report))
        receipt = {key: readback[key] for key in ('sourceStatus', 'sourceProvisional', 'sourceReason', 'sourceEndedBy')}
        m.write_json(source / 'suite-readback.json', dict(receipt, id=self.id, bytes=image.stat().st_size,
            sha256=upload['sha256'], passed=passed, diskVerdict=disk_report))
        scorer.event('cold-disk-verdict', readback=self.id, passed=passed, sourceProvisional=provisional)
        if provisional:
            self.finish_readback_source(source, passed)
        return passed

    def finish_readback_source(self, source, passed):
        with m.locked('finished'):
            m.write_text(source / 'exit-status', str(m.EXIT_DONE if passed else m.EXIT_SHORT) + '\n')
            finished = m.STATE / 'finished.jsonl'
            entries = [json.loads(line) for line in finished.read_text().splitlines()]
            m.append_jsonl(finished, dict(id=source.name, seq=max((e['seq'] for e in entries), default=0) + 1))

    def continue_disk_readback(self):
        """Cold readback is the next boot under this lease, before another disk user can run."""
        boot_id = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-metal'
        while m.boot_dir(boot_id).exists():
            time.sleep(1)
            boot_id = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-metal'
        args = argparse.Namespace(**(vars(self.args) | dict(id=boot_id, mode='default', suite=None,
            payload='disk-readback', disk=None, source_boot=self.id, session=False, input=None,
            case=None, root_fs=None, power_cut_window=None, power_cut_after=None, breenfs_bit_flip=False)))
        child = Driver(args)
        # The same live transient unit owns both boots; the reaper follows the active record's id.
        child.unit = self.unit
        inputs = child.stage / 'inputs'
        inputs.mkdir(parents=True)
        shutil.copyfile(self.dir / 'readback-stub.efi', inputs / 'stub.efi')
        stub = self.delivery['build']['stub']
        if metal_image.sha256(inputs / 'stub.efi') != stub['sha256']:
            raise ValueError('the retained readback firmware differs from the suite build')
        m.write_json(inputs / 'build.json', dict(commit=self.args.commit, profile='disk-readback', stub=stub))
        (inputs / 'ready').touch()
        self.event('cold-readback-next', readback=boot_id)
        child_status = child.run(inherited=self.id)
        if self.power_cut is not None or self.bit_flip:
            return child_status
        return int((self.dir / 'exit-status').read_text().strip())

    def continue_cut_recovery(self):
        source = m.boot_dir(self.args.source_boot)
        boot_id = boot_id_now()
        while m.boot_dir(boot_id).exists():
            time.sleep(1)
            boot_id = boot_id_now()
        args = argparse.Namespace(**(vars(self.args) | dict(id=boot_id, mode='suite', suite='filesystem',
            payload='image', disk='root', root_fs='breenfs', case='power-cut/recovery',
            kernel_command_line=None, cut_recovery_from=self.id)))
        child = Driver(args)
        child.unit = self.unit
        self.event('cut-recovery-next', recovery=boot_id)
        status = child.run(inherited=self.id)
        m.write_json(source / 'cut-cycle.json', dict(readback=self.id, recovery=boot_id, passed=status == m.EXIT_DONE))
        return status


    def challenge_shell(self, text):
        if (self.args.mode == 'shell' and self.shell_ready and not self.shell_sent
                and self.fatal_at is None and 'bsh />' in text):
            subprocess.run(self.tmux + ['send-keys', '-t', 'sol', '-l', '--',
                                       'print("metal-console-ok", 6*7)'], check=True)
            subprocess.run(self.tmux + ['send-keys', '-t', 'sol', 'Enter'], check=True)
            self.shell_sent = True
            self.event('shell-challenge-sent')

    def console_send(self, text, paced=False):
        """One line to the SOL console; paced sends it a few bytes at a time, since a burst can lose a byte while
        the shell echoes (#2105)."""
        # stdin transport keeps a password out of process argv, events and logs.
        data = (text + '\r').encode()
        # HID replay has no terminal echo and must fit the getty cases' deadlines.
        # Keep its bursts below a 16550 FIFO while avoiding one tmux pair per four bytes.
        replay = self.args.mode == 'suite'
        step = (8 if replay else 4) if paced else len(data)
        for at in range(0, len(data), step):
            subprocess.run(self.tmux + ['load-buffer', '-'], input=data[at:at + step], check=True, capture_output=True)
            subprocess.run(self.tmux + ['paste-buffer', '-d', '-t', 'sol'], check=True, capture_output=True)
            if paced:
                time.sleep(0.001 if replay else 0.04)

    def console_account(self):
        """The account staging gave the console password to (metal_root.console_account): the users suite's wheel
        fixture, which reads the root-only screen check through sudo, or root on images from before it."""
        staged = self.delivery.get('diskRoot') or self.delivery.get('root') or {}
        return staged.get('consoleAccount', 'root')

    def challenge_console(self, text, complete=False):
        if xhci_fault(self.args):
            return
        if self.args.mode != 'console' or session(self.args) or self.fatal_at is not None:
            return
        step = self.console_step
        account = self.console_account()
        if step in (0, 3) and 'login: ' in text:
            self.console_step += 1
            self.console_send(self.site['CONSOLE_USER'] if account == 'root' else account, paced=True)
        elif step in (1, 4) and 'Password: ' in text:
            self.console_step += 1
            self.console_send('deliberately-wrong-password' if step == 1 else self.site['CONSOLE_PASSWORD'], paced=True)
        elif step == 2 and 'Login incorrect' in text:
            self.console_step = 3
            self.event('console-wrong-password-refused')
        elif step == 5 and re.search(r'bsh [^\n]*>', text):
            self.console_step = 6
            self.console_send('print("metal-login-ok", 6*7)', paced=True)
        elif step == 6 and text.strip() == 'metal-login-ok 42':
            self.console_step = 7
            self.event('console-computation-answered')
            self.console_send('cat /proc/fbcon/check' if account == 'root' else 'sudo cat /proc/fbcon/check', paced=True)
        elif step == 7 and account != 'root' and not self.console_sudo_answered and f'[sudo] password for {account}: ' in text:
            self.console_sudo_answered = True
            self.event('console-sudo-password')
            self.console_send(self.site['CONSOLE_PASSWORD'], paced=True)
        elif step == 7 and complete and text.startswith('fbcon check: '):
            self.console_step = 8
        elif step == 8 and re.match(r'bsh [^\n]*>', text):
            # The prompt after cat: its rows are complete, so typing cannot interleave with them.
            self.console_step = 9
            self.console_send('exit', paced=True)
        elif step == 9 and '[init] console session ended; restarting getty' in text:
            self.console_step = 10
        elif step == 10 and '[getty] console acquired' in text:
            self.console_step = 11
        elif step == 11 and 'login: ' in text:
            self.console_step = 12
            self.console_done = True
            self.event('console-logout-returned-to-getty')
            # Prompts do not end in a newline. Re-evaluate completion against the
            # measured reacquisition marker after this new prompt has arrived.
            if (self.final_seen and not any(self.required_stages) and self.fatal_at is None
                    and self.disk_evidence_seen()):
                self.completion_reported = True
                raise Finish(m.EXIT_DONE, 'SOL login refused, accepted, computed and logged out')

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def on_line(self, line, *, observed_at=None):
        if self.args.mode == 'tests':
            self.test_report_lines.append(line + "\n")
        observed_at = m.now() if observed_at is None else observed_at
        seconds = round(observed_at - self.t0, 1) if self.t0 is not None else 0
        if self.t0 is None or not line.strip() or line.startswith('[SOL Session'):
            return
        if self.power_cut is not None or self.bit_flip:
            if writer := breenfs_replay.WRITER_START.fullmatch(line.encode()):
                self.suite_name = 'filesystem'
                self.writer_nonce = writer[1]
                self.event('power-cut-writer-start', observed_at=observed_at, nonce=writer[1].decode())
            elif (self.writer_nonce and (ack := breenfs_replay.ACK.fullmatch(line.encode()))
                  and ack[1] == b'1' and ack[3] == self.writer_nonce):
                self.writer_acknowledged = True
        cut = self.power_cut
        if (cut is not None and self.writer_acknowledged and cut['window'] is not None and cut['cutAt'] is None
                and self.suite_name == self.args.suite and 'disk-root-confirmed' in self.seen
                and self.fatal_at is None and not self.gap
                and line == f"[breenfs] commit-window {cut['window']}"):
            raise PowerCut(line, observed_at, self.line_start)
        if not self.first_text:
            self.first_text = True
            self.event('firmware-text', observed_at=observed_at, seconds=seconds)
            self.phase('Firmware output')
        if STUB_LINE in line and 'stub' not in self.seen and self.kernel_started is None:
            self.seen.add('stub')
            self.event('stub-started', observed_at=observed_at, seconds=seconds)
            self.phase('Delivery stub: attaching the boot disk')
        if STUB_FAILED_LINE in line and self.kernel_started is None:
            self.event('stub-failed', observed_at=observed_at, seconds=seconds)
            raise Finish(m.EXIT_DELIVERY, 'the delivery stub could not start the bootloader')

        self.on_manager_line(line, observed_at, seconds)
        if self.args.payload == metal_persist.RECLAIM_PAYLOAD:
            if line == metal_persist.RECLAIM_DONE:
                if 'stub' not in self.seen:
                    raise Finish(m.EXIT_SHORT, 'ext2 reclaim is missing a firmware start')
                self.event('ext2-gpt-readback', observed_at=observed_at)
                raise Finish(m.EXIT_DONE, 'ext2 GPT entries cleared and read back')
            return
        if self.census:
            if line == 'metal-linux-start' and self.kernel_started is None:
                self.kernel_started = observed_at
                self.last_stage = 'Linux census started'
                self.event('linux-started', observed_at=observed_at, seconds=seconds)
            try:
                done = self.census.feed(line)
            except ValueError:
                raise Finish(m.EXIT_SHORT, 'platform facts failed validation')
            if done:
                self.event('linux-census-validated', observed_at=observed_at, files=len(self.census.files))
                raise Finish(m.EXIT_DONE, 'platform facts validated')
        if self.args.payload == 'disk-readback':
            if STUB_LINE in line and self.kernel_started is None:
                self.kernel_started = observed_at
            if re.fullmatch(r'metal-stub: disk readback complete: \d+ bytes', line):
                upload = m.read_json(self.dir / 'disk-upload.json', {})
                if not upload.get('complete'):
                    raise Finish(m.EXIT_SHORT, 'the cold disk upload is missing')
                raise Finish(m.EXIT_DONE, 'cold disk readback received')
        if self.args.payload == metal_export.PAYLOAD:
            if self.migration_phase == 'readback':
                if STUB_LINE in line and self.export_started is None:
                    self.export_started = observed_at
                if receipt := metal_export.SPARSE_RECEIPT.fullmatch(line):
                    role, count, digest = receipt.groups()
                    if role in self.export_receipts:
                        raise Finish(m.EXIT_SHORT, 'duplicate sparse readback receipt')
                    self.export_receipts[role] = (int(count), digest)
                if line == metal_export.SPARSE_DONE and self.export_started is not None:
                    raise Finish(m.EXIT_DONE, 'sparse readback firmware completed')
                return
            if STUB_LINE in line and self.export_started is None:
                self.export_started = observed_at
            if receipt := metal_export.RECEIPT.fullmatch(line):
                role, part, count, digest = receipt.groups()
                key = (role, int(part) if part is not None else None)
                if key in self.export_receipts:
                    raise Finish(m.EXIT_SHORT, 'persistent export repeated a firmware receipt')
                self.export_receipts[key] = (int(count), digest)
            if line == metal_export.DONE:
                if self.export_started is None:
                    raise Finish(m.EXIT_SHORT, 'persistent export is missing the firmware start')
                raise Finish(m.EXIT_DONE, 'persistent export firmware completed')
            return
        if self.kernel_started and self.fatal_at is None:
            challenge = re.fullmatch(r'\[init\] shutdown nonce=([a-f0-9]{64})', line)
            if challenge:
                self.shutdown_token = hashlib.sha256((self.shutdown_seed + challenge[1]).encode()).hexdigest()
            clean = re.fullmatch(r'\[shutdown\] (home|root) clean read-only', line)
            if clean: self.clean_mounts.add(clean[1])
            request = re.fullmatch(r'\[shutdown\] requested (reboot|poweroff) token=([a-f0-9]{64})', line)
            if request and self.shutdown_token is not None and hmac.compare_digest(request[2], self.shutdown_token) and self.clean_mounts == {'home', 'root'}:
                self.shutdown_action = request[1]
                if request[1] == 'reboot':
                    self.seen.discard('manager-slot')
                self.event('requested-shutdown', observed_at=observed_at, action=request[1])
                if request[1] == 'poweroff':
                    raise Finish(m.EXIT_DONE, 'the kernel requested power-off after clean shutdown')
        if (self.requested_reset_at is not None and 'bsshd: listening on ' in line
                and self.kernel_started and 'manager-slot' in self.seen and self.fatal_at is None):
            self.event('requested-reboot-ready', observed_at=observed_at, commit=self.args.commit)
            self.requested_reset_at = None
        self.on_watchdog_line(line, observed_at)
        self.on_migration_line(line, observed_at)
        self.on_persist_line(line, observed_at)
        if BOOTLOADER_LINE in line and self.kernel_started is not None:
            self.on_reset(self.reset_time(observed_at))
            if self.watchdog_trigger is not None or (session(self.args) and persistent(self.args)):
                # The operator restarted the persistent install; the session goes on with the new boot.
                self.event('persistent-restart', observed_at=observed_at, seconds=seconds)
                self.kernel_started = None
                self.seen.discard('bootloader')
            else:
                raise Finish(m.EXIT_SHORT, 'the machine reset after the kernel started')
        if BOOTLOADER_LINE in line and 'bootloader' not in self.seen:
            self.seen.add('bootloader')
            self.event('bootloader', observed_at=observed_at, seconds=seconds)
            self.phase('Bootloader')
            self.last_stage = 'UEFI bootloader started'
        if HANDOFF_LINE in line and self.kernel_started is None:
            self.kernel_started = observed_at
            self.event('handoff', observed_at=observed_at, seconds=seconds)
            self.phase('Handoff: the kernel is starting')
            self.last_stage = 'Bootloader handoff'
        if self.args.payload.startswith('hang') and HANG_LINE in line and self.kernel_started is None:
            self.kernel_started = observed_at
            self.event('payload-started', observed_at=observed_at, seconds=seconds)
            self.phase('Test payload running: interrupts masked, halted')
            self.last_stage = 'metal-hang started'
        suite_record = self.args.mode == 'suite' and line.startswith(('SUITE ', 'SUITE_SEQUENCE '))
        panic_line = re.search(r'KERNEL PANIC[:!]', line)
        dead_suite = self.args.mode == 'suite' and re.search(r'memory allocation of \d+ bytes failed|allocation error:', line)
        if (self.kernel_started and self.fatal_at is None
                and (not suite_record or re.search(r'KERNEL PANIC[:!]', line))
                and (panic_line or dead_suite or any(p.search(line) for p in self.fatal_patterns))):
            self.fatal_at = observed_at
            self.event('fatal', observed_at=observed_at, seconds=seconds)
            if self.args.mode == 'suite' and re.fullmatch(r'BREENIX_ROOT_MOUNT_FATAL errno=[0-9]+', line):
                raise Finish(m.EXIT_SHORT, 'the suite root filesystem could not be mounted')
        if self.args.mode == 'suite' and re.fullmatch(r'SUITE \S+ START cases=\d+(?: only=\S+)?(?: pace_ms=\d+)?(?: screen_proof=on)?|SUITE_SEQUENCE STALLED \S+ cases=\d+/\d+', line):
            self.suite_name = line.split()[1 if line.startswith('SUITE ') else 2]
            if len(suites(self.args)) > 1 or self.suite_name in ('breengel', 'window-manager', 'ui-testing'):
                self.suite_started = observed_at
        if self.args.mode == 'probe' and re.fullmatch(r'PROBE DONE passed=\d+ failed=[1-9]\d*', line):
            self.probe_failed = True
        if '[init] shell ready' in line:
            self.shell_ready = True
        if session(self.args) and self.kernel_started and self.fatal_at is None:
            # The login prompt and echoed input need not end with a newline.
            if line.endswith('[console] input clock alive'):
                self.input_clock_alive = observed_at
            idle = getattr(self.args, 'idle_minutes', 30)
            if line == f'[console] input idle {idle} min':
                raise Finish(m.EXIT_DONE, f'console input idle for {idle} minutes')
        if (getattr(self.args, 'case', None) in ('power-cut/writer', 'power-cut/recovery')
                and line.startswith('SUITE filesystem ERROR ')):
            raise Finish(m.EXIT_SHORT, 'the BreenFS diagnostic reported an error')
        if self.recovery_expected and (recovered := re.fullmatch(
                r'BREENFS POWER-CUT RECOVERY root-is-breenfs bytes=([1-9][0-9]*) sha256=([0-9a-f]{64})', line)):
            if (int(recovered[1]), recovered[2]) != (
                    self.recovery_expected['logBytes'], self.recovery_expected['logSha256']):
                raise Finish(m.EXIT_SHORT, 'the mounted crash log differs from cold replay')
            self.seen.add('cut-recovery-verified')
            self.event('cut-recovery-verified', observed_at=observed_at,
                       bytes=int(recovered[1]), sha256=recovered[2])
        if self.recovery_expected and (missing := self.recovery_expected.get('missingRingB')):
            if line == f"[breenfs] recovered-superblock ring=B slot={missing['slot']} generation={missing['generation']}":
                self.seen.add('cut-recovery-repaired')
                self.event('cut-recovery-repaired', observed_at=observed_at, **missing)
        if self.migration_phase != 'cutover':
            self.on_disk_line(line, observed_at)
        self.on_intent_line(line, observed_at)
        if getattr(self, 'hostkey_reader', None) is None:
            self.on_hostkey_line(line)
        self.challenge_shell(line)
        self.challenge_console(line, complete=True)
        # A prompt is often completed by the next kernel log line before the driver reads it unterminated.
        self.challenge_persistent(line)
        if metal_score.WRITE_FENCE in line:
            layout = self.persistent_fence_layout
            if self.args.mode == 'persistent-install' and getattr(self.args, 'breenfs_upgrade', None):
                layout = self.persist['layout']
            if layout is not None:
                if ('breenfs-fence' in self.seen or not metal_score.breenfs_fence_matches(line, layout)):
                    raise Finish(m.EXIT_SHORT, 'the boot lacks the exact BreenFS system and home write fence')
                self.seen.add('breenfs-fence')
        for stages in self.required_stages:
            if stages and marker_matches(stages[0], line):
                stages.pop(0)
        suite_done = (re.fullmatch(r'SUITE_SEQUENCE DONE suites=\d+', line) if len(suites(self.args)) > 1
                      else re.fullmatch(r'SUITE_SEQUENCE READY ' + re.escape(self.args.suite or ''), line)
                      ) if self.args.mode == 'suite' else True
        if (suite_done and self.final_marker and marker_matches(self.final_marker, line)
                and (self.args.mode != 'shell' or self.shell_sent)):
            self.final_seen = True
        self.maybe_complete(observed_at, seconds)

    def maybe_complete(self, observed_at, seconds):
        """Ends the boot once its final marker, its measured stages and its disk evidence have arrived."""
        if self.args.inject in WATCHDOG_FAULTS: return
        if (self.final_marker and self.final_seen and not any(self.required_stages)
                and self.disk_evidence_seen()
                and not session(self.args)
                and (not getattr(self.args, 'run', None) or self.run_done)
                and (self.args.mode != 'console' or self.console_done)
                and (not getattr(self.args, 'upgrade_parent', None) or self.ssh_verified())
                and (self.migration_phase not in metal_migration.VERIFY_PHASES or self.migration_verified())
                and (self.fatal_at is None or self.panic_oracle) and not self.completion_reported):
            self.completion_reported = True
            self.event('final-marker', observed_at=observed_at, seconds=seconds)
            if self.panic_oracle:
                raise Finish(m.EXIT_SHORT, 'panic oracle terminal records captured')
            if self.args.mode == 'tests':
                passed, reason = metal_score.tests_verdict(self.dir, ''.join(self.test_report_lines))
                self.event('test-report', passed=passed, reason=reason)
                if not passed:
                    raise Finish(m.EXIT_SHORT, reason)
            if self.probe_failed:
                raise Finish(m.EXIT_SHORT, 'the production probe reported a failed check')
            raise Finish(m.EXIT_DONE, 'the mode and its kernel stages finished')

    def on_migration_line(self, line, observed_at):
        phase = self.migration_phase
        if phase == 'add' and line == PERSIST_DONE and self.kernel_started is None:
            metal_persist.update_disk(layout=self.migration['layout'])
            raise Finish(m.EXIT_DONE, 'BreenFS GPT entries and images read back')
        if phase == 'cutover' and line == 'metal-stub: migration rescue slot installed':
            self.seen.add('migration-rescue-staged')
        if phase == 'cutover' and line == PERSIST_DONE and self.kernel_started is None:
            if 'migration-rescue-staged' not in self.seen:
                raise Finish(m.EXIT_SHORT, 'the safe rescue slot was not confirmed before the candidate')
            current = metal_persist.read_disk()['slots']['current']
            metal_persist.update_disk(slots=dict(current=self.migration_slots['rescue'], previous=current,
                                                 next=self.migration_slots['cutover']))
            self.event('migration-slots-staged', observed_at=observed_at)
        if phase != 'migrate' or self.kernel_started is None or self.fatal_at is not None:
            return
        found = re.fullmatch(r'\[migrate\] manifest sha256 source=([0-9a-f]{64}) destination=([0-9a-f]{64})', line)
        if found:
            if self.migration_digests is not None or found[1] != found[2]:
                raise Finish(m.EXIT_SHORT, 'guest migration manifests are inconsistent')
            self.migration_digests = dict(source=found[1], destination=found[2])
        if line == '[migrate] manifests equal':
            self.migration_equal = True
        if line.startswith('[migrate] exit code:'):
            if (line != '[migrate] exit code: 0' or not self.migration_equal
                    or self.migration_digests is None or 'disk-fixture' not in self.seen):
                raise Finish(m.EXIT_SHORT, 'migration has no successful guest manifest comparison')
            raise Finish(m.EXIT_DONE, 'guest migration committed and both manifests agree')

    def on_persist_line(self, line, observed_at):
        """The install boot's request and migration (README, "Install and upgrade")."""
        if self.args.mode == 'persistent-install':
            if line == 'metal-stub: BreenFS upgrade: ext2 rescue pair preserved':
                self.seen.add('breenfs-rescue-preserved')
            if found := re.fullmatch(r'metal-stub: slot userland: (CURRENT|PREVIOUS|NEXT) ([A-Za-z0-9-]{1,64})', line):
                if found[1] in self.slot_userlands:
                    raise Finish(m.EXIT_SHORT, 'duplicate recovered slot reference')
                self.slot_userlands[found[1]] = found[2]
            if line == 'metal-stub: slot userlands complete':
                if set(self.slot_userlands) != {'CURRENT', 'PREVIOUS', 'NEXT'}:
                    raise Finish(m.EXIT_SHORT, 'incomplete recovered slot references')
                self.slot_userlands_complete = True
                self.event('recovered-userlands', references=self.slot_userlands)
            if '[persistent] recovered slot references needed' in line and not self.slot_refs_sent:
                if not self.slot_userlands_complete:
                    raise Finish(m.EXIT_SHORT, 'installer has no recovered slot references')
                refs = 'BREENIX-SLOTS-1 ' + ' '.join(self.slot_userlands[k] for k in ('CURRENT', 'PREVIOUS', 'NEXT'))
                self.console_send(refs, paced=True)
                self.slot_refs_sent = True
        if self.persist and PERSIST_DONE in line and 'persist-written' not in self.seen:
            self.seen.add('persist-written')
            slot = self.persist['slot']
            record = metal_persist.read_disk()
            slots = dict(record.get('slots') or {}, next=slot)
            if rescue := self.persist.get('rescue'):
                if 'breenfs-rescue-preserved' not in self.seen:
                    raise Finish(m.EXIT_SHORT, 'the upgrade stub did not confirm the frozen rescue pair')
                slots['rescue'] = rescue
                self.event('breenfs-rescue-preserved', observed_at=observed_at, commit=rescue['commit'])
            if self.persist['action'] == 'install':
                # From here the disk has the layout, whatever the kernel does next.
                metal_persist.update_disk(layout=self.persist['layout'], slots=slots,
                                          install={'boot': self.id, 'commit': self.args.commit, 'at': observed_at})
            else:
                metal_persist.update_disk(slots=slots)
            self.event('persist-written', observed_at=observed_at, action=self.persist['action'], commit=slot['commit'])
            self.phase('Persistent install: the request is written')
        if self.args.mode == 'persistent-install' and self.kernel_started and INSTALL_FAILED in line:
            self.event('persistent-install-failed', observed_at=observed_at)
            raise Finish(m.EXIT_SHORT, 'the migration onto the system partition failed')
        if self.args.mode == 'persistent-install' and INSTALL_DONE in line:
            self.event('persistent-install-complete', observed_at=observed_at)

    def on_slot_line(self, line, observed_at):
        """The manager's slot commit or rollback, read from the EFI system partition after it renamed the slots."""
        found = re.search(r'breenix-manager: slot (commit|rollback): current ([0-9a-f]{40}), previous ([0-9a-f]{40}|empty)', line)
        if not found or found.group(0) in self.slot_confirmations:
            return
        record = metal_persist.read_disk()
        slots = dict(record.get('slots') or {})
        if found.group(1) == 'commit' and slots.get('next', {}).get('commit') == found.group(2):
            slots['previous'], slots['current'] = slots.get('current'), slots.pop('next')
        elif found.group(1) == 'rollback':
            slots['current'], slots['previous'] = slots.get('previous'), slots.get('current')
        if (slots.get('current') or {}).get('commit') != found.group(2):
            self.event('slot-record-differs', observed_at=observed_at, current=found.group(2))
            raise Finish(m.EXIT_SHORT, "the manager's slots differ from the recorded ones")
        previous = (slots.get('previous') or {}).get('commit', 'empty')
        if previous != found.group(3):
            raise Finish(m.EXIT_SHORT, "the manager's previous slot differs from its record")
        metal_persist.update_disk(slots={k: v for k, v in slots.items() if v})
        self.slot_confirmations.add(found.group(0))
        # Consume a successful action before the next manager query can request another swap.
        with m.locked('lease'):
            lease = m.read_lease()
            if lease and lease.get('id') == self.id and lease.get('slotAction') == found.group(1):
                lease['slotAction'] = None
                m.write_json(m.STATE / m.LEASE, lease)
        self.event('slots', observed_at=observed_at, action=found.group(1), current=found.group(2), previous=found.group(3))

    def on_slot_boot(self, line, observed_at):
        found = re.fullmatch(r'breenix-manager: booting (current|previous|rescue) ([0-9a-f]{40})', line)
        if self.watchdog_trigger is not None and found:
            entry, commit = found.groups()
            if entry != 'current' or commit != self.args.commit:
                raise Finish(m.EXIT_SHORT, 'watchdog returned to another persistent slot')
            run = m.read_json(self.dir / 'run.json', {})
            run['watchdogRecoveredCommit'] = commit
            m.write_json(self.dir / 'run.json', run)
            self.event('watchdog-persistent', observed_at=observed_at, commit=commit)
            return
        if not persistent(self.args) or not found:
            return
        entry, commit = found.groups()
        requested = getattr(self.args, 'entry', None) or 'current'
        if entry != requested and ('rescue' in (entry, requested) or getattr(self.args, 'ext2_reclaimed', None)):
            raise BootManagerAbort(line, observed_at)
        slot = metal_persist.read_disk().get('slots', {}).get(entry, {})
        if self.migration_phase in ('rescue', 'return'):
            expected = 'previous' if self.migration_phase == 'rescue' else 'current'
            kind = 'rescue' if self.migration_phase == 'rescue' else 'cutover'
            if entry != expected or slot.get('migration') != kind or commit != slot.get('commit'):
                raise BootManagerAbort(line, observed_at)
        kept = m.STATE / 'persistent' / commit / 'definition'
        if slot.get('commit') != commit or not kept.is_dir():
            raise Finish(m.EXIT_SHORT, "the booted slot has no matching commit and definition")
        if self.args.commit != commit:
            # This line precedes the bootloader and kernel; use the selected kernel's contracts from here on.
            shutil.rmtree(self.dir / 'definition')
            shutil.copytree(kept, self.dir / 'definition')
            self.args.commit = commit
            m.write_text(self.dir / 'commit', commit + '\n')
            self.load_definition()
        run = m.read_json(self.dir / 'run.json', {})
        run.update(entry=entry, bootedCommit=commit)
        m.write_json(self.dir / 'run.json', run)
        # A lab-selected previous entry is one-shot within this lease too.
        # A later reboot or watchdog reset asks for current without swapping slots.
        m.update_lease(self.id, entry='current')
        self.seen.add('manager-slot')
        self.event('slot-boot', observed_at=observed_at, entry=entry, commit=commit)

    def challenge_persistent(self, text):
        """A persistent boot with --run: log in over SOL with the console account, type each command at a fresh
        prompt, log out, and end at the next login prompt."""
        # The session ends with a power-off: flush the writes the commands made (/bin/sync) before logging out.
        commands = (getattr(self.args, 'run', None) or []) + ['sync']
        if not persistent(self.args) or len(commands) == 1 or self.kernel_started is None or self.fatal_at is not None:
            return
        if self.run_failure:
            raise Finish(m.EXIT_SHORT, self.run_failure)
        if self.run_step >= 2 and re.search(r'\[bsh\] command failed status=[1-9][0-9]*', text):
            self.fail_persistent('a persistent console command failed')
        fresh = self.line_start > self.sent_at
        prompt = re.fullmatch(r'bsh [^>\n]*>\s*', text) is not None
        last = 2 + len(commands)
        # A prompt can be followed by asynchronous diagnostics in the same read.
        # Ask getty for a new one before typing credentials, without requiring an exact line.
        if self.run_step == 0 and 'Breenix login: ' in text:
            self.run_step, self.sent_at = -1, self.line_start
            self.console_send('', paced=True)
        elif self.run_step == -1 and fresh and 'Breenix login: ' in text:
            self.run_step, self.sent_at = 1, self.line_start
            self.console_send(self.site['CONSOLE_USER'], paced=True)
        elif self.run_step == 1 and fresh and 'Password: ' in text:
            self.run_step, self.sent_at = 2, self.line_start
            self.console_send(self.site['CONSOLE_PASSWORD'], paced=True)
        elif 2 <= self.run_step <= last and 'Login incorrect' in text:
            self.fail_persistent('the persistent install refused the console account; commands never ran')
        elif 3 <= self.run_step <= last:
            index = self.run_step - 2
            marker = f'metal-run-{self.run_nonce}-{index}'
            found = re.fullmatch(re.escape(marker) + r' ([0-9]+)\s*', text)
            if found and fresh and self.run_verified < index:
                status = int(found[1])
                self.event('persistent-command-result', index=index, status=status)
                if status:
                    self.fail_persistent(f'persistent console command {index} failed with status {status}')
                self.run_verified = index
            if fresh and prompt and self.run_verified != index:
                self.fail_persistent(f'persistent console command {index} returned without an exit status')
        if 2 <= self.run_step <= last and fresh and prompt:
            if self.run_step < last:
                index = self.run_step - 1
                marker = f'metal-run-{self.run_nonce}-{index}'
                # bsh -c preserves the account shell's command syntax and returns
                # ordinary nonzero statuses too. A prompt alone proves no success.
                command = 'print("\\n' + marker + '", run("/bin/bsh", "-c", ' + json.dumps(commands[index - 1]) + '))'
                self.event('persistent-command', index=index, of=len(commands))
                self.console_send(command, paced=True)
                self.run_step += 1
            else:
                self.run_step = last + 1
                self.console_send('exit', paced=True)
            self.sent_at = self.line_start
        elif self.run_step == last + 1 and fresh and 'Breenix login: ' in text:
            self.run_step = last + 2
            self.run_done = True
            self.event('persistent-commands-done', commands=len(commands))
            self.maybe_complete(m.now(), round(m.now() - self.t0, 1))

    def fail_persistent(self, reason):
        # pump_serial finishes the captured batch after a decision. Later
        # prompts must neither replace this reason nor start another command.
        self.run_failure = reason
        raise Finish(m.EXIT_SHORT, reason)

    def persistent_missing(self):
        if not getattr(self.args, 'run', None) or self.run_done:
            return 'stages missing'
        if self.run_step <= 2:
            return 'persistent console login did not finish; commands never ran'
        return f'persistent console commands incomplete; {self.run_verified} exit statuses verified'

    def on_manager_line(self, line, observed_at, seconds):
        """The boot manager's start, the lab's answer it acted on, and a probe's end (README, "The boot manager")."""
        answer = MANAGER_ANSWER.search(line)
        if getattr(self.args, 'entry', None) == 'rescue' and (
                (answer and answer[1] != f'persistent {self.id} rescue')
                or 'breenix-manager: ext2 rescue unavailable' in line):
            raise BootManagerAbort(line, observed_at)
        if self.migration_phase in ('rescue', 'return'):
            expected = metal_migration.manager_answer(self.migration_phase, self.id, self.args.slot_action)
            if ((answer and answer[1] != expected)
                    or 'breenix-manager: the slot action failed' in line
                    or 'breenix-manager: installed configuration unavailable' in line):
                raise BootManagerAbort(line, observed_at)
        # An intentional watchdog recovery returns to the persistent slot.
        if not persistent(self.args) and self.watchdog_trigger is None and (
                (answer and answer[1] != f'test {self.id}') or MANAGER_PERSISTENT_COUNTDOWN.search(line)
                or MANAGER_PERSISTENT_START.search(line)):
            raise BootManagerAbort(line, observed_at)
        if MANAGER_STARTED in line and self.kernel_started is not None and session(self.args) and persistent(self.args):
            self.on_reset(self.reset_time(observed_at))
            self.event('persistent-restart', observed_at=observed_at)
            self.kernel_started = None
        self.on_slot_line(line, observed_at)
        self.on_slot_boot(line, observed_at)
        if MANAGER_STARTED in line:
            self.manager_started = self.manager_started or observed_at
            self.event('manager-started', observed_at=observed_at, seconds=seconds)
            self.phase('Boot manager started')
            if self.args.payload == 'manager' and self.kernel_started is None:
                self.kernel_started = observed_at
                self.last_stage = 'boot manager started'
        if answer:
            if self.migration_phase:
                self.migration_answer = True
            self.event('manager-answer', observed_at=observed_at, answer=answer[1][:120])
            self.phase('Boot manager: the lab answered ' + answer[1][:80])
        if MANAGER_PANIC in line:
            raise Finish(m.EXIT_SHORT, 'the boot manager panicked')
        if self.args.payload == 'manager' and MANAGER_PROBE_DONE in line:
            raise Finish(m.EXIT_DONE, 'the boot manager probe completed')

    def disk_evidence_seen(self):
        """The disk's record, and on a disk-root console boot the kernel's account of this boot's intent."""
        if self.migration_phase == 'cutover':
            return getattr(self, 'migration_slots', None) is not None
        needed = {None: set(), 'install': {'disk-write'}, 'root': {'disk-root'}}[getattr(self.args, 'disk', None)]
        if persistent(self.args):
            needed.add('manager-slot')
        if self.console_intent:
            needed.add('console-intent')
        if self.recovery_expected:
            needed.add('cut-recovery-verified')
            if self.recovery_expected.get('missingRingB'):
                needed.add('cut-recovery-repaired')
        return needed <= self.seen

    def wait_replay_ack(self, sequence, kind="BXKEY"):
        marker = ('%s_ACK %016x' % (kind, sequence)).encode()
        deadline = time.monotonic() + 0.35
        raw = self.dir / 'serial.raw'
        while time.monotonic() < deadline:
            self.checkpoint()
            with raw.open('rb') as stream:
                stream.seek(max(0, raw.stat().st_size - 65536))
                if re.search(rb'(?:^|[\r\n])' + marker + rb'\r?\n', stream.read()):
                    return True
            time.sleep(0.01)
        return False

    def replay_send(self, line):
        # A UART/SOL loss must not silently remove a chord. Retry the numbered
        # packet; the kernel acknowledges duplicates without queueing them again.
        if line.startswith('BXPTR @'):
            sequence = int(line[7:23], 16)
            for attempt in range(3):
                self.console_send(line, paced=True)
                if self.wait_replay_ack(sequence, 'BXPTR'):
                    return
                self.event('hostpointer-retry', sequence=sequence, attempt=attempt + 1)
            raise RuntimeError('host pointer packet %d was not acknowledged' % sequence)
        sequence = getattr(self, 'hostkey_sequence', 0) + 1
        self.hostkey_sequence = sequence
        body = '%016x %s' % (sequence, line.removeprefix('BXKEY '))
        packet = 'BXKEY @%016x:%08x %s' % (sequence, zlib.crc32(body.encode()), line.removeprefix('BXKEY '))
        for attempt in range(3):
            self.console_send(packet, paced=True)
            if self.wait_replay_ack(sequence):
                return
            self.event('hostkey-retry', sequence=sequence, attempt=attempt + 1)
        raise RuntimeError('host key packet %d was not acknowledged' % sequence)

    def on_hostkey_line(self, line):
        """A suite case's HOSTKEY record: type its chords on the serial console as HID boot reports, which the
        kernel delivers through its shared host input devices (scripts/hostkeys.py, ReplayKeys). Each record is answered
        once; what was sent goes to the boot's events, never to the guest's serial."""
        if self.args.mode != 'suite' or not self.kernel_started or self.fatal_at is not None:
            return
        if self.hostkey_watcher is None:
            self.hostkey_watcher = hostkeys.Watcher(hostkeys.ReplayKeys(self.replay_send), 'replay',
                                                    log=lambda message: self.event('hostkeys', message=message))
        self.hostkey_watcher.line(line)

    def drain_hostkey_events(self):
        events = getattr(self, 'hostkey_events', None)
        if events is not None:
            while True:
                try:
                    kind, at, fields = events.get_nowait()
                except queue.Empty:
                    break
                self.event(kind, observed_at=at, **fields)

    def start_hostkey_reader(self):
        """Serve console requests from the authoritative raw capture independently of archiving.

        The archive loop can spend seconds processing a capture batch. Neither its
        record writes nor scoring work may delay a case's next HOSTKEY request.
        """
        if self.args.mode != 'suite' or not {'console', 'window-manager'}.intersection(suites(self.args)):
            return
        self.hostkey_events = queue.SimpleQueue()
        self.hostkey_stop = threading.Event()
        self.hostkey_error = None

        def read():
            offset, pending = 0, ''
            cleaner = m.SerialCleaner()
            try:
                while not self.hostkey_stop.is_set():
                    with (self.dir / 'serial.raw').open('rb') as stream:
                        stream.seek(offset)
                        data = stream.read(65536)
                    if not data:
                        self.hostkey_stop.wait(0.01)
                        continue
                    offset += len(data)
                    lines = (pending + cleaner.feed(data)).split('\n')
                    pending = lines.pop()
                    for line in lines:
                        if self.hostkey_stop.is_set():
                            return
                        self.on_hostkey_line(line)
            except Exception as error:
                if not self.hostkey_stop.is_set():
                    self.hostkey_error = error

        self.hostkey_reader = threading.Thread(target=read, name='metal-hostkeys', daemon=True)
        self.hostkey_reader.start()

    def stop_hostkey_reader(self):
        reader = getattr(self, 'hostkey_reader', None)
        if reader is None:
            return True
        self.hostkey_stop.set()
        reader.join(5)
        self.drain_hostkey_events()
        return not reader.is_alive()

    def on_intent_line(self, line, observed_at):
        """A disk-root console boot's replug choice must come from its staged intent, not the installed target."""
        if not self.console_intent or 'console-intent' in self.seen or not (found := INTENT_LINE.search(line)):
            return
        self.seen.add('console-intent')
        replug = found.group(1) == 'requested'
        honored = found.group(2) == 'intent' and replug == (self.console_intent == 'measure')
        self.event('console-intent', observed_at=observed_at, staged=self.console_intent, replug=replug,
                   source=found.group(2), honored=honored)
        if not honored and not session(self.args):
            raise Finish(m.EXIT_SHORT, "the kernel did not apply this boot's console intent")

    # claim-lint:ok: #1680 Reviewed tool contract against this function and the host tests in tests/metal_tools_test.py.
    def on_disk_line(self, line, observed_at):
        """Check the kernel's account of the disk against what this boot asked for (README, "The disks")."""
        disk = getattr(self.args, 'disk', None)
        if disk == 'install' and 'disk-write' not in self.seen and (found := READ_BACK_LINE.search(line)):
            self.seen.add('disk-write')
            write = self.delivery['root']['diskWrite']
            matched = int(found.group(1)) == write['bytes'] and found.group(2) == write['sha256AfterRecord']
            self.event('disk-write-verified', observed_at=observed_at, match=matched, bytes=int(found.group(1)))
            if not matched:
                raise Finish(m.EXIT_SHORT, 'the installed bytes or digest differ from the staged image')
            # The disk now holds this boot's root: a later disk-root boot expects this install.
            metal_persist.record_test_root(dict(write, commit=self.args.commit, verifiedAt=observed_at, mode=self.args.mode,
                                                consoleIdentity=self.delivery['root'].get('consoleIdentity')))
        if disk == 'root' and 'disk-fixture' not in self.seen and (found := re.search(r'metal-stub: suite fixture verified: (\d+) bytes', line)):
            if self.recovery_expected:
                raise Finish(m.EXIT_SHORT, 'the recovery boot unexpectedly staged a fixture')
            installed = self.delivery['diskRoot']
            size = installed.get('stagedBytes', installed['bytes'])
            if int(found.group(1)) != size:
                raise Finish(m.EXIT_SHORT, 'the firmware fixture size differs from the staged image')
            self.seen.add('disk-fixture')
            # Firmware has flushed and read back the entire image and written
            # the record last. Persist before a kernel panic can prevent mount.
            metal_persist.record_test_root(dict(installed, lastBoot=self.id))
            self.event('disk-fixture-verified', observed_at=observed_at, bytes=size)
        if disk == 'root' and 'disk-root' not in self.seen and (found := ROOT_RECORD_LINE.search(line)):
            self.seen.add('disk-root')
            installed = self.delivery['diskRoot']
            matched = (found.group(1) == installed.get('installedBy') and int(found.group(2)) == installed.get('bytes')
                       and found.group(3) == installed.get('sha256AfterRecord'))
            self.event('disk-root-record', observed_at=observed_at, matchesLastInstall=matched,
                       installedBy=found.group(1))
            if not matched:
                raise Finish(m.EXIT_SHORT, 'the disk root record differs from the recorded install')
            self.seen.add('disk-root-confirmed')
            metal_persist.record_test_root(dict(installed, lastBoot=self.id))

    # The HTTP server's log.
    def pump_http(self):
        log = m.STATE / 'http.jsonl'
        if not log.exists():
            return
        with log.open() as handle:
            handle.seek(self.http_offset)
            lines = handle.readlines()
            self.http_offset = handle.tell()
        for line in lines:
            with contextlib.suppress(ValueError):
                self.on_http(json.loads(line))

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def on_http(self, entry):
        if self.t0 is None or entry.get('t', 0) < self.t0:
            return
        observed_at = entry['t']
        elapsed = round(observed_at - self.t0, 1)
        kind = entry.get('event')
        if kind == 'manager-query':
            # The boot manager's question; not the firmware's image request, so it leaves the POST measurement alone.
            self.event('manager-query', observed_at=observed_at, seconds=elapsed, answer=entry.get('answer'))
            return
        if kind not in ('redirect', 'head', 'start', 'progress', 'range-done', 'complete', 'short', 'broken', '404',
                        'range-invalid'):
            return
        if kind == '404' and not entry.get('route'):
            return
        if self.request_at is None:
            self.request_at = entry['t']
            seconds = self.request_at - self.t0
            self.delivery['postSeconds'] = round(seconds, 1)
            m.record_post_time(self.id, seconds)
            self.event('image-request', observed_at=observed_at, seconds=round(seconds, 1))
            self.phase(f'Image requested · {seconds:.0f} s after power-on')
        if kind == '404':
            if self.complete_at is None and self.not_found_at is None:
                self.not_found_at = entry['t']
                self.event('image-not-found', observed_at=observed_at, seconds=elapsed)
                self.phase('No image staged: the request was refused')
            elif self.complete_at is not None:
                self.event('image-refused-again', observed_at=observed_at, seconds=elapsed)
                if self.kernel_started is not None and self.watchdog_trigger is None:
                    self.on_reset(self.reset_time(observed_at))
                    raise Finish(m.EXIT_SHORT, 'the machine reset after the kernel started')
            return
        if entry.get('id') != self.id:
            return
        if kind == 'redirect':
            self.event('image-redirect', observed_at=observed_at, method=entry.get('method'))
        elif kind == 'start':
            self.first_byte_at = self.first_byte_at or entry['t']
            self.last_progress = entry['t']
            self.broken_at = None
            self.event('image-start', observed_at=observed_at, total=entry.get('total'))
        elif kind in ('progress', 'range-done'):
            self.last_progress = entry['t']
            if m.now() - self.last_phase_progress >= 5:
                self.last_phase_progress = m.now()
                self.phase(f"Fetching boot image · {entry['bytes'] >> 20} of {entry['total'] >> 20} MB")
        elif kind == 'range-invalid':
            self.event('image-range-invalid', observed_at=observed_at, range=entry.get('range'))
        elif kind == 'broken':
            self.broken_at = entry['t']
            self.event('image-broken', observed_at=observed_at, bytes=entry.get('bytes'))
        elif kind in ('complete', 'short'):
            if kind == 'short' or not entry.get('matches'):
                self.event('image-mismatch', observed_at=observed_at, bytes=entry.get('bytes'))
                raise Finish(m.EXIT_DELIVERY, 'the image arrived incomplete or with the wrong checksum')
            self.complete_at = entry['t']
            seconds = entry['t'] - (self.first_byte_at or entry['t'])
            self.delivery['transferSeconds'] = round(seconds, 2)
            self.event('image-complete', observed_at=observed_at, seconds=elapsed, transfer=round(seconds, 2),
                       sha256=entry.get('sha256'))
            self.phase(f'Image fetched in {seconds:.1f} s')

    # Paced reads of boot progress and the POST code.
    def poller(self):
        while not self.stopping.is_set():
            interval = RUNNING_POLL_SECONDS if self.kernel_started or self.complete_at else POST_POLL_SECONDS
            try:
                system = m.rf_get(m.SYSTEM + '?$select=PowerState,BootProgress')
                manager = m.rf_get(m.MANAGER_ATTRIBUTES + '?$select=Attributes/SysInfo.1.POSTCode')
                reading = {'t': m.now(), 'power': system.get('PowerState'), 'progress': system.get('BootProgress'),
                           'postCode': (manager.get('Attributes') or {}).get('SysInfo.1.POSTCode')}
            except m.BmcError as error:
                reading = {'t': m.now(), 'error': str(error)}
            with self.bmc_lock:
                self.bmc_events.append(reading)
            self.stopping.wait(interval)

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def pump_bmc(self):
        with self.bmc_lock:
            readings, self.bmc_events = self.bmc_events, []
        for reading in readings:
            observed_at = reading['t']
            elapsed = round(observed_at - self.t0, 1)
            if 'error' in reading:
                self.event('bmc-read-error', observed_at=observed_at, error=reading['error'])
                continue
            if reading.get('power') == 'On':
                self.power_seen_on = True
            if reading.get('power') == 'Off' and (self.power_seen_on or self.kernel_started is not None):
                self.event('power-off-observed', observed_at=observed_at, seconds=elapsed)
                raise Finish(m.EXIT_DONE if session(self.args) else m.EXIT_SHORT,
                             'the machine powered off during the boot')
            unknown = self.progress_unknown_at
            pending = unknown is not None and 0 <= observed_at - unknown <= 60
            code = reading.get('postCode')
            code_changed = code is not None and code != self.post_code
            progress = reading.get('progress') or {}
            if code_changed:
                previous, self.post_code = self.post_code, code
                if not self.post_seen:
                    self.post_seen = True
                    self.event('post', observed_at=observed_at, code=code, previous=previous, seconds=elapsed)
                else:
                    self.event('post-code', observed_at=observed_at, code=code, seconds=elapsed)
                if self.kernel_started is None and self.request_at is None:
                    self.phase(f'POST code 0x{int(code):02x} · {self.since_power():.0f} s')
            key = progress_key(progress)
            progress_changed = key != self.progress_key
            if progress_changed:
                # Only a state new since power-on counts: the baseline may be left from an earlier power cycle.
                self.progress_key = key
                self.progress_changed = True
                self.event('boot-progress', observed_at=observed_at, state=key[0], oem=key[1], seconds=elapsed)
            # S26: an empty management state is not POST evidence. Retain the
            # selected management reading beside it; do not delay stage judging.
            if self.kernel_started is not None:
                empty = key[0] in (None, '', 'None')
                if empty and key != self.unknown_progress_key:
                    self.progress_unknown_at = observed_at
                    self.unknown_progress_key = key
                    self.event('boot-progress-unknown', observed_at=observed_at, reading=reading)
                elif not empty:
                    self.unknown_progress_key = None
                if (progress_changed and not empty and key[0] not in RUNNING_STATES) or (pending and code_changed):
                    self.on_reset(self.reset_time(observed_at))
                    if self.watchdog_trigger is not None or (session(self.args) and persistent(self.args)):
                        self.event('persistent-restart', observed_at=observed_at, state=key[0])
                        self.kernel_started = None
                    else:
                        raise Finish(m.EXIT_SHORT, 'the machine reset after the kernel started')
            if NO_BOOTABLE in key[1].lower() and self.kernel_started is None:
                raise Finish(m.EXIT_DELIVERY, 'the firmware found no bootable device')

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    # Deadlines.
    def reset_time(self, observed_at):
        unknown = self.progress_unknown_at
        self.progress_unknown_at = None
        self.unknown_progress_key = None
        return unknown if unknown is not None and 0 <= observed_at - unknown <= 60 else observed_at

    def on_reset(self, observed_at):
        if self.shutdown_action == 'reboot' and self.fatal_at is None:
            self.event('requested-reset-observed', observed_at=observed_at)
            if not (session(self.args) and persistent(self.args)):
                raise Finish(m.EXIT_SHORT, 'requested reset needs a persistent session')
            self.requested_reset_at = observed_at
            self.shutdown_action = None
            self.clean_mounts.clear()
            self.seen.discard('bootloader')
        if self.args.inject == 'panic-reboot' and self.fatal_at is not None:
            self.event('panic-reset-observed', observed_at=observed_at)
            raise Finish(m.EXIT_SHORT, 'fault-test panic reset observed')

    def persistent_deadlines(self):
        """A persistent boot: POST until the manager starts, then silence bounds until the kernel; a session has no
        deadline after that, a check boot its mode deadline."""
        if self.requested_reset_at is not None and m.now() - self.requested_reset_at > 600:
            raise Finish(m.EXIT_HUNG, 'requested reboot did not return to SSH', hung=True)
        if getattr(self.args, 'upgrade_parent', None) or self.migration_phase in metal_migration.VERIFY_PHASES:
            self.maybe_complete(m.now(), self.since_power())
            if self.t0 is not None and self.since_power() >= 600:
                raise Finish(m.EXIT_SHORT, 'S21 SSH verification deadline passed')
        if self.lease_ceiling and m.now() >= self.lease_ceiling:
            raise Finish(m.EXIT_HUNG, 'the attempt ceiling passed', hung=True)
        if self.fatal_at and m.now() - self.fatal_at >= (120 if self.args.inject == 'panic-reboot' else FATAL_GRACE_SECONDS):
            raise Finish(m.EXIT_SHORT, 'a fatal line')
        adopted = getattr(self.args, 'adopt', False)
        if self.manager_started is None and self.kernel_started is None and not adopted:
            if self.since_power() > self.post_budget:
                raise Finish(m.EXIT_HUNG, f'POST over budget: the boot manager did not start (code {self.post_code})')
            return
        if session(self.args):
            return
        quiet = m.now() - max(self.last_serial or 0, self.kernel_started or self.manager_started or 0)
        if quiet > SILENCE_SECONDS:
            raise Finish(m.EXIT_HUNG, f'silent for {SILENCE_SECONDS} s after {self.last_stage or "the boot manager"}', hung=True)
        if self.kernel_started and m.now() - self.kernel_started > MODE_DEADLINE_SECONDS['persistent']:
            raise Finish(m.EXIT_SHORT, 'the mode deadline passed: ' + self.persistent_missing())

    def on_watchdog_line(self, line, observed_at):
        if self.args.inject not in WATCHDOG_FAULTS: return
        expected = '[watchdog-fault] trigger ' + self.args.inject.removeprefix('watchdog-')
        if line != expected: return
        if self.watchdog_trigger is not None:
            raise Finish(m.EXIT_SHORT, 'duplicate watchdog fault')
        self.watchdog_trigger = observed_at
        # This only changes the manager's one-shot answer. No power operation is
        # sent: the armed BMC must perform the reset itself.
        m.update_lease(self.id, watchdogRecovery=True, ceilingAt=observed_at + 660)
        self.event('watchdog-trigger', observed_at=observed_at, fault=self.args.inject, trigger=observed_at)

    def watchdog_verdict(self, receipt):
        serial = (self.dir / 'serial.txt').read_text()
        events = [json.loads(row) for row in (self.dir / 'events.jsonl').read_text().splitlines()]
        run = m.read_json(self.dir / 'run.json', {})
        trigger = self.watchdog_trigger
        at = receipt.get('sshAt', 0)
        after = serial.split('[watchdog-fault] trigger ', 1)[-1]
        before = serial.split('[watchdog-fault] trigger ', 1)[0]
        forbidden = {'power-on', 'power-off', 'power-off-observed', 'nmi', 'nmi-capture-done',
                     'console-gap-start', 'driver-error', 'persistent-verification-error'}
        assisted = any(e.get('event') in forbidden and trigger <= e['t'] <= at for e in events)
        ids = re.findall(r'\[init\] log boot-id=([a-f0-9-]+)', serial)
        return (receipt.get('boot') == self.id and receipt.get('commit') == self.args.commit
                and receipt.get('case') == self.args.inject.removeprefix('watchdog-')
                and receipt.get('trigger') == trigger
                and 0 < at - trigger <= 600 and at <= m.now() + 1
                and run.get('toolsCommit') == self.args.commit
                and run.get('watchdogRecoveredCommit') == self.args.commit
                and '[watchdog] armed seconds=120 action=hard-reset' in before
                and '[watchdog] healthy feeds=6' in before
                and '[watchdog] previous-expired=1' in after
                and '[storage] root partition: system ' in after
                and len(ids) >= 2 and ids[0] != ids[-1] and receipt.get('bootId') == ids[-1]
                and not assisted and not self.gap and self.fatal_at is None)

    def check_deadlines(self):
        if self.watchdog_trigger is not None:
            receipt = m.read_json(self.dir / 'watchdog-ssh.json', {})
            if receipt:
                passed = self.watchdog_verdict(receipt)
                verdict = dict(passed=passed, commit=self.args.commit, boot=self.id, receipt=receipt)
                if m.read_json(self.dir / 'watchdog-verdict.json', {}) != verdict:
                    m.write_json(self.dir / 'watchdog-verdict.json', verdict)
                    self.event('watchdog-verdict', passed=passed)
                if passed and receipt.get('cleanShutdown'):
                    if m.now() - receipt['sshAt'] > 120:
                        raise Finish(m.EXIT_SHORT, 'watchdog clean shutdown deadline passed')
                    return
                raise Finish(m.EXIT_DONE if passed else m.EXIT_SHORT, 'watchdog recovery observation complete')
            if m.now() - self.watchdog_trigger > 600:
                m.write_json(self.dir / 'watchdog-verdict.json', dict(passed=False, commit=self.args.commit,
                    boot=self.id, reason='no unaided SSH within 600 seconds'))
                raise Finish(m.EXIT_SHORT, 'watchdog recovery deadline passed')
            return
        if persistent(self.args):
            return self.persistent_deadlines()
        elapsed = self.since_power()
        if self.migration_phase == 'cutover':
            self.maybe_complete(m.now(), elapsed)
        if self.lease_ceiling and m.now() >= self.lease_ceiling:
            raise Finish(m.EXIT_DONE if session(self.args) else m.EXIT_HUNG,
                         'console session ceiling passed' if session(self.args) else 'the attempt ceiling passed',
                         hung=not session(self.args))
        if self.fatal_at and m.now() - self.fatal_at >= (120 if self.args.inject == 'panic-reboot' else FATAL_GRACE_SECONDS):
            raise Finish(m.EXIT_SHORT, 'a fatal line')
        if self.request_at is None:
            if elapsed > self.post_budget:
                raise Finish(m.EXIT_HUNG, f'POST over budget at code {self.post_code}')
            return
        if self.not_found_at is not None and self.complete_at is None:
            if m.now() - self.not_found_at >= NOT_FOUND_CAPTURE_SECONDS:
                raise Finish(m.EXIT_DELIVERY, 'no image was staged: the request got 404')
            return
        if self.complete_at is None:
            if self.first_byte_at is None:
                if m.now() - self.request_at > DOWNLOAD_SECONDS:
                    raise Finish(m.EXIT_DELIVERY, 'the image was requested but never fetched')
                return
            if m.now() - (self.last_progress or self.first_byte_at) > DOWNLOAD_IDLE_SECONDS:
                raise Finish(m.EXIT_DELIVERY, 'the transfer stalled')
            if m.now() - self.first_byte_at > DOWNLOAD_SECONDS:
                raise Finish(m.EXIT_DELIVERY, 'the transfer was too slow')
            return
        if self.migration_phase in metal_migration.VERIFY_PHASES and elapsed >= 600:
            raise Finish(m.EXIT_SHORT, 'migration SSH verification deadline passed')
        if self.migration_phase == 'migrate' and self.kernel_started:
            return
        if self.export_started is not None:
            if m.now() - max(self.last_serial or 0, self.export_started) > SILENCE_SECONDS:
                raise Finish(m.EXIT_HUNG, 'persistent export stopped reporting progress')
            return
        if self.kernel_started is None:
            # An install's stub writes the layout and the test root first, reporting its progress.
            limit = (INSTALL_STUB_SECONDS if self.args.mode == 'persistent-install' or self.migration_phase
                     or self.args.payload == metal_persist.RECLAIM_PAYLOAD
                     else BOOTLOADER_SECONDS)
            if 'bootloader' not in self.seen and m.now() - self.complete_at > limit:
                raise Finish(m.EXIT_DELIVERY, 'no bootloader after the image arrived')
            quiet = m.now() - (self.last_serial or self.complete_at)
            if 'bootloader' in self.seen and quiet > SILENCE_SECONDS:
                raise Finish(m.EXIT_HUNG, f'silent for {SILENCE_SECONDS} s after the bootloader started', hung=True)
            return
        if session(self.args):
            quiet = m.now() - (self.input_clock_alive or self.kernel_started)
            if quiet > SILENCE_SECONDS:
                raise Finish(m.EXIT_HUNG, f'console input clock silent for {SILENCE_SECONDS} s', hung=True)
            return
        quiet = m.now() - max(self.last_serial or 0, self.kernel_started)
        if quiet > SILENCE_SECONDS:
            raise Finish(m.EXIT_HUNG, f'silent for {SILENCE_SECONDS} s after {self.last_stage}', hung=True)
        # Each suite has a DONE deadline independent of progress and the fixed attempt ceiling.
        if m.now() - (self.suite_started or self.kernel_started) > mode_deadline_seconds(self.args, self.suite_name):
            raise Finish(m.EXIT_SHORT, 'the mode deadline passed with stages missing')

    # Power.
    def power_on(self):
        self.checkpoint()
        self.phase_name = 'powering-on'
        if metal_persist.layout():
            # The boot manager is first in the firmware's boot order and asks the lab (README, "Test boots on the
            # persistent layout"); a persistent boot never fetches anything.
            self.event('override-skipped', why='the boot manager starts the test loop or the persistent install')
        else:
            try:
                m.rf('PATCH', m.SYSTEM, {'Boot': {'BootSourceOverrideEnabled': 'Once',
                                                  'BootSourceOverrideTarget': 'UefiHttp',
                                                  'BootSourceOverrideMode': 'UEFI'}})
                boot = m.rf_get(m.SYSTEM + '?$select=Boot').get('Boot', {})
            except m.BmcError as error:
                self.event('override-error', error=str(error))
                raise Finish(m.EXIT_DELIVERY, 'the one-time boot override could not be set')
            if boot.get('BootSourceOverrideEnabled') != 'Once' or boot.get('BootSourceOverrideTarget') != 'UefiHttp':
                raise Finish(m.EXIT_DELIVERY, 'the one-time boot override did not read back')
            self.event('override-set', target='UefiHttp')
        self.checkpoint()
        self.t0 = m.now()
        ceiling = ceiling_seconds(self.args)
        self.lease_ceiling = None if ceiling is None else self.t0 + ceiling
        m.update_lease(self.id, state='powered', powerOnAt=self.t0, ceilingAt=self.lease_ceiling)
        try:
            reply = m.rf('POST', m.SYSTEM + '/Actions/ComputerSystem.Reset', {'ResetType': 'On'}, priority=0)
            self.t0 = reply['startedAt']
            self.lease_ceiling = None if ceiling is None else self.t0 + ceiling
            m.update_lease(self.id, powerOnAt=self.t0, ceilingAt=self.lease_ceiling)
        except m.BmcError as error:
            m.quarantine_lease(self.id, 'power-on outcome uncertain')
            self.event('power-on-error', error=str(error))
            raise Finish(m.EXIT_DELIVERY, 'power-on was refused')
        self.post_budget = m.post_budget()
        self.event('power-on', observed_at=self.t0, postBudget=self.post_budget, ceiling=ceiling)
        self.phase('Power on')
        self.phase_name = 'post'

    def watch(self):
        self.start_hostkey_reader()
        threading.Thread(target=self.poller, daemon=True).start()
        last_console_check = 0.0
        while True:
            self.checkpoint()
            self.check_power_cut_deadline()
            self.pump_serial()
            self.pump_http()
            self.pump_bmc()
            if m.now() - last_console_check >= 1:
                last_console_check = m.now()
                if self.console_dead():
                    self.heal_console()
            if self.kernel_started:
                self.phase_name = 'kernel'
            elif self.complete_at:
                self.phase_name = 'bootloader'
            elif self.first_byte_at:
                self.phase_name = 'download'
            self.check_deadlines()
            time.sleep(0.25)

    def check_power_cut_deadline(self):
        if self.power_cut is not None and (seconds := self.power_cut['afterSeconds']) is not None:
            if self.t0 is not None and m.now() >= self.t0 + seconds:
                raise PowerCut()

    def cut_power(self, trigger):
        # Record the host time of the cut request and whether the controller confirmed Off.
        cut_at = m.now()
        off = self.power_off(False, immediate=True)
        self.power_cut.update(triggerLine=trigger.line, triggerObservedAt=trigger.observed_at,
                              triggerSerialOffset=trigger.serial_offset, cutAt=cut_at,
                              powerOffAt=m.now() if off else None, powerOffConfirmed=off)
        for name in ('run.json', 'metal-run.json'):
            path = self.dir / name
            if path.is_file():
                run = m.read_json(path)
                run['powerCut'] = self.power_cut
                m.write_json(path, run)
        return off

    def power_off(self, hung, *, immediate=False):
        """NMI first when a started kernel or payload hung (or `--nmi` asks for it), then ForceOff; quarantine if it
        does not go Off."""
        if not immediate and (hung or getattr(self.args, 'nmi', False)) and self.kernel_started:
            try:
                m.rf('POST', m.SYSTEM + '/Actions/ComputerSystem.Reset', {'ResetType': 'Nmi'}, priority=0)
                self.event('nmi')
                self.phase('NMI sent; capturing for 5 s')
            except m.BmcError as error:
                self.event('nmi-error', error=str(error))
            end = m.now() + NMI_CAPTURE_SECONDS
            while m.now() < end:
                with contextlib.suppress(Finish):
                    self.pump_serial()
                time.sleep(0.25)
            self.event('nmi-capture-done', bytesAfter=self.raw_offset)
        if not immediate and self.args.inject == 'forceoff-fail':
            self.event('power-off-failed', injected=True)
            self.phase('Power-off failed (injected): the machine may still be on')
            m.quarantine_lease(self.id, 'driver power-off failed (injected)')
            return False
        started = m.now()
        off = m.force_off_and_wait(immediate=True) if immediate else m.force_off_and_wait()
        self.event('power-off', off=off, seconds=round(m.now() - started, 1))
        if off:
            self.phase('Powered off')
        else:
            self.phase('Power-off failed: the machine may still be on')
            m.quarantine_lease(self.id, 'driver power-off failed')
        return off

    def abort_manager_boot(self, finish):
        requested_at = m.now()
        off = self.power_off(False, immediate=True)
        run_path = self.dir / 'run.json'
        run = m.read_json(run_path)
        run['bootManagerAbort'] = dict(line=self.redact(finish.line), observedAt=finish.observed_at,
                                      action='ForceOff', powerOffRequestedAt=requested_at, powerOffConfirmed=off)
        m.write_json(run_path, run)
        self.event('boot-manager-abort', **run['bootManagerAbort'])
        return off

    def cleanup(self, status, ended_by='driver', keep_lease=False):
        self.stopping.set()
        with contextlib.suppress(Finish):
            self.pump_serial()
        if self.claimed:
            upload = m.read_json(m.STATE / 'disk-upload.json', {})
            if upload.get('id') == self.id:
                (m.STATE / 'disk-upload.json').unlink(missing_ok=True)
            if self.args.payload == metal_export.PAYLOAD:
                metal_export.discard(self.id)
            m.clear_override()
            m.unstage(self.id)
            subprocess.run(self.tmux + ['kill-server'], capture_output=True)
            with contextlib.suppress(m.BmcError):
                m.sol_deactivate()
        if self.delivery:
            m.write_json(self.dir / 'delivery.json', self.delivery)
        if self.migration_phase and self.t0 is None and ended_by == 'driver':
            self.event('migration-not-powered')
        m.close_record(self.dir, status, ended_by)
        shutil.rmtree(self.stage, ignore_errors=True)
        if self.claimed and not keep_lease:
            m.release_lease(self.id)

    # claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
    def run(self, inherited=None):
        self.create_record()
        self.lease_ceiling = None
        status = m.EXIT_SHORT
        pending_readback = False
        provisional_readback = False
        pending_recovery = False
        try:
            if getattr(self.args, 'adopt', False):
                self.adopt()
            elif inherited is None:
                self.claim()
            else:
                holder = self.holder()
                if not m.handoff_lease(inherited, holder):
                    raise Finish(m.EXIT_INCOMPLETE, 'the lease could not transfer to the next boot')
                self.claimed = True
                self.claim_status('claimed')
                self.event('lease-inherited', source=inherited)
                threading.Thread(target=self.heartbeat, daemon=True).start()
            self.prepare_payload()
            if getattr(self.args, 'adopt', False):
                # The operator powered the machine on; the console is captured from here.
                self.start_console()
                self.t0 = m.now()
                self.power_seen_on = True
                m.update_lease(self.id, powerOnAt=self.t0)
                self.phase_name = 'kernel'
            else:
                self.preflight()
                self.do_stage()
                self.start_console()
                self.power_on()
            self.watch()
        except Finish as finish:
            status = finish.status
            off = self.cut_power(finish) if isinstance(finish, PowerCut) else None
            if isinstance(finish, BootManagerAbort):
                off = self.abort_manager_boot(finish)
            reason = finish.reason
            if self.power_cut is not None and status == m.EXIT_DONE:
                status, reason = m.EXIT_SHORT, 'the boot finished before the requested power cut'
            if not self.stop_hostkey_reader():
                status = m.EXIT_INCOMPLETE
            if status == m.EXIT_DONE and getattr(self, 'hostkey_error', None) is not None:
                status = m.EXIT_INCOMPLETE
            self.event('decided', status=status, reason=reason)
            self.phase(('Stopped: ' if status else 'Done: ') + reason)
            if self.t0 is not None:
                if off is None:
                    off = self.power_off(finish.hung)
                if not off:
                    status = m.EXIT_INCOMPLETE
                # A multi-suite boot scores each suite even when it stopped part way, so a stalled suite keeps
                # the cases it reported.
                several = len(suites(self.args)) > 1 and self.kernel_started is not None
                disk_source = (getattr(self.args, 'disk', None) == 'root' and self.args.payload == 'image'
                               and getattr(self, 'hostkey_error', None) is None)
                if (isinstance(finish, PowerCut) and off and status == m.EXIT_SHORT
                        and 'disk-root-confirmed' in self.seen and self.writer_acknowledged):
                    pending_readback = True
                if self.bit_flip and off and status == m.EXIT_DONE and disk_source and 'disk-root-confirmed' in self.seen:
                    self.event('suite-awaiting-disk-readback', provisional=True)
                    pending_readback = provisional_readback = True
                    status = m.EXIT_SHORT
                if (self.power_cut is None and self.args.mode == 'suite' and getattr(self.args, 'case', None) is None
                        and (status == m.EXIT_DONE or several or (disk_source and status == m.EXIT_SHORT))
                        and status not in (m.EXIT_CANCELLED, m.EXIT_STOPPED, m.EXIT_INCOMPLETE)):
                    with contextlib.suppress(Finish):
                        self.pump_serial()
                    if self.gap:
                        status = m.EXIT_INCOMPLETE
                    else:
                        try:
                            if (disk_source and 'disk-root-confirmed' in self.seen
                                    and status in (m.EXIT_DONE, m.EXIT_SHORT)
                                    and metal_disk.needs_readback(self.dir, suites(self.args))):
                                provisional_readback = status == m.EXIT_DONE
                                m.write_text(self.dir / 'suite-verdict.txt', 'FAIL: awaiting cold raw disk readback after power-off\n')
                                self.event('suite-awaiting-disk-readback', provisional=provisional_readback)
                                pending_readback = True
                                if provisional_readback:
                                    status = m.EXIT_SHORT
                            elif status == m.EXIT_DONE or several:
                                if not self.score_suite() and status == m.EXIT_DONE:
                                    status = m.EXIT_SHORT
                        except Exception as error:
                            self.event('suite-verdict-error', error=error.__class__.__name__)
                            status = m.EXIT_SHORT
                if self.args.payload == 'disk-readback' and status == m.EXIT_DONE and off and not self.gap:
                    try:
                        if self.finalize_disk_suite():
                            pending_recovery = m.read_json(self.dir / 'readback.json').get('powerCut', False)
                        else:
                            status = m.EXIT_SHORT
                    except Exception as error:
                        self.event('disk-suite-verdict-error', error=error.__class__.__name__)
                        status = m.EXIT_SHORT
                if self.migration_phase and status == m.EXIT_DONE and off and not self.gap:
                    try:
                        self.finish_migration()
                    except (ValueError, OSError, subprocess.CalledProcessError) as error:
                        self.event('migration-evidence-failed', error=str(error))
                        status = m.EXIT_SHORT
                elif self.args.payload == metal_persist.RECLAIM_PAYLOAD and status == m.EXIT_DONE and off and not self.gap:
                    try:
                        metal_migration.record_reclaimed(self.id, *self.reclaim)
                    except (OSError, ValueError) as error:
                        self.event('ext2-reclaim-evidence-failed', error=str(error))
                        status = m.EXIT_SHORT
                elif self.args.payload == metal_export.PAYLOAD and status == m.EXIT_DONE and off and not self.gap:
                    try:
                        metal_export.publish(self.dir, self.id, self.export_receipts)
                        self.event('persistent-export-published')
                    except ValueError as error:
                        self.event('persistent-export-publish-error', error=str(error))
                        status = m.EXIT_SHORT
                    except OSError as error:
                        self.event('persistent-export-publish-error', error=error.__class__.__name__)
                        status = m.EXIT_INCOMPLETE
                if self.census and status == m.EXIT_DONE:
                    if off and not self.gap:
                        try:
                            self.census.write(self.dir / 'platform-facts')
                        except (ValueError, OSError):
                            self.event('linux-evidence-write-failed')
                            status = m.EXIT_INCOMPLETE
                    else:
                        status = m.EXIT_INCOMPLETE
            if self.gap and status != m.EXIT_BUSY:
                status = m.EXIT_INCOMPLETE
                self.event('capture-incomplete', why='console gap')
        except Exception as error:
            self.stop_hostkey_reader()
            self.event('driver-error', error=f'{error.__class__.__name__}: {error}'[:300])
            if self.t0 is not None:
                self.power_off(False)
            status = m.EXIT_INCOMPLETE if self.t0 is not None else m.EXIT_CANCELLED
        # Persistent sessions are scored like default boots; console sessions and fault tests never are.
        scored = (not self.migration_phase and self.power_cut is None and getattr(self.args, 'case', None) is None
                  and (not session(self.args) or persistent(self.args)) and not xhci_fault(self.args)
                  and self.args.inject not in (FENCE_FAULT, 'panic-reboot', *WATCHDOG_FAULTS))
        if scored and (self.dir / 'definition/docs/metal/boot-path.json').is_file():
            try:
                verdict = metal_score.score(self.dir)
                m.write_json(self.dir / 'milestone-verdict.json', verdict)
                if provisional_readback and metal_score.falls_short(verdict):
                    pending_readback = False
                if status == m.EXIT_DONE and metal_score.falls_short(verdict):
                    status = m.EXIT_SHORT
            except (OSError, ValueError, KeyError) as error:
                self.event('milestone-verdict-error', error=error.__class__.__name__)
                if provisional_readback:
                    pending_readback = False
                if status == m.EXIT_DONE:
                    status = m.EXIT_SHORT
        if pending_readback and not self.gap:
            self.cleanup(status, keep_lease=True)
            try:
                readback_status = self.continue_disk_readback()
                return readback_status if provisional_readback or self.power_cut is not None else status
            except Exception as error:
                self.event('cold-readback-error', error=error.__class__.__name__)
                m.release_lease(self.id)
                return status
        if pending_recovery and status == m.EXIT_DONE and not self.gap:
            self.cleanup(status, keep_lease=True)
            try:
                return self.continue_cut_recovery()
            except Exception as error:
                self.event('cut-recovery-error', error=error.__class__.__name__)
                m.release_lease(self.id)
                return m.EXIT_SHORT
        if self.args.mode == 'persistent-install' and status == m.EXIT_DONE and not self.gap:
            self.cleanup(status, keep_lease=True)
            try:
                return self.continue_verification()
            except Exception as error:
                self.event('persistent-verification-error', error=error.__class__.__name__)
                m.release_lease(self.id)
                return m.EXIT_SHORT
        self.cleanup(status, keep_lease=bool(getattr(self.args, 'upgrade_parent', None)))
        return status

    def adopt(self):
        """Takes up the lease the image server wrote for an operator's power-on (README, "Persistent sessions")."""
        lease = m.read_lease() or {}
        if lease.get('id') != self.id or lease.get('unit') != self.unit:
            raise Finish(m.EXIT_CANCELLED, 'the adopted lease is not this boot\'s')
        self.claimed = True
        self.claim_status('claimed')
        self.event('lease-adopted')
        threading.Thread(target=self.heartbeat, daemon=True).start()

    def migration_verified(self):
        if self.migration_phase == 'cutover' and (
                not getattr(self, 'migration_slots', None)
                or (metal_persist.read_disk().get('slots', {}).get('next') or {}) != self.migration_slots['cutover']):
            return False
        receipt = m.read_json(self.dir / 'ssh-verification.json', {}) or {}
        if not receipt:
            return False
        if (receipt.get('boot') != self.id or receipt.get('powerOn') != round(self.t0, 3)
                or not all(receipt.get(key) is True for key in ('passed', 'authenticated', 'strictHostKey',
                                                                'servicesStarted', 'homeReadable'))
                or receipt.get('generation') != self.migration['userland']
                or not self.t0 < receipt.get('completedAt', 0) <= self.t0 + 600):
            raise Finish(m.EXIT_SHORT, 'migration SSH proof failed')
        metal_migration.verify_mounts(receipt.get('mounts', ''), self.migration_phase)
        return True

    def finish_migration(self):
        if not self.migration_answer:
            raise ValueError('migration phase is missing its boot-manager lease answer')
        phase = self.migration_phase
        if phase == 'migrate':
            self.migration['guest'] = self.migration_digests
        elif phase == 'readback':
            cold = metal_export.publish_sparse(self.dir, self.id, self.export_receipts)
            allowed = {ident: step for step, ident in self.migration['boots'].items()}
            paths, history = metal_migration.backup(self.migration['layout'], allowed=allowed,
                                                    active=self.id, verify_images=True)
            m.write_json(self.dir / 'ext2-proof.json', dict(copyOff=metal_migration.COPY_OFF, boots=history))
            tools = m.boot_dir(self.migration['boots']['migrate']) / 'breenfs-tools'
            digests = metal_migration.score_manifests(paths, cold, self.migration['userland'],
                                                       self.migration['guest'], tools)
            m.write_json(self.dir / 'migration-manifests.json', digests)
        metal_migration.record_phase(self.migration, phase, self.id)

    def ssh_verified(self):
        receipt = m.read_json(self.dir / 'ssh-verification.json', {}) or {}
        if receipt.get('boot') != self.id or receipt.get('powerOn') != round(self.t0, 3):
            return False
        if receipt.get('passed') is not True or any(receipt.get(field) is not True for field in
                                                  ('authenticated', 'strictHostKey', 'servicesStarted')):
            raise Finish(m.EXIT_SHORT, 'S21 SSH probe failed')
        if receipt.get('generation') != getattr(self.args, 'expected_generation', None):
            raise Finish(m.EXIT_SHORT, 'SSH answered from a different userland generation')
        if getattr(self.args, 'breenfs_upgrade', None):
            try:
                if receipt.get('homeReadable') is not True:
                    raise ValueError('the BreenFS home is unreadable')
                metal_migration.verify_mounts(receipt.get('mounts', ''), 'BreenFS upgrade')
                # The kernel seals this fence before launching a persistent init.
                lines = (self.dir / 'serial.txt').read_text().splitlines()
                if not metal_score.exact_breenfs_fence(lines, self.persistent_fence_layout):
                    raise ValueError('verification lacks the exact BreenFS system and home write fence')
            except ValueError as error:
                raise Finish(m.EXIT_SHORT, str(error)) from error
        if not self.t0 < receipt.get('completedAt', 0) <= self.t0 + 600:
            raise Finish(m.EXIT_SHORT, 'S21 SSH probe finished outside its deadline')
        return True

    def continue_verification(self):
        """Promote, probe over SSH, and restore the previous paired slot on failure (S21)."""
        slots = metal_persist.read_disk().get('slots', {})
        result = dict(install=self.id, toolsCommit=tools_commit(), recoveredReferences=self.slot_userlands,
                      candidateGeneration=(slots.get('next') or {}).get('installedBy'),
                      previousGeneration=(slots.get('current') or {}).get('installedBy'))
        last = self.id
        try:
            for action in ('commit', 'rollback'):
                boot_id = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-metal'
                while m.boot_dir(boot_id).exists():
                    time.sleep(1)
                    boot_id = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '-metal'
                args = argparse.Namespace(**(vars(self.args) | dict(
                    id=boot_id, mode='persistent', payload='persistent', suite=None, disk=None, session=False,
                    input=None, inject=None, entry='current', slot_action=action, verify=True, run=None, adopt=False,
                    upgrade_parent=self.id, expected_generation=result['candidateGeneration' if action == 'commit' else 'previousGeneration'], commit='')))
                child = Driver(args)
                child.unit = self.unit
                self.event('persistent-verification-next' if action == 'commit' else 'persistent-rollback-next',
                           verification=boot_id)
                status = child.run(inherited=last)
                last = boot_id
                key = 'verification' if action == 'commit' else 'rollback'
                result[key] = (m.read_json(child.dir / 'ssh-verification.json', {})
                               or m.read_json(child.dir / 'ssh-verification-progress.json', {}) or {})
                result[key].update(boot=boot_id, exit=status)
                if status == m.EXIT_DONE:
                    result['outcome'] = 'verified' if action == 'commit' else 'rolled-back'
                    m.write_json(self.dir / 'upgrade-result.json', result)
                    return status
                if status in (m.EXIT_CANCELLED, m.EXIT_STOPPED, m.EXIT_BUSY):
                    break
                if action == 'commit':
                    # Never swap a slot that the manager did not actually promote.
                    events = (child.dir / 'events.jsonl').read_text() if (child.dir / 'events.jsonl').exists() else ''
                    if not any(json.loads(line).get('event') == 'slots' and json.loads(line).get('action') == 'commit'
                               for line in events.splitlines()):
                        break
                    if not result['previousGeneration']:
                        break
            result['outcome'] = 'failed'
            m.write_json(self.dir / 'upgrade-result.json', result)
            return m.EXIT_SHORT
        finally:
            m.release_lease(last)


def progress_key(progress):
    progress = progress or {}
    return (progress.get('LastState'), progress.get('OemLastState') or '', progress.get('LastStateTime'))


def marker_matches(spec, line):
    """Pipe-separated literal alternatives; line matching requires the entire serial line."""
    marker, match = spec if isinstance(spec, tuple) else (spec, 'contains')
    alternatives = marker.split('|')
    if match == 'line':
        return line in alternatives
    if match != 'contains':
        raise ValueError('unsupported marker match: ' + match)
    return any(value in line for value in alternatives)


