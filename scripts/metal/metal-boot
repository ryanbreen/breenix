def session(args):
    """A boot held for the operator with no deadline: a console session, or a persistent boot without commands."""
    return bool(getattr(args, 'session', False)) or (persistent(args) and not check(args))


def persistent(args):
    return getattr(args, 'payload', None) == 'persistent'


def check(args):
    """A persistent boot that ends by itself: one that runs commands, or the install's verification."""
    return bool(getattr(args, 'run', None)) or bool(getattr(args, 'verify', False))


def attended(args):
    return bool(getattr(args, 'attended', False))


# claim-lint:ok: #1680 Python None or CLI none is a source token, not an empirical quantifier.
def input_kind(args):
    """Who types: the operator on the USB keyboard (attended), SOL, the operator at a persistent session (whose
    keyboard stages count when typed), or nobody."""
    if persistent(args):
        return 'sol' if getattr(args, 'run', None) else 'operator'
    return 'keyboard' if attended(args) else getattr(args, 'input', None)


def xhci_fault(args):
    value = getattr(args, 'inject', None)
    return {'xhci-reset-device': 'reset-device', 'xhci-short-read': 'short-read'}.get(value)


def validate_xhci_fault(args):
    if xhci_fault(args) and (args.payload != 'image' or args.mode != 'console'
                            or getattr(args, 'input', None) != 'sol'
                            or session(args) or attended(args) or getattr(args, 'disk', None)):
        raise ValueError('xHCI faults need a RAM-disk console boot with --input sol')


def suites(args):
    """The suites a suite boot runs, in order: one, or several in turn (docs/suites/README.md)."""
    return (getattr(args, 'suite', None) or '').split(',') if args.mode == 'suite' else []


def ceiling_seconds(args):
    if attended(args):
        # Delivery/start-up budget plus the entire operator wait from handoff.
        return CEILING_SECONDS['console'] + args.wait * 60
    if args.mode == 'suite':
        # Each further suite of a multi-suite boot brings its own DONE deadline.
        return CEILING_SECONDS['suite'] + MODE_DEADLINE_SECONDS['suite'] * (len(suites(args)) - 1)
    if persistent(args) and session(args):
        # A persistent session keeps the machine with no deadline until it is stopped or powered off.
        return None
    return SESSION_CEILING_SECONDS if session(args) else CEILING_SECONDS[args.mode]


