def clock_failure(serial):
    """Describe a GT 710 clock failure before downstream suite failures."""
    lines = serial.splitlines()
    for line in lines:
        if re.match(r'^GT710_CLOCK_STARTUP\s+full=false(?:\s|$)', line):
            reason = line.partition(' status=')[2] or 'unknown reason'
            if reason == 'post-option':
                return 'GT 710 clock startup kept POST (gt710.clocks=post)'
            return 'GT 710 clock startup failed: ' + reason
    for line in lines:
        if line.startswith('GT710_CLOCK_FALLBACK '):
            reason = line.partition(' reason=')[2].split(' gpc_restore=', 1)[0]
            return 'GT 710 clock startup failed: ' + (reason or line)
        if line.startswith(('GT710_CLOCK_GUARD ', 'GT710_CLOCK_CRITICAL ')):
            return 'GT 710 clock startup failed: ' + line
    return None


def session(args):
    """A boot held for the operator with no deadline: a console session, or a persistent boot without commands."""
    return bool(getattr(args, 'session', False)) or (persistent(args) and not check(args))


def persistent(args):
    return getattr(args, 'payload', None) == 'persistent'


def check(args):
    """A persistent boot that ends by itself: one that runs commands, or the install's verification."""
    return bool(getattr(args, 'run', None)) or bool(getattr(args, 'verify', False))


