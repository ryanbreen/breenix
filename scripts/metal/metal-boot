        to serial.raw, so the capture holds exactly the bytes the session printed, banner included."""
        hold = f"sh -c 'stty -echo; read go; exec {m.TOOLS / 'metal-sol'} activate'"
        environment = dict(os.environ, TERM='xterm-256color')
        if fresh:
            subprocess.run(self.tmux + ['kill-server'], capture_output=True)
            subprocess.run(self.tmux + ['new-session', '-d', '-s', 'sol', '-x', '200', '-y', '50', hold],
                           check=True, env=environment)
            subprocess.run(self.tmux + ['set-option', '-t', 'sol', 'remain-on-exit', 'on'], capture_output=True)
        else:
            subprocess.run(self.tmux + ['respawn-pane', '-k', '-t', 'sol', hold], check=True, env=environment)
        subprocess.run(self.tmux + ['pipe-pane', '-t', 'sol'], capture_output=True)
        subprocess.run(self.tmux + ['pipe-pane', '-O', '-t', 'sol', f"exec cat >> {self.dir / 'serial.raw'}"],
                       check=True)
