                       help='send the NMI and capture for 5 s before powering off a started kernel, finished or not')
        p.add_argument('--ramdisk', action='store_true', default=True, help='put the ext2 root on the boot disk as `ramdisk`')
        p.add_argument('--content-type', choices=('application/octet-stream',),
                       help='a test payload served with this type instead of its form\'s own')
        p.add_argument('--serve-as', choices=('boot.iso', 'boot.efi'),
                       help='answer the fixed URI with a redirect to this name beside it, and serve the file there')
    p = sub.add_parser('stop')
    p.add_argument('id')
    p = sub.add_parser('inputs-ready')
    p.add_argument('id')
    p = sub.add_parser('inputs-failed')
    p.add_argument('id')
    p.add_argument('why')
    sub.add_parser('status')
    args, _ = parser.parse_known_args()
    if args.command in ('launch', 'run'):
        if args.mode == 'suite':
            if not re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*', args.suite or ''):
                parser.error('suite mode needs --suite ID')
        elif args.suite:
            parser.error('--suite needs suite mode')
        if args.payload != 'image' and args.mode != 'default':
            parser.error('boot modes need an image payload')
    if args.command == 'launch':
        extra = sys.argv[2:]
        if args.id:
            index = extra.index('--id')
            del extra[index:index + 2]
        return launch(args, extra)
    if args.command == 'run':
        if not args.id or not re.fullmatch(r'\d{8}T\d{6}Z-metal', args.id):
            parser.error('run needs --id in the form YYYYMMDDTHHMMSSZ-metal')
        return Driver(args).run()
    if args.command == 'stop':
        directory = m.boot_dir(args.id)
        if not directory.is_dir() or (directory / 'ended').exists():
            print('no such running boot', file=sys.stderr)
            return 1
        (directory / 'stop-request').touch()
        return 0
    if args.command in ('inputs-ready', 'inputs-failed'):
        inputs = m.stage_dir(args.id) / 'inputs'
        inputs.mkdir(parents=True, exist_ok=True)
        if args.command == 'inputs-ready':
            (inputs / 'ready').touch()
        else:
            (inputs / 'failed').write_text(args.why[:300] + '\n')
        return 0
    return status()


if __name__ == '__main__':
    sys.exit(main())
