#!/usr/bin/env python3
"""The x86-metal image step by hand (docs/metal/README.md, "What is served").

  metal-image assemble --uefi IMG --ramdisk EXT2 OUT   boot.img from a kernel build's UEFI image and an ext2 root
  metal-image hang-efi OUT                             the metal-hang.efi test payload

Both print the result's size and sha256 (and, for assemble, each component's) as JSON.
"""
import argparse
import json
from pathlib import Path
import sys
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parent))
import metal_image  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('assemble')
    p.add_argument('--uefi', required=True)
    p.add_argument('--ramdisk', required=True)
    p.add_argument('output')
    sub.add_parser('hang-efi').add_argument('output')
    args = parser.parse_args()
    if args.command == 'hang-efi':
        Path(args.output).write_bytes(metal_image.hang_efi())
        facts = {'size': Path(args.output).stat().st_size, 'sha256': metal_image.sha256(args.output)}
    else:
        with tempfile.TemporaryDirectory() as scratch:
            files = metal_image.extract_esp(args.uefi, scratch)
            files['ramdisk'] = Path(args.ramdisk)
            facts = metal_image.assemble(args.output, files)
    print(json.dumps(facts, indent=1))
    return 0


if __name__ == '__main__':
    sys.exit(main())
