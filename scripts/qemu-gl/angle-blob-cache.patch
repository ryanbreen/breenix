--- a/ui/breenix-blob-cache.h
+++ b/ui/breenix-blob-cache.h
@@ -0,0 +1,257 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef BREENIX_BLOB_CACHE_H
+#define BREENIX_BLOB_CACHE_H
+#include <glib.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <stdint.h>
+#include <epoxy/egl.h>
+
+#define BBC_ENTRY_MAX (16 * 1024 * 1024)
+#define BBC_TOTAL_MAX (64 * 1024 * 1024)
+static GMutex bbc_mutex;
+static char *bbc_directory;
+static int bbc_lock = -1;
+
+static inline bool bbc_enter(void)
+{
+    g_mutex_lock(&bbc_mutex);
+    if (bbc_lock >= 0 && flock(bbc_lock, LOCK_EX) == 0) {
+        return true;
+    }
+    g_mutex_unlock(&bbc_mutex);
+    return false;
+}
+
+static inline void bbc_leave(void)
+{
+    flock(bbc_lock, LOCK_UN);
+    g_mutex_unlock(&bbc_mutex);
+}
+
+static inline char *bbc_path(const void *key, EGLsizeiANDROID size)
+{
+    char *hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256, key, size);
+    char *path = g_build_filename(bbc_directory, hash, NULL);
+    g_free(hash);
+    return path;
+}
+
+static EGLsizeiANDROID bbc_get(const void *key, EGLsizeiANDROID key_size,
+                                void *value, EGLsizeiANDROID value_size)
+{
+    EGLsizeiANDROID result = 0;
+    struct stat st;
+    char *path, *bytes = NULL;
+    int fd;
+    size_t length, done = 0;
+    char *digest;
+    if (!key || key_size <= 0 || key_size > 128 || value_size < 0 || !bbc_enter()) {
+        return 0;
+    }
+    path = bbc_path(key, key_size);
+    fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+    g_free(path);
+    if (fd < 0) {
+        goto out;
+    }
+    /* key || SHA256(value) as hexadecimal || opaque value. The key and
+     * digest make a wrong or corrupt record an ordinary compile miss. */
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != getuid() ||
+        st.st_size <= key_size + 64 || st.st_size > key_size + 64 + BBC_ENTRY_MAX) {
+        goto close_fd;
+    }
+    length = st.st_size;
+    bytes = g_malloc(length);
+    while (done < length) {
+        ssize_t n = read(fd, bytes + done, length - done);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            goto close_fd;
+        }
+        done += n;
+    }
+    if (memcmp(key, bytes, key_size)) {
+        goto close_fd;
+    }
+    length -= key_size + 64;
+    digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                          (guchar *)bytes + key_size + 64, length);
+    if (memcmp(digest, bytes + key_size, 64) == 0) {
+        result = length;
+        if (value && value_size >= result) {
+            memcpy(value, bytes + key_size + 64, result);
+        }
+    }
+    g_free(digest);
+close_fd:
+    close(fd);
+    g_free(bytes);
+out:
+    bbc_leave();
+    return result;
+}
+
+typedef struct BBCEntry { char *path; off_t size; time_t mtime; } BBCEntry;
+static inline gint bbc_older(gconstpointer left, gconstpointer right)
+{
+    const BBCEntry *a = *(BBCEntry * const *)left;
+    const BBCEntry *b = *(BBCEntry * const *)right;
+    return (a->mtime > b->mtime) - (a->mtime < b->mtime);
+}
+static inline void bbc_entry_free(gpointer opaque)
+{
+    BBCEntry *e = opaque;
+    g_free(e->path);
+    g_free(e);
+}
+static inline bool bbc_reserve(size_t incoming)
+{
+    GDir *dir = g_dir_open(bbc_directory, 0, NULL);
+    GPtrArray *entries = g_ptr_array_new_with_free_func(bbc_entry_free);
+    const char *name;
+    size_t total = incoming;
+    bool ok = false;
+    if (!dir) {
+        goto out;
+    }
+    while ((name = g_dir_read_name(dir))) {
+        struct stat st;
+        BBCEntry *e;
+        char *path;
+        if (g_str_has_prefix(name, ".tmp-")) {
+            path = g_build_filename(bbc_directory, name, NULL);
+            unlink(path);
+            g_free(path);
+            continue;
+        }
+        if (strlen(name) != 64 || strspn(name, "0123456789abcdef") != 64) {
+            continue;
+        }
+        path = g_build_filename(bbc_directory, name, NULL);
+        if (lstat(path, &st) || !S_ISREG(st.st_mode) || st.st_uid != getuid()) {
+            g_free(path);
+            continue;
+        }
+        e = g_new(BBCEntry, 1);
+        *e = (BBCEntry){ path, st.st_size, st.st_mtime };
+        total += st.st_size;
+        g_ptr_array_add(entries, e);
+    }
+    g_dir_close(dir);
+    g_ptr_array_sort(entries, bbc_older);
+    for (guint i = 0; total > BBC_TOTAL_MAX && i < entries->len; i++) {
+        BBCEntry *e = entries->pdata[i];
+        if (unlink(e->path) == 0) {
+            total -= e->size;
+        }
+    }
+    ok = total <= BBC_TOTAL_MAX;
+out:
+    g_ptr_array_unref(entries);
+    return ok;
+}
+
+static void bbc_set(const void *key, EGLsizeiANDROID key_size,
+                     const void *value, EGLsizeiANDROID value_size)
+{
+    char *path = NULL, *temporary = NULL, *digest = NULL, *bytes = NULL;
+    size_t length, done = 0;
+    int fd = -1;
+    if (!key || !value || key_size <= 0 || key_size > 128 || value_size <= 0 ||
+        value_size > BBC_ENTRY_MAX || !bbc_enter()) {
+        return;
+    }
+    length = key_size + 64 + value_size;
+    if (!bbc_reserve(length)) {
+        goto out;
+    }
+    path = bbc_path(key, key_size);
+    temporary = g_build_filename(bbc_directory, ".tmp-XXXXXX", NULL);
+    fd = g_mkstemp_full(temporary, O_WRONLY | O_CLOEXEC, 0600);
+    if (fd < 0) {
+        goto out;
+    }
+    bytes = g_malloc(length);
+    digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256, value, value_size);
+    memcpy(bytes, key, key_size);
+    memcpy(bytes + key_size, digest, 64);
+    memcpy(bytes + key_size + 64, value, value_size);
+    while (done < length) {
+        ssize_t n = write(fd, bytes + done, length - done);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            goto out;
+        }
+        done += n;
+    }
+    close(fd);
+    fd = -1;
+    rename(temporary, path);
+out:
+    if (fd >= 0) {
+        close(fd);
+    }
+    if (temporary) {
+        unlink(temporary);
+    }
+    g_free(path);
+    g_free(temporary);
+    g_free(digest);
+    g_free(bytes);
+    bbc_leave();
+}
+
+/* Called once, after EGL initialization and before renderer contexts exist.
+ * ANGLE's opaque program key also includes its renderer and program identity. */
+static void breenix_blob_cache_install(EGLDisplay display, const char *pin)
+{
+    char base[4096];
+    struct stat st;
+    char *identity, *hash, *lock_path;
+    PFNEGLSETBLOBCACHEFUNCSANDROIDPROC set_blob_cache_funcs;
+    if (bbc_directory || !epoxy_has_egl_extension(display, "EGL_ANDROID_blob_cache")) {
+        return;
+    }
+    /* Epoxy's extension dispatch checks the current display, but no context
+     * is current during display initialization. Resolve against EGL after
+     * checking this initialized display's extension support instead. */
+    set_blob_cache_funcs = (PFNEGLSETBLOBCACHEFUNCSANDROIDPROC)
+        eglGetProcAddress("eglSetBlobCacheFuncsANDROID");
+    if (!set_blob_cache_funcs) {
+        g_message("egl: eglSetBlobCacheFuncsANDROID unavailable; program cache disabled");
+        return;
+    }
+    if (confstr(_CS_DARWIN_USER_CACHE_DIR, base, sizeof(base)) == 0) {
+        return;
+    }
+    identity = g_strdup_printf("%s:%s:%s", pin,
+                              eglQueryString(display, EGL_VENDOR),
+                              eglQueryString(display, EGL_VERSION));
+    hash = g_compute_checksum_for_string(G_CHECKSUM_SHA256, identity, -1);
+    g_free(identity);
+    bbc_directory = g_build_filename(base, "org.breenix.qemu-gl", hash, NULL);
+    g_free(hash);
+    if (g_mkdir_with_parents(bbc_directory, 0700) ||
+        lstat(bbc_directory, &st) || !S_ISDIR(st.st_mode) ||
+        st.st_uid != getuid() || (st.st_mode & 077)) {
+        g_clear_pointer(&bbc_directory, g_free);
+        return;
+    }
+    lock_path = g_build_filename(bbc_directory, ".lock", NULL);
+    bbc_lock = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+    g_free(lock_path);
+    if (bbc_lock < 0) {
+        g_clear_pointer(&bbc_directory, g_free);
+        return;
+    }
+    set_blob_cache_funcs(display, bbc_set, bbc_get);
+}
+#endif
