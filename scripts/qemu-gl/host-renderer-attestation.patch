     virgl_renderer_context_destroy(cd.hdr.ctx_id);
+    if (breenix_attest_submitted) {
+        g_hash_table_remove(breenix_attest_submitted,
+                            GUINT_TO_POINTER(cd.hdr.ctx_id));
+    }
 }
 
