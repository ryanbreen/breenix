                                                  cc.context_init,
                                                  cc.nlen,
                                                  cc.debug_name);
+        breenix_attest("context-create", cc.hdr.ctx_id);
         return;
 #endif
     }
 
     virgl_renderer_context_create(cc.hdr.ctx_id, cc.nlen, cc.debug_name);
+    breenix_attest("context-create", cc.hdr.ctx_id);
 }
 
 static void virgl_cmd_context_destroy(VirtIOGPU *g,
@@ -601,6 +684,10 @@
