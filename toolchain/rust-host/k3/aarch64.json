    "text": "--- a/libcxx/include/__locale_dir/locale_base_api.h\n+++ b/libcxx/include/__locale_dir/locale_base_api.h\n@@ -129,3 +129,5 @@\n //       will define those directly.\n-#    if defined(_AIX) || defined(__MVS__)\n+#    if defined(__breenix__)\n+#      include <__locale_dir/locale_base_api/breenix.h>\n+#    elif defined(_AIX) || defined(__MVS__)\n #      include <__locale_dir/locale_base_api/ibm.h>\n--- /dev/null\n+++ b/libcxx/include/__locale_dir/locale_base_api/breenix.h\n@@ -0,0 +1,11 @@\n+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception\n+#ifndef _LIBCPP___LOCALE_DIR_LOCALE_BASE_API_BREENIX_H\n+#define _LIBCPP___LOCALE_DIR_LOCALE_BASE_API_BREENIX_H\n+\n+#include <locale.h>\n+\n+// C and C.UTF-8 share the dot radix and have no numeric grouping.\n+#include <__support/xlocale/__strtonum_fallback.h>\n+#define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE\n+\n+#endif // _LIBCPP___LOCALE_DIR_LOCALE_BASE_API_BREENIX_H\n"
