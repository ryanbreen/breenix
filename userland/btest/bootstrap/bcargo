#!/bin/sh
# The installed bcargo can replace this launcher when the image carries it.
# Resolve Cargo, rustc, bld, and the target from a single CURRENT snapshot.
set -eu

source=$(pwd -P)
cache="$HOME/.cache/btest"
root=/opt/breenix/rust
id=$(/bin/cat "$root/CURRENT")
case "$id" in
    ''|*[!a-zA-Z0-9_-]*) echo 'bcargo: invalid CURRENT' >&2; exit 2 ;;
esac
toolchain="$root/$id"
/bin/mkdir -p "$cache/cargo-home/registry" "$cache/tmp" "$cache/target"
flags=$(printf '%s\037' "--sysroot=$toolchain/sysroot" "-Clinker=$toolchain/bin/bld" \
    "-Clink-arg=-T$toolchain/lib/linker.ld" "-Lnative=$toolchain/lib" \
    -Clink-arg=--allow-multiple-definition -Cdefault-linker-libraries=no \
    "--remap-path-prefix=${source%/*}=/breenix-src")
exec /bin/env -i PATH=/bin HOME="$cache/cargo-home" CARGO_HOME="$cache/cargo-home" \
    TMPDIR="$cache/tmp" CARGO_BUILD_JOBS=4 CARGO_TERM_COLOR=never \
    RUSTC="$toolchain/bin/rustc" RUST_TARGET_PATH="$toolchain/targets" \
    CARGO_ENCODED_RUSTFLAGS="${flags}-Dwarnings" \
    "$toolchain/bin/cargo" -Z unstable-options -C "$source" "$@" \
    --target "$toolchain/targets/${id%%-*}-breenix.json"
