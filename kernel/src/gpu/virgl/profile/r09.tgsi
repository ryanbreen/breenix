FRAG
DCL IN[0], POSITION, LINEAR
DCL OUT[0], COLOR
DCL CONST[0..4]
DCL TEMP[0..14]
IMM[0] UINT32 {65535, 16, 0, 1}
IMM[1] UINT32 {2, 3, 4, 5}
IMM[2] UINT32 {8, 24, 31, 32}
IMM[3] UINT32 {96, 255, 0, 998277249}
IMM[4] UINT32 {65535, 65535, 16, 0}
UADD TEMP[14].x, CONST[4].zzzz, IMM[4].xxxx
SHL TEMP[14].x, TEMP[14].xxxx, IMM[4].zzzz
OR TEMP[14].x, TEMP[14].xxxx, IMM[4].yyyy
F2I TEMP[0].xy, IN[0]
AND TEMP[1].x, CONST[0].xxxx, IMM[0].xxxx
USHR TEMP[2].x, CONST[0].xxxx, IMM[0].yyyy
AND TEMP[3].x, CONST[0].yyyy, IMM[0].xxxx
USHR TEMP[4].x, CONST[0].yyyy, IMM[0].yyyy
UMUL TEMP[5].x, TEMP[1].xxxx, TEMP[3].xxxx
UMUL TEMP[6].x, TEMP[2].xxxx, TEMP[3].xxxx
UMUL TEMP[3].x, TEMP[1].xxxx, TEMP[4].xxxx
UMUL TEMP[1].x, TEMP[2].xxxx, TEMP[4].xxxx
USHR TEMP[4].x, TEMP[5].xxxx, IMM[0].yyyy
AND TEMP[2].x, IMM[0].xxxx, TEMP[6].xxxx
AND TEMP[7].x, IMM[0].xxxx, TEMP[3].xxxx
UADD TEMP[8].x, TEMP[4].xxxx, TEMP[2].xxxx
UADD TEMP[2].x, TEMP[7].xxxx, TEMP[8].xxxx
AND TEMP[8].x, IMM[0].xxxx, TEMP[5].xxxx
SHL TEMP[5].x, TEMP[2].xxxx, IMM[0].yyyy
OR TEMP[7].x, TEMP[8].xxxx, TEMP[5].xxxx
USHR TEMP[5].x, TEMP[6].xxxx, IMM[0].yyyy
USHR TEMP[6].x, TEMP[3].xxxx, IMM[0].yyyy
USHR TEMP[3].x, TEMP[2].xxxx, IMM[0].yyyy
UADD TEMP[2].x, TEMP[1].xxxx, TEMP[5].xxxx
UADD TEMP[5].x, TEMP[6].xxxx, TEMP[2].xxxx
UADD TEMP[2].x, TEMP[3].xxxx, TEMP[5].xxxx
UADD TEMP[9].x, TEMP[7].xxxx, IMM[0].zzzz
USEQ TEMP[10].x, CONST[4].xxxx, IMM[0].wwww
USNE TEMP[12].x, TEMP[10].xxxx, IMM[0].zzzz
XOR TEMP[13].x, TEMP[2].xxxx, TEMP[9].xxxx
AND TEMP[13].x, TEMP[13].xxxx, TEMP[12].xxxx
XOR TEMP[9].x, TEMP[13].xxxx, TEMP[9].xxxx
USHR TEMP[11].x, TEMP[9].xxxx, IMM[0].yyyy
AND TEMP[11].x, TEMP[11].xxxx, IMM[3].yyyy
USHR TEMP[11].y, TEMP[9].xxxx, IMM[2].xxxx
AND TEMP[11].y, TEMP[11].yyyy, IMM[3].yyyy
USHR TEMP[11].z, TEMP[9].xxxx, IMM[0].zzzz
AND TEMP[11].z, TEMP[11].zzzz, IMM[3].yyyy
USHR TEMP[11].w, TEMP[9].xxxx, IMM[2].yyyy
AND TEMP[11].w, TEMP[11].wwww, IMM[3].yyyy
U2F TEMP[11], TEMP[11]
MUL OUT[0], TEMP[11], IMM[3].wwww
END
