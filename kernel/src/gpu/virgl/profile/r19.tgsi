FRAG
DCL IN[0], POSITION, LINEAR
DCL OUT[0], COLOR
DCL CONST[0..4]
DCL TEMP[0..6]
IMM[0] UINT32 {0, 1, 2, 3}
IMM[1] UINT32 {4, 5, 8, 16}
IMM[2] UINT32 {24, 31, 32, 96}
IMM[3] UINT32 {255, 0, 998277249, 0}
IMM[4] UINT32 {65535, 65535, 16, 0}
UADD TEMP[6].x, CONST[4].zzzz, IMM[4].xxxx
SHL TEMP[6].x, TEMP[6].xxxx, IMM[4].zzzz
OR TEMP[6].x, TEMP[6].xxxx, IMM[4].yyyy
F2I TEMP[0].xy, IN[0]
UADD TEMP[1].x, TEMP[0].yyyy, IMM[0].xxxx
USHR TEMP[3].x, TEMP[1].xxxx, IMM[1].wwww
AND TEMP[3].x, TEMP[3].xxxx, IMM[3].xxxx
USHR TEMP[3].y, TEMP[1].xxxx, IMM[1].zzzz
AND TEMP[3].y, TEMP[3].yyyy, IMM[3].xxxx
USHR TEMP[3].z, TEMP[1].xxxx, IMM[0].xxxx
AND TEMP[3].z, TEMP[3].zzzz, IMM[3].xxxx
USHR TEMP[3].w, TEMP[1].xxxx, IMM[2].xxxx
AND TEMP[3].w, TEMP[3].wwww, IMM[3].xxxx
U2F TEMP[3], TEMP[3]
MUL OUT[0], TEMP[3], IMM[3].zzzz
END
