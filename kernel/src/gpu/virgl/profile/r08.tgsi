FRAG
DCL IN[0], POSITION, LINEAR
DCL OUT[0], COLOR
DCL CONST[0..4]
DCL TEMP[0..9]
IMM[0] UINT32 {128, 8, 0, 1}
IMM[1] UINT32 {2, 3, 4, 5}
IMM[2] UINT32 {16, 24, 31, 32}
IMM[3] UINT32 {96, 255, 0, 998277249}
IMM[4] UINT32 {65535, 65535, 16, 0}
UADD TEMP[9].x, CONST[4].zzzz, IMM[4].xxxx
SHL TEMP[9].x, TEMP[9].xxxx, IMM[4].zzzz
OR TEMP[9].x, TEMP[9].xxxx, IMM[4].yyyy
F2I TEMP[0].xy, IN[0]
UADD TEMP[1].x, CONST[0].xxxx, IMM[0].xxxx
USHR TEMP[2].x, TEMP[1].xxxx, IMM[0].yyyy
UADD TEMP[3].x, TEMP[1].xxxx, TEMP[2].xxxx
USHR TEMP[2].x, TEMP[3].xxxx, IMM[0].yyyy
UADD TEMP[4].x, TEMP[2].xxxx, IMM[0].zzzz
USHR TEMP[6].x, TEMP[4].xxxx, IMM[2].xxxx
AND TEMP[6].x, TEMP[6].xxxx, IMM[3].yyyy
USHR TEMP[6].y, TEMP[4].xxxx, IMM[0].yyyy
AND TEMP[6].y, TEMP[6].yyyy, IMM[3].yyyy
USHR TEMP[6].z, TEMP[4].xxxx, IMM[0].zzzz
AND TEMP[6].z, TEMP[6].zzzz, IMM[3].yyyy
USHR TEMP[6].w, TEMP[4].xxxx, IMM[2].yyyy
AND TEMP[6].w, TEMP[6].wwww, IMM[3].yyyy
U2F TEMP[6], TEMP[6]
MUL OUT[0], TEMP[6], IMM[3].wwww
END
