{
  "title": "Path to Breenix on bare-metal x86-64",
  "outcome": "A production kernel reaches a console shell on a RAM-disk root, passes the networking suite, and supports SATA/AHCI storage and the Breenix filesystem on physical x86-64 hardware.",
  "efforts": [
    {
      "id": "metal-bring-up",
      "title": "Bare-metal bring-up",
      "outcome": "The production kernel, delivered over the network, boots to idle with its log on the remote console, interrupts and timers working, and every CPU online.",
      "targets": [
        "x86-metal"
      ],
      "milestones": [
