  "later": [
    {
      "id": "metal-link-aggregation",
      "after": "metal-network",
      "scheduled": false,
      "outcome": "Both ports cabled and bonded as one virtual link using IEEE 802.1AX/LACP from the published standard; the BCM5720 driver stays per-function so a second port attaches without redesign."
