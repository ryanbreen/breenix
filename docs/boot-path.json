    "tests": {
      "title": "Tests",
      "summary": "The testing kernel boots and its test loader runs every test binary; this is the milestone gate."
    },
    "probe": {
      "title": "Probe",
      "summary": "The production kernel runs /sbin/probe as PID 1, which checks each subsystem in boot order and prints one PROBE line per check."
    },
    "shell": {
      "title": "Shell",
      "summary": "The production kernel runs /sbin/init shell: an interactive bsh prompt on the serial console."
    },
    "desktop": {
      "title": "Desktop",
      "summary": "The production kernel runs /sbin/init desktop: the Breenix window manager (bwm) and a terminal in the VM window."
    },
    "program": {
      "title": "Program",
      "summary": "The production kernel runs /sbin/probe --run <path> as PID 1, which runs that one program, relays its output and shows a pass or fail verdict on screen."
    },
    "suite": {
      "title": "Suite",
      "summary": "The production kernel runs an effort suite, /sbin/suite-<id>, as PID 1: it runs every case in docs/suites/<id>.json, prints one SUITE line per case and leaves a scored panel on screen."
    }
