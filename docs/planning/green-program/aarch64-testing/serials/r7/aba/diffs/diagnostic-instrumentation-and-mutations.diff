diff --git a/kernel/src/drivers/virtio/block_mmio.rs b/kernel/src/drivers/virtio/block_mmio.rs
index e2944692..5834d22f 100644
--- a/kernel/src/drivers/virtio/block_mmio.rs
+++ b/kernel/src/drivers/virtio/block_mmio.rs
@@ -152,11 +152,41 @@ struct BlockWedgeOracleSleepContext;
 #[cfg(feature = "boot_tests")]
 impl BlockWedgeOracleSleepContext {
     fn enter() -> Option<Self> {
+        use crate::arch_impl::aarch64::context_switch::{raw_uart_dec, raw_uart_str};
         if crate::per_cpu_aarch64::preempt_count() != 0 {
+            raw_uart_str("[RCA786_WEDGE] entry_preempt_nonzero=");
+            raw_uart_dec(crate::per_cpu_aarch64::preempt_count() as u64);
+            raw_uart_str("\n");
             return None;
         }
         crate::per_cpu_aarch64::preempt_disable();
         if !block_mmio_request_gate_can_sleep() {
+            raw_uart_str("[RCA786_WEDGE] refused irq_on=");
+            raw_uart_dec(crate::arch_interrupts_enabled() as u64);
+            raw_uart_str(" in_irq=");
+            raw_uart_dec(crate::per_cpu_aarch64::in_interrupt() as u64);
+            raw_uart_str(" in_sirq=");
+            raw_uart_dec(crate::per_cpu_aarch64::in_softirq() as u64);
+            raw_uart_str(" pc=");
+            raw_uart_dec(crate::per_cpu_aarch64::preempt_count() as u64);
+            raw_uart_str(" timer=");
+            raw_uart_dec(crate::arch_impl::aarch64::timer_interrupt::is_initialized() as u64);
+            raw_uart_str(" idle_ans=");
+            raw_uart_dec(match crate::task::scheduler::is_current_idle_thread() {
+                None => 2,
+                Some(true) => 1,
+                Some(false) => 0,
+            });
+            raw_uart_str(" cpu=");
+            raw_uart_dec(crate::arch_impl::aarch64::percpu::Aarch64PerCpu::cpu_id());
+            raw_uart_str(" unknown_identity_refusals=");
+            raw_uart_dec(
+                crate::task::idle_sleep::RCA786_UNKNOWN_IDENTITY_REFUSALS
+                    .load(core::sync::atomic::Ordering::Relaxed),
+            );
+            raw_uart_str(" idle_refused=");
+            raw_uart_dec(crate::task::idle_sleep::idle_sleep_refused());
+            raw_uart_str("\n");
             crate::per_cpu_aarch64::preempt_enable();
             return None;
         }
diff --git a/kernel/src/main_aarch64.rs b/kernel/src/main_aarch64.rs
index 29e0a577..881e52ce 100644
--- a/kernel/src/main_aarch64.rs
+++ b/kernel/src/main_aarch64.rs
@@ -291,6 +291,25 @@ fn launch_init_from_elf(
     // If we enabled interrupts HERE (before ERET), the pending timer would
     // fire in EL1 context, the scheduler would context-switch the boot thread
     // away (thinking it's the init process), and it would never reach ERET.
+    // RCA786-MUT-A (diagnostic, not for commit): reconcile the two per-CPU
+    // TTBR0 shadows with the architectural write above, exactly as
+    // restore_ttbr0_after_failed_exec and quiesce_ttbr0_for_exit already do.
+    unsafe {
+        kernel::arch_impl::aarch64::percpu::Aarch64PerCpu::set_next_cr3(0);
+        kernel::arch_impl::aarch64::percpu::Aarch64PerCpu::set_saved_process_cr3(ttbr0_value);
+    }
+    {
+        use kernel::arch_impl::aarch64::context_switch::{raw_uart_dec, raw_uart_hex, raw_uart_str};
+        raw_uart_str("[RCA786_PRE_ERET] cpu=");
+        raw_uart_dec(kernel::arch_impl::aarch64::percpu::Aarch64PerCpu::cpu_id());
+        raw_uart_str(" next_cr3=");
+        raw_uart_hex(kernel::arch_impl::aarch64::percpu::Aarch64PerCpu::next_cr3());
+        raw_uart_str(" saved_proc_cr3=");
+        raw_uart_hex(kernel::arch_impl::aarch64::percpu::Aarch64PerCpu::saved_process_cr3());
+        raw_uart_str(" ttbr0=");
+        raw_uart_hex(ttbr0_value);
+        raw_uart_str("\n");
+    }
     unsafe {
         return_to_userspace(entry_point, user_sp);
     }
