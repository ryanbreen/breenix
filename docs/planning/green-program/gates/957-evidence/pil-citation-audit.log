scripts/lib/python-with-pil.sh:1:#!/usr/bin/env bash
scripts/lib/python-with-pil.sh:2:# Source this file to select a Python interpreter that can load Pillow.
scripts/lib/python-with-pil.sh:3:# BREENIX_PYTHON is a preferred executable (not a command with arguments).
scripts/lib/python-with-pil.sh:4:breenix_resolve_python_with_pil() {
scripts/lib/python-with-pil.sh:5:    local candidate resolved
scripts/lib/python-with-pil.sh:6:    for candidate in "${BREENIX_PYTHON:-}" python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
scripts/lib/python-with-pil.sh:7:        [ -n "$candidate" ] || continue
scripts/lib/python-with-pil.sh:8:        resolved="$(command -v "$candidate" 2>/dev/null)" || continue
scripts/lib/python-with-pil.sh:9:        if "$resolved" -c 'from PIL import Image, ImageChops, ImageDraw' >/dev/null 2>&1; then
scripts/lib/python-with-pil.sh:10:            export BREENIX_PYTHON="$resolved"
scripts/lib/python-with-pil.sh:11:            return 0
scripts/lib/python-with-pil.sh:12:        fi
scripts/lib/python-with-pil.sh:13:    done
scripts/lib/python-with-pil.sh:14:    echo "ERROR: no Python with Pillow found; install Pillow or set BREENIX_PYTHON to an interpreter with Pillow" >&2
scripts/lib/python-with-pil.sh:15:    return 1
scripts/lib/python-with-pil.sh:16:}
