docker/qemu/run-x86-boot-tests.sh:129: # sets this to a per-clone directory instead.
docker/qemu/run-x86-boot-tests.sh:130: # claim-lint:ok: #797, diff-empty against origin/main -- see
docker/qemu/run-x86-boot-tests.sh:131: # docs/planning/green-program/gates/GATE-TMP-BASEDIR-2026-09-05.md
docker/qemu/run-x86-boot-tests.sh:132: BREENIX_GATE_TMP="${BREENIX_GATE_TMP:-/tmp}"
docker/qemu/run-x86-boot-tests.sh:133: # Must be absolute: OUTPUT_DIR (below, post-cd) is built from this value
