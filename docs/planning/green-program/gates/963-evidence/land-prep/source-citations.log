docker/qemu/run-x86-boot-tests.sh:99: # reports what ended up on the wire. See that file's own header and
docker/qemu/run-x86-boot-tests.sh:100: # docs/planning/green-program/failure-capture/PLAN-2026-09-05.md section 6.
docker/qemu/run-x86-boot-tests.sh:101: # shellcheck source=lib/gate-capture-drain.sh
