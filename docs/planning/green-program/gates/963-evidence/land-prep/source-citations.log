docker/qemu/run-x86-boot-tests.sh:1: #!/bin/bash
docker/qemu/run-x86-boot-tests.sh:2: # Build and execute the x86_64 frame/page-table custody injection gates.
docker/qemu/run-x86-boot-tests.sh:3: # This script deliberately does not treat [BOOT_TESTS:PASS] as test evidence:
docker/qemu/run-x86-boot-tests.sh:4: # advance_stage_marker_only
docker/qemu/run-x86-boot-tests.sh:5: # emits it unconditionally alongside [TESTS_COMPLETE:0/0]. The removed
docker/qemu/run-x86-boot-tests.sh:6: # KERNEL_POST_TESTS_COMPLETE marker is likewise never used as a gate.
docker/qemu/run-x86-boot-tests.sh:7: # The 900-second poll bound allows the x86 boot-test registry to run after the
docker/qemu/run-x86-boot-tests.sh:8: # userspace programs; a shorter bound scores a slow-but-healthy boot as failed.
docker/qemu/run-x86-boot-tests.sh:9: # http_test's live external fetches are bounded in-process by a receive
docker/qemu/run-x86-boot-tests.sh:10: # deadline. A connect-phase failure prints an explicit SKIP marker and the boot
docker/qemu/run-x86-boot-tests.sh:11: # continues; a mid-stream stall is an honest FAIL that appears in the tally as
docker/qemu/run-x86-boot-tests.sh:12: # a nonzero http_test exit. A quiet boot with no marker remains a gate failure.
docker/qemu/run-x86-boot-tests.sh:13: # This gate never retries a hung run: a blanket retry could swallow exactly the
docker/qemu/run-x86-boot-tests.sh:14: # recv-wake regression this gate exists to catch.
docker/qemu/run-x86-boot-tests.sh:15: #
docker/qemu/run-x86-boot-tests.sh:16: # Before building the kernel, this gate runs each tests/*_structure.rs suite
docker/qemu/run-x86-boot-tests.sh:17: # (docker/qemu/lib/gate-structure-preflight.sh) and fails if any is red.
docker/qemu/run-x86-boot-tests.sh:18: # BREENIX_GATE_SKIP_STRUCTURE=1 skips that step loudly.
docker/qemu/run-x86-boot-tests.sh:19:
docker/qemu/run-x86-boot-tests.sh:20: set -euo pipefail
docker/qemu/run-x86-boot-tests.sh:21: # errtrace: without this, the ERR trap below is not inherited into shell
docker/qemu/run-x86-boot-tests.sh:22: # functions, and report_gate_failure is itself invoked from that trap.
docker/qemu/run-x86-boot-tests.sh:23: set -E
docker/qemu/run-x86-boot-tests.sh:24:
docker/qemu/run-x86-boot-tests.sh:25: # Every assertion below this point (the explicit passed-flag check and the ~40
docker/qemu/run-x86-boot-tests.sh:26: # bare `test ... -eq N` marker-count assertions) is deliberately a
docker/qemu/run-x86-boot-tests.sh:27: # set -e abort point: on a genuine boot regression, the assertion SHOULD
docker/qemu/run-x86-boot-tests.sh:28: # kill the script. What must never happen is a silent kill: `set -e`
docker/qemu/run-x86-boot-tests.sh:29: # does not print anything on its own, so without this trap the script
docker/qemu/run-x86-boot-tests.sh:30: # dies with no verdict/FAIL text and no serial pointer, and the only way
docker/qemu/run-x86-boot-tests.sh:31: # to learn why is to dig through the raw serial by hand. This trap is the
docker/qemu/run-x86-boot-tests.sh:32: # fix: it fires on every uncaught nonzero exit under set -e (bash routes
docker/qemu/run-x86-boot-tests.sh:33: # them through ERR the same way set -e decides to abort), prints an
docker/qemu/run-x86-boot-tests.sh:34: # explicit FAIL line naming the failing command and line, tails the
docker/qemu/run-x86-boot-tests.sh:35: # current run's serial output for diagnosis, and then exits nonzero
docker/qemu/run-x86-boot-tests.sh:36: # deliberately so the caller still sees a real failure.
docker/qemu/run-x86-boot-tests.sh:37: report_gate_failure() {
docker/qemu/run-x86-boot-tests.sh:38:     local exit_code=$?
docker/qemu/run-x86-boot-tests.sh:39:     local line_no="$1"
docker/qemu/run-x86-boot-tests.sh:40:     local failing_cmd="$2"
docker/qemu/run-x86-boot-tests.sh:41:     # #717: many assertions below are shaped `test "$(cmd | awk ...)" -eq N`
docker/qemu/run-x86-boot-tests.sh:42:     # (or `VAR=$(cmd | awk ...)` feeding one). That command substitution
docker/qemu/run-x86-boot-tests.sh:43:     # runs in its own subshell; under `set -o pipefail`, a zero-match `grep`
docker/qemu/run-x86-boot-tests.sh:44:     # earlier in such a pipeline fails the whole pipeline even though the
docker/qemu/run-x86-boot-tests.sh:45:     # final command (commonly `awk`) is fine, so this ERR trap fires INSIDE
docker/qemu/run-x86-boot-tests.sh:46:     # that subshell first, misattributing the failure to the pipeline's
docker/qemu/run-x86-boot-tests.sh:47:     # last command. `exit` there only ends the subshell, not the script --
docker/qemu/run-x86-boot-tests.sh:48:     # the parent's `test`/assignment then receives this handler's own
docker/qemu/run-x86-boot-tests.sh:49:     # printed text (or nothing) as its "value" instead of a real count,
docker/qemu/run-x86-boot-tests.sh:50:     # which always fails that parent statement's own check too, re-firing
docker/qemu/run-x86-boot-tests.sh:51:     # this trap a SECOND time at the top level with a different, but this
docker/qemu/run-x86-boot-tests.sh:52:     # time correctly-attributed, $LINENO/failing-command pair. A plain
docker/qemu/run-x86-boot-tests.sh:53:     # shell-variable guard can't dedupe this: the subshell's variable
docker/qemu/run-x86-boot-tests.sh:54:     # changes never propagate back to the parent. `$BASH_SUBSHELL` does
docker/qemu/run-x86-boot-tests.sh:55:     # survive that boundary as a readable fact (it counts subshell nesting
docker/qemu/run-x86-boot-tests.sh:56:     # depth), so use it: stay silent when running inside a subshell -- the
docker/qemu/run-x86-boot-tests.sh:57:     # top-level re-fire this always triggers is the one worth reporting --
docker/qemu/run-x86-boot-tests.sh:58:     # and print (and exit the whole script) only from depth 0.
docker/qemu/run-x86-boot-tests.sh:59:     if [ "$BASH_SUBSHELL" -gt 0 ]; then
docker/qemu/run-x86-boot-tests.sh:60:         exit "$exit_code"
docker/qemu/run-x86-boot-tests.sh:61:     fi
docker/qemu/run-x86-boot-tests.sh:62:     echo "x86 frame-custody gate${i:+ run $i}: FAIL (set -e abort at ${BASH_SOURCE[0]}:${line_no}, exit ${exit_code})"
docker/qemu/run-x86-boot-tests.sh:63:     echo "  failing command: ${failing_cmd}"
docker/qemu/run-x86-boot-tests.sh:64:     # failure-trace-capture PR-5: set once, right before this boot's own
docker/qemu/run-x86-boot-tests.sh:65:     # kill line (see the drain call above it), so it is already on the
docker/qemu/run-x86-boot-tests.sh:66:     # record if a later assertion aborts the script through this trap --
docker/qemu/run-x86-boot-tests.sh:67:     # empty on an abort before that point (a build failure, say), where
docker/qemu/run-x86-boot-tests.sh:68:     # there is no boot to report capture evidence about.
docker/qemu/run-x86-boot-tests.sh:69:     if [ -n "${CAPTURE_LINES:-}" ]; then
docker/qemu/run-x86-boot-tests.sh:70:         printf '%s\n' "$CAPTURE_LINES"
docker/qemu/run-x86-boot-tests.sh:71:     fi
docker/qemu/run-x86-boot-tests.sh:72:     if [ -n "${OUTPUT_DIR:-}" ] && compgen -G "$OUTPUT_DIR/serial_*.txt" >/dev/null 2>&1; then
docker/qemu/run-x86-boot-tests.sh:73:         echo "--- serial tail (last 200 lines per file, $OUTPUT_DIR) ---"
docker/qemu/run-x86-boot-tests.sh:74:         tail -n 200 "$OUTPUT_DIR"/serial_*.txt
docker/qemu/run-x86-boot-tests.sh:75:         # failure-trace-capture PR-5: preserve the serial pair and the
docker/qemu/run-x86-boot-tests.sh:76:         # capture-drain reading beside it in a durable evidence dir, the
docker/qemu/run-x86-boot-tests.sh:77:         # same shape run-aarch64-boot-test-strict.sh's report_failure keeps
docker/qemu/run-x86-boot-tests.sh:78:         # (this script previously only tailed to console and preserved no
docker/qemu/run-x86-boot-tests.sh:79:         # evidence dir).
docker/qemu/run-x86-boot-tests.sh:80:         local failure_dir
docker/qemu/run-x86-boot-tests.sh:81:         failure_dir="${BREENIX_GATE_TMP:-/tmp}/breenix_x86_boot_tests_failures/$(date -u +%Y%m%dT%H%M%SZ)_$$"
docker/qemu/run-x86-boot-tests.sh:82:         mkdir -p "$failure_dir" 2>/dev/null || true
docker/qemu/run-x86-boot-tests.sh:83:         cp "$OUTPUT_DIR"/serial_*.txt "$failure_dir/" 2>/dev/null || true
docker/qemu/run-x86-boot-tests.sh:84:         printf '%s\n' "${CAPTURE_LINES:-}" >"$failure_dir/capture_drain.txt" 2>/dev/null || true
docker/qemu/run-x86-boot-tests.sh:85:         echo "  preserved failing serial + capture reading: $failure_dir"
docker/qemu/run-x86-boot-tests.sh:86:     fi
docker/qemu/run-x86-boot-tests.sh:87:     breenix_runs_import_nonfatal "${OUTPUT_DIR:-}" x86_64 boot-tests FAIL "$exit_code" "${HOST_MS_START:-}" "${BREENIX_RUNS_GATE_ARGV[@]}" || :
docker/qemu/run-x86-boot-tests.sh:88:     exit "$exit_code"
docker/qemu/run-x86-boot-tests.sh:89: }
docker/qemu/run-x86-boot-tests.sh:90: trap 'report_gate_failure "$LINENO" "$BASH_COMMAND"' ERR
