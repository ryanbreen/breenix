docker/qemu/lib/gate-qmp-backstop.sh:83:     # timeout treats 0 as unbounded; refuse it (and malformed budgets).
docker/qemu/lib/gate-qmp-backstop.sh:84:     if ! [[ "$budget_s" =~ ^[1-9][0-9]*$ ]]; then
docker/qemu/lib/gate-qmp-backstop.sh:85:         printf '[QMP_DUMP:capture=partial:reason=invalid_budget:core=-:decoded_events=-:dump_ms=0]\n'
docker/qemu/lib/gate-qmp-backstop.sh:86:         return
docker/qemu/lib/gate-qmp-backstop.sh:87:     fi
docker/qemu/lib/gate-qmp-backstop.sh:88:     if [ ! -S "$sock" ]; then
docker/qemu/lib/gate-qmp-backstop.sh:89:         end_ms="$(gqb_now_ms)"
docker/qemu/lib/gate-qmp-backstop.sh:90:         printf '[QMP_DUMP:capture=partial:reason=qmp_socket_missing:core=-:decoded_events=-:dump_ms=%s]\n' "$((end_ms - start_ms))"
docker/qemu/lib/gate-qmp-backstop.sh:91:         return
docker/qemu/lib/gate-qmp-backstop.sh:92:     fi
docker/qemu/lib/gate-qmp-backstop.sh:93:     if ! command -v socat >/dev/null 2>&1; then
