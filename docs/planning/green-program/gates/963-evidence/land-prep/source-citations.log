docker/qemu/lib/gate-qmp-backstop.sh:63:     dir="$(dirname -- "$sock")"
docker/qemu/lib/gate-qmp-backstop.sh:64:     case "$dir" in
docker/qemu/lib/gate-qmp-backstop.sh:65:         /tmp/bxqmp.*) rm -rf -- "$dir" ;;
docker/qemu/lib/gate-qmp-backstop.sh:66:     esac
docker/qemu/lib/gate-qmp-backstop.sh:67: }
