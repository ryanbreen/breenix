docker/qemu/run-x86-boot-tests.sh:149: # ERR trap is already installed above, and no kernel build or QEMU state
docker/qemu/run-x86-boot-tests.sh:150: # exists yet). BREENIX_GATE_SKIP_STRUCTURE=1 skips this loudly; see
docker/qemu/run-x86-boot-tests.sh:151: # docker/qemu/lib/gate-structure-preflight.sh for both the rustc-vs-cargo
docker/qemu/run-x86-boot-tests.sh:152: # reasoning and what each printed field means. `false`, not `exit 1`, is the
docker/qemu/run-x86-boot-tests.sh:153: # same #802/#805 idiom the BREENIX_GATE_TMP check above uses: the ERR trap
