scripts/forensic-capture.sh:121: # ─── QMP helper ──────────────────────────────────────────────────────────────
scripts/forensic-capture.sh:122:
scripts/forensic-capture.sh:123: # Send a QMP command and capture the response.
scripts/forensic-capture.sh:124: # QMP requires: 1) Read greeting, 2) Send qmp_capabilities, 3) Send command
scripts/forensic-capture.sh:125: qmp_command() {
scripts/forensic-capture.sh:126:     local cmd="$1"
scripts/forensic-capture.sh:127:     local output_file="${2:-/dev/null}"
scripts/forensic-capture.sh:128:
scripts/forensic-capture.sh:129:     # Full QMP session: greeting → capabilities → command
scripts/forensic-capture.sh:130:     {
scripts/forensic-capture.sh:131:         # Wait for greeting, then negotiate capabilities, then send command
scripts/forensic-capture.sh:132:         sleep 0.2
scripts/forensic-capture.sh:133:         echo '{"execute": "qmp_capabilities"}'
scripts/forensic-capture.sh:134:         sleep 0.2
scripts/forensic-capture.sh:135:         echo "$cmd"
scripts/forensic-capture.sh:136:         sleep 0.5
scripts/forensic-capture.sh:137:     } | socat - UNIX-CONNECT:"$QMP_SOCK" 2>/dev/null | tail -1 > "$output_file"
scripts/forensic-capture.sh:138: }
scripts/forensic-capture.sh:139:
scripts/forensic-capture.sh:140: # Send multiple QMP commands in one session
scripts/forensic-capture.sh:141: qmp_session() {
scripts/forensic-capture.sh:142:     local cmds=("$@")
scripts/forensic-capture.sh:143:     {
scripts/forensic-capture.sh:144:         sleep 0.2
scripts/forensic-capture.sh:145:         echo '{"execute": "qmp_capabilities"}'
scripts/forensic-capture.sh:146:         sleep 0.2
scripts/forensic-capture.sh:147:         for cmd in "${cmds[@]}"; do
scripts/forensic-capture.sh:148:             echo "$cmd"
scripts/forensic-capture.sh:149:             sleep 0.3
scripts/forensic-capture.sh:150:         done
scripts/forensic-capture.sh:151:         sleep 0.5
scripts/forensic-capture.sh:152:     } | socat - UNIX-CONNECT:"$QMP_SOCK" 2>/dev/null
scripts/forensic-capture.sh:153: }
