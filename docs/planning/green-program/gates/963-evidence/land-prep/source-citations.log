scripts/forensic-capture.sh:184:         if [ "$local_size" = "$new_size" ]; then
scripts/forensic-capture.sh:185:             break
scripts/forensic-capture.sh:186:         fi
scripts/forensic-capture.sh:187:     fi
scripts/forensic-capture.sh:188:     sleep 1
scripts/forensic-capture.sh:189: done
scripts/forensic-capture.sh:190:
