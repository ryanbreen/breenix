docker/qemu/lib/gate-qmp-backstop.sh:95:         printf '[QMP_DUMP:capture=partial:reason=qmp_tool_missing:core=-:decoded_events=-:dump_ms=%s]\n' "$((end_ms - start_ms))"
docker/qemu/lib/gate-qmp-backstop.sh:96:         return
docker/qemu/lib/gate-qmp-backstop.sh:97:     fi
docker/qemu/lib/gate-qmp-backstop.sh:98:     # A repeated call must not classify a previous dump as this attempt's.
docker/qemu/lib/gate-qmp-backstop.sh:99:     rm -f "$core"
docker/qemu/lib/gate-qmp-backstop.sh:100:     timeout --kill-after=1 "$budget_s" bash "$fc_sh" --qmp "$sock" --output-dir "$output_dir" \
docker/qemu/lib/gate-qmp-backstop.sh:101:         >"$output_dir/qmp-backstop.log" 2>&1 || true
docker/qemu/lib/gate-qmp-backstop.sh:102:     end_ms="$(gqb_now_ms)"
docker/qemu/lib/gate-qmp-backstop.sh:103:     dump_ms=$((end_ms - start_ms))
docker/qemu/lib/gate-qmp-backstop.sh:104:     if [ -s "$core" ]; then
docker/qemu/lib/gate-qmp-backstop.sh:105:         local decode_out decoded
docker/qemu/lib/gate-qmp-backstop.sh:106:         decode_out="$(timeout --kill-after=1 "$budget_s" python3 "$decode_py" --parse "$core" --kernel "$kernel_elf" --validate 2>&1)" || true
docker/qemu/lib/gate-qmp-backstop.sh:107:         printf '%s\n' "$decode_out" > "$output_dir/qmp-decode.log"
docker/qemu/lib/gate-qmp-backstop.sh:108:         decoded="$(printf '%s\n' "$decode_out" | grep -oE 'TRACE_DECODED_EVENTS:[0-9]+' | head -1 | cut -d: -f2)" || true
docker/qemu/lib/gate-qmp-backstop.sh:109:         printf '[QMP_DUMP:capture=complete:reason=-:core=%s:decoded_events=%s:dump_ms=%s]\n' \
docker/qemu/lib/gate-qmp-backstop.sh:110:             "$core" "${decoded:--}" "$dump_ms"
docker/qemu/lib/gate-qmp-backstop.sh:111:     else
docker/qemu/lib/gate-qmp-backstop.sh:112:         printf '[QMP_DUMP:capture=partial:reason=qmp_timeout:core=-:decoded_events=-:dump_ms=%s]\n' "$dump_ms"
docker/qemu/lib/gate-qmp-backstop.sh:113:     fi
docker/qemu/lib/gate-qmp-backstop.sh:114: }

