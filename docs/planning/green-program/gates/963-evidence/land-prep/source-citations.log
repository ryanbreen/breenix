scripts/forensic-capture.sh:378:     log "  $line"
scripts/forensic-capture.sh:379: done
scripts/forensic-capture.sh:380: log ""
scripts/forensic-capture.sh:381: log "Analyze with GDB:"
scripts/forensic-capture.sh:382: if [ -n "$KERNEL_BIN" ]; then
