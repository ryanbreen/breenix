docker/qemu/run-x86-boot-tests.sh:137: #
docker/qemu/run-x86-boot-tests.sh:138: # The rejection below is `echo` + bare `false` rather than a bare `exit 1`
docker/qemu/run-x86-boot-tests.sh:139: # (#802/#805 idiom, widened to this gate): the ERR trap is already installed
docker/qemu/run-x86-boot-tests.sh:140: # above, so a `false` here fires it and the gate's own
docker/qemu/run-x86-boot-tests.sh:141: # "x86 frame-custody gate: FAIL (...)" line prints before the process ends,
docker/qemu/run-x86-boot-tests.sh:142: # instead of a silent `exit`, which the trap does not catch.
