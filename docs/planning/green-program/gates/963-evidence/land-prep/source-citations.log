scripts/forensic-capture.sh:275:
scripts/forensic-capture.sh:276: # Register state for all CPUs
scripts/forensic-capture.sh:277: echo \n=== PER-CPU REGISTERS ===\n
scripts/forensic-capture.sh:278: thread apply all info registers
scripts/forensic-capture.sh:279:
scripts/forensic-capture.sh:280: # Try to read trace counters via GDB
scripts/forensic-capture.sh:281: echo \n=== TRACE COUNTERS ===\n
scripts/forensic-capture.sh:282:
scripts/forensic-capture.sh:283: # SYSCALL_TOTAL (per-CPU counter, slot 0 value at offset 8)
scripts/forensic-capture.sh:284: echo SYSCALL_TOTAL:
scripts/forensic-capture.sh:285: print SYSCALL_TOTAL.per_cpu[0].value
scripts/forensic-capture.sh:286: print SYSCALL_TOTAL.per_cpu[1].value
scripts/forensic-capture.sh:287: print SYSCALL_TOTAL.per_cpu[2].value
scripts/forensic-capture.sh:288: print SYSCALL_TOTAL.per_cpu[3].value
scripts/forensic-capture.sh:289:
scripts/forensic-capture.sh:290: echo IRQ_TOTAL:
scripts/forensic-capture.sh:291: print IRQ_TOTAL.per_cpu[0].value
scripts/forensic-capture.sh:292: print IRQ_TOTAL.per_cpu[1].value
scripts/forensic-capture.sh:293: print IRQ_TOTAL.per_cpu[2].value
scripts/forensic-capture.sh:294: print IRQ_TOTAL.per_cpu[3].value
scripts/forensic-capture.sh:295:
scripts/forensic-capture.sh:296: echo CTX_SWITCH_TOTAL:
scripts/forensic-capture.sh:297: print CTX_SWITCH_TOTAL.per_cpu[0].value
scripts/forensic-capture.sh:298: print CTX_SWITCH_TOTAL.per_cpu[1].value
scripts/forensic-capture.sh:299: print CTX_SWITCH_TOTAL.per_cpu[2].value
scripts/forensic-capture.sh:300: print CTX_SWITCH_TOTAL.per_cpu[3].value
scripts/forensic-capture.sh:301:
scripts/forensic-capture.sh:302: echo TIMER_TICK_TOTAL:
scripts/forensic-capture.sh:303: print TIMER_TICK_TOTAL.per_cpu[0].value
scripts/forensic-capture.sh:304: print TIMER_TICK_TOTAL.per_cpu[1].value
scripts/forensic-capture.sh:305: print TIMER_TICK_TOTAL.per_cpu[2].value
scripts/forensic-capture.sh:306: print TIMER_TICK_TOTAL.per_cpu[3].value
scripts/forensic-capture.sh:307:
scripts/forensic-capture.sh:308: # Scheduler state
scripts/forensic-capture.sh:309: echo \n=== SCHEDULER STATE ===\n
scripts/forensic-capture.sh:310: echo Global tick count:
