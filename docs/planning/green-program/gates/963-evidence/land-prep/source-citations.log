scripts/forensic-capture.sh:170: log "Step 3: Dumping guest memory to ELF core..."
scripts/forensic-capture.sh:171: log "  (This produces a ~512MB file — includes per-CPU register state)"
scripts/forensic-capture.sh:172:
scripts/forensic-capture.sh:173: # dump-guest-memory produces an ELF core file with NT_PRSTATUS notes
scripts/forensic-capture.sh:174: # containing per-CPU register state. This is loadable in GDB.
