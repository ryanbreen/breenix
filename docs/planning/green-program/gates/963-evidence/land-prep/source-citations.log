scripts/forensic-capture.sh:198: # ─── Step 4: GDB backtraces ──────────────────────────────────────────────────
scripts/forensic-capture.sh:199:
scripts/forensic-capture.sh:200: log "Step 4: Capturing GDB backtraces..."
scripts/forensic-capture.sh:201:
scripts/forensic-capture.sh:202: # Detect architecture from kernel binary
scripts/forensic-capture.sh:203: KERNEL_ARCH=""
scripts/forensic-capture.sh:204: KERNEL_BIN=""
