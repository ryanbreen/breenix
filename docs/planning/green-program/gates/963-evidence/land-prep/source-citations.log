scripts/forensic-capture.sh:316: call trace_dump_counters()
scripts/forensic-capture.sh:317:
scripts/forensic-capture.sh:318: # Disconnect cleanly
scripts/forensic-capture.sh:319: disconnect
scripts/forensic-capture.sh:320: quit
scripts/forensic-capture.sh:321: GDBEOF
scripts/forensic-capture.sh:322:
scripts/forensic-capture.sh:323:     # Run GDB with timeout
scripts/forensic-capture.sh:324:     # --nx skips .gdbinit (which may load x86-specific config)
scripts/forensic-capture.sh:325:     timeout 30 "$GDB_BIN" --nx -batch -x "$GDB_CMDS" "$KERNEL_BIN" \
scripts/forensic-capture.sh:326:         > "$OUTPUT_DIR/backtraces.txt" 2>&1 || true
scripts/forensic-capture.sh:327:
scripts/forensic-capture.sh:328:     if [ -f "$OUTPUT_DIR/backtraces.txt" ] && [ -s "$OUTPUT_DIR/backtraces.txt" ]; then
scripts/forensic-capture.sh:329:         log "  Backtraces saved to backtraces.txt"
scripts/forensic-capture.sh:330:
scripts/forensic-capture.sh:331:         # Extract trace counters to separate file for easy viewing
scripts/forensic-capture.sh:332:         grep -A1 -E "(SYSCALL_TOTAL|IRQ_TOTAL|CTX_SWITCH_TOTAL|TIMER_TICK_TOTAL|FORK_TOTAL|EXEC_TOTAL)" \
scripts/forensic-capture.sh:333:             "$OUTPUT_DIR/backtraces.txt" > "$OUTPUT_DIR/trace-counters.txt" 2>/dev/null || true
scripts/forensic-capture.sh:334:         log "  Trace counters saved to trace-counters.txt"
scripts/forensic-capture.sh:335:     else
scripts/forensic-capture.sh:336:         log "  WARNING: GDB capture may have failed (check backtraces.txt)"
scripts/forensic-capture.sh:337:     fi
scripts/forensic-capture.sh:338: else
scripts/forensic-capture.sh:339:     if [ -z "$KERNEL_BIN" ]; then
scripts/forensic-capture.sh:340:         log "  Kernel binary not found for symbol loading."
scripts/forensic-capture.sh:341:     fi
scripts/forensic-capture.sh:342:     log "  NOTE: You can analyze the memory dump offline with:"
scripts/forensic-capture.sh:343:     log "    gdb -ex 'target core $MEMDUMP' $KERNEL_BIN"
scripts/forensic-capture.sh:344: fi
scripts/forensic-capture.sh:345:
scripts/forensic-capture.sh:346: # ─── Step 5: Post-capture action ─────────────────────────────────────────────
scripts/forensic-capture.sh:347:
scripts/forensic-capture.sh:348: log ""
scripts/forensic-capture.sh:349: case "$ACTION" in
scripts/forensic-capture.sh:350:     resume)
scripts/forensic-capture.sh:351:         log "Step 5: Resuming VM..."
scripts/forensic-capture.sh:352:         qmp_command '{"execute": "cont"}' /dev/null
scripts/forensic-capture.sh:353:         log "  VM resumed"
scripts/forensic-capture.sh:354:         ;;
scripts/forensic-capture.sh:355:     kill)
scripts/forensic-capture.sh:356:         log "Step 5: Killing VM..."
scripts/forensic-capture.sh:357:         qmp_command '{"execute": "quit"}' /dev/null
scripts/forensic-capture.sh:358:         log "  VM terminated"
scripts/forensic-capture.sh:359:         ;;
scripts/forensic-capture.sh:360:     pause)
scripts/forensic-capture.sh:361:         log "Step 5: VM remains paused."
scripts/forensic-capture.sh:362:         log "  To resume: echo '{\"execute\":\"cont\"}' | socat - UNIX-CONNECT:$QMP_SOCK"
scripts/forensic-capture.sh:363:         log "  To kill:   echo '{\"execute\":\"quit\"}' | socat - UNIX-CONNECT:$QMP_SOCK"
scripts/forensic-capture.sh:364:         ;;
scripts/forensic-capture.sh:365: esac
scripts/forensic-capture.sh:366:
scripts/forensic-capture.sh:367: # ─── Summary ─────────────────────────────────────────────────────────────────
scripts/forensic-capture.sh:368:
scripts/forensic-capture.sh:369: log ""
scripts/forensic-capture.sh:370: log "========================================"
scripts/forensic-capture.sh:371: log "  Forensic Capture Complete"
scripts/forensic-capture.sh:372: log "========================================"
scripts/forensic-capture.sh:373: log ""
scripts/forensic-capture.sh:374: log "Output directory: $OUTPUT_DIR"
scripts/forensic-capture.sh:375: log ""
scripts/forensic-capture.sh:376: log "Files:"
