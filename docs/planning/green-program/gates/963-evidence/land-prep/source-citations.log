docker/qemu/run-x86-boot-tests.sh:119: # scripts/run-structure-tests.sh's rustc --test path (not cargo test -- see
docker/qemu/run-x86-boot-tests.sh:120: # that file's own header for why the kernel-swap hazard does not apply to
