scripts/forensic-capture.sh:386: fi
scripts/forensic-capture.sh:387: log ""
scripts/forensic-capture.sh:388: log "Quick check of per-CPU registers in the core dump:"
scripts/forensic-capture.sh:389: log "  readelf -n $MEMDUMP | head -50"

FILE: docker/qemu/lib/gate-qmp-backstop.sh
docker/qemu/lib/gate-qmp-backstop.sh:1: #!/bin/bash
docker/qemu/lib/gate-qmp-backstop.sh:2: # failure-trace-capture PR-6: passive QMP evidence for a non-PASS boot.
docker/qemu/lib/gate-qmp-backstop.sh:3: # Call after freezing the verdict and before the gate's own first SIGTERM.
docker/qemu/lib/gate-qmp-backstop.sh:4: # One QMP_DUMP line per outcome; complete means a nonempty core exists,
docker/qemu/lib/gate-qmp-backstop.sh:5: # not that decoding or validation succeeded (consult qmp-decode.log).
docker/qemu/lib/gate-qmp-backstop.sh:6: #
docker/qemu/lib/gate-qmp-backstop.sh:7: # Paths and budget are explicit per-call arguments, rather than source-time
docker/qemu/lib/gate-qmp-backstop.sh:8: # cached globals: a caller's current timeout override must reach this call.
docker/qemu/lib/gate-qmp-backstop.sh:9: # The outer timeout bounds the entire forensic child, independently of its
docker/qemu/lib/gate-qmp-backstop.sh:10: # internal polling or wall-clock readings. A kill-after also bounds a child
docker/qemu/lib/gate-qmp-backstop.sh:11: # that ignores TERM. Decoding has its own timeout; dump_ms measures capture.
docker/qemu/lib/gate-qmp-backstop.sh:12: # PASS just prints its contract and does not access the socket.
docker/qemu/lib/gate-qmp-backstop.sh:13: # A missing socat prevents the forensic child from starting QMP at all;
docker/qemu/lib/gate-qmp-backstop.sh:14: # report that dependency failure separately from an exchange that times out.
docker/qemu/lib/gate-qmp-backstop.sh:15: # Budget and socket validation precede the tool check to retain their reasons.
docker/qemu/lib/gate-qmp-backstop.sh:16: #
docker/qemu/lib/gate-qmp-backstop.sh:17: # Same clock primitive as gcd_now_ms, duplicated rather than sourced to
docker/qemu/lib/gate-qmp-backstop.sh:18: # avoid a load-order dependency on the sibling drain library. This clock
docker/qemu/lib/gate-qmp-backstop.sh:19: # is best-effort reporting only; no termination decision trusts its value.
docker/qemu/lib/gate-qmp-backstop.sh:20: # Q-1/PR-6 fix pass: docs/planning/green-program/failure-capture/PR-6-2026-09-07.md
docker/qemu/lib/gate-qmp-backstop.sh:21: # section 5 hit this exact wall producing its own evidence and worked around
docker/qemu/lib/gate-qmp-backstop.sh:22: # it with a manual, unshipped /tmp symlink. The QMP unix-socket BIND path is
docker/qemu/lib/gate-qmp-backstop.sh:23: # bounded by struct sockaddr_un's sun_path -- 104 bytes on macOS/BSD, 108 on
docker/qemu/lib/gate-qmp-backstop.sh:24: # Linux, NUL-terminated -- a separate, much tighter ceiling than
docker/qemu/lib/gate-qmp-backstop.sh:25: # an ordinary filesystem path. The gate's own output/profile directories are
docker/qemu/lib/gate-qmp-backstop.sh:26: # correctly lane-scoped under the (long) worktree-scoped BREENIX_GATE_TMP
docker/qemu/lib/gate-qmp-backstop.sh:27: # this repo's own convention mandates, but a socket path built by appending
docker/qemu/lib/gate-qmp-backstop.sh:28: # "qmp.sock" under one of those directories routinely exceeds that ceiling
docker/qemu/lib/gate-qmp-backstop.sh:29: # on that exact convention: qemu-system-aarch64 then refuses to start
docker/qemu/lib/gate-qmp-backstop.sh:30: # ("Path must be less than 104 bytes", exit 1), not the graceful
docker/qemu/lib/gate-qmp-backstop.sh:31: # qmp_socket_missing degradation gqb_dump_and_report reports for an
docker/qemu/lib/gate-qmp-backstop.sh:32: # evidence-only miss -- empty serial output, no per-boot artifact naming the
docker/qemu/lib/gate-qmp-backstop.sh:33: # real cause. The listener therefore lives in its own short-named directory
docker/qemu/lib/gate-qmp-backstop.sh:34: # directly under the real /tmp, bypassing $TMPDIR/$BREENIX_GATE_TMP;
docker/qemu/lib/gate-qmp-backstop.sh:35: # only the ephemeral bind socket needs this -- the durable dump/decode
docker/qemu/lib/gate-qmp-backstop.sh:36: # artifacts gqb_dump_and_report writes still land wherever the caller's own
docker/qemu/lib/gate-qmp-backstop.sh:37: # (long, lane-scoped) output directory already puts them.
docker/qemu/lib/gate-qmp-backstop.sh:38: GQB_SOCK_LIMIT_BYTES=100
docker/qemu/lib/gate-qmp-backstop.sh:39:
docker/qemu/lib/gate-qmp-backstop.sh:40: gqb_alloc_socket() {
docker/qemu/lib/gate-qmp-backstop.sh:41:     local dir path
docker/qemu/lib/gate-qmp-backstop.sh:42:     dir="$(mktemp -d /tmp/bxqmp.XXXXXX)" || {
docker/qemu/lib/gate-qmp-backstop.sh:43:         echo "gqb_alloc_socket: mktemp failed" >&2
docker/qemu/lib/gate-qmp-backstop.sh:44:         return 1
docker/qemu/lib/gate-qmp-backstop.sh:45:     }
docker/qemu/lib/gate-qmp-backstop.sh:46:     chmod 700 "$dir"
docker/qemu/lib/gate-qmp-backstop.sh:47:     path="$dir/q.sock"
docker/qemu/lib/gate-qmp-backstop.sh:48:     # Defensive, not expected to trip: the mktemp template above is fixed
docker/qemu/lib/gate-qmp-backstop.sh:49:     # width, so this only fires if that template is ever widened later.
docker/qemu/lib/gate-qmp-backstop.sh:50:     if [ "${#path}" -gt "$GQB_SOCK_LIMIT_BYTES" ]; then
docker/qemu/lib/gate-qmp-backstop.sh:51:         echo "gqb_alloc_socket: generated path exceeds ${GQB_SOCK_LIMIT_BYTES} bytes: $path" >&2
docker/qemu/lib/gate-qmp-backstop.sh:52:         rm -rf -- "$dir"
docker/qemu/lib/gate-qmp-backstop.sh:53:         return 1
docker/qemu/lib/gate-qmp-backstop.sh:54:     fi
docker/qemu/lib/gate-qmp-backstop.sh:55:     printf '%s' "$path"
docker/qemu/lib/gate-qmp-backstop.sh:56: }
