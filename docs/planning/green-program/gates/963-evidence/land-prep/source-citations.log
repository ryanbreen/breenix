docker/qemu/run-x86-boot-tests.sh:103: # #826/#834/#865/R181: this gate's qemu-system-x86_64 boot(s) run behind the
docker/qemu/run-x86-boot-tests.sh:104: # host-wide lock in lib/qemu-host-lock.sh (one lock domain per QEMU binary --
docker/qemu/run-x86-boot-tests.sh:105: # see that file's own ARCHITECTURE AWARENESS comment), so at most one
docker/qemu/run-x86-boot-tests.sh:106: # qemu-system-x86_64 is active on this host for each boot's duration. #865
docker/qemu/run-x86-boot-tests.sh:107: # is this lock's own report of the failure mode on the beast x86 host:
docker/qemu/run-x86-boot-tests.sh:108: # several TCG lanes running concurrently starve each other and hit the
docker/qemu/run-x86-boot-tests.sh:109: # gate's own timing ceilings on a healthy guest.
docker/qemu/run-x86-boot-tests.sh:110: # shellcheck source=lib/qemu-host-lock.sh
docker/qemu/run-x86-boot-tests.sh:111: source "$SCRIPT_DIR/lib/qemu-host-lock.sh"
docker/qemu/run-x86-boot-tests.sh:112: # #827/#865: per-boot host-side facts (wall-clock window, host QEMU count
docker/qemu/run-x86-boot-tests.sh:113: # and load average at start/kill, QEMU's own CPU time, the guest's last
docker/qemu/run-x86-boot-tests.sh:114: # heartbeat, and which bound ended the boot) -- see that file's own header
