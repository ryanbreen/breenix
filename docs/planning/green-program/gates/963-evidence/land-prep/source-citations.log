scripts/forensic-capture.sh:2: # Breenix Forensic Capture
scripts/forensic-capture.sh:3: # ========================
scripts/forensic-capture.sh:4: # Captures diagnostic state from a running (or deadlocked) Breenix QEMU instance.
scripts/forensic-capture.sh:5: #
scripts/forensic-capture.sh:6: # This script:
scripts/forensic-capture.sh:7: #   1. Connects to the QMP socket to pause the VM
scripts/forensic-capture.sh:8: #   2. Dumps guest memory via QMP (ELF core with per-CPU registers)
scripts/forensic-capture.sh:9: #   3. Attaches GDB to capture per-CPU backtraces and trace counters
scripts/forensic-capture.sh:10: #   4. Optionally resumes or kills the VM
scripts/forensic-capture.sh:11: #
scripts/forensic-capture.sh:12: # Usage:
scripts/forensic-capture.sh:13: #   scripts/forensic-capture.sh              # Capture and pause
scripts/forensic-capture.sh:14: #   scripts/forensic-capture.sh --resume     # Capture then resume VM
scripts/forensic-capture.sh:15: #   scripts/forensic-capture.sh --kill       # Capture then kill VM
scripts/forensic-capture.sh:16: #   scripts/forensic-capture.sh --timeout 30 # Auto-capture after 30s of no output
scripts/forensic-capture.sh:17: #
scripts/forensic-capture.sh:18: # Prerequisites:
scripts/forensic-capture.sh:19: #   - QEMU running with QMP socket (run.sh enables this by default)
scripts/forensic-capture.sh:20: #   - GDB (for backtraces): aarch64-none-elf-gdb or gdb-multiarch
scripts/forensic-capture.sh:21: #   - socat (for QMP communication)
scripts/forensic-capture.sh:22: #
scripts/forensic-capture.sh:23: # Output:
scripts/forensic-capture.sh:24: #   /tmp/breenix-forensic-<timestamp>/
scripts/forensic-capture.sh:25: #     ├── guest-memory.elf    # Full memory dump (loadable in GDB)
scripts/forensic-capture.sh:26: #     ├── backtraces.txt      # Per-CPU backtraces from GDB
scripts/forensic-capture.sh:27: #     ├── trace-counters.txt  # Kernel trace counter values
scripts/forensic-capture.sh:28: #     ├── qmp-status.json     # VM status at capture time
scripts/forensic-capture.sh:29: #     └── capture.log         # Script log
scripts/forensic-capture.sh:30:
scripts/forensic-capture.sh:31: set -euo pipefail
