docker/qemu/run-x86-boot-tests.sh:122: # shellcheck source=lib/gate-structure-preflight.sh
docker/qemu/run-x86-boot-tests.sh:123: source "$SCRIPT_DIR/lib/gate-structure-preflight.sh"
docker/qemu/run-x86-boot-tests.sh:124: # #797: concurrent lanes sharing one host (e.g. the beast Incus container) each
docker/qemu/run-x86-boot-tests.sh:125: # invoking this script hardcode the identical /tmp/breenix_x86_boot_tests_$i
docker/qemu/run-x86-boot-tests.sh:126: # path, so one lane's rm -rf/mkdir can clobber another lane's in-flight run and
docker/qemu/run-x86-boot-tests.sh:127: # a poll loop can read back the wrong lane's serial as its own. Defaulting to
