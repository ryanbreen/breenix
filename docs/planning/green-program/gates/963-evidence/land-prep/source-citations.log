docker/qemu/run-x86-boot-tests.sh:526: RING_SPAN_RATIO_FLOOR=10
docker/qemu/run-x86-boot-tests.sh:527: # #766: wake-to-dispatch latency. One kthread sleeps 10 ms against an absolute
docker/qemu/run-x86-boot-tests.sh:528: # monotonic deadline while 8 CPU-bound kthreads are runnable; the oracle reports
docker/qemu/run-x86-boot-tests.sh:529: # `wake_instant - deadline`. Before the fix, `wake_expired_timers` enqueued a
docker/qemu/run-x86-boot-tests.sh:530: # thread whose deadline had already passed at the TAIL of the single x86 ready
docker/qemu/run-x86-boot-tests.sh:531: # queue, so the wake cost a full round robin -- #766 measured p90 2592 ms and
docker/qemu/run-x86-boot-tests.sh:532: # max 10318 ms over 324 trials, and #631's `clock_gettime_test` Test 3 red is
docker/qemu/run-x86-boot-tests.sh:533: # that same quantity seen from userspace. The fix enqueues at the head, which
docker/qemu/run-x86-boot-tests.sh:534: # bounds the wait by the running thread's remaining quantum plus one tick:
docker/qemu/run-x86-boot-tests.sh:535: # 10 ticks * 5 ms + 5 ms = 55 ms on this profile. `bound_ms=100` is that plus a
docker/qemu/run-x86-boot-tests.sh:536: # TCG jitter allowance; `quantum_ms` and `round_ms` are printed so the
docker/qemu/run-x86-boot-tests.sh:537: # arithmetic can be redone from the line. The remaining fields are pinned
docker/qemu/run-x86-boot-tests.sh:538: # because the marker's own PASS also requires them, so a gate that re-derives
docker/qemu/run-x86-boot-tests.sh:539: # them cannot be satisfied by a verdict that drifted.
docker/qemu/run-x86-boot-tests.sh:540: TIMER_WAKE_LATENCY_ORACLE_PREFIX='[TIMER_WAKE_LATENCY_ORACLE:'
docker/qemu/run-x86-boot-tests.sh:541: TIMER_WAKE_LATENCY_ORACLE_PASS_PATTERN='\[TIMER_WAKE_LATENCY_ORACLE:x86:sleep_ms=10:peers=8:overrun_ms=[0-9]+:bound_ms=100:quantum_ms=50:round_ms=400:wake_enqueues=[1-9][0-9]*:peers_started=8:peers_spinning=8:backstops=0:setup_ms=[0-9]+:window_ms=[0-9]+:measured=1:PASS\]'
docker/qemu/run-x86-boot-tests.sh:542: # Anti-vacuity preflights on that pattern, in the shape the aarch64 strict gate
docker/qemu/run-x86-boot-tests.sh:543: # uses for its own oracle patterns: a sample carrying the pre-fix reading must
docker/qemu/run-x86-boot-tests.sh:544: # be REJECTED, and a sample carrying a real measured reading must be ACCEPTED.
docker/qemu/run-x86-boot-tests.sh:545: # Without the first, a gate could score green on a line it did not really
docker/qemu/run-x86-boot-tests.sh:546: # constrain; without the second, this gate could not pass.
docker/qemu/run-x86-boot-tests.sh:547: timer_wake_oracle_sample() {
docker/qemu/run-x86-boot-tests.sh:548:     printf '[TIMER_WAKE_LATENCY_ORACLE:x86:sleep_ms=10:peers=8:overrun_ms=%s:bound_ms=100:quantum_ms=50:round_ms=400:wake_enqueues=1:peers_started=8:peers_spinning=8:backstops=0:setup_ms=120:window_ms=430:measured=1:%s]\n' "$1" "$2"
docker/qemu/run-x86-boot-tests.sh:549: }
docker/qemu/run-x86-boot-tests.sh:550: if timer_wake_oracle_sample 2592 FAIL | grep -qE "$TIMER_WAKE_LATENCY_ORACLE_PASS_PATTERN"; then
docker/qemu/run-x86-boot-tests.sh:551:     echo "x86 frame-custody gate preflight: TIMER_WAKE_LATENCY_ORACLE_PASS_PATTERN accepts the pre-#766 reading (overrun_ms=2592, FAIL), so this gate would score green on the round-robin wake latency it exists to catch"
docker/qemu/run-x86-boot-tests.sh:552:     false
docker/qemu/run-x86-boot-tests.sh:553: fi
docker/qemu/run-x86-boot-tests.sh:554: if ! timer_wake_oracle_sample 41 PASS | grep -qE "$TIMER_WAKE_LATENCY_ORACLE_PASS_PATTERN"; then
docker/qemu/run-x86-boot-tests.sh:555:     echo "x86 frame-custody gate preflight: TIMER_WAKE_LATENCY_ORACLE_PASS_PATTERN rejects overrun_ms=41, a reading the repaired dispatch really records, so this gate cannot pass"
docker/qemu/run-x86-boot-tests.sh:556:     false
docker/qemu/run-x86-boot-tests.sh:557: fi
docker/qemu/run-x86-boot-tests.sh:558: # Thirteen oracle/counter lines are pinned by the success chain below; fields are exact except for the bounded boot-state-dependent KSTACK_OWNER fields documented above.
docker/qemu/run-x86-boot-tests.sh:559: # Ten launched test programs, one smoke_hello_time (the RING3_SMOKE process
docker/qemu/run-x86-boot-tests.sh:560: # kernel_main_continue creates after the twelve disk-loaded ones), one
docker/qemu/run-x86-boot-tests.sh:561: # futex_handoff_oracle, one df_preempt_oracle, 64 retire-cohort children, five loopback_wake_test
docker/qemu/run-x86-boot-tests.sh:562: # processes (parent, reader, peer, load, watchdog), 16 exec-cohort children, one
docker/qemu/run-x86-boot-tests.sh:563: # clonevm_exec_test process (renamed by its second-stage exec), its phase-1
docker/qemu/run-x86-boot-tests.sh:564: # CLONE_VM child, two clone-admission oracle rows, one init designation
docker/qemu/run-x86-boot-tests.sh:565: # oracle terminated-row refusal (arm A5), and the two rows P6a PR-2's tombstone
docker/qemu/run-x86-boot-tests.sh:566: # join oracle stages — its fixture has to reach the real zombie state, so both
docker/qemu/run-x86-boot-tests.sh:567: # rows pass through terminate_minimal, which is the tally's choke point. The
docker/qemu/run-x86-boot-tests.sh:568: # init designation oracle's other synthetic rows are removed with remove_process
docker/qemu/run-x86-boot-tests.sh:569: # and contribute nothing, while its two construction-failure arms create no row
docker/qemu/run-x86-boot-tests.sh:570: # at all:
docker/qemu/run-x86-boot-tests.sh:571: # 10 + 1 + 1 + 1 + 64 + 5 + 16 + 1 + 1 + 2 + 1 + 2 = 105. The exec-detach oracle contributes
docker/qemu/run-x86-boot-tests.sh:572: # zero because its rows use the deferred-reclaim path rather than the
docker/qemu/run-x86-boot-tests.sh:573: # Process::terminate / terminate_minimal tally choke point. This is a floor,
docker/qemu/run-x86-boot-tests.sh:574: # checked >= by scripts/x86-gate-verdict.sh; the production-path arm execs the
docker/qemu/run-x86-boot-tests.sh:575: # cohort's already-inserted parent and fails without launching a new userspace
docker/qemu/run-x86-boot-tests.sh:576: # process; re-pin consciously.
docker/qemu/run-x86-boot-tests.sh:577: # claim-lint:ok: the 12 addends above are this paragraph's own enumeration,
docker/qemu/run-x86-boot-tests.sh:578: # and their sum is checked as a FLOOR (>=) by scripts/x86-gate-verdict.sh, so a
docker/qemu/run-x86-boot-tests.sh:579: # boot that exits fewer rows than the enumeration names still fails it. The
docker/qemu/run-x86-boot-tests.sh:580: # "contribute nothing" clause names rows removed with remove_process, which
docker/qemu/run-x86-boot-tests.sh:581: # never reach the Process::terminate / terminate_minimal choke point this
docker/qemu/run-x86-boot-tests.sh:582: # floor counts.
docker/qemu/run-x86-boot-tests.sh:583: #
docker/qemu/run-x86-boot-tests.sh:584: # Re-derived for P6a PR-2, and the re-derivation closed a pre-existing one-row
docker/qemu/run-x86-boot-tests.sh:585: # gap rather than only adding this PR's two: the enumeration read 101 while the
docker/qemu/run-x86-boot-tests.sh:586: # gate's own runs measured 102 (two runs, 2026-08-23) because smoke_hello_time
docker/qemu/run-x86-boot-tests.sh:587: # was never counted. 102 + this PR's two staged rows = 104, which is what the
docker/qemu/run-x86-boot-tests.sh:588: # branch's own run measures.
docker/qemu/run-x86-boot-tests.sh:589: #
docker/qemu/run-x86-boot-tests.sh:590: # 105, not 104, since the 737 direction-flag preempt oracle joined the
docker/qemu/run-x86-boot-tests.sh:591: # RING3_SMOKE roster. It is one more launched program that runs to
docker/qemu/run-x86-boot-tests.sh:592: # completion and exits once, so it moves this floor by exactly 1. It never
docker/qemu/run-x86-boot-tests.sh:593: # forks, so it contributes 0 to PRODUCTION_REAPED_ROWS above, which is
docker/qemu/run-x86-boot-tests.sh:594: # derived from fork call sites and is left untouched by this addition.
docker/qemu/run-x86-boot-tests.sh:595: # claim-lint:ok: 0 of 0 fork() call sites in
docker/qemu/run-x86-boot-tests.sh:596: # userspace/programs/src/df_preempt_oracle.rs under the same
docker/qemu/run-x86-boot-tests.sh:597: # grep -cE '(match|=) *([a-zA-Z_]+::)*fork\(\)' pattern the
docker/qemu/run-x86-boot-tests.sh:598: # PRODUCTION_REAPED_ROWS loop above runs; the +1 is the single exit of the
docker/qemu/run-x86-boot-tests.sh:599: # single process kernel/src/main.rs creates for it. #737.
docker/qemu/run-x86-boot-tests.sh:600: readonly EXPECTED_USERSPACE_EXITS=105
