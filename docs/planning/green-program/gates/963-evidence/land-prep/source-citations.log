docker/qemu/lib/gate-qmp-backstop.sh:77: gqb_dump_and_report() {
docker/qemu/lib/gate-qmp-backstop.sh:78:     local sock="$1" output_dir="$2" fc_sh="$3" decode_py="$4" kernel_elf="$5"
docker/qemu/lib/gate-qmp-backstop.sh:79:     local budget_s="${6:-30}"
