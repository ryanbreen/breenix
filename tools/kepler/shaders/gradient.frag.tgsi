FRAG
DCL IN[0], POSITION, LINEAR
DCL OUT[0], COLOR
DCL TEMP[0..1]
IMM[0] UINT32 {1, 2, 0, 0}
IMM[1] FLT32 {0.003921568627450980392156862745098, 1.0, 0.0, 0.0}
F2U TEMP[0].xy, IN[0]
UADD TEMP[1].x, TEMP[0].xxxx, TEMP[0].yyyy
SHL TEMP[1].x, TEMP[1].xxxx, IMM[0].xxxx
SHL TEMP[1].y, TEMP[0].yyyy, IMM[0].yyyy
SHL TEMP[1].z, TEMP[0].xxxx, IMM[0].yyyy
U2F TEMP[1].xyz, TEMP[1]
MUL OUT[0].xyz, TEMP[1], IMM[1].xxxx
MOV OUT[0].w, IMM[1].yyyy
END
