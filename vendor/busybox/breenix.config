# BusyBox Breenix configuration fragment
# Apply on top of allnoconfig using make allnoconfig followed by enabling these

# Build options
CONFIG_STATIC=y
CONFIG_CROSS_COMPILER_PREFIX="x86_64-linux-musl-"
CONFIG_EXTRA_LDFLAGS="-Wl,-Ttext-segment=0x40000000"
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_CLEAN_UP=y

# Core applets (replacements for b-prefixed coreutils)
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_GREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_MORE=y
CONFIG_TOUCH=y
CONFIG_LN=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_WHICH=y

# Shell (ash)
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_BUILTIN_PRINTF=y
CONFIG_ASH_BUILTIN_TEST=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y

# Text processing
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FIND=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_TEE=y
CONFIG_XARGS=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_PRINTF=y
CONFIG_OD=y
CONFIG_HEXDUMP=y

# File utilities
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y

# System info
CONFIG_DF=y
CONFIG_DU=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_UNAME=y
CONFIG_DATE=y
CONFIG_HOSTNAME=y

# Process/identity
CONFIG_SLEEP=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_EXPR=y
CONFIG_SEQ=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_ENV=y

# Checksums
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y

# Editor
CONFIG_VI=y
