# BusyBox for /bin and the libc and utilities suites, built against Breenix's
# own C library. scripts/build-libc-busybox.sh applies this on allnoconfig.

CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SHOW_USAGE=y
CONFIG_LONG_OPTS=y

# The shell, with echo, printf and test built in.
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=n
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
# $((...)) arithmetic expansion.
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y

CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_GREP=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_XARGS=y
CONFIG_PRINTF=y
CONFIG_EXPR=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_MD5SUM=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_DATE=y

# Full utility suite and legacy /bin parity.
CONFIG_CHMOD=y
CONFIG_CMP=y
CONFIG_COMM=y
CONFIG_DF=y
CONFIG_DIFF=y
# diff DIR DIR and diff -r.
CONFIG_FEATURE_DIFF_DIR=y
CONFIG_DU=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_TRUE=y
CONFIG_ID=y
CONFIG_GROUPS=y
CONFIG_LN=y
CONFIG_NICE=y
CONFIG_NOHUP=y
CONFIG_OD=y
CONFIG_PASTE=y
CONFIG_PS=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_TEE=y
CONFIG_TIME=y
CONFIG_TIMEOUT=y
CONFIG_TOUCH=y
CONFIG_TTY=y
CONFIG_UNAME=y
CONFIG_KILL=y
CONFIG_MORE=y
CONFIG_WHICH=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_FREE=y
CONFIG_SEQ=y
CONFIG_WHOAMI=y
CONFIG_HOSTNAME=y
CONFIG_HEXDUMP=y
CONFIG_SHA256SUM=y
CONFIG_VI=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_GETOPTS=y
CONFIG_DESKTOP=y
CONFIG_FEATURE_TOUCH_SUSV3=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_FEATURE_FIND_MTIME=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_PAREN=y
# The rest of POSIX find's primaries; -exec ... {} + batches its operands.
CONFIG_FEATURE_FIND_EXEC_PLUS=y
CONFIG_FEATURE_FIND_EXEC_OK=y
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_FIND_PERM=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_LINKS=y
CONFIG_FEATURE_FIND_USER=y
CONFIG_FEATURE_FIND_GROUP=y
CONFIG_FEATURE_FIND_NEWER=y
CONFIG_FEATURE_FIND_XDEV=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_ATIME=y
CONFIG_FEATURE_FIND_CTIME=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_FEATURE_XARGS_SUPPORT_REPL_STR=y
CONFIG_FEATURE_XARGS_SUPPORT_QUOTES=y
CONFIG_FEATURE_GREP_CONTEXT=y

# Image links are installed by the Breenix image builder.
CONFIG_FEATURE_INSTALLER=n
CONFIG_SHA512SUM=n

# ps -o nice=, required by process-utils/nice, and ps -G and -U (real IDs).
CONFIG_FEATURE_PS_ADDITIONAL_COLUMNS=y
# ps -o time and -o etime, and the TIME column of the default listing.
CONFIG_FEATURE_PS_TIME=y
# Fractional durations: sleep 0.5, timeout 0.5 cmd.
CONFIG_FLOAT_DURATION=y
