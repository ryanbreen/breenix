# BusyBox built against Breenix's own C library: the applets the libc suite's busybox
# category runs, and the features its cases use. scripts/build-libc-busybox.sh applies
# this on top of allnoconfig.

CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SHOW_USAGE=y
CONFIG_LONG_OPTS=y

# The shell, with echo, printf and test built in.
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=n
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
# $((...)) arithmetic expansion.
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y

CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_GREP=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_XARGS=y
CONFIG_PRINTF=y
CONFIG_EXPR=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_MD5SUM=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_DATE=y
