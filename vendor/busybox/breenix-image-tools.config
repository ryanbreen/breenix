# Kbuild's mkconfigs and usage_compressed scripts run these image applets.
CONFIG_BZIP2=y
CONFIG_DD=y
# The build driver verifies chained SHA-256 receipts with sha256sum -c.
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y
# The pinned source archive contains GNU long-name records.
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
