+static void print_range(int a, int b, char sep)
+{
+	printf("%d", MIN(a, b));
+	if (a < b)
+		printf("%c%d", sep, b);
+}
+
+/* Text for an ed command, ending input mode. In a script (-e) a line holding
+ * only "." would end input mode early: it is written as "..", input mode ends,
+ * the extra dot is removed and appending resumes after it. */
+static void ed_text(FILE_and_pos_t *ft, const off_t *ix, int a, int b, bool script)
+{
+	bool ended = false;
+	int i;
+
+	for (i = a; i <= b; i++) {
+		int len = ix[i] - ix[i - 1];
+		ended = false;
+		if (script && (len == 2 || (len == 1 && i == b))) {
+			int c0, c1 = '\n';
+			seek_ft(ft, ix[i - 1]);
+			c0 = fgetc(ft->ft_fp);
+			if (len == 2)
+				c1 = fgetc(ft->ft_fp);
+			fseeko(ft->ft_fp, ft->ft_pos, SEEK_SET);
+			if (c0 == '.' && c1 == '\n') {
+				puts("..\n.\ns/.//");
+				if (i < b)
+					puts("a");
+				ended = true;
+				continue;
+			}
+		}
+		fetch(ft, ix, i, i, 0);
+	}
+	if (!ended)
+		puts(".");
 }
 
+static void print_header(const char *mark, int i, char *file[2])
+{
+	char when[64];
+	struct tm *tm;
+
+	if (label[i]) {
+		printf("%s %s\n", mark, label[i]);
+	} else if (CONTEXT_FORMAT && (tm = localtime(&stb[i].st_mtime)) != NULL
+	        && strftime(when, sizeof(when), "%a %b %e %T %Y", tm) != 0) {
+		/* POSIX: "*** %s %s\n" with date's "+%a %b %e %T %Y" timestamp */
+		printf("%s %s %s\n", mark, file[i], when);
+	} else {
+		printf("%s %s\n", mark, file[i]);
+	}
+}
