+static void print_range(int a, int b)
+{
+	printf("%d", MIN(a, b));
+	if (a < b)
+		printf(",%d", b);
+}
+
+static void directory_header(char *file[2])
+{
+	int i;
+	if (!G.directory || (option_mask32 & FLAG(q))) return;
+	printf("diff");
+	for (i = 1; i < G.option_count; i++) printf(" %s", G.options[i]);
+	printf(" %s %s\n", file[0], file[1]);
+}
+
+static void context_header(char *file[2])
+{
+	int j;
+	for (j = 0; j < 2; j++) {
+		char stamp[64];
+		struct tm *tm = localtime(&stb[j].st_mtime);
+		if (!tm || !strftime(stamp, sizeof(stamp), "%a %b %e %T %Y", tm))
+			bb_simple_error_msg_and_die("invalid file timestamp");
+		printf("%s %s %s\n", j ? "---" : "***", label[j] ? label[j] : file[j], stamp);
+	}
+}
+
+/* ed terminates input on a single dot. Escape it, then restore that line
+ * with an addressed substitution after completing this input block. */
+static void script_text(FILE_and_pos_t *ft, off_t *ix, int a, int b, int base, bool ed)
+{
+	int i, c;
+	for (i = a; i <= b; i++) {
+		seek_ft(ft, ix[i - 1]);
+		if (ed && ix[i] - ix[i - 1] == 2 && fgetc(ft->ft_fp) == '.') putchar('.');
+		ft->ft_pos = -1;
+		seek_ft(ft, ix[i - 1]);
+		while ((c = fgetc(ft->ft_fp)) != EOF) {
+			ft->ft_pos++;
+			putchar(c);
+			if (c == '\n') break;
+		}
+		if (c == EOF) putchar('\n');
+	}
+	puts(".");
+	if (ed) for (i = a; i <= b; i++) {
+		seek_ft(ft, ix[i - 1]);
+		if (ix[i] - ix[i - 1] == 2 && fgetc(ft->ft_fp) == '.')
+			printf("%ds/^\\.\\.$/./\n", base + i - a);
+		ft->ft_pos = -1;
+	}
+}
