+/* Input errors make diff's status 2, never "same" or "different". */
+static bool read_failed(FILE *fp[2], char *file[2])
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		if (ferror(fp[i])) {
+			bb_perror_msg("%s", file[i]);
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Output that was not written is an error, whatever the comparison found. */
+static int output_status(void)
+{
+	if (fflush(stdout) != 0 || ferror(stdout)) {
+		bb_simple_perror_msg(bb_msg_standard_output);
+		return 2;
+	}
+	return (exit_status & 2) ? 2 : exit_status;
+}
