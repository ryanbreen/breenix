+/* POSIX selection: each list option is one argument of items separated by
+ * commas or blanks; an empty list or item is a syntax error. A process is
+ * written if any given option selects it.
+ */
+struct selection {
+	char **items;
+	unsigned *ids;
+	unsigned count;
+};
+
+static void split_lists(llist_t *lists, struct selection *sel)
+{
+	while (lists) {
+		char *s = llist_pop(&lists);
+		int need_item = 1; /* at the start, or after a comma */
+		for (;;) {
+			char sep;
+			s += strspn(s, " \t");
+			if (*s == '\0' || *s == ',') {
+				if (need_item)
+					bb_simple_error_msg_and_die("list syntax error");
+				if (*s++ == '\0')
+					break;
+				need_item = 1;
+				continue;
+			}
+			sel->items = xrealloc_vector(sel->items, 4, sel->count);
+			sel->items[sel->count++] = s;
+			s += strcspn(s, ", \t");
+			sep = *s;
+			if (sep)
+				*s++ = '\0';
+			need_item = (sep == ',');
+			if (!sep)
+				break;
+		}
+	}
+}
 
+/* Numeric IDs, or user or group names when `name2id` is given. */
+static void select_ids(llist_t *lists, struct selection *sel, long FAST_FUNC (*name2id)(const char *))
+{
+	unsigned i;
+
+	split_lists(lists, sel);
+	sel->ids = xzalloc(sel->count * sizeof(sel->ids[0]) + 1);
+	for (i = 0; i < sel->count; i++) {
+		const char *item = sel->items[i];
+		if (name2id && item[strspn(item, "0123456789")] != '\0')
+			sel->ids[i] = name2id(item);
+		else
+			sel->ids[i] = xatou(item);
+	}
+}
+
+static int has_id(const struct selection *sel, unsigned id)
+{
+	unsigned i;
+	for (i = 0; i < sel->count; i++)
+		if (sel->ids[i] == id)
+			return 1;
+	return 0;
+}
+
+static int has_tty(const struct selection *sel, const procps_status_t *p)
+{
+	char name[32];
+	unsigned i;
+
+	tty_name(name, sizeof(name), p->tty_major, p->tty_minor);
+	for (i = 0; i < sel->count; i++) {
+		const char *item = sel->items[i];
+		if (is_prefixed_with(item, "/dev/"))
+			item += 5;
+		if (strcmp(item, name) == 0)
+			return 1;
+	}
+	return 0;
+}
