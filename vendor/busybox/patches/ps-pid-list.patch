+/* The terminal's name, as ps -t takes it: pts/N, ttyN or console; "?"
+ * for none (a tty field of 0). */
+static void tty_name(char *buf, int size, unsigned major, unsigned minor)
+{
+	if (major >= 136 && major <= 143)
+		snprintf(buf, size, "pts/%u", (major - 136) * 256 + minor);
+	else if (major == 5 && minor == 1)
+		snprintf(buf, size, "console");
+	else if (major == 4)
+		snprintf(buf, size, "tty%u", minor);
+	else if (major)
+		snprintf(buf, size, "%u,%u", major, minor);
+	else
+		snprintf(buf, size, "?");
 }
 
