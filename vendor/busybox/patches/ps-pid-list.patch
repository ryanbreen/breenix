+	opt = getopt32(argv, "Zo:*aAdefl"IF_FEATURE_SHOW_THREADS("T")"p:*", &opt_o, &opt_p);
+	/* POSIX: -p proclist, a blank- or comma-separated list of PIDs */
+	while (opt_p) {
+		char *list = llist_pop(&opt_p);
+		char *pid;
+		while ((pid = strsep(&list, ", \t")) != NULL) {
+			if (!pid[0])
+				continue;
+			pids = xrealloc_vector(pids, 4, pid_cnt);
+			pids[pid_cnt++] = xatou(pid);
+		}
+	}
+	/* -A and -e select every process whatever else is selected */
+	if (opt & (OPT_A | OPT_e))
+		pid_cnt = 0;
 
